---
import AnalyticsTable from "./AnalyticsTable.astro";
import type { AnalyticsV2ViewModel } from "../lib/analytics-v2";
import {ANALYTICS_V2_COPY,contextLabel,formatComparisonPeriod} from "../lib/analytics-v2-language";
type View="overview"|"explore"|"diagnostics";type Area="search"|"discovery"|"products"|"brands"|"returning"|"acquisition";
const {model,view,area}=Astro.props as {model:AnalyticsV2ViewModel;view:View;area:Area};
const n=(v:number|null,d=0)=>v==null?ANALYTICS_V2_COPY.insufficient.sample:new Intl.NumberFormat("bg-BG",{maximumFractionDigits:d}).format(v),pct=(v:number|null)=>v==null?ANALYTICS_V2_COPY.insufficient.sample:`${n(v*100,1)}%`;
const areaHref=(next:Area)=>{const p=new URLSearchParams(Astro.url.searchParams);p.set("view","explore");p.set("area",next);return`/analytics/?${p}`};const areas=Object.keys(ANALYTICS_V2_COPY.explore) as Area[];
---
<section class="v2-shell" aria-labelledby="analytics-v2-title">
 <header class="v2-head"><div><h2 id="analytics-v2-title">Откриване и интерес</h2><p>{formatComparisonPeriod(model.period.start,model.period.end,model.period.previousStart,model.period.previousEnd)}</p></div><span class:list={["status",{weak:!model.period.comparisonAvailable}]}>{model.period.comparisonAvailable?"Има данни за двата периода":"Недостатъчни данни за сравнение"}</span></header>
 {view==="overview"&&<section class="v2-section"><h3>Какво трябва да знам?</h3>{model.insights.length?<div class="insights">{model.insights.map(i=><article class="insight"><div class="insight-top"><strong>{i.statement}</strong><span class={`confidence ${i.confidence.toLowerCase()}`}>{i.confidenceLabel}</span></div><b class="magnitude">{i.change}</b><p>{i.comparison}</p><p><b>Основание:</b> {i.evidenceText}</p><small>{i.sampleText}</small>{i.caveat&&<p class="caveat">{i.caveat}</p>}<p class="question">{i.question}</p></article>)}</div>:<div class="empty">{model.lowData.message}</div>}<p class="activity">За периода са отчетени {n(model.quality.events)} събития от посетители, дали съгласие.</p><p class="admin-note">Праговете за увереност ще бъдат калибрирани с натрупване на повече данни.</p></section>}
 {view==="explore"&&<><nav class="area-nav" aria-label="Области за разглеждане">{areas.map(key=><a href={areaHref(key)} aria-current={area===key?"page":undefined} class:list={{active:area===key}}>{ANALYTICS_V2_COPY.explore[key]}</a>)}</nav>
 {area==="search"&&<section class="v2-section"><h3>Търсене</h3>{model.search.totals.searches?<><div class="summary-grid"><article><span>Търсения</span><b>{n(model.search.totals.searches)}</b></article><article><span>Посетители с търсене</span><b>{n(model.search.totals.visitors)}</b></article><article><span>Без резултат</span><b>{pct(model.search.totals.zeroRate)}</b></article><article><span>Промяна на заявката</span><b>{pct(model.search.totals.reformulationRate)}</b></article><article><span>Търсене → отваряне</span><b>{pct(model.search.totals.selectionRate)}</b></article><article><span>Търсене → сайт на бранд</span><b>{pct(model.search.totals.outboundRate)}</b></article></div><AnalyticsTable heads={["Заявка","Търсения","Посетители","Медиана резултати","Без резултат","Реално показване","Отваряне","Към бранд","Отваряне / търсене"]} rows={model.search.searches.map(x=>[x.query,x.searches,x.visitors,n(x.medianSupply),x.zero,x.exposed,x.selected,x.outbound,pct(x.selectionRate)])} paginate/></>:<div class="empty">Няма наблюдавана активност в търсенето за избрания период.</div>}</section>}
 {area==="discovery"&&<><section class="v2-section"><h3>Пътят до интерес</h3><div class="funnel-v2">{model.funnel.map((x,index)=><article><span>{x.label}</span><b>{n(x.count)}</b><small>наблюдавано при {n(x.visitors)} посетители</small><small>{x.rate==null?(index===0?"Всички измерени възможности в периода":"Няма надеждна база за процент"):index===1?`${pct(x.rate)} от продуктите, които са могли да бъдат показани`:`${pct(x.rate)} спрямо предходната стъпка`}</small>{"secondaryRate" in x&&x.secondaryRate!=null&&<small>{pct(x.secondaryRate)} от реалните показвания</small>}</article>)}</div><p class="caveat">Всеки процент използва изрично показаната база. Преминаването към сайта на бранда е сигнал за намерение, не покупка.</p></section><section class="v2-section"><h3>Откъде хората откриват продукти</h3>{model.surfaces.length?<AnalyticsTable heads={["Място","Продукти, които са могли да бъдат показани","Реални показвания","Отваряния","Продуктови страници","Сигнали за интерес","Към бранд","Отваряне / показване"]} rows={model.surfaces.map(x=>[x.label,x.canonical?n(x.eligible):"Не е приложимо",x.exposed,x.selected,x.pageViewed,x.considered,x.outbound,pct(x.selectionRate)])}/>:<div class="empty">Няма наблюдавана активност в тази област за избрания период.</div>}</section></>}
 {area==="products"&&<section class="v2-section"><h3>Продукти</h3>{model.products.length?<AnalyticsTable id="v2-products" paginate heads={["Продукт","Бранд","Възможности","Реално показване","Посетители","Отваряния","Дял отваряния","Продуктова страница","Сигнал за интерес","Към бранд","Към бранд / показване","Медианна позиция","Основни места"]} rows={model.products.map(x=>[x.name,x.brand,x.eligible,x.exposed,x.visitors,x.selected,pct(x.selectionRate),x.pageViews,x.consideration,x.outbound,pct(x.outboundRate),n(x.medianPosition,1),x.surfaces.split(", ").map(contextLabel).join(", ")])}/>:<div class="empty">Няма наблюдавана продуктова активност за избрания период.</div>}</section>}
 {area==="brands"&&<section class="v2-section"><h3>Брандове</h3>{model.brands.length?<AnalyticsTable heads={["Бранд","Реални показвания","Отваряния","Страница на бранд","Към сайта на бранда","Интерес към няколко продукта","Повторен интерес","Показвания на продукти","Отваряния на продукти","Към продукт в сайта на бранда"]} rows={model.brands.map(x=>[x.name,x.impressions,x.selections,x.pageViews,x.outbound,x.multiProduct,x.repeatVisitors,x.productExposures,x.productSelections,x.productOutbound])}/>:<div class="empty">Няма наблюдавана активност за брандове през избрания период.</div>}</section>}
 {area==="returning"&&<section class="v2-section"><h3>Връщащ се интерес</h3><div class="summary-grid"><article><span>Посетители</span><b>{n(model.returning.visitors)}</b></article><article><span>Връщащи се посетители</span><b>{n(model.returning.returning)}</b><small>{pct(model.returning.rate)}</small></article><article><span>Повторен продуктов интерес</span><b>{n(model.returning.repeatProducts)}</b></article><article><span>Повторен интерес към бранд</span><b>{n(model.returning.repeatBrands)}</b></article></div>{!model.returning.repeatProducts&&!model.returning.repeatBrands&&<div class="empty compact">Все още няма достатъчно данни за надеждно измерване на интерес между отделни посещения.</div>}<p class="caveat">„Връщащ се посетител“ означава разпознат анонимен браузър, не идентифициран човек. Повторения в едно посещение не се броят за връщане.</p></section>}
 {area==="acquisition"&&<section class="v2-section"><h3>Откъде идват посетителите</h3>{model.acquisitionUnknown.visits>0&&<aside class="explanation"><strong>Не успяхме да определим източника за {n(model.acquisitionUnknown.visits)} посещения.</strong>{model.acquisitionUnknown.reasons.length?<ul>{model.acquisitionUnknown.reasons.map(reason=><li>{n(reason.count)} {reason.label}</li>)}</ul>:<p>Наличните данни не позволяват причините да бъдат разграничени по-надеждно.</p>}<small>Техническите стойности за източник се виждат в „Диагностика“.</small></aside>}{model.acquisition.length?<AnalyticsTable heads={["Канал","Източник","Тип","Кампания","Препращащ сайт","Посетители","Активни посещения","Реални показвания","Отваряния","Сигнали за интерес","Към бранд","Връщащи се"]} rows={model.acquisition.map(x=>[x.channelLabel,x.source,x.medium||"—",x.campaign||"—",x.referrer||"—",x.visitors,x.discoveryActiveSessions,x.exposed,x.selected,x.considered,x.outbound,x.returningVisitors])}/>:<div class="empty">Няма достатъчно данни за източниците на посещения. Групите с по-малко от 2 посетители са скрити.</div>}</section>}</>}
 {view==="diagnostics"&&<section class="v2-section"><h3>Качество и надеждност на данните</h3><div class="summary-grid"><article><span>Събития в периода</span><b>{n(model.quality.events)}</b></article><article><span>Пълни състояния на откриване</span><b>{n(model.quality.completeStates)}</b></article><article><span>Непълни състояния</span><b>{n(model.quality.incompleteStates)}</b></article><article><span>Елементи в резултатите</span><b>{n(model.quality.members)}</b></article><article><span>Стари неразграничени прегледи</span><b>{n(model.quality.legacyViews)}</b></article><article><span>Събития без посетителска идентичност</span><b>{n(model.quality.missingIdentity)}</b></article><article><span>Период за сравнение</span><b>{model.quality.comparisonAvailable?"Наличен":"Недостатъчен"}</b></article><article><span>Исторически период</span><b>{model.quality.lookbackAvailable?"Зареден":"Недостъпен"}</b></article></div>{model.quality.diagnostics>0&&<p class="warning">Открити диагностични сигнали: {model.quality.diagnostics}. Непълните състояния са изключени от базите за изчисление.</p>}</section>}
</section>
<style>.v2-shell{box-sizing:border-box;width:100%;max-width:100%;min-width:0;overflow:hidden;margin:18px 0 28px;padding:20px;background:#f6faf7;border:1px solid #cddfd3;border-radius:12px}.v2-head{display:flex;justify-content:space-between;gap:20px;align-items:start}.v2-head h2{margin:.2rem 0}.v2-head p,.caveat,.admin-note{color:#66706a}.status{padding:7px 10px;border-radius:20px;background:#dceee2;color:#245d37;white-space:nowrap}.status.weak{background:#fff0cf;color:#80520b}.area-nav{display:flex;gap:7px;flex-wrap:wrap;margin:18px 0}.area-nav a{padding:8px 11px;border:1px solid var(--line);border-radius:20px;background:#fff;color:inherit;text-decoration:none}.area-nav a.active{background:var(--green);color:#fff}.v2-section{width:100%;max-width:100%;min-width:0;overflow:hidden;margin-top:22px;padding-top:18px;border-top:1px solid #d9e7dd}.v2-section :global(.table-wrap){box-sizing:border-box;width:100%;max-width:100%;overflow-x:auto}.v2-section h3{margin-top:0}.insights{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.insight{padding:15px;background:#fff;border:1px solid var(--line);border-radius:9px}.insight-top{display:flex;justify-content:space-between;gap:15px}.magnitude{display:block;font-size:1.35rem;margin-top:10px}.confidence{font-size:.75rem;padding:4px 7px;border-radius:12px;white-space:nowrap;background:#eee}.confidence.medium,.confidence.high{background:#dceee2;color:#245d37}.caveat,.admin-note{font-size:.88rem}.question{font-weight:600}.empty,.explanation{padding:18px;border:1px dashed #bccbc0;border-radius:8px;background:#fff;color:#5d675f}.explanation{margin-bottom:12px}.empty.compact{margin-top:10px;padding:10px}.activity{font-weight:600}.funnel-v2,.summary-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:9px}.funnel-v2 article,.summary-grid article{padding:12px;background:#fff;border:1px solid var(--line);border-radius:8px}.funnel-v2 span,.funnel-v2 b,.funnel-v2 small,.summary-grid span,.summary-grid b,.summary-grid small{display:block}.funnel-v2 b,.summary-grid b{font-size:1.3rem;margin:.25rem 0}.funnel-v2 small,.summary-grid small{color:#68716b}.warning{color:#80520b}@media(max-width:1100px){.funnel-v2,.summary-grid{grid-template-columns:repeat(3,1fr)}.insights{grid-template-columns:1fr}}@media(max-width:700px){.v2-shell{padding:14px}.v2-head{display:block}.status{display:inline-block;white-space:normal}.funnel-v2,.summary-grid{grid-template-columns:1fr}}</style>
