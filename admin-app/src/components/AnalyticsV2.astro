---
import AnalyticsTable from "./AnalyticsTable.astro";
import type { AnalyticsV2ViewModel } from "../lib/analytics-v2";
const {model}=Astro.props as {model:AnalyticsV2ViewModel};
const n=(v:number|null,d=0)=>v==null?"Недостатъчно данни":new Intl.NumberFormat("bg-BG",{maximumFractionDigits:d}).format(v),pct=(v:number|null)=>v==null?"Недостатъчно данни":`${n(v*100,1)}%`;
const surface=(v:string)=>({homepage_default:"Начална страница",search_results:"Търсене",category_results:"Категория",taxonomy_results:"Категория",gift_discovery:"Подаръци",seo_landing:"SEO страница",brand_page_products:"Продукти на бранд",related_products:"Свързани продукти",more_from_brand:"Още от бранда",saved_products:"Запазени продукти",named_collection:"Именувана колекция",shared_collection:"Споделена колекция",brand_directory:"Каталог с брандове"} as Record<string,string>)[v]||v.replaceAll("_"," ");
---
<section class="v2-shell" aria-labelledby="analytics-v2-title">
 <header class="v2-head"><div><span class="eyebrow">Analytics V2</span><h2 id="analytics-v2-title">Изводи за откриването и интереса</h2><p>Период {model.period.start.toISOString().slice(0,10)} → {model.period.end.toISOString().slice(0,10)} · сравнение с непосредствено предходния равен период.</p></div><span class:list={["status",{weak:!model.period.comparisonAvailable}]}>{model.period.comparisonAvailable?"Има период за сравнение":"Недостатъчни данни за сравнение"}</span></header>
 <section class="v2-section"><h3>Какво се случва</h3>{model.insights.length?<div class="insights">{model.insights.map(i=><article class="insight"><div class="insight-top"><strong>{i.statement}</strong><span class={`confidence ${i.confidence.toLowerCase()}`}>{i.confidenceLabel}</span></div><p>{i.comparison}</p><p><b>Доказателства:</b> {i.evidenceText}</p><small>{i.sampleText}</small>{i.caveat&&<p class="caveat">{i.caveat}</p>}<p class="question">{i.question}</p></article>)}</div>:<div class="empty">Все още няма достатъчно данни за надеждни автоматични изводи за този период.</div>}<p class="admin-note">Праговете за увереност ще бъдат калибрирани с натрупване на повече данни.</p></section>
 <section class="v2-section"><h3>Пътят до интерес</h3><div class="funnel-v2">{model.funnel.map(x=><article><span>{x.label}</span><b>{n(x.count)}</b><small>{n(x.visitors)} приложими посетители</small><small>{x.rate==null?"Начална мерна единица":pct(x.rate)}</small>{"secondaryRate" in x&&x.secondaryRate!=null&&<small>{pct(x.secondaryRate)} от реално показване</small>}</article>)}</div><p class="caveat">Всеки процент използва изрично показания приложим denominator. „Преминаване към сайта на бранда“ е намерение, не покупка.</p></section>
 <section class="v2-section"><h3>Търсене</h3>{model.search.totals.searches?<><div class="summary-grid"><article><span>Търсения</span><b>{n(model.search.totals.searches)}</b></article><article><span>Посетители с търсене</span><b>{n(model.search.totals.visitors)}</b></article><article><span>Без резултат</span><b>{pct(model.search.totals.zeroRate)}</b></article><article><span>Преформулиране</span><b>{pct(model.search.totals.reformulationRate)}</b></article><article><span>Търсене → отваряне</span><b>{pct(model.search.totals.selectionRate)}</b></article><article><span>Търсене → сайт на бранд</span><b>{pct(model.search.totals.outboundRate)}</b></article></div><h4>Най-често търсени</h4><AnalyticsTable heads={["Заявка","Търсения","Посетители","Медиана резултати","Без резултат","Реално показване","Отваряне","Към бранд","Отваряне / търсене"]} rows={model.search.searches.map(x=>[x.query,x.searches,x.visitors,n(x.medianSupply),x.zero,x.exposed,x.selected,x.outbound,pct(x.selectionRate)])} paginate/>{model.search.searches.some(x=>x.zero>0)&&<><h4>Заявки без резултат</h4><AnalyticsTable heads={["Заявка","Търсения","Без резултат"]} rows={model.search.searches.filter(x=>x.zero>0).map(x=>[x.query,x.searches,x.zero])}/></>}{model.search.searches.some(x=>(x.medianSupply??99)>0&&(x.medianSupply??99)<=3)&&<><h4>Ограничено предлагане</h4><AnalyticsTable heads={["Заявка","Търсения","Медиана резултати","Отваряния","Към бранд"]} rows={model.search.searches.filter(x=>(x.medianSupply??99)>0&&(x.medianSupply??99)<=3).map(x=>[x.query,x.searches,n(x.medianSupply),x.selected,x.outbound])}/></>}{model.search.searches.some(x=>x.searches>=20&&x.selected===0)&&<><h4>Високо търсене без измерено отваряне</h4><AnalyticsTable heads={["Заявка","Търсения","Реални показвания","Отваряния","Към бранд"]} rows={model.search.searches.filter(x=>x.searches>=20&&x.selected===0).map(x=>[x.query,x.searches,x.exposed,x.selected,x.outbound])}/></>}{!model.search.searches.some(x=>x.zero>0||(x.medianSupply??99)<=3||x.searches>=20&&x.selected===0)&&<p class="caveat">Няма заявки, които покриват надеждно праговете за supply/engagement класификация.</p>}</>:<div class="empty">Няма достатъчно измерено търсене за този период.</div>}</section>
 <section class="v2-section"><h3>Откъде хората откриват продукти</h3>{model.surfaces.length?<AnalyticsTable heads={["Повърхност","Допустими възможности","Реални показвания","Отваряния","Продуктови страници","Сигнали за интерес","Към бранд","Отваряне / показване"]} rows={model.surfaces.map(x=>[surface(x.surface),x.canonical?n(x.eligible):"Не е приложимо",x.exposed,x.selected,x.pageViewed,x.considered,x.outbound,pct(x.selectionRate)])}/>:<div class="empty">Няма данни за discovery surfaces.</div>}<p class="caveat">При повърхности без canonical result set не се показва измислен denominator за допустими възможности.</p></section>
 <section class="v2-section"><h3>Продукти</h3>{model.products.length?<AnalyticsTable id="v2-products" paginate heads={["Продукт","Бранд","Допустими","Реално показване","Посетители","Отваряния","Дял отваряния","Продуктова страница","Сигнал за интерес","Към бранд","Към бранд / показване","Медианна позиция","Основни повърхности"]} rows={model.products.map(x=>[x.name,x.brand,x.eligible,x.exposed,x.visitors,x.selected,pct(x.selectionRate),x.pageViews,x.consideration,x.outbound,pct(x.outboundRate),n(x.medianPosition,1),x.surfaces])}/>:<div class="empty">Няма продуктови факти за периода. Сравненията с cohorts се скриват при слаба извадка.</div>}</section>
 <section class="v2-section"><h3>Брандове</h3>{model.brands.length?<AnalyticsTable heads={["Бранд","Реални показвания на бранд","Отваряния на бранд","Страница на бранд","Към сайт на бранд","Multi-product exploration","Повторен интерес","Показвания на продукти","Отваряния на продукти","Продуктови outbound intent"]} rows={model.brands.map(x=>[x.name,x.impressions,x.selections,x.pageViews,x.outbound,x.multiProduct,x.repeatVisitors,x.productExposures,x.productSelections,x.productOutbound])}/>:<div class="empty">Няма измерени brand facts за периода.</div>}</section>
 <section class="v2-section"><h3>Връщащ се интерес</h3><div class="summary-grid"><article><span>Посетители</span><b>{n(model.returning.visitors)}</b></article><article><span>Връщащи се посетители</span><b>{n(model.returning.returning)}</b><small>{pct(model.returning.rate)}</small></article><article><span>Повторен продуктов интерес</span><b>{n(model.returning.repeatProducts)}</b></article><article><span>Повторен интерес към бранд</span><b>{n(model.returning.repeatBrands)}</b></article></div>{!model.returning.repeatProducts&&!model.returning.repeatBrands&&<div class="empty compact">Няма достатъчно cross-session repeat-interest данни.</div>}<p class="caveat">„Връщащ се посетител“ означава разпознат анонимен браузър, не идентифициран човек. Повторения в една сесия не са retention.</p></section>
 <section class="v2-section"><h3>Качество на трафика</h3>{model.acquisition.length?<AnalyticsTable heads={["Източник","Medium","Кампания","Referrer","Посетители","Discovery сесии","Реални показвания","Отваряния","Сигнали за интерес","Към бранд","Връщащи се"]} rows={model.acquisition.map(x=>[x.source,x.medium||"—",x.campaign||"—",x.referrer||"—",x.visitors,x.discoveryActiveSessions,x.exposed,x.selected,x.considered,x.outbound,x.returningVisitors])}/>:<div class="empty">Няма достатъчно данни за acquisition групи. Групи с по-малко от 2 посетители са скрити.</div>}</section>
 <details class="quality"><summary>Качество и надеждност на данните</summary><div class="summary-grid"><article><span>Събития в периода</span><b>{n(model.quality.events)}</b></article><article><span>Пълни discovery states</span><b>{n(model.quality.completeStates)}</b></article><article><span>Непълни states</span><b>{n(model.quality.incompleteStates)}</b></article><article><span>Discovery members</span><b>{n(model.quality.members)}</b></article><article><span>Legacy неразграничени views</span><b>{n(model.quality.legacyViews)}</b></article><article><span>Събития без visitor identity</span><b>{n(model.quality.missingIdentity)}</b></article><article><span>Comparison</span><b>{model.quality.comparisonAvailable?"Наличен":"Недостатъчен"}</b></article><article><span>Historical lookback</span><b>{model.quality.lookbackAvailable?"Зареден":"Недостъпен"}</b></article></div>{model.quality.diagnostics>0&&<p class="warning">{model.quality.diagnostics} integrity diagnostics; непълните states са изключени от denominators.</p>}</details>
</section>
<style>.v2-shell{margin:18px 0 28px;padding:20px;background:#f6faf7;border:1px solid #cddfd3;border-radius:12px}.v2-head{display:flex;justify-content:space-between;gap:20px;align-items:start}.v2-head h2{margin:.2rem 0}.v2-head p{color:#66706a}.eyebrow{font-weight:700;color:var(--green);letter-spacing:.08em;text-transform:uppercase;font-size:.75rem}.status{padding:7px 10px;border-radius:20px;background:#dceee2;color:#245d37;white-space:nowrap}.status.weak{background:#fff0cf;color:#80520b}.v2-section{margin-top:22px;padding-top:18px;border-top:1px solid #d9e7dd}.v2-section h3{margin-top:0}.insights{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.insight{padding:15px;background:#fff;border:1px solid var(--line);border-radius:9px}.insight-top{display:flex;justify-content:space-between;gap:15px}.confidence{font-size:.75rem;padding:4px 7px;border-radius:12px;white-space:nowrap;background:#eee}.confidence.medium,.confidence.high{background:#dceee2;color:#245d37}.caveat,.admin-note{color:#6c746f;font-size:.88rem}.question{font-weight:600}.empty{padding:18px;border:1px dashed #bccbc0;border-radius:8px;background:#fff;color:#5d675f}.empty.compact{margin-top:10px;padding:10px}.funnel-v2,.summary-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:9px}.funnel-v2 article,.summary-grid article{padding:12px;background:#fff;border:1px solid var(--line);border-radius:8px}.funnel-v2 span,.funnel-v2 b,.funnel-v2 small,.summary-grid span,.summary-grid b,.summary-grid small{display:block}.funnel-v2 b,.summary-grid b{font-size:1.3rem;margin:.25rem 0}.funnel-v2 small,.summary-grid small{color:#68716b}.quality{margin-top:22px;padding:14px;background:#fff;border:1px solid var(--line);border-radius:8px}.quality summary{cursor:pointer;font-weight:700}.quality .summary-grid{margin-top:12px;grid-template-columns:repeat(4,minmax(0,1fr))}.warning{color:#80520b}@media(max-width:1100px){.funnel-v2,.summary-grid{grid-template-columns:repeat(3,1fr)}.insights{grid-template-columns:1fr}}@media(max-width:700px){.v2-head{display:block}.status{display:inline-block}.funnel-v2,.summary-grid,.quality .summary-grid{grid-template-columns:1fr}}</style>
