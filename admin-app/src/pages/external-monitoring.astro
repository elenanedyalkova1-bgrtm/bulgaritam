---
import AdminLayout from "../layouts/AdminLayout.astro";
import { externalGlobalEnabled, externalOperations, listObservedProducts, loadExternalHistory, OBSERVED_PRODUCTS_TABLE, setBrandExternalPause } from "../lib/external-monitoring";
import { listBrands, validateCsrf } from "../lib/repositories";
import { consumerDealsService } from "../lib/consumer-deals-api";
let message = ""; let error = "";
if (Astro.request.method === "POST") { const form = await Astro.request.formData(); try { validateCsrf(form, Astro.locals.admin.csrf); const brandId = Number(form.get("brand_id")); if (!brandId) throw new Error("Invalid brand"); await setBrandExternalPause(brandId, form.get("paused") === "true"); return Astro.redirect("/external-monitoring/?saved=1"); } catch (cause) { error = cause instanceof Error ? cause.message : String(cause); } }
if (Astro.url.searchParams.get("saved")) message = "Brand monitoring state saved.";
let brands:any[]=[];let observed:any[]=[];let history:any[]=[];
try { brands = await listBrands(); if (OBSERVED_PRODUCTS_TABLE) [observed, history] = await Promise.all([listObservedProducts(), loadExternalHistory()]); }
catch (cause) { error = cause instanceof Error ? cause.message : String(cause); }
let consumerDealsProbeError = "";
try { await consumerDealsService.get(new Date()); } catch (cause) { consumerDealsProbeError = cause instanceof Error ? cause.message : String(cause); }
const consumerDealsHealth = consumerDealsService.inspect(new Date());
const dailyBudget = Number(import.meta.env.EXTERNAL_MONITOR_DAILY_BUDGET || 500); const ops = externalOperations(observed, history, brands, dailyBudget);
const enabledBrands = brands.filter((brand) => brand.external_monitoring_enabled && !brand.external_monitoring_paused);
const date = (value:any) => value ? new Date(value).toLocaleString("bg-BG") : "—";
---
<AdminLayout title="External Monitoring" active="external-monitoring">
  <header class="head"><div><h1>External Monitoring</h1><p class="muted">Internal-only observed products and external deal review. Nothing here is published on /namaleniya/.</p></div></header>
  {message && <div class="notice">{message}</div>}{error && <div class="error">{error}</div>}
  {!OBSERVED_PRODUCTS_TABLE && <div class="notice warning"><strong>Schema migration required.</strong> BASEROW_OBSERVED_PRODUCTS_TABLE_ID is not configured. External monitoring remains inactive.</div>}
  <section class="panel"><strong>Global monitoring: </strong><span class={`status ${externalGlobalEnabled ? "" : "hidden"}`}>{externalGlobalEnabled ? "ON" : "OFF"}</span><span class="muted"> · enabled brands: {enabledBrands.length} · daily budget: {dailyBudget}</span></section>
  <section class="panel"><h2>Consumer deals API health</h2><div class="cards health-cards"><div class="metric">Source refresh<b>{consumerDealsHealth.lastRefreshStatus}</b></div><div class="metric">Deal count<b>{consumerDealsHealth.dealCount}</b></div><div class="metric">Last success<b class="metric-date">{date(consumerDealsHealth.lastSuccessAt)}</b></div><div class="metric">LKG age<b class="metric-date">{consumerDealsHealth.lkgAgeMs == null ? "—" : `${Math.floor(consumerDealsHealth.lkgAgeMs / 1000)}s`}</b></div></div>{consumerDealsProbeError && <div class="error">Latest refresh failed: {consumerDealsProbeError}</div>}{consumerDealsHealth.lastError && <p class="muted">Last endpoint/source error: {consumerDealsHealth.lastError} · {date(consumerDealsHealth.lastErrorAt)}</p>}</section>
  <section class="cards metrics">
    {Object.entries({"Observed products":ops.summary.observed,"Active":ops.summary.active,"Successful":ops.summary.successful,"Failed":ops.summary.failed,"Blocked":ops.summary.blocked,"Ambiguous":ops.summary.ambiguous,"Not detected":ops.summary.notDetected,"Active deals":ops.summary.deals,"Matched":ops.summary.matched,"Unmatched":ops.summary.unmatched,"Checks today":ops.summary.checksToday,"Budget remaining":ops.summary.remainingBudget}).map(([label,value])=><div class="metric">{label}<b>{value}</b></div>)}
  </section>
  <section class="panel table-wrap"><h2>Brands</h2><table><thead><tr><th>Brand</th><th>State</th><th>Observed</th><th>Successful</th><th>Failures</th><th>Deals</th><th>Last check</th><th>Action</th></tr></thead><tbody>
    {brands.filter((brand)=>brand.external_monitoring_enabled).map((brand)=>{const products=observed.filter((row)=>String(row.brand_id)===String(brand.id));const latest=products.map((row)=>ops.latest.get(String(row.id))).filter(Boolean);return <tr><td><a class="row-link" href={`/brands/${brand.id}/`}>{brand.brand_name}</a></td><td><span class={`status ${brand.external_monitoring_paused?"hidden":""}`}>{brand.external_monitoring_paused?"Paused":"Enabled"}</span></td><td>{products.length}</td><td>{latest.filter((row)=>["verified","changed","redirected"].includes(row.status)).length}</td><td>{latest.filter((row)=>["error","blocked","ambiguous","not_detected"].includes(row.status)).length}</td><td>{ops.dealCards.filter((card:any)=>String(card.product.brand_id)===String(brand.id)).length}</td><td>{date(products.map((row)=>row.last_checked_at).filter(Boolean).sort().at(-1))}</td><td><form method="post"><input type="hidden" name="csrf" value={Astro.locals.admin.csrf}/><input type="hidden" name="brand_id" value={brand.id}/><input type="hidden" name="paused" value={brand.external_monitoring_paused?"false":"true"}/><button class="secondary">{brand.external_monitoring_paused?"Resume":"Pause"}</button></form></td></tr>})}
  </tbody></table>{!brands.some((brand)=>brand.external_monitoring_enabled)&&<div class="empty">No brands enabled for external monitoring.</div>}</section>
  <section class="panel table-wrap"><h2>Internal deal review</h2><table><thead><tr><th>Product</th><th>Brand</th><th>Current</th><th>Regular</th><th>Discount</th><th>Promotion confidence</th><th>Availability</th><th>Evidence</th><th>Destination</th></tr></thead><tbody>
    {ops.reviewCards.map((card:any)=><tr><td>{card.product.image_url&&<img src={card.product.image_url} alt="" width="54" height="54" loading="lazy"/>}<strong>{card.product.title}</strong></td><td>{card.brand?.brand_name||card.product.brand_id}</td><td>{card.current_price} {card.currency}</td><td>{card.regular_price} {card.currency}</td><td>{card.discount_percent}%</td><td><code>{card.promotion_confidence||"UNKNOWN"}</code><div class="hint">{card.promotion_consumer_eligible?"consumer eligible":"not consumer eligible"}</div></td><td>{card.product.availability||"—"}</td><td><code>{card.extraction_method||"—"}</code><div class="hint">{card.confidence||"—"} · {card.active_sale?"explicit sale":"historical drop"}</div></td><td><a href={card.product.canonical_url||card.product.source_url} target="_blank" rel="noreferrer">Към магазина ↗</a><div class="hint">{date(card.latest_checked_at)}</div></td></tr>)}
  </tbody></table>{!ops.reviewCards.length&&<div class="empty">No external promotion candidates in the current internal snapshot.</div>}</section>
</AdminLayout>
<style>.metrics{grid-template-columns:repeat(6,minmax(0,1fr));margin-bottom:20px}.health-cards{margin-top:14px}.health-cards .metric b{font-size:18px}.health-cards .metric-date{font-size:14px}.table-wrap{overflow:auto}td img{border-radius:7px;object-fit:cover;vertical-align:middle;margin-right:9px}@media(max-width:1100px){.metrics{grid-template-columns:repeat(3,1fr)}}@media(max-width:700px){.metrics{grid-template-columns:repeat(2,1fr)}.health-cards{grid-template-columns:1fr}}</style>
