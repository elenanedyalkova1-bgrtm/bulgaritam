---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Стани част от Българитъм | За българските брандове";
const description = "Кандидатствай за включване на своя бранд и продукти в Българитъм — платформа за откриване според категория, повод и конкретно търсене.";
const canonical = "https://bulgaritam.bg/partnyori/";
const APPLICATION_ENDPOINT = import.meta.env.PUBLIC_BRAND_APPLICATION_ENDPOINT || "https://admin.bulgaritam.bg/api/brand-applications/";
---
<BaseLayout seo={{title,description,data:{breadcrumbs:[{name:"Начало",item:"/"},{name:"Стани партньор",item:"/partnyori/"}]}}} canonical={canonical}>
<main class="partner-page">
  <header class="hero">
    <div>
      <p class="eyebrow">За българските брандове</p>
      <h1 class="page-title">Стани част от Българитъм</h1>
      <div class="hero-copy">
        <p>Българитъм събира на едно място български продукти и брандове и ги свързва с хората според това, което реално търсят - категория, повод или конкретен продукт.</p>
        <p>Целта ни е да изградим полезна платформа за откриване, в която присъствието на брандовете не е реклама, а част от самото преживяване.</p>
      </div>
      <div class="actions"><a class="btn" href="#kandidatstvay">Кандидатствай за включване</a><a class="secondary" href="#kak-raboti">Как работи ↓</a></div>
    </div>
    <aside><span>01</span><p>Откриване по намерение, не прекъсване с реклама.</p><small>Категория<br>↓<br>Повод<br>↓<br>Продукт</small></aside>
  </header>

  <section class="section presence" id="kak-raboti">
    <header class="section-head"><p class="eyebrow">Как работи присъствието ти</p><h2>Ние подготвяме представянето.<br>Ти запазваш връзката с клиента.</h2></header>
    <div class="presence-grid">
      <div class="lead"><span>Българитъм</span><p>Подготвяме публичната страница и продуктовото присъствие на бранда.</p></div>
      <ul>
        <li><strong>Без профил за управление</strong><span>Не е необходимо да създаваш account или да поддържаш съдържание в платформата.</span></li>
        <li><strong>Без отделен магазин</strong><span>Българитъм представя и насочва, но не дублира твоя e-commerce процес.</span></li>
        <li><strong>Директно към твоя сайт</strong><span>Всеки продукт води към собствения сайт на бранда.</span></li>
        <li><strong>Клиентът остава при теб</strong><span>Поръчките и отношенията с клиентите остават изцяло при бранда.</span></li>
      </ul>
    </div>
  </section>

  <section class="section value">
    <header class="center"><p class="eyebrow">Какво получава брандът</p><h2>Присъствие в полезен контекст</h2></header>
    <ol class="value-list">
      <li><span>01</span><div><h3>Още едно място за откриване</h3><p>Продуктите могат да бъдат намирани чрез търсене, категории, подаръчни поводи и разглеждане на страниците на Българитъм.</p></div></li>
      <li><span>02</span><div><h3>Собствено присъствие</h3><p>Всеки бранд има собствена публична страница с представяне, продукти и директна връзка към неговия сайт. Това не е потребителски профил, а публична brand landing page, управлявана от Българитъм.</p></div></li>
      <li><span>03</span><div><h3>По-ясна картина за интереса</h3><p>Българитъм развива собствена first-party информация за това какво хората търсят и разглеждат. С развитието на платформата целта е тези сигнали да помагат на участващите брандове да разбират по-добре интереса към категории и типове продукти, без да обещаваме конкретни отчети или метрики, преди да са налични.</p></div></li>
    </ol>
  </section>

  <section class="participation"><p class="eyebrow">Участие</p><div><h2>Без такса за присъствие</h2><p>Включването на бранд и неговите продукти в Българитъм е без такса за присъствие.</p></div></section>

  <section class="section process">
    <header class="section-head"><p class="eyebrow">Как се включваш</p><h2>Три ясни стъпки</h2></header>
    <ol class="steps">
      <li><span>01</span><div><strong>Изпращаш кандидатура</strong><p>Споделяш основната информация за бранда и продуктите.</p></div></li>
      <li><span>02</span><div><strong>Преглеждаме информацията</strong><p>Проверяваме дали брандът и продуктите са подходящи и се свързваме при нужда от уточнения.</p></div></li>
      <li><span>03</span><div><strong>Подготвяме присъствието</strong><p>Структурираме публичната brand страница, продуктите и директните връзки към сайта ти.</p></div></li>
    </ol>
    <a class="btn" href="#kandidatstvay">Кандидатствай за включване</a>
  </section>

  <section class="application" id="kandidatstvay">
    <div><p class="eyebrow">Brand Application</p><h2>Разкажи ни за бранда</h2><p>Кратката кандидатура ни дава основата да преценим и подготвим подходящо присъствие. Изпращането ѝ не създава профил или магазин.</p></div>
    <form id="brand-application-form" data-endpoint={APPLICATION_ENDPOINT} novalidate>
      <input type="hidden" name="started_at"><label class="honey">Компания<input name="company" tabindex="-1" autocomplete="off"></label>
      <label><span>Име на бранда *</span><input name="brand_name" maxlength="160" autocomplete="organization" required></label>
      <label><span>Лице за контакт *</span><input name="contact_name" maxlength="160" autocomplete="name" required></label>
      <label><span>Email *</span><input type="email" name="email" maxlength="240" autocomplete="email" required></label>
      <label><span>Телефон</span><input type="tel" name="phone" maxlength="80" autocomplete="tel"></label>
      <label class="wide"><span>Сайт на бранда *</span><input type="url" name="website" placeholder="https://" maxlength="500" required></label>
      <label class="wide"><span>Instagram</span><input type="url" name="instagram" placeholder="https://instagram.com/…" maxlength="500"></label>
      <label class="wide"><span>Категории и типове продукти *</span><textarea name="categories" maxlength="800" required placeholder="Напр. дамско облекло, ленени рокли, аксесоари…"></textarea></label>
      <label class="wide"><span>Какво е важно да знаем за бранда?</span><textarea name="message" maxlength="3000" placeholder="Кратка история, производство в България, отличителни материали или подход…"></textarea></label>
      <label class="consent wide"><input type="checkbox" name="consent" required><span>Съгласявам се Българитъм да използва изпратената информация, за да разгледа кандидатурата и да се свърже с мен. *</span></label>
      <div class="submit wide"><button class="btn" type="submit">Изпрати кандидатура</button><p class="form-status" role="status" aria-live="polite"></p></div>
    </form>
  </section>
</main>
<script>
const form=document.querySelector("#brand-application-form");
if(form){
 const started=form.elements.namedItem("started_at"),status=form.querySelector(".form-status"),button=form.querySelector('button[type="submit"]');
 started.value=String(Date.now());
 form.addEventListener("submit",async(event)=>{
  event.preventDefault(); if(!form.reportValidity())return; const buttonLabel=button.textContent; button.disabled=true; button.textContent="Изпращане…"; form.setAttribute("aria-busy","true"); status.className="form-status"; status.textContent="Изпращаме кандидатурата…";
  const data=new FormData(form),payload=Object.fromEntries(data.entries()); payload.consent=data.get("consent")==="on";
  try{const response=await fetch(form.dataset.endpoint,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});if(!response.ok)throw new Error();form.reset();started.value=String(Date.now());status.className="form-status success";status.textContent="Благодарим! Кандидатурата е изпратена успешно."}
  catch{status.className="form-status error";status.textContent="Кандидатурата не можа да бъде изпратена. Опитай отново или пиши на info@bulgaritam.bg."}
  finally{button.disabled=false;button.textContent=buttonLabel;form.removeAttribute("aria-busy")}
 });
}
</script>
<style>
.partner-page{width:min(1160px,calc(100% - 40px));margin:auto;padding:62px 0 90px}.partner-page h2,.partner-page h3,.partner-page p{margin-top:0}.eyebrow{color:var(--accent-strong);font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.hero{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(260px,.5fr);gap:clamp(48px,8vw,110px);align-items:end;padding:28px 0 78px;border-bottom:1px solid var(--border)}.hero .page-title{max-width:780px;margin:10px 0 24px}.hero-copy{max-width:780px;font-size:clamp(17px,1.6vw,20px);line-height:1.65;color:var(--muted)}.hero-copy p{margin-bottom:12px}.actions{display:flex;align-items:center;gap:24px;margin-top:30px}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 19px;border:0;border-radius:14px;background:var(--accent-strong);color:#fff!important;font:750 14px var(--font-body);text-decoration:none;cursor:pointer}.btn:disabled{opacity:.65}.secondary{font-weight:700;text-decoration:none}.hero aside{padding-left:24px;border-left:1px solid rgba(95,127,107,.34)}.hero aside>span,.value-list>li>span,.steps>li>span{color:var(--accent-strong);font-size:12px;font-weight:800;letter-spacing:.14em}.hero aside p{margin:18px 0 25px;font:400 25px/1.25 var(--font-title)}.hero aside small{color:var(--muted);line-height:2}.section{padding:84px 0;border-bottom:1px solid var(--border)}.section-head{display:grid;grid-template-columns:minmax(170px,.42fr) minmax(0,1fr);gap:42px}.section-head h2{margin:0;max-width:760px}.presence-grid{display:grid;grid-template-columns:minmax(230px,.42fr) minmax(0,1fr);gap:42px;margin-top:45px}.lead{padding:24px;border-radius:var(--radius);background:var(--accent-strong);color:#fff}.lead span{display:block;margin-bottom:50px;font-size:12px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;opacity:.72}.lead p{margin:0;font:400 24px/1.3 var(--font-title)}.presence ul{display:grid;grid-template-columns:repeat(2,1fr);list-style:none;margin:0;padding:0;border-top:1px solid var(--border)}.presence li{display:grid;gap:8px;padding:22px 26px 25px 0;border-bottom:1px solid var(--border)}.presence li:nth-child(even){padding-left:26px;border-left:1px solid var(--border)}.presence li strong{font:650 19px var(--font-title)}.presence li span,.value-list p,.steps p,.application>div>p:last-child{color:var(--muted);line-height:1.65}.center{text-align:center}.center h2{margin:0}.value-list{list-style:none;max-width:900px;margin:48px auto 0;padding:0;border-top:1px solid var(--border)}.value-list li{display:grid;grid-template-columns:70px 1fr;gap:24px;padding:31px 0;border-bottom:1px solid var(--border)}.value-list h3{margin:0 0 8px;font:650 24px var(--font-title)}.value-list p{margin-bottom:0}.participation{display:grid;grid-template-columns:minmax(170px,.42fr) 1fr;gap:42px;margin:0 -40px;padding:44px 40px;background:rgba(95,127,107,.11);border-radius:0 0 28px 28px}.participation h2{margin-bottom:8px}.participation div p{margin:0;color:var(--muted)}.steps{display:grid;grid-template-columns:repeat(3,1fr);list-style:none;margin:46px 0 30px;padding:0;border-block:1px solid var(--border)}.steps li{display:grid;grid-template-columns:34px 1fr;gap:13px;padding:28px 28px 30px 0}.steps li+li{padding-left:28px;border-left:1px solid var(--border)}.steps strong{display:block;margin-bottom:8px;font:650 19px var(--font-title)}.steps p{margin:0}.application{display:grid;grid-template-columns:minmax(260px,.65fr) minmax(0,1.35fr);gap:clamp(40px,7vw,90px);padding:84px clamp(24px,5vw,62px);margin-top:84px;border:1px solid var(--border);border-radius:28px;background:rgba(255,255,255,.72)}.application form{display:grid;grid-template-columns:repeat(2,1fr);gap:19px 16px}.application label{display:grid;gap:7px;min-width:0}.application label>span{font-size:13px;font-weight:700}.application input,.application textarea{width:100%;min-width:0;padding:13px 14px;border:1px solid rgba(26,26,26,.17);border-radius:12px;background:#fff;color:var(--text);font:16px var(--font-body)}.application textarea{min-height:116px;resize:vertical}.application .wide{grid-column:1/-1}.consent{display:flex!important;align-items:flex-start;gap:10px}.consent input{width:18px;height:18px;margin-top:2px;accent-color:var(--accent)}.consent span{color:var(--muted);line-height:1.5}.submit{display:flex;align-items:center;gap:16px}.form-status{margin:0;font-size:14px;color:var(--muted)}.form-status.success{color:var(--accent-strong);font-weight:700}.form-status.error{color:#8c3732}.honey{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important;overflow:hidden!important}
@media(max-width:820px){.partner-page{width:min(100% - 32px,1160px);padding:36px 0 64px}.hero{grid-template-columns:1fr;gap:42px;padding:16px 0 56px}.hero .page-title{max-width:11ch}.section{padding:60px 0}.section-head,.presence-grid,.participation,.application{grid-template-columns:1fr}.section-head{gap:10px}.presence-grid{gap:20px;margin-top:30px}.lead span{margin-bottom:30px}.presence ul{grid-template-columns:1fr}.presence li,.presence li:nth-child(even){padding:20px 0;border-left:0}.participation{gap:8px;margin:0 -16px;padding:34px 16px}.steps{grid-template-columns:1fr}.steps li,.steps li+li{padding:24px 0;border-left:0}.steps li+li{border-top:1px solid var(--border)}.application{gap:28px;margin-top:60px;padding:36px 20px}}
@media(max-width:560px){.actions,.submit{align-items:stretch;flex-direction:column}.actions .btn,.submit .btn{width:100%}.secondary{text-align:center}.value-list li{grid-template-columns:42px 1fr;gap:12px}.application form{grid-template-columns:1fr}.application .wide{grid-column:auto}}
</style>
</BaseLayout>
