---
import FaviconHead from "../../components/FaviconHead.astro";
const target = "/bulgarski-podaratsi/";
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={`https://bulgaritam.bg${target}`} />
    <meta name="robots" content="noindex,follow" />
    <title>Пренасочване…</title>
    <FaviconHead />
  </head>
  <body>
    <script is:inline>
      window.location.replace("/bulgarski-podaratsi/");
    </script>
    <p>
      Ако не бъдеш пренасочен автоматично, отвори
      <a href={target}>{target}</a>.
    </p>
  </body>
</html>
