---
import AnalyticsOverview from "./analytics-v2/AnalyticsOverview.astro";
import AnalyticsExplore from "./analytics-v2/AnalyticsExplore.astro";
import type {AnalyticsV2ViewModel} from "../lib/analytics-v2";
import {ANALYTICS_V2_COPY,formatComparisonPeriod,type AnalyticsExploreArea} from "../lib/analytics-v2-language";
type View="overview"|"explore"|"diagnostics";
const {model,view,area}=Astro.props as{model:AnalyticsV2ViewModel;view:View;area:AnalyticsExploreArea};
const n=(value:number|null,digits=0)=>value==null?ANALYTICS_V2_COPY.insufficient.sample:new Intl.NumberFormat("bg-BG",{maximumFractionDigits:digits}).format(value);
---
<section class="v2-shell" aria-labelledby="analytics-v2-title">
 <header class="v2-head"><div><h2 id="analytics-v2-title">Откриване и интерес</h2><p>{formatComparisonPeriod(model.period.start,model.period.end,model.period.previousStart,model.period.previousEnd)}</p></div>{(view!=="overview"||!model.period.comparisonAvailable)&&<span class:list={["status",{weak:!model.period.comparisonAvailable}]}>{model.period.comparisonAvailable?"Има данни за двата периода":"Недостатъчни данни за сравнение"}</span>}</header>
 {view==="overview"&&<AnalyticsOverview model={model}/>}
 {view==="explore"&&<AnalyticsExplore model={model} area={area}/>}
 {view==="diagnostics"&&<section class="v2-section"><h3>Качество и надеждност на данните</h3><div class="summary-grid"><article><span>Събития в периода</span><b>{n(model.quality.events)}</b></article><article><span>Пълни състояния на откриване</span><b>{n(model.quality.completeStates)}</b></article><article><span>Непълни състояния</span><b>{n(model.quality.incompleteStates)}</b></article><article><span>Елементи в резултатите</span><b>{n(model.quality.members)}</b></article><article><span>Стари неразграничени прегледи</span><b>{n(model.quality.legacyViews)}</b></article><article><span>Събития без посетителска идентичност</span><b>{n(model.quality.missingIdentity)}</b></article><article><span>Период за сравнение</span><b>{model.quality.comparisonAvailable?"Наличен":"Недостатъчен"}</b></article><article><span>Исторически период</span><b>{model.quality.lookbackAvailable?"Зареден":"Недостъпен"}</b></article></div>{model.quality.diagnostics>0&&<p class="warning">Открити диагностични сигнали: {model.quality.diagnostics}. Непълните състояния са изключени от базите за изчисление.</p>}</section>}
</section>
<style>
 .v2-shell{box-sizing:border-box;width:100%;max-width:100%;min-width:0;overflow:hidden;margin:18px 0 28px;padding:20px;background:#f6faf7;border:1px solid #cddfd3;border-radius:12px}.v2-head{display:flex;justify-content:space-between;gap:20px;align-items:start}.v2-head h2{margin:.2rem 0}.v2-head p{color:#66706a}.status{padding:7px 10px;border-radius:20px;background:#dceee2;color:#245d37;white-space:nowrap}.status.weak{background:#fff0cf;color:#80520b}.v2-section{width:100%;max-width:100%;min-width:0;overflow:hidden;margin-top:22px;padding-top:18px;border-top:1px solid #d9e7dd}.v2-section h3{margin-top:0}.summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}.summary-grid article{padding:12px;background:#fff;border:1px solid var(--line);border-radius:8px}.summary-grid span,.summary-grid b{display:block}.summary-grid b{margin:.25rem 0;font-size:1.3rem}.warning{color:#80520b}
 @media(max-width:900px){.summary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:700px){.v2-shell{padding:14px}.v2-head{display:block}.status{display:inline-block;white-space:normal}.summary-grid{grid-template-columns:1fr}}
</style>
