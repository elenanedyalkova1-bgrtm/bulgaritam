---
import SeoProductLanding from "../../components/SeoProductLanding.astro";
import {
  getProductsForLanding,
  getProductsForIntentLanding,
  getSubcategoryLandings,
  getIntentLandingsForCategory,
} from "../../lib/seo-landings";
import { getSubcategoryLabelForLang } from "../../lib/taxonomy";
import { loadProducts } from "../../lib/products";

const allProducts = await loadProducts();
const giftSubcategoryLandings = getSubcategoryLandings("gifts");
const giftIntentLandings = getIntentLandingsForCategory("gifts", "gifts");

export async function getStaticPaths() {
  const products = await loadProducts();
  const giftSubcategoryLandings = getSubcategoryLandings("gifts");
  const giftIntentLandings = getIntentLandingsForCategory("gifts", "gifts");

  const taxonomyEntries = giftSubcategoryLandings.map((landing) => ({
    params: { slug: landing.slug },
    props: {
      landing: {
        ...landing,
        title: `${landing.viewAllLabel} | Българитъм`,
        h1: landing.viewAllLabel,
      },
      products: getProductsForLanding(products, landing),
    },
  }));

  const intentEntries = giftIntentLandings.map((landing) => ({
    params: { slug: landing.path.split("/").filter(Boolean).pop()! },
    props: {
      landing,
      products: getProductsForIntentLanding(products, landing),
    },
  }));

  return [...taxonomyEntries, ...intentEntries].filter((entry) => entry.props.products.length > 0);
}

const { landing, products } = Astro.props;

const primaryPills = [
  ...giftSubcategoryLandings
    .map((entry) => ({
      ...entry,
      productCount: getProductsForLanding(allProducts, entry).length,
    }))
    .filter((entry) => entry.productCount > 0)
    .map((entry) => ({
      label: entry.label,
      labelEn: entry.subcategoryKey ? getSubcategoryLabelForLang(entry.subcategoryKey, "en") : entry.label,
      href: `/bulgarski-podaratsi/${entry.slug}/`,
      isActive: `/bulgarski-podaratsi/${entry.slug}/` === landing.path || entry.slug === landing.slug,
    })),
  ...giftIntentLandings.map((entry) => ({
    label: entry.label,
    labelEn: entry.labelEn,
    href: entry.path,
    isActive: entry.path === landing.path,
  })),
];

const canonicalPath = landing.path || `/bulgarski-podaratsi/${landing.slug}/`;
