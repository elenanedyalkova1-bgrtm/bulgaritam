    <script is:inline>
  // ==========================================
  // Bulgaritam Saved Boards (single device)
  // ==========================================
  const STORAGE_KEY = "bulgaritam_saved_boards_v1";
  const DEFAULT_BOARD_ID = "all";
  const DEFAULT_BOARD_NAME = "Всички запазени";

  const defaultState = () => ({
    boards: [{ id: DEFAULT_BOARD_ID, name: DEFAULT_BOARD_NAME, visibility: "private", shareKey: null }],
    items: { [DEFAULT_BOARD_ID]: [] } // boardId -> savedItem[]
  });

  const readState = () => {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return defaultState();
      const s = JSON.parse(raw);
      if (!s || !Array.isArray(s.boards) || typeof s.items !== "object") return defaultState();
      s.boards = s.boards
        .map((b) => ({
          id: String(b?.id || ""),
          name: String(b?.name || "").trim() || "Нова колекция",
          visibility: b?.visibility || "private",
          shareKey: b?.shareKey ?? null,
        }))
        .filter((b) => b.id);

      if (!s.boards.find((b) => b.id === DEFAULT_BOARD_ID)) {
        s.boards.unshift({ id: DEFAULT_BOARD_ID, name: DEFAULT_BOARD_NAME, visibility: "private", shareKey: null });
      } else {
        s.boards = s.boards.map((b) =>
          b.id === DEFAULT_BOARD_ID
            ? { ...b, name: DEFAULT_BOARD_NAME, visibility: "private", shareKey: null }
            : b
        );
      }

      s.items[DEFAULT_BOARD_ID] = s.items[DEFAULT_BOARD_ID] || [];
      s.boards.forEach((board) => {
        s.items[board.id] = Array.isArray(s.items[board.id]) ? s.items[board.id] : [];
      });
      return s;
    } catch {
      return defaultState();
    }
  };

const updateSavedBadges = (state) => {
  const count = (state?.items?.[DEFAULT_BOARD_ID] || []).length;
  document.querySelectorAll("[data-saved-count]").forEach((el) => {
    el.textContent = `(${count})`;
    if (count > 0) el.removeAttribute("hidden");
    else el.setAttribute("hidden", "");
  });
};

  const writeState = (s) => {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(s));
  window.dispatchEvent(new CustomEvent("bulgaritam:saved", { detail: s }));
  updateSavedBadges(s); // ✅ обновява count веднага
};


  const escapeHtml = (s) => String(s ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");

  const slugId = () => "b_" + Math.random().toString(36).slice(2, 10);

  const isSavedInBoard = (state, boardId, id) => {
    const pid = String(id);
    return Array.isArray(state?.items?.[boardId]) && state.items[boardId].some((x) => String(x.id) === pid);
  };

  const isSavedAnywhere = (state, id) => {
    const pid = String(id);
    return Object.values(state.items).some(arr => Array.isArray(arr) && arr.some(x => String(x.id) === pid));
  };

  const removeEverywhere = (state, id) => {
    const pid = String(id);
    for (const k of Object.keys(state.items)) {
      state.items[k] = (state.items[k] || []).filter(x => String(x.id) !== pid);
    }
  };

  const addToBoard = (state, boardId, item) => {
    state.items[boardId] = state.items[boardId] || [];
    state.items[boardId].unshift(item);

    // keep unique per board by id
    const seen = new Set();
    state.items[boardId] = state.items[boardId].filter(x => {
      const key = String(x.id);
      if (seen.has(key)) return false;
      seen.add(key);
      return true;
    });

    // also keep the default collection as catch-all
    state.items[DEFAULT_BOARD_ID] = state.items[DEFAULT_BOARD_ID] || [];
    state.items[DEFAULT_BOARD_ID].unshift(item);
    const seenAll = new Set();
    state.items[DEFAULT_BOARD_ID] = state.items[DEFAULT_BOARD_ID].filter(x => {
      const key = String(x.id);
      if (seenAll.has(key)) return false;
      seenAll.add(key);
      return true;
    });
  };

  // -------------------------
// Modal UI
// -------------------------
const getSaveModalUI = () => {
  const modal = document.getElementById("save-modal");
  const boardsWrap = document.getElementById("save-modal-boards");
  const inputNew = document.getElementById("save-modal-newname");
  const btnCreate = document.getElementById("save-modal-create");
  const btnSave = document.getElementById("save-modal-save");

  return {
    modal,
    boardsWrap,
    inputNew,
    btnCreate,
    btnSave,
    hasModalUI: !!(modal && boardsWrap && inputNew && btnCreate && btnSave),
  };
};

let pendingItem = null;
let selectedBoardId = DEFAULT_BOARD_ID;

const renderBoards = (state) => {
  const { boardsWrap, hasModalUI } = getSaveModalUI();
  if (!hasModalUI) return;

  const boards = state.boards || [];
  boardsWrap.innerHTML = boards
    .map((b) => {
      const count = (state.items?.[b.id] || []).length;
      const sel = b.id === selectedBoardId ? " is-selected" : "";
      return `
        <button class="save-board${sel}" type="button" data-board="${b.id}">
          <span class="save-board__name">${escapeHtml(b.name)}</span>
          <span class="save-board__meta">${count} продукта</span>
        </button>
      `;
    })
    .join("");
};

const openModal = (item) => {
  const { modal, inputNew, hasModalUI } = getSaveModalUI();
  if (!hasModalUI) return;

  pendingItem = item;
  const state = readState();
  const customBoards = (state.boards || []).filter((board) => board.id !== DEFAULT_BOARD_ID);
  const alreadySavedCustomBoard = customBoards.find((board) => isSavedInBoard(state, board.id, item.id));

  selectedBoardId = alreadySavedCustomBoard?.id || customBoards[0]?.id || DEFAULT_BOARD_ID;
  renderBoards(state);

  modal.setAttribute("aria-hidden", "false");
  document.documentElement.classList.add("no-scroll");

  inputNew.value = "";
  inputNew.focus();
};

const closeModal = () => {
  const { modal, hasModalUI } = getSaveModalUI();
  if (!hasModalUI) return;

  modal.setAttribute("aria-hidden", "true");
  document.documentElement.classList.remove("no-scroll");
  pendingItem = null;
};

const createBoardFromModal = () => {
  const { inputNew, hasModalUI } = getSaveModalUI();
  if (!hasModalUI) return;

  const name = (inputNew.value || "").trim();
  if (!name) return;

  const state = readState();
  const id = slugId();
  state.boards.push({ id, name, visibility: "private", shareKey: null });
  state.items[id] = state.items[id] || [];
  writeState(state);
  window.bulgaritamTrack?.("create_collection", { collection_id: id, source_context: "save_modal" });

  selectedBoardId = id;
  renderBoards(state);
  inputNew.value = "";
};

const savePendingItemToBoard = () => {
  if (!pendingItem || !selectedBoardId) return;

  const state = readState();
  addToBoard(state, selectedBoardId, pendingItem);
  writeState(state);

  window.bulgaritamTrack?.("save_product", {
    product_id: pendingItem?.productId || "",
    product_slug: pendingItem?.id || "",
    product_name: pendingItem?.title || "",
    brand_id: pendingItem?.brandId || "",
    brand_slug: pendingItem?.brandSlug || "",
    brand_name: pendingItem?.brand || "",
    collection_id: selectedBoardId || "",
    ...(window.__bulgaritamDiscoveryContext || {}),
  });
  window.bulgaritamTrack?.("add_to_collection", {
    product_id: pendingItem?.productId || "",
    product_slug: pendingItem?.id || "",
    brand_id: pendingItem?.brandId || "",
    brand_slug: pendingItem?.brandSlug || "",
    collection_id: selectedBoardId || "",
    collection_product_count: (state.items?.[selectedBoardId] || []).length,
    source_context: "save_modal",
    ...(window.__bulgaritamDiscoveryContext || {}),
  });

  syncSaveButtons();
  closeModal();
};

document.addEventListener("click", (e) => {
  const closeBtn = e.target.closest("[data-save-close]");
  if (closeBtn) {
    closeModal();
    return;
  }

  const boardBtn = e.target.closest("[data-board]");
  if (boardBtn) {
    selectedBoardId = boardBtn.getAttribute("data-board") || DEFAULT_BOARD_ID;
    renderBoards(readState());
    return;
  }

  const createBtn = e.target.closest("#save-modal-create");
  if (createBtn) {
    createBoardFromModal();
    return;
  }

  const saveBtn = e.target.closest("#save-modal-save");
  if (saveBtn) {
    savePendingItemToBoard();
  }
});

document.addEventListener("keydown", (e) => {
  const { inputNew, modal, hasModalUI } = getSaveModalUI();
  if (!hasModalUI) return;

  if (e.key === "Escape" && modal.getAttribute("aria-hidden") === "false") {
    closeModal();
    return;
  }

  if (e.key === "Enter" && document.activeElement === inputNew) {
    e.preventDefault();
    createBoardFromModal();
  }
});



  // -------------------------
  // Save buttons everywhere
  // -------------------------
  const getItemFromBtn = (btn) => {
    // Required:
    // data-save-id, data-save-url
    // Optional:
    // data-save-title, data-save-image, data-save-brand, data-save-price
    const scope = btn.closest("[data-product-slug]");
    return {
      id: btn.getAttribute("data-save-id"),
      productId: scope?.dataset.productId || "",
      brandId: scope?.dataset.brandId || "",
      brandSlug: scope?.dataset.brandSlug || "",
      url: btn.getAttribute("data-save-url"),
      title: btn.getAttribute("data-save-title") || "Запазен продукт",
      image: btn.getAttribute("data-save-image") || "",
      brand: btn.getAttribute("data-save-brand") || "",
      price: btn.getAttribute("data-save-price") || ""
    };
  };

  const syncSaveButtons = () => {
    const state = readState();
    document.querySelectorAll(".save-btn[data-save-id]").forEach(btn => {
      const id = btn.getAttribute("data-save-id");
      const saved = isSavedAnywhere(state, id);
      btn.classList.toggle("is-saved", saved);
      btn.setAttribute("aria-pressed", saved ? "true" : "false");
    });
  };
  window.syncSaveButtons = syncSaveButtons;

  document.addEventListener("click", (e) => {
    const btn = e.target.closest(".save-btn[data-save-id]");
    if (!btn) return;

    e.preventDefault();
    e.stopPropagation();

  const item = getItemFromBtn(btn);
  const state = readState();
    const hasCustomCollections = (state.boards || []).some((board) => board.id !== DEFAULT_BOARD_ID);

    // Always ask where to save.
    // If there are no custom collections yet, the modal still opens so the user
    // can explicitly choose "Всички запазени" or create a new one first.
    openModal(item);
  });

  // initial
const initialState = readState();
syncSaveButtons();
updateSavedBadges(initialState);

window.addEventListener("storage", () => {
  const s = readState();
  syncSaveButtons();
  updateSavedBadges(s);
});

window.addEventListener("bulgaritam:saved", (e) => {
  updateSavedBadges(e.detail);
});


</script>


