---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { isProductActive, listBrands, listProducts } from "../../lib/repositories";
import { getStructuredDataGaps, MANUAL_CLASSIFICATION_GUIDANCE, needsClassification, selectValue, structuredCategoryForSubcategory } from "../../lib/product-taxonomy";
const [allProducts, brands] = await Promise.all([listProducts(), listBrands()]);
const q = (Astro.url.searchParams.get("q") || "").trim().toLowerCase();
const status = Astro.url.searchParams.get("status") || "all";
const brandId = Number(Astro.url.searchParams.get("brand") || 0);
const classification = Astro.url.searchParams.get("classification") || "all";
const brandMap = new Map(brands.map((b) => [b.id, b]));
const products = allProducts.filter((p) => p.name_bg && p.slug).filter((p) => !q || `${p.name_bg} ${p.slug} ${p.brand_name}`.toLowerCase().includes(q)).filter((p) => status === "all" || (status === "active" ? isProductActive(p.is_active) : !isProductActive(p.is_active))).filter((p) => !brandId || Number(p.brand_ref?.[0]?.id) === brandId).filter((p) => classification === "all" || (classification === "needs" ? needsClassification(p) : classification === "data-gaps" ? getStructuredDataGaps(p).length > 0 : true));
---
<AdminLayout title="Products" active="products"><header class="head"><div><h1>Products</h1><p class="muted">{products.length} of {allProducts.filter((p) => p.name_bg && p.slug).length} Products</p></div><a class="btn" href="/products/new/">New Product</a></header>
<form class="panel filters" method="get"><input type="search" name="q" value={q} placeholder="Search name, slug or Brand"/><select name="status"><option value="all" selected={status === "all"}>All statuses</option><option value="active" selected={status === "active"}>Active</option><option value="hidden" selected={status === "hidden"}>Hidden</option></select><select name="brand"><option value="">All Brands</option>{brands.filter((b) => b.brand_name).map((b) => <option value={b.id} selected={b.id === brandId}>{b.brand_name}</option>)}</select><select name="classification"><option value="all" selected={classification === "all"}>All classifications</option><option value="needs" selected={classification === "needs"}>Needs classification</option><option value="data-gaps" selected={classification === "data-gaps"}>Likely structured data gaps</option></select><button>Filter</button><a class="btn secondary" href="/products/">Clear</a></form>
{classification === "needs" && <section class="review-list">{products.map((p) => {const brand=brandMap.get(Number(p.brand_ref?.[0]?.id));const guidance=MANUAL_CLASSIFICATION_GUIDANCE[p.slug];return <article class="panel"><header class="head"><div><h2>{p.name_bg}</h2><p class="muted">{brand?.brand_name || p.brand_name || "Unknown Brand"} · /{p.slug}</p></div><a class="btn" href={`/products/${p.id}/`}>Classify</a></header><dl><dt>Current category</dt><dd>{p.category || "—"}</dd><dt>Tags</dt><dd>{p.tags || "—"}</dd><dt>Short description</dt><dd>{p.short_desc_bg || "—"}</dd><dt>Long description</dt><dd>{p.long_desc_bg || "—"}</dd>{guidance&&<><dt>Recommended path</dt><dd><strong>{guidance.recommended}</strong><br/><span class="muted">{guidance.reason}</span></dd><dt>Alternatives</dt><dd>{guidance.alternatives.join("; ")}</dd></>}</dl></article>})}</section>}
{classification === "data-gaps" && <section class="review-list">{products.map((p) => {const brand=brandMap.get(Number(p.brand_ref?.[0]?.id));const gaps=getStructuredDataGaps(p);return <article class="panel"><header class="head"><div><h2>{p.name_bg}</h2><p class="muted">{brand?.brand_name || p.brand_name || "Unknown Brand"} · /{p.slug}</p></div><a class="btn" href={`/products/${p.id}/`}>Review fields</a></header><ul>{gaps.map((gap)=><li>{gap}</li>)}</ul><p class="muted">Suggestions only. Nothing is written until you review and save the Product.</p></article>})}</section>}
{classification === "all" &&
<section class="panel table-wrap"><table><thead><tr><th>Product</th><th>Brand</th><th>Taxonomy</th><th>Status</th><th>Price</th></tr></thead><tbody>{products.map((p) => {const brand=brandMap.get(Number(p.brand_ref?.[0]?.id));return <tr><td><a class="row-link" href={`/products/${p.id}/`}>{p.name_bg}</a><div class="muted">/{p.slug}</div></td><td>{brand?.brand_name || p.brand_name || "—"}</td><td>{structuredCategoryForSubcategory(p.subcategory) || "Needs classification"}<div class="muted">{selectValue(p.subcategory) || "—"} · {selectValue(p.product_type) || "—"}</div></td><td><span class={`status ${isProductActive(p.is_active) ? "" : "hidden"}`}>{isProductActive(p.is_active) ? "Active" : "Hidden"}</span></td><td>{p.price_min_eur || "—"}{p.price_max_eur ? `–${p.price_max_eur}` : ""} {p.currency}</td></tr>})}</tbody></table>{!products.length && <div class="empty">No Products match these filters.</div>}</section>
}
</AdminLayout>
