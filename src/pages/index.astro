---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomepageProductCard from "../components/HomepageProductCard.astro";
import { Image } from "astro:assets";
import { CATEGORY_LANDINGS, SUBCATEGORY_LANDINGS } from "../lib/seo-landings";
import { getCategoryLabelForLang, getSubcategoryViewAllLabelForLang } from "../lib/taxonomy";
import { loadProducts } from "../lib/products";
import { getAvailablePublicBrowse, PUBLIC_GIFT_OCCASIONS } from "../lib/public-browse-taxonomy";
import { loadHomepageSettings } from "../lib/site-settings";
import defaultHomeHero from "../assets/home-hero-fashion-collage.webp";
import { getHumanReviewedLandingContent } from "../lib/landing-content";

const [products, homepageSettings] = await Promise.all([loadProducts(), loadHomepageSettings()]);
const displayProducts = [...new Map(products.filter((product) => product.image_urls?.[0]).map((product) => [product.slug, product])).values()];
const productPageSize = 48;
const productPageCount = Math.ceil(displayProducts.length / productPageSize);
const homeCategories = getAvailablePublicBrowse(displayProducts, true);
const structuredAttributes = new Set(displayProducts.flatMap((product) => product.attributes));
const attributeOptions = ["Веган", "Еко", "Натурален", "Органичен памук", "Ръчна изработка", "Персонализируем"].filter((value) => structuredAttributes.has(value));
const materialOptions = [...new Set(displayProducts.flatMap((product) => product.materials).filter(Boolean))].sort((a, b) => a.localeCompare(b, "bg"));
const colorOptions = [...new Set(displayProducts.flatMap((product) => product.colors).filter(Boolean))].sort((a, b) => a.localeCompare(b, "bg"));
const structuredRecipients = new Set(displayProducts.filter((product) => product.giftable).flatMap((product) => product.recipient));
const recipientOptions = ["За бебе", "За двойка", "За дете", "За жена", "За мъж"].filter((value) => structuredRecipients.has(value));
const giftOccasionOptions = ["Рожден ден", "Сватба", "Новородено", "Свети Валентин"].filter((value) =>
  PUBLIC_GIFT_OCCASIONS.includes(value)
);
const giftAttributeOptions = attributeOptions.filter((value) => ["Персонализируем", "Ръчна изработка"].includes(value));
const reviewedHomeContent = getHumanReviewedLandingContent("/");

---

<BaseLayout seo={{ type: "home" }} i18n={{
  en: {
    "home.freshNote": "Discover what Bulgarian brands create and save your favorite products",
    "home.searchLabel": "Find a Bulgarian product",
    "home.searchPlaceholder": 'e.g. "silver earrings", "women\'s pajamas", "night cream"',
    "home.viewAll": "View all",
    "home.occasion": "Gift & occasion",
    "home.filters": "Filters",
    "home.sortLabel": "Sort",
    "home.sort.featured": "Featured",
    "home.sort.newest": "Newest",
    "home.sort.priceAsc": "Price: low to high",
    "home.sort.priceDesc": "Price: high to low",
    "home.sort.alpha": "A–Z",
    "home.cardCta": "See on brand site ↗",
    "home.subcategories": "Subcategories",
    "home.resultsFor": "Results for:"
  }
}}>
  <main class="wrap">
    <section class="home-hero home-hero--banner">
      <div class="hero-media">
        {homepageSettings?.heroUrl ? <img
          src={homepageSettings.heroUrl}
          alt={homepageSettings.heroAltBg}
          class="hero-media-img"
          width="1600"
          height="900"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        /> : <Image
          src={defaultHomeHero}
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 768px) 100vw, (max-width: 1240px) 100vw, 1240px"
          format="webp"
          quality={82}
          alt="Колаж с български модни и лайфстайл продукти"
          class="hero-media-img"
          width={defaultHomeHero.width}
          height={defaultHomeHero.height}
          loading="eager"
          fetchpriority="high"
          priority
          decoding="async"
        />}
      </div>
      <h1 class="home-fresh-note" data-i18n="home.freshNote">{reviewedHomeContent?.h1 || "Открий какво създават българските брандове и запази любимите си продукти"}</h1>
    </section>

    <section class="home-search" id="product-search" aria-label="Търсене и категории">
      <div class="search search--home">
        <label class="search-label" for="q" data-i18n="home.searchLabel">Търси български продукт</label>

        <form class="search-row" id="searchForm" role="search">
          <input
            id="q"
            class="search-input"
            type="search"
            placeholder='напр. „сребърни обеци“, „дамска пижама“, „нощен крем“'
            data-i18n-placeholder="home.searchPlaceholder"
            autocomplete="off"
          />
          <button class="search-submit" id="searchBtn" type="submit">Търси</button>
        </form>
      </div>

      <div class="discovery-shortcuts" role="group" aria-label="Бързо откриване">
        <button class="discovery-shortcut" type="button" data-discovery-category="home">🏠 <span>Търся нещо за дома</span></button>
        <button class="discovery-shortcut" type="button" data-discovery-self aria-expanded="false" aria-controls="selfCategoryChoices">✨ <span>Търся нещо за себе си</span></button>
        <button class="discovery-shortcut" type="button" data-discovery-gift>🎁 <span>Търся нещо за подарък</span></button>
        <button class="discovery-shortcut" type="button" data-discovery-surprise>🎲 <span>Изненадай ме</span></button>
      </div>
      <div class="gift-hub-entries" aria-label="Още начини за разглеждане">
        <div class="gift-hub-entry"><a href="/bulgarski-drehi/"><span>👕</span> Разгледай български дрехи <span aria-hidden="true">→</span></a></div>
        <div class="gift-hub-entry"><a href="/bulgarski-podaratsi/"><span>🎁</span> Разгледай всички идеи за подарък <span aria-hidden="true">→</span></a></div>
        <div class="gift-hub-entry"><a href="/namaleniya/"><span>💸</span> Разгледай намалени продукти <span aria-hidden="true">→</span></a></div>
      </div>
      <div class="self-category-choices" id="selfCategoryChoices" role="group" aria-label="Избери категория" hidden>
        {[["clothing","Облекло"],["accessories","Аксесоари"],["cosmetics","Козметика"],["health","Здраве и грижа"],["books","Книги, игри и творчество"]].map(([key,label]) =>
          <button class="chip chip-sub" type="button" data-self-category={key}>{label}</button>
        )}
      </div>

      <p class="chips-section-label chips-section-label--category">Търси по категория</p>

      <div class="chips chips--home" role="group" aria-label="Категории" id="mainChips"></div>
      <p class="chips-section-label" id="subChipsLabel" hidden>Избери подкатегория</p>
      <div class="chips chips-sub chips--home" role="group" aria-labelledby="subChipsLabel" id="subChips" hidden></div>
      <p class="chips-section-label" id="typeChipsLabel" hidden>Избери тип продукт</p>
      <div class="chips chips-types chips--home" role="group" aria-labelledby="typeChipsLabel" id="typeChips" hidden></div>
      <button class="taxonomy-results-cue" id="taxonomyResultsCue" type="button" hidden>Виж всички резултати ↓</button>
      <div
        id="homeLandingData"
        data-landings={JSON.stringify(
          [...CATEGORY_LANDINGS, ...SUBCATEGORY_LANDINGS].map((landing) => ({
            slug: landing.slug,
            categoryKey: landing.categoryKey,
            subcategoryKey: landing.subcategoryKey,
            kind: landing.kind,
            label: landing.label,
            viewAllLabel: landing.viewAllLabel,
            viewAllLabelEn: landing.kind === "subcategory" && landing.subcategoryKey
              ? getSubcategoryViewAllLabelForLang(landing.subcategoryKey, "en")
              : `All ${getCategoryLabelForLang(landing.categoryKey, "en")}`,
            queryAliases: landing.queryAliases || [],
          }))
        )}
        hidden
      ></div>
      <div id="homeCategoriesData" data-categories={JSON.stringify(homeCategories)} hidden></div>
      <div class="discovery-tools" aria-label="Сортиране и филтри">
        <button
          id="occasionToggle"
          class="discovery-btn discovery-btn--occasion"
          type="button"
          aria-haspopup="dialog"
          aria-controls="occasionModal"
          aria-expanded="false"
        >
          <span data-i18n="home.occasion">Подарък и повод</span>
          <span id="occasionBadge" class="discovery-btn__badge" hidden>1</span>
        </button>

        <button
          id="filtersToggle"
          class="discovery-btn discovery-btn--filters"
          type="button"
          aria-haspopup="dialog"
          aria-controls="filtersModal"
          aria-expanded="false"
        >
          <span data-i18n="home.filters">Филтри</span>
          <span id="filtersBadge" class="discovery-btn__badge" hidden>1</span>
        </button>

        <label class="sort-control" for="sortSelect">
          <span class="sort-label" data-i18n="home.sortLabel">Подредба</span>
          <select id="sortSelect" class="sort-select">
            <option value="featured" data-i18n="home.sort.featured">Подбрани</option>
            <option value="price-asc" data-i18n="home.sort.priceAsc">Цена: ниска към висока</option>
            <option value="price-desc" data-i18n="home.sort.priceDesc">Цена: висока към ниска</option>
            <option value="alpha-asc">Име: А–Я</option>
            <option value="alpha-desc">Име: Я–А</option>
          </select>
        </label>
      </div>
    </section>

    <div id="filtersModal" class="filters-modal" hidden>
      <div class="filters-modal__backdrop" data-filters-close></div>

      <div
        class="filters-modal__panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="filtersTitle"
      >
        <div class="filters-modal__head">
          <div>
            <p class="filters-modal__eyebrow">Още контрол</p>
            <h3 id="filtersTitle" class="filters-modal__title">Филтри</h3>
          </div>

          <button class="filters-modal__close" type="button" aria-label="Затвори" data-filters-close>
            ✕
          </button>
        </div>

        <div class="filters-modal__body">
        <div class="filters-group" data-dynamic-filter-group="price">
          <p class="filters-group__label">Цена</p>

          <label class="filter-option" data-dynamic-filter-option>
            <input type="radio" name="priceFilter" value="all" checked />
            <span>Всички цени</span>
          </label>
          <label class="filter-option" data-dynamic-filter-option>
            <input type="radio" name="priceFilter" value="0-25" />
            <span>До €25</span>
          </label>
          <label class="filter-option" data-dynamic-filter-option>
            <input type="radio" name="priceFilter" value="25-50" />
            <span>€25–50</span>
          </label>
          <label class="filter-option" data-dynamic-filter-option>
            <input type="radio" name="priceFilter" value="50-100" />
            <span>€50–100</span>
          </label>
          <label class="filter-option" data-dynamic-filter-option>
            <input type="radio" name="priceFilter" value="100+" />
            <span>€100+</span>
          </label>
        </div>

        {attributeOptions.length ? (
          <div class="filters-group filters-group--spaced" data-dynamic-filter-group="attribute">
            <p class="filters-group__label">Характеристики</p>
            <div class="filter-options-grid" data-collapsible-options>
              {attributeOptions.map((attribute) => (
                <label class="filter-option filter-option--checkbox" data-dynamic-filter-option>
                  <input type="checkbox" name="attributeFilter" value={attribute} />
                  <span data-filter-label={attribute}>{attribute}</span>
                </label>
              ))}
            </div>
          </div>
        ) : null}

        <div class="filters-group filters-group--spaced" data-dynamic-filter-group="color" hidden>
          <p class="filters-group__label">Цвят</p>
          <div class="filter-options-grid" data-collapsible-options>
            {colorOptions.map((value) => <label class="filter-option filter-option--checkbox" data-dynamic-filter-option><input type="checkbox" name="colorFilter" value={value} /><span data-filter-label={value}>{value}</span></label>)}
          </div>
        </div>

        <div class="filters-group filters-group--spaced" data-dynamic-filter-group="material" hidden>
          <p class="filters-group__label">Материал</p>
          <div class="filter-options-grid" data-collapsible-options>
            {materialOptions.map((value) => <label class="filter-option filter-option--checkbox" data-dynamic-filter-option><input type="checkbox" name="materialFilter" value={value} /><span data-filter-label={value}>{value}</span></label>)}
          </div>
        </div>

        <div class="filters-group">
          <p class="filters-group__label">Доставка</p>

          <label class="filter-option filter-option--checkbox">
            <input type="checkbox" id="deliveryOutsideHome" name="deliveryOutsideHome" />
            <span>Доставя извън България</span>
          </label>
        </div>
        </div>

        <div class="filters-modal__actions">
          <button id="filtersReset" class="filters-action filters-action--ghost" type="button">
            Изчисти
          </button>
          <button id="filtersApply" class="filters-action" type="button">
            Покажи резултатите
          </button>
        </div>
      </div>
    </div>

    <div id="occasionModal" class="filters-modal" hidden>
      <div class="filters-modal__backdrop" data-occasion-close></div>

      <div
        class="filters-modal__panel filters-modal__panel--occasion"
        role="dialog"
        aria-modal="true"
        aria-labelledby="occasionTitle"
      >
        <div class="filters-modal__head">
          <div>
            <p class="filters-modal__eyebrow">Подходящ избор за подарък</p>
            <h3 id="occasionTitle" class="filters-modal__title">Подарък и повод</h3>
          </div>

          <button class="filters-modal__close" type="button" aria-label="Затвори" data-occasion-close>
            ✕
          </button>
        </div>

        <div class="filters-modal__body occasion-sheet">
          <section class="occasion-group" data-dynamic-filter-group="recipient">
            <h4 class="occasion-group__title">За кого</h4>
            <div class="occasion-options" data-collapsible-options>
              {recipientOptions.map((value) => <label class="occasion-option" data-dynamic-filter-option><input type="checkbox" name="giftFilter" value={`recipient:${value}`} /><span data-filter-label={value}>{value}</span></label>)}
            </div>
          </section>
          <section class="occasion-group" data-dynamic-filter-group="occasion">
            <h4 class="occasion-group__title">По повод</h4>
            <div class="occasion-options" data-collapsible-options>
              {giftOccasionOptions.map((value) => <label class="occasion-option" data-dynamic-filter-option><input type="checkbox" name="giftFilter" value={`occasion:${value}`} /><span data-filter-label={value}>{value}</span></label>)}
            </div>
          </section>
          <section class="occasion-group" data-dynamic-filter-group="giftPrice">
            <h4 class="occasion-group__title">Цена</h4>
            <div class="occasion-options">
              <label class="occasion-option" data-dynamic-filter-option><input type="radio" name="giftPriceFilter" value="all" checked /><span>Без ограничение</span></label>
              <label class="occasion-option" data-dynamic-filter-option><input type="radio" name="giftPriceFilter" value="0-25" /><span>До €25</span></label>
              <label class="occasion-option" data-dynamic-filter-option><input type="radio" name="giftPriceFilter" value="25-50" /><span>€25–50</span></label>
              <label class="occasion-option" data-dynamic-filter-option><input type="radio" name="giftPriceFilter" value="50-100" /><span>€50–100</span></label>
              <label class="occasion-option" data-dynamic-filter-option><input type="radio" name="giftPriceFilter" value="100+" /><span>€100+</span></label>
            </div>
          </section>
          <section class="occasion-group" data-dynamic-filter-group="giftAttribute">
            <h4 class="occasion-group__title">Характеристики</h4>
            <div class="occasion-options" data-collapsible-options>
              {giftAttributeOptions.map((value) => <label class="occasion-option" data-dynamic-filter-option><input type="checkbox" name="giftFilter" value={`attribute:${value}`} /><span data-filter-label={value}>{value}</span></label>)}
            </div>
          </section>
        </div>

        <div class="filters-modal__actions">
          <button id="occasionReset" class="filters-action filters-action--ghost" type="button">
            Изчисти
          </button>
          <button id="occasionApply" class="filters-action" type="button">
            Покажи резултатите
          </button>
        </div>
      </div>
    </div>

    <section class="section section--feed" id="products" data-total-items={displayProducts.length} data-total-pages={productPageCount} data-current-page="1" data-collection-path="/">
      <div id="activeSelections" class="active-selections" aria-live="polite" hidden></div>
      <div class="section-head section-head--centered" id="productResultsStart">
        <h2 class="h2">Продукти (<span id="count">{displayProducts.length}</span>)</h2>
        <div class="hint" id="hint"></div>
        <p class="intent-status" id="intentStatus" hidden></p>
      </div>

      <ul class="grid" id="grid" data-masonry-grid></ul>
      <template id="productCardCatalogue">
        {displayProducts.slice(0, productPageSize).map((product, index) => <HomepageProductCard product={product} index={index} />)}
      </template>

      <div class="feed-meta">
        <p class="feed-status" id="feedStatus" aria-live="polite"></p>
        <div class="feed-sentinel" id="feedSentinel" aria-hidden="true"></div>
        <button class="feed-load-more" id="feedLoadMore" type="button" hidden>Покажи още</button>
      </div>
      {productPageCount > 1 ? <nav class="collection-pagination" data-pagination-first-page aria-label="Страници с продукти"><span>Страница 1 от {productPageCount}</span><a rel="next" href="/page/2/">Следваща</a></nav> : null}
    </section>
  </main>

  <style>
    .home-hero--banner {
      max-width: 1240px;
      margin: 0 auto;
      padding: 28px 0 22px;
    }

    .hero-media {
      width: 100%;
      max-width: 100%;
      border-radius: 28px;
      overflow: hidden;
      background: transparent;
      box-shadow: 0 18px 48px rgba(0, 0, 0, 0.08);
    }

    .hero-media-img {
      display: block;
      width: 100%;
      max-width: 100%;
      height: auto;
    }

    .home-search {
      max-width: 1240px;
      margin: 0 auto;
      padding: 4px 0 22px;
    }

    .home-fresh-note {
      margin: 14px auto 0;
      text-align: center;
      font-size: 12px;
      font-weight: 700;
      font-family: var(--font-wordmark);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(26, 26, 26, 0.54);
    }

    .search--home {
      max-width: 760px;
      margin: 0 auto 20px;
      padding: 18px;
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.74);
      border: 1px solid rgba(26, 26, 26, 0.08);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.06);
    }

    .search--home .search-label {
      margin-bottom: 12px;
      text-align: center;
      font-size: 13px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(26, 26, 26, 0.62);
    }

    .search--home .search-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 10px;
      align-items: center;
    }

    .search--home .search-input {
      min-width: 0;
      max-width: 640px;
      width: 100%;
      height: 58px;
      border-radius: 14px;
      padding: 0 22px;
      font-size: 16px;
      border: 1px solid rgba(26, 26, 26, 0.08);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }

    .search-submit {
      min-width: 104px;
      height: 58px;
      padding: 0 20px;
      border: 1px solid rgba(26, 26, 26, 0.1);
      border-radius: 14px;
      background: var(--accent);
      color: #fff;
      font: inherit;
      font-weight: 800;
      cursor: pointer;
    }

    .discovery-shortcuts {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      max-width: 920px;
      margin: 18px auto 10px;
    }

    .discovery-shortcut {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      min-width: 0;
      max-width: 100%;
      min-height: 44px;
      height: auto;
      padding: 10px 15px;
      border: 1px solid rgba(95, 127, 107, 0.3);
      border-radius: 15px;
      background: rgba(95, 127, 107, 0.09);
      color: var(--text);
      font: 700 14px/1.25 var(--font-body);
      text-align: center;
      white-space: normal;
      overflow-wrap: anywhere;
      text-wrap: balance;
      cursor: pointer;
    }

    .discovery-shortcut span { min-width: 0; }

    .gift-hub-entries { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 4px auto 14px; }
    .gift-hub-entry { display: flex; justify-content: center; }
    .gift-hub-entry a { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 40px; padding: 8px 14px; border-radius: 999px; border: 1px solid rgba(123,64,59,.16); background: rgba(255,255,255,.58); color: rgba(83,48,44,.9); font-size: 13px; font-weight: 750; text-decoration: none; box-shadow: 0 8px 20px rgba(0,0,0,.035); }
    .gift-hub-entry a:hover, .gift-hub-entry a:focus-visible { background: rgba(255,255,255,.9); border-color: rgba(123,64,59,.28); }

    .discovery-shortcut:hover,
    .discovery-shortcut:focus-visible {
      border-color: rgba(95, 127, 107, 0.48);
      background: #fff;
    }

    .self-category-choices {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      max-width: 820px;
      margin: 0 auto 12px;
    }

    .self-category-choices[hidden] { display: none; }

    .chips--home {
      max-width: 1180px;
      margin: 0 auto;
      justify-content: center;
      min-height: 60px;
    }

    :global(#mainChips .chip) {
      flex: 1 1 160px;
      max-width: 210px;
      min-height: 52px;
      padding: 13px 20px;
      font-size: 17px;
      font-weight: 800;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.05);
    }

    :global(#subChips .chip-sub) {
      flex: 0 1 auto;
      min-height: 42px;
      padding: 10px 15px;
      font-size: 14px;
      font-weight: 750;
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.035);
    }

    .chips-section-label {
      margin: 14px 0 0;
      text-align: center;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(26, 26, 26, 0.48);
    }

    .chips-section-label--category{display:flex;align-items:center;gap:12px;margin:16px auto 8px;max-width:980px}.chips-section-label--category::before,.chips-section-label--category::after{content:"";height:1px;flex:1;background:rgba(26,26,26,.09)}

    .chips-sub {
      margin-top: 8px;
      opacity: 0.95;
      padding: 10px 12px;
      border-radius: 22px;
      background: rgba(95, 127, 107, 0.055);
