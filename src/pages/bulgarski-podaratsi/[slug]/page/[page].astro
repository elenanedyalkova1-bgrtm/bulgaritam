---
import SeoProductLanding from "../../../../components/SeoProductLanding.astro";
import { getIntentLandingsForCategory, getLandingPageHierarchy, getProductsForIntentLanding, getProductsForLanding, getSubcategoryLandings } from "../../../../lib/seo-landings";
import { loadProducts } from "../../../../lib/products";

export async function getStaticPaths() {
  const products = await loadProducts();
  const landings = [
    ...getSubcategoryLandings("gifts").map((landing) => ({ landing, matches: getProductsForLanding(products, landing) })),
    ...getIntentLandingsForCategory("gifts", "gifts").filter((landing) => landing.path.startsWith("/bulgarski-podaratsi/")).map((landing) => ({ landing, matches: getProductsForIntentLanding(products, landing) })),
  ];
  return landings.flatMap(({ landing, matches }) => Array.from({ length: Math.max(0, Math.ceil(matches.length / 48) - 1) }, (_, index) => ({
    params: { slug: (landing.path || `/bulgarski-podaratsi/${landing.slug}/`).split("/").filter(Boolean).pop()!, page: String(index + 2) },
    props: { landing, products: matches, pageNumber: index + 2 },
  })));
}
const { landing, products, pageNumber } = Astro.props;
const allProducts = await loadProducts();
const collectionPath = landing.path || `/bulgarski-podaratsi/${landing.slug}/`;
const hierarchy = getLandingPageHierarchy(landing, allProducts);
---
<SeoProductLanding landing={hierarchy.seoLanding} products={products} browseProducts={allProducts}
  canonicalPath={`${collectionPath.replace(/\/$/, "")}/page/${pageNumber}/`} collectionPath={collectionPath} pageNumber={pageNumber}
  breadcrumbs={hierarchy.breadcrumbs} primaryPills={hierarchy.primaryPills} secondaryPills={hierarchy.secondaryPills} parentLink={hierarchy.parentLink} />
