---
import type {AnalyticsV2ViewModel} from "../../lib/analytics-v2";
import {choiceDimensionLabel,choiceOrientation,choicesWord,choiceValueLabel,visitorsWord} from "../../lib/analytics-v2-choice";
const {interest}=Astro.props as{interest:AnalyticsV2ViewModel["interest"]};
const n=(value:number)=>new Intl.NumberFormat("bg-BG").format(value);
const availability=(row:typeof interest.taxonomy[number])=>row.availability?row.availability.minimum===row.availability.maximum?`При този измерен избор са били налични ${n(row.availability.minimum)} резултата.`:`При измерените избори са били налични между ${n(row.availability.minimum)} и ${n(row.availability.maximum)} резултата.`:"";
const useWord=(row:typeof interest.filters[number])=>row.action==="remove"?"Премахнато":row.action==="clear"?"Изчистено":"Избрано";
const facet=(dimension:string)=>({recipient:"Получател",occasion:"Повод",price:"Цена",attribute:"Характеристика"} as Record<string,string>)[dimension]||"Критерий";
const giftGroups=[
 {title:"За кого търсят",rows:interest.gift.filter(row=>row.dimension==="recipient")},
 {title:"По какъв повод",rows:interest.gift.filter(row=>row.dimension==="occasion")},
 {title:"Какъв бюджет задават",rows:interest.gift.filter(row=>row.dimension==="price")},
 {title:"Какво още задават",rows:interest.gift.filter(row=>!["recipient","occasion","price"].includes(row.dimension))},
].filter(group=>group.rows.length);
---
{interest.summary.actions===0?<div class="choice-empty"><strong>Няма измерени изрични избори за този период.</strong><p>Показванията на продукти не се броят като избор.</p></div>:<div class="choice">
 <section class="choice-summary" aria-label="Обобщение" data-choice-summary>
  <article><span>Посетители, направили избор</span><b>{n(interest.summary.visitors)}</b></article>
  <article><span>Направени избори</span><b>{n(interest.summary.actions)}</b></article>
  {interest.summary.taxonomyValues>0&&<article><span>Различни категории и типове</span><b>{n(interest.summary.taxonomyValues)}</b></article>}
  {interest.summary.giftActions>0&&<article><span>Избори за подарък</span><b>{n(interest.summary.giftActions)}</b></article>}
 </section>

 {interest.taxonomy.length>0&&<section class="choice-section" data-choice-taxonomy><h4>Към какво се насочват посетителите?</h4><div class="choice-list">{interest.taxonomy.map(row=>row.availability?<details class="choice-row"><summary><span><small>{choiceDimensionLabel(row.dimension)}</small><strong>{choiceValueLabel(row.dimension,row.label)}</strong></span><span><b>{n(row.actions)}</b> {choicesWord(row.actions)} · {n(row.visitors)} {visitorsWord(row.visitors)}</span><i aria-hidden="true">⌄</i></summary><div><p>{availability(row)}</p></div></details>:<div class="choice-row choice-line"><span><small>{choiceDimensionLabel(row.dimension)}</small><strong>{choiceValueLabel(row.dimension,row.label)}</strong></span><span><b>{n(row.actions)}</b> {choicesWord(row.actions)} · {n(row.visitors)} {visitorsWord(row.visitors)}</span></div>)}</div></section>}

 {interest.filters.length>0&&<section class="choice-section" data-choice-filters><h4>Как стесняват избора си?</h4><div class="choice-list">{interest.filters.map(row=>row.availability?<details class="choice-row"><summary><span><strong>{choiceValueLabel(row.dimension,row.label)}</strong></span><span>{useWord(row)} <b>{n(row.actions)}</b> {row.actions===1?"път":"пъти"} · {n(row.visitors)} {visitorsWord(row.visitors)}</span><i aria-hidden="true">⌄</i></summary><div><p>{availability(row)}</p></div></details>:<div class="choice-row choice-line"><span><strong>{choiceValueLabel(row.dimension,row.label)}</strong></span><span>{useWord(row)} <b>{n(row.actions)}</b> {row.actions===1?"път":"пъти"} · {n(row.visitors)} {visitorsWord(row.visitors)}</span></div>)}</div></section>}

 {(giftGroups.length>0||interest.giftTool>0||interest.surprise>0||interest.giftStates.length>0)&&<section class="choice-section gift" data-choice-gift><h4>Когато търсят подарък</h4>{(interest.giftTool>0||interest.surprise>0)&&<div class="gift-tools">{interest.giftTool>0&&<p>Изборът за подарък е отворен <b>{n(interest.giftTool)}</b> {interest.giftTool===1?"път":"пъти"}.</p>}{interest.surprise>0&&<p>„Изненадай ме“ е използвано <b>{n(interest.surprise)}</b> {interest.surprise===1?"път":"пъти"}.</p>}</div>}{giftGroups.map(group=><div class="gift-group"><h5>{group.title}</h5><div class="choice-list">{group.rows.map(row=>row.availability?<details class="choice-row"><summary><span><strong>{choiceValueLabel(row.dimension,row.label)}</strong></span><span><b>{n(row.actions)}</b> {choicesWord(row.actions)} · {n(row.visitors)} {visitorsWord(row.visitors)}</span><i aria-hidden="true">⌄</i></summary><div><p>{availability(row)}</p></div></details>:<div class="choice-row choice-line"><span><strong>{choiceValueLabel(row.dimension,row.label)}</strong></span><span><b>{n(row.actions)}</b> {choicesWord(row.actions)} · {n(row.visitors)} {visitorsWord(row.visitors)}</span></div>)}</div></div>)}{interest.giftStates.length>0&&<details class="measured-sets"><summary>Виж комбинациите от критерии</summary><div>{interest.giftStates.slice(0,8).map(state=><article><p>{state.facets.map(item=>`${facet(item.dimension)}: ${choiceValueLabel(item.dimension,item.label)}`).join(" · ")}</p><strong>{state.resultCount===1?"При този набор от критерии е бил наличен 1 продукт.":`При този набор от критерии са били налични ${n(state.resultCount)} продукта.`}</strong>{state.observations>1&&<small>Измерено {n(state.observations)} пъти.</small>}</article>)}</div><small>Това описва наличния избор при конкретната комбинация. Не означава, че отделен критерий е причинил последващо действие.</small></details>}</section>}

 {interest.sort.length>0&&<details class="secondary"><summary>Други начини за стесняване на избора</summary><ul>{interest.sort.map(row=><li><span>{choiceValueLabel(row.dimension,row.value)}</span><b>{n(row.actions)} {choicesWord(row.actions)}</b></li>)}</ul></details>}

 <div class="attention" role="note"><strong>Какво заслужава внимание</strong><p>{choiceOrientation(interest.summary,interest.taxonomy)}</p></div>
 <details class="method"><summary>Какво броим като избор?</summary><p>Броим само действия, които посетителят е направил изрично — например избор на категория, цена, получател или характеристика. Самото виждане на продукт не се брои като избор. „Посетител“ означава анонимно разпознат браузър.</p></details>
</div>}
<style>
 .choice{display:grid;gap:22px;min-width:0}.choice-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}.choice-summary article{padding:14px;background:#fff;border:1px solid var(--line);border-radius:9px}.choice-summary span,.choice-summary b{display:block}.choice-summary span{color:#5d675f;font-size:.88rem}.choice-summary b{margin-top:5px;font-size:1.45rem}.choice-section h4{margin:0 0 11px;font-size:1.05rem}.choice-list{display:grid;gap:8px}.choice-row{background:#fff;border:1px solid #dce6df;border-radius:9px;overflow:hidden}.choice-row summary,.choice-line{display:grid;grid-template-columns:minmax(0,1fr) auto 18px;gap:14px;align-items:center;padding:12px 14px}.choice-row summary{cursor:pointer;list-style:none}.choice-row summary::-webkit-details-marker{display:none}.choice-row summary span:first-child,.choice-line span:first-child{display:grid;gap:2px}.choice-row small{color:#6b746e}.choice-row strong{color:#29342c}.choice-row summary>span:nth-child(2),.choice-line>span:nth-child(2){white-space:nowrap;color:#536057}.choice-row i{font-style:normal}.choice-row[open] i{transform:rotate(180deg)}.choice-row>div{padding:0 14px 12px;border-top:1px solid #edf1ee}.choice-row p{margin:9px 0 0}.choice-line{grid-template-columns:minmax(0,1fr) auto}.gift{display:grid;gap:14px;padding:16px;background:#f0f7f2;border-radius:10px}.gift h4{margin-bottom:0}.gift-group{display:grid;gap:7px}.gift-group h5{margin:0;font-size:.92rem;color:#536057}.gift-tools{display:flex;gap:16px;flex-wrap:wrap}.measured-sets,.secondary,.method{background:#fff;border:1px solid #dce6df;border-radius:9px;padding:12px 14px}.measured-sets>summary,.secondary>summary,.method>summary{cursor:pointer;font-weight:650}.measured-sets article{padding:10px 0;border-bottom:1px solid #edf1ee}.measured-sets article:last-child{border-bottom:0}.measured-sets p{margin:0 0 4px}.secondary ul{padding:0;margin:12px 0 0;list-style:none}.secondary li{display:flex;justify-content:space-between;gap:15px;padding:8px 0;border-top:1px solid #edf1ee}.attention,.choice-empty{padding:16px;border:1px dashed #afc5b5;border-radius:9px;background:#fff}.attention p,.choice-empty p{margin:.4rem 0 0;color:#5d675f}.method p,.secondary small,.measured-sets small{color:#626d65;line-height:1.5}.choice-empty{max-width:720px}
 @media(max-width:900px){.choice-summary{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:600px){.choice-summary{grid-template-columns:1fr}.choice-row summary,.choice-line{grid-template-columns:minmax(0,1fr) 16px}.choice-row summary>span:nth-child(2),.choice-line>span:nth-child(2){grid-column:1;font-size:.9rem;white-space:normal}.choice-row i{grid-column:2;grid-row:1/3}.gift{padding:12px}.secondary li{align-items:start}.choice,.choice-section,.choice-list,.choice-row{max-width:100%;min-width:0}}
</style>
