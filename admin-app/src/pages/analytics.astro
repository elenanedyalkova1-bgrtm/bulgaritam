---
import AdminLayout from "../layouts/AdminLayout.astro";
import AnalyticsTable from "../components/AnalyticsTable.astro";
import AnalyticsV2 from "../components/AnalyticsV2.astro";
import AnalyticsNavigation from "../components/analytics-v2/AnalyticsNavigation.astro";
import { PUBLIC_BROWSE_CATEGORIES } from "../../../src/lib/public-browse-taxonomy";
import {buildAcquisitionRows,buildBrandRows,buildBrandSearchRows,buildDimensionRows,buildFilterRows,buildFunnel,buildJourneyRows,buildPageRows,buildProductRows,buildSearchRows,buildUnmetRows,count,metricSummary,resolvePeriod,returnedBrands,returnedProducts,type AnalyticsEvent} from "../lib/analytics";
import {createServerSupabaseAnalyticsRepository,safeAnalyticsErrorDiagnostics} from "../lib/supabase-analytics";
import {loadAnalyticsV2} from "../lib/analytics-v2-loader";
import {buildAnalyticsV2ViewModel,type AnalyticsV2ViewModel} from "../lib/analytics-v2";
import {resolveAnalyticsExploreArea} from "../lib/analytics-v2-language";
const period=resolvePeriod(Astro.url);let error="",dated:AnalyticsEvent[]=[],previousAll:AnalyticsEvent[]=[],v2:AnalyticsV2ViewModel|null=null;try{const loaded=await loadAnalyticsV2(createServerSupabaseAnalyticsRepository(),period);dated=loaded.currentEvents;previousAll=loaded.previousEvents;v2=buildAnalyticsV2ViewModel(loaded)}catch(cause){console.error("Admin analytics Supabase read failed",safeAnalyticsErrorDiagnostics(cause));error="Данните не могат да бъдат заредени."}
const brandFilter=Astro.url.searchParams.get("brand")||"",productFilter=Astro.url.searchParams.get("product")||"",categoryFilter=Astro.url.searchParams.get("category")||"";
const matches=(e:any)=>{const rp=returnedProducts(e),rb=returnedBrands(e);return(!brandFilter||e.brandId===brandFilter||rp.some((x:any)=>x[1]===brandFilter)||rb.some((x:any)=>x[0]===brandFilter))&&(!productFilter||e.productId===productFilter||rp.some((x:any)=>x[0]===productFilter))&&(!categoryFilter||e.category===categoryFilter)};
const events=dated.filter(matches),previous=previousAll.filter(matches),fmt=(n:number,d=0)=>new Intl.NumberFormat("bg-BG",{maximumFractionDigits:d}).format(n),rate=(a:number,b:number)=>b?a/b*100:0,na=(v:number|null)=>v===null?"Няма данни":fmt(v),pct=(v:number|null)=>v===null?"Няма данни":`${fmt(v,1)}%`;
const canonicalLabels=new Map<string,string>();PUBLIC_BROWSE_CATEGORIES.forEach(category=>{canonicalLabels.set(category.key,category.label);canonicalLabels.set(category.value,category.label);category.subcategories.forEach(subcategory=>{canonicalLabels.set(subcategory.key,subcategory.label);canonicalLabels.set(subcategory.value,subcategory.label)})});const human=(value:string)=>canonicalLabels.get(value)||({gifts:"Подаръци",discovery:"Откриване",product:"Продукт",brand:"Бранд",content:"Съдържание",homepage_default:"Начална страница",search_results:"Резултати от търсене",brand_directory:"Каталог с брандове",gift_discovery:"Откриване на подаръци",product_page:"Продуктова страница",brand_page:"Страница на бранд",shared_collection:"Споделена колекция"} as Record<string,string>)[value]||value.replaceAll("_"," ");
const brandOptions=buildBrandRows(dated),productOptions=buildProductRows(dated),categoryOptions=[...new Set(dated.map(e=>e.category).filter(Boolean))].sort(),rawMetrics=metricSummary(events,previous);const metric=(key:string,label:string)=>{const m=rawMetrics.find(x=>x.key===key);return{label,value:m?.value||0,change:m?.change??null,suffix:""}};const sessions=new Set(events.map(e=>e.sessionId).filter(Boolean)),discovered=new Set(events.filter(e=>["save_product","outbound_product_click"].includes(e.event)).map(e=>e.sessionId).filter(Boolean));
const overview=[metric("sessions","Сесии"),metric("search","Търсения"),metric("search_no_results","Без резултат"),{label:"Дял без резултат",value:rate(count(events,"search_no_results"),count(events,"search")),change:null,suffix:"%"},metric("view_product","Прегледи на продукти"),metric("view_brand","Прегледи на брандове"),metric("outbound_product_click","Изходящи към продукти"),metric("outbound_brand_click","Изходящи към брандове"),metric("save_product","Запазвания"),{label:"Процент на откриване",value:rate(discovered.size,sessions.size),change:null,suffix:"%"}];
const searches=buildSearchRows(events),unmet=buildUnmetRows(events),filters=buildFilterRows(events),products=buildProductRows(events),brands=buildBrandRows(events),pages=buildPageRows(events),acquisition=buildAcquisitionRows(events),funnel=buildFunnel(events),journeys=buildJourneyRows(events),duration=(ms:number)=>ms<60000?`${Math.round(ms/1000)} сек.`:`${Math.floor(ms/60000)} мин. ${Math.round(ms%60000/1000)} сек.`,clock=(date:Date)=>new Intl.DateTimeFormat("bg-BG",{hour:"2-digit",minute:"2-digit",second:"2-digit"}).format(date);
const zeroDemand=unmet.filter(r=>r.resultCount===0),lowDemand=unmet.filter(r=>r.resultCount>0);
const dimensions=[{title:"Категории",rows:buildDimensionRows(events,e=>e.category)},{title:"Подкатегории",rows:buildDimensionRows(events,e=>e.subcategory)},{title:"Типове продукти",rows:buildDimensionRows(events,e=>e.productType)},{title:"Източник",rows:buildDimensionRows(events,e=>e.sourceContext)},{title:"Списък / контекст",rows:buildDimensionRows(events,e=>e.listContext)},{title:"Получатели",rows:buildDimensionRows(events,e=>e.giftRecipient)},{title:"Поводи",rows:buildDimensionRows(events,e=>e.giftOccasion)}],filterGroups=[{title:"Таксономия",keys:["category","subcategory","product_type"]},{title:"Подаръци",keys:["gift_budget","gift_recipient","gift_occasion","giftable"]},{title:"Продуктови характеристики",keys:["materials","colors","attributes","price_range","delivery_abroad"]}];
type View="overview"|"explore"|"diagnostics";const rawView=Astro.url.searchParams.get("view"),rawArea=Astro.url.searchParams.get("area"),view:View=(["overview","explore","diagnostics"] as string[]).includes(rawView||"")?rawView as View:"overview",area=resolveAnalyticsExploreArea(rawArea);
---
<AdminLayout title="Аналитика" active="analytics"><header class="head"><div><h1>Аналитика</h1><p class="muted">Поведение при търсене и откриване · данни от Supabase</p></div><div class="device-exclusion"><strong data-analytics-device-status></strong><button type="button" class="secondary" data-analytics-device-toggle></button><small class="muted">Изключването важи за бъдещата активност от това устройство. Вече събраните данни не се изтриват.</small></div></header>
<AnalyticsNavigation view={view}/><form class="panel controls" method="get"><div class="presets">{[["today","Днес"],["yesterday","Вчера"],["7d","7 дни"],["30d","30 дни"],["90d","90 дни"],["last_month","Последен пълен месец"],["last_quarter","Последно пълно тримесечие"]].map(([k,l])=><a class:list={["btn","secondary",{active:period.key===k}]} href={`/analytics/?period=${k}&view=${view}${view==="explore"?`&area=${area}`:""}`}>{l}</a>)}</div><label>От<input type="date" name="from" value={period.from}/></label><label>До<input type="date" name="to" value={period.to}/></label><input type="hidden" name="period" value="custom"/><input type="hidden" name="view" value={view}/>{view==="explore"&&<input type="hidden" name="area" value={area}/>} {view==="diagnostics"&&<><label>Бранд<select name="brand"><option value="">Всички</option>{brandOptions.map(x=><option value={x.id} selected={x.id===brandFilter}>{x.name}</option>)}</select></label><label>Продукт<select name="product"><option value="">Всички</option>{productOptions.map(x=><option value={x.id} selected={x.id===productFilter}>{x.name}</option>)}</select></label><label>Категория<select name="category"><option value="">Всички</option>{categoryOptions.map(x=><option value={x} selected={x===categoryFilter}>{human(x)}</option>)}</select></label></>}<button>Приложи</button><span class="muted">{period.from} → {period.to} · {events.length} събития</span></form>{error&&<div class="error">{error}</div>}
{v2&&<AnalyticsV2 model={v2} view={view} area={area}/>}<details class="v1-disclosure" hidden={view!=="diagnostics"}><summary>Отвори старите отчети (Analytics V1)</summary><div class="v1-divider"><h2>Analytics V1</h2><p class="muted">Съществуващите отчети остават достъпни за паралелна проверка. Филтрите за бранд, продукт и категория се прилагат само към V1.</p></div>
<section class="metric-grid">{overview.map(m=><article class="metric"><span>{m.label}</span><b>{fmt(m.value,1)}{m.suffix||""}</b>{m.change!==null&&<small>{m.change>=0?"+":""}{fmt(m.change,1)}% спрямо предходния период</small>}</article>)}</section>
<section class="panel analytics-section"><h2>Какво търсят хората</h2><input class="table-search" type="search" placeholder="Търси фраза" data-filter-table="search-demand"/><AnalyticsTable heads={["Търсене","Търсения","Сесии","Средно резултати","Без резултат","Прегледи продукти","Прегледи брандове","Запазвания","Изходящи"]} rows={searches.map(r=>[r.query,r.searches,r.sessions,fmt(r.avgResults,1),r.zero,r.productViews,r.brandViews,r.saves,r.productOutbound+r.brandOutbound])} id="search-demand" paginate/><div>{searches.slice(0,20).map(r=><details class="brand-row"><summary><strong>{r.query}</strong><span>Върнати и последващи действия с explicit search_id</span></summary><p><b>Top продукти върнати:</b> {r.topProductsReturned.map(([id,n])=>`${id} (${n})`).join(", ")||"Няма данни"}</p><p><b>Top продукти прегледани:</b> {r.topProductsViewed.map(([id,n])=>`${id} (${n})`).join(", ")||"0"}</p><p><b>Top брандове върнати:</b> {r.topBrandsReturned.map(([id,n])=>`${id} (${n})`).join(", ")||"Няма данни"}</p><p><b>Top брандове прегледани:</b> {r.topBrandsViewed.map(([id,n])=>`${id} (${n})`).join(", ")||"0"}</p><p><b>Outbound after search:</b> {r.productOutbound+r.brandOutbound}</p></details>)}</div></section>
<section class="panel analytics-section"><h2>Търсения без резултат</h2><AnalyticsTable heads={["Търсене","Брой","Резултати","Категория","Подкатегория","Тип продукт","Получател","Повод","Бюджет"]} rows={zeroDemand.map(r=>[r.query,r.searches,r.resultCount,human(r.category),human(r.subcategory),human(r.productType),human(r.recipient),human(r.occasion),human(r.budget)])} emphasizeColumn={2} emphasizeValue={0}/><h3>Слабо покритие (1–3 резултата)</h3><AnalyticsTable heads={["Търсене","Брой","Резултати","Категория","Подкатегория","Тип продукт","Получател","Повод","Бюджет"]} rows={lowDemand.map(r=>[r.query,r.searches,r.resultCount,human(r.category),human(r.subcategory),human(r.productType),human(r.recipient),human(r.occasion),human(r.budget)])}/></section>
<section class="panel analytics-section"><h2>Какви филтри използват</h2><div class="columns">{filterGroups.map(g=><article><h3>{g.title}</h3><AnalyticsTable heads={["Филтър","Стойност","Избори","Резултати преди","Резултати след","Прегледи след избор","Изходящи след избор"]} rows={filters.filter(r=>g.keys.includes(r.key)).map(r=>[r.label,human(r.value),r.selections,na(r.resultsBefore),na(r.resultsAfter),r.views,r.outbound])}/></article>)}</div></section>
<section class="panel analytics-section"><h2>Продукти</h2><input class="table-search" type="search" placeholder="Продукт или бранд" data-filter-table="products-table"/><AnalyticsTable heads={["Продукт","Бранд","Върнат","Импресии","Прегледи","Запазвания","Изходящи","Върнат→преглед","Импресия→преглед","Преглед→изходящ","Върнат→изходящ"]} rows={products.map(r=>[r.name,r.brand,na(r.returned),r.impressions,r.views,r.saves,r.outbound,pct(r.returnedViewRate),pct(r.impressionViewRate),pct(r.viewOutboundRate),pct(r.returnedOutboundRate)])} id="products-table" paginate/></section>
<section class="panel analytics-section"><h2>Брандове</h2><input class="table-search" type="search" placeholder="Търси бранд" data-filter-table="brands-table"/><AnalyticsTable id="brands-table" paginate heads={["Бранд","Върнат","Импресии","Бранд прегледи","Продуктови прегледи","Запазвания","Изходящи продукти","Изходящи бранд"]} rows={brands.map(r=>[r.name,na(r.returned),r.impressions,r.brandViews,r.productViews,r.saves,r.productOutbound,r.brandOutbound])}/><h3>Подробности за Top 20</h3><div>{brands.slice(0,20).map(r=><details class="brand-row"><summary><strong>{r.name}</strong><span>Върнат: {na(r.returned)} · Импресии: {r.impressions} · Прегледи: {r.brandViews+r.productViews}</span></summary><h3>Кои търсения водят до този бранд</h3><AnalyticsTable heads={["Търсене","Появи в резултати","Импресии","Прегледи","Изходящи"]} rows={buildBrandSearchRows(events,r.id).map(x=>[x.query,x.returned,x.impressions,x.views,x.outbound])}/></details>)}</div></section>
<section class="panel analytics-section"><h2>Страници и входни страници</h2><AnalyticsTable heads={["Страница / път","Тип","Сесии","Прегледи на страници","Прегледи продукти","Прегледи брандове","Запазвания","Изходящи"]} rows={pages.map(r=>[r.path,human(r.pageType),r.sessions,r.pageViews,r.productViews,r.brandViews,r.saves,r.outbound])}/></section>
<section class="panel analytics-section"><h2>Фуния на търсенето и откриването</h2>{!funnel.available&&<p class="notice">Данните за върнати резултати не са налични за избрания исторически период.</p>}<div class="funnel">{[["Търсене → резултат",rate(funnel.searchesWithResults,funnel.searches)],["Върнат → импресия",funnel.available?funnel.returnImpression:null],["Импресия → преглед",funnel.impressionView],["Преглед → запазване",funnel.viewSave],["Преглед → изходящ",funnel.viewOutbound],["Търсене → изходящ",funnel.searchOutbound]].map(([l,v])=><div><span>{l}</span><b>{v===null?"Няма данни":`${fmt(Number(v),1)}%`}</b></div>)}</div></section>
<section class="panel analytics-section"><h2>Контекст на откриване</h2><div class="columns">{dimensions.map(d=><article><h3>{d.title}</h3><AnalyticsTable heads={["Стойност","Събития","Сесии","Прегледи","Запазвания","Изходящи"]} rows={d.rows.map(r=>[human(r.name),r.events,r.sessions,r.views,r.saves,r.outbound])}/></article>)}</div></section>
<section class="panel analytics-section"><h2>Сесии</h2><div class="session-list">{journeys.map(row=><details class="session-row"><summary><span>{row.sessionId}{row.legacy?" · legacy/partial":""}</span><span>{row.started?.toLocaleString("bg-BG")}</span><span>{duration(row.durationMs)}</span><span>{row.landing}</span><span>{row.source}</span><span>{row.searches} търс. · {row.productViews} прод. · {row.brandViews} бранд · {row.saves} зап. · {row.outbound} изх.</span></summary><ol>{row.steps.map(step=><li><time>{clock(step.at)}</time> <b>{step.event}</b> {step.label}<small>{step.attributed?" · explicit search attribution":" · unattributed"}</small></li>)}</ol></details>)}</div></section><section class="panel analytics-section"><h2>Придобиване</h2><AnalyticsTable heads={["Канал","Източник","Medium","Кампания","Препращащ сайт","Сесии","Търсения","Прегледи","Запазвания","Изходящи"]} rows={acquisition.map(r=>[r.channel,r.source,r.medium,r.campaign,r.referrer,r.sessions,r.searches,r.views,r.saves,r.outbound])}/></section></details></AdminLayout>
<script>document.querySelectorAll<HTMLTableCellElement>("table[data-sortable] th").forEach((h,i)=>h.addEventListener("click",()=>{const b=h.closest("table")?.tBodies[0];if(!b)return;const d=h.dataset.d==="a"?-1:1;h.dataset.d=d===1?"a":"d";[...b.rows].sort((x,y)=>{const a=x.cells[i]?.innerText||"",c=y.cells[i]?.innerText||"",an=Number(a.replace(",",".")),cn=Number(c.replace(",","."));return(Number.isFinite(an)&&Number.isFinite(cn)?an-cn:a.localeCompare(c,"bg"))*d}).forEach(x=>b.appendChild(x))}));document.querySelectorAll<HTMLInputElement>("[data-filter-table]").forEach(i=>i.addEventListener("input",()=>{const q=i.value.toLocaleLowerCase("bg"),target=document.getElementById(i.dataset.filterTable||"");target?.querySelectorAll<HTMLElement>("tbody tr, details.brand-row").forEach(r=>r.hidden=Boolean(q&&!r.textContent?.toLocaleLowerCase("bg").includes(q)))}));const toggle=document.querySelector<HTMLButtonElement>("[data-analytics-device-toggle]"),status=document.querySelector<HTMLElement>("[data-analytics-device-status]");const excluded=()=>document.cookie.split(";").some(x=>x.trim()==="bulgaritam_analytics_excluded=1"),productionHost=location.hostname==="bulgaritam.bg"||location.hostname.endsWith(".bulgaritam.bg"),scope=`; Path=/; SameSite=Lax${productionHost?"; Domain=.bulgaritam.bg; Secure":""}`;const sync=()=>{const value=excluded();if(status)status.textContent=value?"Това устройство е изключено от Analytics":"Това устройство участва в Analytics";if(toggle)toggle.textContent=value?"Включи отново":"Изключи това устройство от Analytics"};toggle?.addEventListener("click",()=>{document.cookie=excluded()?`bulgaritam_analytics_excluded=; Max-Age=0${scope}`:`bulgaritam_analytics_excluded=1; Max-Age=31536000${scope}`;sync()});sync();</script>
<style>.controls{display:flex;max-width:100%;min-width:0;gap:9px;align-items:end;flex-wrap:wrap}.controls label{width:145px}.presets{display:flex;max-width:100%;gap:5px;flex-wrap:wrap}.active{background:var(--green)!important;color:#fff!important}.metric-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin:18px 0}.metric{background:#fff;border:1px solid var(--line);border-radius:10px;padding:14px}.metric span,.metric small{display:block;color:#777}.metric b{font-size:25px}.analytics-section{margin:18px 0}.columns{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.table-wrap{max-height:560px;overflow:auto}th{cursor:pointer;position:sticky;top:0;background:#fff}tr.signal{background:#fff4dd}.table-search{max-width:280px;margin-bottom:10px}.brand-row{border:1px solid var(--line);border-radius:8px;padding:12px;margin:8px 0}.brand-row summary{display:flex;justify-content:space-between;gap:15px;cursor:pointer}.funnel{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}.funnel div{background:#edf5f0;padding:14px;border-radius:8px}.funnel span,.funnel b{display:block}.funnel b{font-size:22px}.notice{color:#80520b}@media(max-width:1100px){.metric-grid,.columns{grid-template-columns:repeat(2,1fr)}.funnel{grid-template-columns:repeat(3,1fr)}}@media(max-width:700px){.metric-grid,.columns,.funnel{grid-template-columns:1fr}.brand-row summary{display:block}}</style>
<style>.analytics-section,.panel,.columns>article{min-width:0}.columns{grid-template-columns:repeat(3,minmax(0,1fr))}.table-wrap{width:100%;max-width:100%;overflow-x:auto}.device-exclusion{display:grid;gap:5px}.v1-disclosure{margin:22px 0}.v1-disclosure>summary{cursor:pointer;font-weight:700;padding:14px;border:1px solid var(--line);border-radius:8px;background:#fff}.session-row{border:1px solid var(--line);border-radius:8px;padding:12px;margin:8px 0}.session-row summary{display:grid;grid-template-columns:repeat(6,minmax(110px,1fr));gap:10px;cursor:pointer}.session-row li{margin:8px 0}.session-row small{color:#777}.table-actions{display:flex;gap:8px;margin-top:10px}@media(max-width:1100px){.session-row summary{grid-template-columns:repeat(2,1fr)}}@media(max-width:700px){.session-row summary{display:block}}</style>
