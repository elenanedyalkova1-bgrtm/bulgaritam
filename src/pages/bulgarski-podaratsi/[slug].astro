const editorialContent = seoEditorialBySlug[landing.slug] || null;
---

<SeoProductLanding
  landing={landing}
  products={products}
  browseProducts={allProducts}
  canonicalPath={canonicalPath}
  breadcrumbs={[
    { name: "Начало", item: "/" },
    { name: "Български подаръци", item: "/bulgarski-podaratsi/" },
    { name: landing.label, item: canonicalPath },
  ]}
  primaryPills={primaryPills}
  editorialHeader={editorialContent?.header}
  editorialSections={editorialContent?.sections || []}
/>
