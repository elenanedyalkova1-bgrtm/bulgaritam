  <script>
    import { parseBulgarianShoppingIntent } from "../lib/search-intent";

    async function initializeHomepage() {
    const q = document.getElementById("q") as HTMLInputElement;
    const searchForm = document.getElementById("searchForm");
    const grid = document.getElementById("grid");
    const productFeed = document.getElementById("products");
    const count = document.getElementById("count");
    const hint = document.getElementById("hint");
    const intentStatus = document.getElementById("intentStatus");

    const mainChips = document.getElementById("mainChips");
    const subChips = document.getElementById("subChips");
    const subChipsLabel = document.getElementById("subChipsLabel");
    const typeChips = document.getElementById("typeChips");
    const typeChipsLabel = document.getElementById("typeChipsLabel");
    const taxonomyResultsCue = document.getElementById("taxonomyResultsCue");
    const activeSelections = document.getElementById("activeSelections");
    const feedStatus = document.getElementById("feedStatus");
    const feedSentinel = document.getElementById("feedSentinel");
    const feedLoadMore = document.getElementById("feedLoadMore");
    const productCardCatalogue = document.querySelector("template#productCardCatalogue");
    const homeLandingData = document.getElementById("homeLandingData");
    const homeCategoriesData = document.getElementById("homeCategoriesData");
    const occasionToggle = document.getElementById("occasionToggle");
    const occasionModal = document.getElementById("occasionModal");
    const occasionBadge = document.getElementById("occasionBadge");
    const occasionApply = document.getElementById("occasionApply");
    const occasionReset = document.getElementById("occasionReset");
    const sortSelect = document.getElementById("sortSelect");
    const filtersToggle = document.getElementById("filtersToggle");
    const filtersModal = document.getElementById("filtersModal");
    const filtersBadge = document.getElementById("filtersBadge");
    const filtersApply = document.getElementById("filtersApply");
    const filtersReset = document.getElementById("filtersReset");
    // Randomize the static page order once per visit, then each disjoint page
    // once before display. Discovery fetches only the next 48-card page.
    const firstPageCards = Array.from(productCardCatalogue?.content.querySelectorAll("li.card") || []);
    let allCards = [];
    let loadedThroughPage = 0; // Number consumed from pageOrder, not a page number.
    const totalStaticPages = Number(productFeed?.dataset.totalPages || 1);
    const totalCatalogueItems = Number(productFeed?.dataset.totalItems || firstPageCards.length);
    const discoverySeed = Math.floor(Math.random() * 0x100000000);
    const createShuffledOrder = (items, seed = discoverySeed) => {
      let state = seed >>> 0;
      const random = () => {
        state += 0x6D2B79F5;
        let value = Math.imul(state ^ (state >>> 15), 1 | state);
        value ^= value + Math.imul(value ^ (value >>> 7), 61 | value);
        return ((value ^ (value >>> 14)) >>> 0) / 0x100000000;
      };
      const shuffled = [...items];
      for (let i = shuffled.length - 1; i > 0; i -= 1) {
        const j = Math.floor(random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }
      return shuffled;
    };
    const pageOrder = createShuffledOrder(Array.from({ length: totalStaticPages }, (_, i) => i + 1));
    const loadedPages = new Set();
    let pageLoadPromise = null;
    const loadStaticPage = async (page) => {
      if (loadedPages.has(page) || !page) return false;
      if (pageLoadPromise) await pageLoadPromise;
      if (loadedPages.has(page)) return false;
      pageLoadPromise = (async () => {
        let cards = firstPageCards;
        if (page !== 1) {
          const response = await fetch(`/page/${page}/`, { credentials: "same-origin" });
          if (!response.ok) throw new Error(`Pagination ${response.status}`);
          const pageDocument = new DOMParser().parseFromString(await response.text(), "text/html");
          cards = Array.from(pageDocument.querySelectorAll("#grid li.card"));
          if (!cards.length) throw new Error("Empty product page");
        }
        const known = new Set(allCards.map((card) => card.dataset.productSlug));
        const added = createShuffledOrder(cards, discoverySeed ^ page).filter((card) => {
          const slug = card.dataset.productSlug;
          if (!slug || known.has(slug)) return false;
          known.add(slug);
          return true;
        });
        added.forEach((card) => {
          const node = page === 1 ? card : document.importNode(card, true);
          node.dataset.originalIndex = String((page - 1) * 48 + cards.indexOf(card));
          node.dataset.featuredIndex = String(allCards.length);
          node.dataset.position = String(allCards.length + 1);
          allCards.push(node);
        });
        loadedPages.add(page);
        loadedThroughPage = loadedPages.size;
        return added.length > 0;
      })().finally(() => { pageLoadPromise = null; });
      return pageLoadPromise;
    };
    const ensureAllStaticPages = async () => {
      for (const page of pageOrder) await loadStaticPage(page);
    };
    try {
      await loadStaticPage(pageOrder[0]);
    } catch {
      // First-page HTML is already available even if the network is offline.
      pageOrder.splice(pageOrder.indexOf(1), 1);
      pageOrder.unshift(1);
      await loadStaticPage(1);
    }
    const catalogueMaterials = Array.from(document.querySelectorAll('input[name="materialFilter"]')).map((input) => input.value);

    const getBatchSize = () => {
      if (window.innerWidth <= 640) return 8;
      if (window.innerWidth <= 768) return 10;
      return 16;
    };

    let visibleCount = getBatchSize();
    let matchedCards = [...allCards];
    let appendInProgress = false;
    let feedObserver = null;
    let gridPulseFrame = 0;
    let activeCategoryKey = "";
    let activeSubcategoryKey = "";
    let activeProductType = "";
    let selectedPriceRange = "all";
    let selectedDeliveryOutside = false;
    const supportedSorts = new Set(["featured", "price-asc", "price-desc", "alpha-asc", "alpha-desc"]);
    const requestedSort = new URLSearchParams(window.location.search).get("sort") || "";
    let selectedSort = supportedSorts.has(requestedSort) ? requestedSort : "featured";
    if (sortSelect) sortSelect.value = selectedSort;
    let selectedGiftFilters = [];
    let selectedAttributes = [];
    let selectedMaterials = [];
    let selectedColors = [];
    let currentSearchIntent = null;
    let executedSearchContext = null;
    let searchFallbackRequired = false;
    let lastTrackedSearchSignature = "";
    const SEO_LANDING_LINKS = homeLandingData?.dataset.landings
      ? JSON.parse(homeLandingData.dataset.landings)
      : [];
    const CATEGORIES = homeCategoriesData?.dataset.categories
      ? JSON.parse(homeCategoriesData.dataset.categories)
      : [];
    const getCurrentLang = () => localStorage.getItem("bulgaritam_lang_v1") === "en" ? "en" : "bg";

    const focusResults = () => window.requestAnimationFrame(() => window.bulgaritamScrollToResults?.());

    const removeStructuredTermsFromSearch = () => {
      const intent = parseBulgarianShoppingIntent(q.value || "");
      if (!intent || (!intent.categoryKey && !intent.subcategoryKey && !intent.productType)) return;
      q.value = intent.residualQuery || "";
      currentSearchIntent = null;
    };

    const pulseResults = () => {
      if (!grid) return;
      grid.classList.remove("is-updated");
      cancelAnimationFrame(gridPulseFrame);
      gridPulseFrame = requestAnimationFrame(() => {
        grid.classList.add("is-updated");
        window.setTimeout(() => grid.classList.remove("is-updated"), 650);
      });
    };

    const parseComparablePrice = (card) => {
      const min = Number(card.dataset.priceMin);
      const max = Number(card.dataset.priceMax);
      if (!Number.isNaN(min) && min > 0) return min;
      if (!Number.isNaN(max) && max > 0) return max;
      return Number.POSITIVE_INFINITY;
    };
    const comparePrice = (a, b, direction) => {
      const aPrice = parseComparablePrice(a);
      const bPrice = parseComparablePrice(b);
      const aMissing = !Number.isFinite(aPrice);
      const bMissing = !Number.isFinite(bPrice);
      if (aMissing !== bMissing) return aMissing ? 1 : -1;
      if (aMissing && bMissing) return Number(a.dataset.originalIndex) - Number(b.dataset.originalIndex);
      const difference = direction === "desc" ? bPrice - aPrice : aPrice - bPrice;
      return difference || Number(a.dataset.originalIndex) - Number(b.dataset.originalIndex);
    };

    const parseCreatedAt = (card) => {
      const raw = card.dataset.createdAt || "";
      const value = raw ? Date.parse(raw) : 0;
      return Number.isNaN(value) ? 0 : value;
    };

    const matchesPriceRange = (card, range) => {
      if (!range || range === "all") return true;

      const parsePrice = (value) => value === "" || value == null ? null : Number(value);
      const parsedMin = parsePrice(card.dataset.priceMin);
      const parsedMax = parsePrice(card.dataset.priceMax);
      const low = Number.isFinite(parsedMin) ? parsedMin : Number.isFinite(parsedMax) ? parsedMax : null;
      const high = Number.isFinite(parsedMax) ? parsedMax : Number.isFinite(parsedMin) ? parsedMin : null;
      if (low === null || high === null) return false;

      if (range === "0-25") {
        return low <= 25;
      }

      if (range === "25-50") {
        return low <= 50 && high >= 25;
      }

      if (range === "50-100") {
        return low <= 100 && high >= 50;
      }

      if (range === "100+") {
        return high >= 100;
      }

      return true;
    };

    const CYRILLIC_TO_LATIN = {
      "а": "a", "б": "b", "в": "v", "г": "g", "д": "d", "е": "e", "ж": "zh", "з": "z",
      "и": "i", "й": "y", "к": "k", "л": "l", "м": "m", "н": "n", "о": "o", "п": "p",
      "р": "r", "с": "s", "т": "t", "у": "u", "ф": "f", "х": "h", "ц": "ts", "ч": "ch",
      "ш": "sh", "щ": "sht", "ъ": "a", "ь": "y", "ю": "yu", "я": "ya",
    };

    const BG_SUFFIXES = [
      "овете", "евете", "анията", "ението", "енията", "ищата", "ите", "ове", "еве",
      "ата", "ята", "ният", "ната", "ното", "ните", "ски", "ска", "ско", "чен", "чна",
      "чно", "чни", "ен", "на", "но", "ни", "ът", "та", "то", "те", "ия", "ие", "а",
      "я", "и", "е", "о", "у",
    ];

    const SPECIAL_EQUIVALENTS = [
      [/^памуч/, ["памук"]],
      [/^pamuch/, ["pamuk"]],
      [/^ленен/, ["лен"]],
      [/^lenen/, ["len"]],
      [/^вълнен/, ["вълна"]],
      [/^valnen|^vulnen/, ["valna"]],
    ];

    const SEMANTIC_GROUPS = [
      ["gift", "gifts", "подарък", "подаръци"],
      ["baby", "babies", "бебе", "бебешки", "бебешко"],
      ["kid", "kids", "children", "дете", "деца", "детски", "детско"],
      ["clothing", "apparel", "outfit", "outfits", "облекло", "дреха", "дрехи"],
      ["cotton", "памук", "памучен", "памучна", "памучно"],
      ["linen", "лен", "ленен", "ленена"],
      ["wool", "вълна", "вълнен", "вълнена"],
      ["night", "нощен", "нощна", "нощно"],
      ["day", "дневен", "дневна", "дневно"],
      ["cream", "крем"],
      ["serum", "серум"],
      ["shampoo", "шампоан"],
      ["mask", "маска"],
      ["soap", "sapun", "сапун"],
      ["body", "тяло"],
      ["face", "лице"],
      ["hair", "коса"],
      ["lip", "lips", "устни"],
      ["candle", "candles", "свещ", "свещи"],
      ["bag", "bags", "чанта", "чанти"],
      ["earring", "earrings", "обеци"],
      ["jewelry", "бижута", "бижу"],
      ["dress", "рокля", "рокли"],
      ["shirt", "shirts", "риза", "ризи"],
      ["tshirt", "t-shirt", "tshirt", "tee", "тениска", "тениски"],
      ["home", "дом"],
      ["interior", "интериор"],
      ["decor", "dekor", "декор"],
      ["cleaning", "почистване"],
      ["book", "books", "книга", "книги"],
      ["toy", "toys", "играчка", "играчки"],
      ["tea", "чай"],
      ["herbs", "herb", "билки", "билка"],
      ["supplement", "supplements", "добавка", "добавки"],
      ["extract", "extracts", "екстракт", "екстракти", "тинктура"],
      ["sport", "sports", "спорт"],
      ["cosmetics", "козметика"],
      ["natural", "натурален", "натурална", "натурално"],
      ["organic", "органичен", "органична", "органично", "bio", "био"],
      ["eco", "еко", "sustainable", "устойчив", "reusable", "многократен", "biodegradable", "биоразградим"],
    ];
    const BG_SEARCH_STOP_WORDS = new Set(["за", "от", "с", "на"]);

    const normalizeSearchText = (value) =>
      String(value || "")
        .toLowerCase()
        .replace(/&/g, " ")
        .replace(/['\"`´’‘]/g, "")
        .replace(/[.,/#!$%^*;:{}=\\-_~()@\\[\\]+<>?\\\\|]/g, " ")
        .replace(/\s+/g, " ")
        .trim();

    const transliterateBulgarianToLatin = (value) =>
      Array.from(normalizeSearchText(value))
        .map((char) => CYRILLIC_TO_LATIN[char] || char)
        .join("");

    const tokenizeSearchText = (value) =>
      normalizeSearchText(value)
        .split(/\s+/)
        .map((token) => token.trim())
        .filter((token) => token && !BG_SEARCH_STOP_WORDS.has(token));

    const expandSearchToken = (token) => {
      const forms = new Set();
      const normalized = normalizeSearchText(token);
      if (!normalized) return Array.from(forms);
      forms.add(normalized);
      if (normalized.length >= 4) forms.add(normalized.slice(0, 4));
      if (normalized.length >= 6) forms.add(normalized.slice(0, 5));

      BG_SUFFIXES.forEach((suffix) => {
        if (normalized.length - suffix.length >= 3 && normalized.endsWith(suffix)) {
          forms.add(normalized.slice(0, -suffix.length));
        }
      });

      SPECIAL_EQUIVALENTS.forEach(([pattern, equivalents]) => {
        if (pattern.test(normalized)) equivalents.forEach((entry) => forms.add(entry));
      });

      SEMANTIC_GROUPS.forEach((group) => {
        if (group.includes(normalized)) group.forEach((entry) => forms.add(entry));
      });

      return Array.from(forms);
    };

    const buildSearchGroups = (value) => {
      const normalized = normalizeSearchText(value);
      const transliterated = transliterateBulgarianToLatin(normalized);
      const rawTokens = [...new Set([
        ...tokenizeSearchText(normalized),
        ...tokenizeSearchText(transliterated),
      ])];

      return rawTokens.map((token) => expandSearchToken(token));
    };

    const buildSearchQuery = (value) => {
      const normalized = normalizeSearchText(value);
      return {
        normalized,
        latin: transliterateBulgarianToLatin(normalized),
        groups: buildSearchGroups(normalized),
      };
    };

    const buildSearchDocumentString = (value) => {
      const tokens = new Set();
      [normalizeSearchText(value), transliterateBulgarianToLatin(value)].forEach((entry) => {
        tokenizeSearchText(entry).forEach((token) => {
          expandSearchToken(token).forEach((form) => tokens.add(form));
        });
      });
      return Array.from(tokens).join(" ");
    };

    const scheduleSearchTracking = (value, searchId) => {
      const normalized = normalizeSearchText(value);
      if (normalized.length < 2) {
        lastTrackedSearchSignature = "";
        executedSearchContext = null;
        return;
      }

      executedSearchContext = { search_id: searchId, search_term: String(value || "").trim() };
      const signature = [
        normalized,
        activeCategoryKey || "all",
        activeSubcategoryKey || "all",
        selectedSort || "featured",
        matchedCards.length,
      ].join("|");

      lastTrackedSearchSignature = signature;

      const intent = currentSearchIntent;
      const searchParams = {
          search_id: searchId,
          query: String(value || "").trim(),
          search_term: String(value || "").trim(),
          normalized_query: normalized,
          result_count: matchedCards.length,
          search_results_count: matchedCards.length,
          structured_intent: intent?.labels?.join(" > ") || "",
          used_fallback: searchFallbackRequired,
          category: intent?.categoryKey || activeCategoryKey || "",
          subcategory: intent?.subcategoryKey || activeSubcategoryKey || "",
          product_type: intent?.productType || activeProductType || "",
          gift_recipient: intent?.recipients?.join(",") || "",
          gift_occasion: intent?.occasions?.join(",") || "",
          audience: intent?.audienceKey || "",
          materials: intent?.materials?.join(",") || "",
          max_price_eur: intent?.maxPriceEur ?? "",
          discovery_state_id: window.__bulgaritamCurrentDiscoveryState?.discovery_state_id || "",
          tracking_version: "2",
      };
      const returnedProducts = matchedCards.map((card, position) => [
        card.dataset.productId || "",
        card.dataset.brandId || "",
        position + 1,
      ]);
      window.bulgaritamTrack?.("search", {
        ...searchParams,
        returned_products_json: JSON.stringify(returnedProducts),
      });
      window.bulgaritamTrack?.(matchedCards.length ? "search_results_view" : "search_no_results", searchParams);
    };

    const updateUsefulResultSignals = () => {
      const activeSearchId = executedSearchContext?.search_id || "";
      allCards.forEach((card) => {
        const button = card.querySelector("[data-user-signal='useful_result']");
        if (!button) return;
        button.hidden = !activeSearchId || !matchedCards.includes(card) || card.dataset.listContext !== "search_results";
      });
    };

    const searchCardCache = new WeakMap();

    const getSearchCardData = (card) => {
      if (!searchCardCache.has(card)) {
        const raw = normalizeSearchText(card?.dataset?.searchRaw || "");
        const rawLatin = transliterateBulgarianToLatin(raw);
        const structured = String(card?.dataset?.search || card?.search || "");
        const searchable = `${raw} ${structured}`.trim();
        const productName = normalizeSearchText(card?.dataset?.productName || "");
        const brandName = normalizeSearchText(card?.dataset?.brandName || "");
        searchCardCache.set(card, {
          raw,
          rawLatin,
          searchable,
          searchableLatin: transliterateBulgarianToLatin(searchable),
          productName,
          productNameLatin: transliterateBulgarianToLatin(productName),
          brandName,
          brandNameLatin: transliterateBulgarianToLatin(brandName),
          tokens: new Set([
            ...structured.split(/\s+/).filter(Boolean),
            ...tokenizeSearchText(raw),
            ...tokenizeSearchText(rawLatin),
          ]),
        });
      }
      return searchCardCache.get(card);
    };

    const matchesSearchDocument = (card, value) => {
      const query = typeof value === "string" ? buildSearchQuery(value) : value;
      const normalizedQuery = query.normalized;
      if (!normalizedQuery) return true;
      const { raw, rawLatin, searchable, searchableLatin, tokens } = getSearchCardData(card);
      const queryLatin = query.latin;
      if (
        raw.includes(normalizedQuery) ||
        raw.includes(queryLatin) ||
        rawLatin.includes(normalizedQuery) ||
        rawLatin.includes(queryLatin) ||
        searchable.includes(normalizedQuery) ||
        searchable.includes(queryLatin) ||
        searchableLatin.includes(normalizedQuery) ||
        searchableLatin.includes(queryLatin)
      ) {
        return true;
      }
      const groups = query.groups;
      if (!groups.length) return true;
      return groups.every((group) =>
        group.some((token) => {
          if (!token) return false;
          if (token.length < 3) return false;
          if (tokens.has(token)) return true;
          for (const docToken of tokens) {
            if (docToken.startsWith(token)) return true;
          }
          return false;
        })
      );
    };

    const getSearchRelevanceScore = (card, value) => {
      const query = typeof value === "string" ? buildSearchQuery(value) : value;
      const normalizedQuery = query.normalized;
      if (!normalizedQuery) return 0;

      const queryLatin = query.latin;
      const { productName, productNameLatin, brandName, brandNameLatin, raw, rawLatin, searchable, searchableLatin } = getSearchCardData(card);
      const queryGroups = query.groups;
      let score = 0;

      if (productName === normalizedQuery || productNameLatin === queryLatin) score += 260;
      if (productName.startsWith(normalizedQuery) || productNameLatin.startsWith(queryLatin)) score += 190;
      if (productName.includes(normalizedQuery) || productName.includes(queryLatin) || productNameLatin.includes(normalizedQuery) || productNameLatin.includes(queryLatin)) score += 150;
      if (brandName === normalizedQuery || brandNameLatin === queryLatin) score += 130;
      if (brandName.includes(normalizedQuery) || brandNameLatin.includes(queryLatin)) score += 75;
      if (raw.includes(normalizedQuery) || rawLatin.includes(queryLatin)) score += 60;
      if (searchable.includes(normalizedQuery) || searchable.includes(queryLatin) || searchableLatin.includes(normalizedQuery) || searchableLatin.includes(queryLatin)) score += 45;

      queryGroups.forEach((group) => {
        const bestTokenScore = group.reduce((best, token) => {
          if (!token) return best;
          if (productName.includes(token) || productNameLatin.includes(token)) return Math.max(best, 42);
          if (brandName.includes(token) || brandNameLatin.includes(token)) return Math.max(best, 30);
          if (searchable.includes(token) || searchableLatin.includes(token)) return Math.max(best, 18);
          return best;
        }, 0);
        score += bestTokenScore;
      });

      return score;
    };

    const sortCardsForSearch = (cards, value) => {
      const query = typeof value === "string" ? buildSearchQuery(value) : value;
      const scores = new Map(cards.map((card) => [card, getSearchRelevanceScore(card, query)]));
      return [...cards].sort((a, b) => {
        const scoreDiff = scores.get(b) - scores.get(a);
        if (scoreDiff !== 0) return scoreDiff;
        return Number(a.dataset.featuredIndex) - Number(b.dataset.featuredIndex);
      });
    };

    const findLandingByQuery = (value) => {
      const query = normalizeSearchText(value);
      if (!query) return null;
      return SEO_LANDING_LINKS.find((item) =>
        (item.queryAliases || []).some((term) =>
          matchesSearchDocument({ search: buildSearchDocumentString(term) }, query)
        )
      ) || null;
    };

    const sortCards = (cards, sortValue) => {
      const sorted = [...cards];

      switch (sortValue) {
        case "price-asc":
          sorted.sort((a, b) => comparePrice(a, b, "asc"));
          break;
        case "price-desc":
          sorted.sort((a, b) => comparePrice(a, b, "desc"));
          break;
        case "alpha-asc":
          sorted.sort((a, b) =>
            String(a.dataset.productName || "").localeCompare(
              String(b.dataset.productName || ""),
              "bg"
            )
          );
          break;
        case "alpha-desc":
          sorted.sort((a, b) =>
            String(b.dataset.productName || "").localeCompare(String(a.dataset.productName || ""), "bg")
          );
          break;
        case "featured":
        default:
          sorted.sort((a, b) => Number(a.dataset.featuredIndex) - Number(b.dataset.featuredIndex));
          break;
      }

      return sorted;
    };

    matchedCards = sortCards([...allCards], "featured");
    const renderVisibleCards = () => {
      const desiredCards = matchedCards.slice(0, visibleCount);
      const currentCards = Array.from(grid.children);
      const unchanged = desiredCards.length === currentCards.length && desiredCards.every((card, index) => card === currentCards[index]);
      if (unchanged) return;
      const appendOnly = currentCards.every((card, index) => card === desiredCards[index]);
      if (!appendOnly) grid.classList.remove("is-masonry-ready");
      const fragment = document.createDocumentFragment();
      const changedCards = appendOnly ? desiredCards.slice(currentCards.length) : desiredCards;
      changedCards.forEach((card) => {
        card.style.removeProperty("display");
        card.style.removeProperty("--masonry-span");
        fragment.appendChild(card);
      });
      if (appendOnly) grid.appendChild(fragment);
      else grid.replaceChildren(fragment);
      window.bulgaritamScheduleMasonry?.(grid);
      window.dispatchEvent(new CustomEvent("bulgaritam:products-appended", { detail: { nodes: changedCards } }));
    };

    const updateGridLayoutState = () => {
      if (!grid) return;
      grid.classList.remove("is-filtered");
    };

    function updateFeedVisibility() {
      updateGridLayoutState();
      renderVisibleCards();

      const hasActiveDiscovery = Boolean((q.value || "").trim() || activeCategoryKey || activeSubcategoryKey || activeProductType || selectedPriceRange !== "all" || selectedDeliveryOutside || selectedGiftFilters.length || selectedAttributes.length || selectedMaterials.length || selectedColors.length);
      const collectionPagination = productFeed?.querySelector(".collection-pagination");
      if (collectionPagination) collectionPagination.hidden = hasActiveDiscovery;

      if (feedStatus) {
        const resolvedTotal = !hasActiveDiscovery && loadedThroughPage < totalStaticPages ? totalCatalogueItems : matchedCards.length;
        const shown = Math.min(visibleCount, matchedCards.length);
        feedStatus.textContent =
          resolvedTotal > shown ? `Показани ${shown} от ${resolvedTotal}` : "";
      }

      if (feedSentinel) {
        feedSentinel.hidden = matchedCards.length <= visibleCount && loadedThroughPage >= totalStaticPages;
      }
      if (matchedCards.length <= visibleCount && loadedThroughPage >= totalStaticPages) feedObserver?.disconnect();
      else if (feedObserver && feedSentinel) feedObserver.observe(feedSentinel);
      if (feedLoadMore) {
        feedLoadMore.hidden = matchedCards.length <= visibleCount && loadedThroughPage >= totalStaticPages;
      }

      if (typeof window.syncSaveButtons === "function") window.syncSaveButtons();
    }

    async function loadMore() {
      if (appendInProgress) return;
      appendInProgress = true;
      let failed = false;
      try {
        if (visibleCount >= matchedCards.length && loadedThroughPage < totalStaticPages) {
          await loadStaticPage(pageOrder[loadedThroughPage]);
          matchedCards = sortCards([...allCards], selectedSort);
        }
        if (visibleCount >= matchedCards.length) return;
        visibleCount = Math.min(matchedCards.length, visibleCount + getBatchSize());
        updateFeedVisibility();
      } catch {
        failed = true;
        if (feedStatus) feedStatus.textContent = "Зареждането не успя. Опитай отново с „Покажи още“.";
        if (feedLoadMore) feedLoadMore.hidden = false;
      } finally {
        appendInProgress = false;
        if (!failed && feedSentinel && !feedSentinel.hidden) {
          const rect = feedSentinel.getBoundingClientRect();
          if (rect.top <= window.innerHeight + 900 && rect.bottom >= -900) requestAnimationFrame(loadMore);
        }
      }
    }

    function updateActiveChips() {
      mainChips.querySelectorAll(".chip").forEach((chip) => {
        chip.classList.toggle("is-active", chip.dataset.categoryKey === activeCategoryKey);
      });

      subChips.querySelectorAll(".chip").forEach((chip) => {
        chip.classList.toggle("is-active", chip.dataset.subcategoryKey === activeSubcategoryKey);
      });
      typeChips?.querySelectorAll(".chip").forEach((chip) => {
        chip.classList.toggle("is-active", chip.dataset.productType === activeProductType);
      });
    }

    function updateFiltersBadge() {
      const total = (selectedPriceRange !== "all" ? 1 : 0) + (selectedDeliveryOutside ? 1 : 0) + selectedAttributes.length + selectedMaterials.length + selectedColors.length;
      if (!filtersBadge) return;
      if (total > 0) {
        filtersBadge.textContent = String(total);
        filtersBadge.removeAttribute("hidden");
      } else {
        filtersBadge.setAttribute("hidden", "");
      }
    }

    function updateOccasionBadge() {
      if (!occasionBadge) return;
      if (selectedGiftFilters.length) {
        occasionBadge.textContent = String(selectedGiftFilters.length);
        occasionBadge.removeAttribute("hidden");
      } else {
        occasionBadge.setAttribute("hidden", "");
      }
    }

    const splitPipeValues = (value) => String(value || "").split("|").map((item) => item.trim()).filter(Boolean);
    const AUDIENCE_VALUE_TERMS = {
      woman: ["жена", "жени", "дамски", "дамско", "women", "woman"],
      man: ["мъж", "мъже", "мъжки", "мъжко", "men", "man"],
      child: ["дете", "деца", "детски", "детско", "children", "kids"],
      baby: ["бебе", "бебета", "бебешки", "бебешко", "baby"],
    };
    const matchesAudience = (card, audienceKey) => {
      if (!audienceKey) return true;
      const values = splitPipeValues(card.dataset.audience).map(normalizeSearchText);
      const terms = AUDIENCE_VALUE_TERMS[audienceKey] || [];
      if (values.length) {
        return values.includes("унисекс") || values.some((value) => terms.some((term) => value === term || value.includes(term)));
      }
      const publicSubcategory = normalizeSearchText(card.dataset.publicSubcategory || "");
      if (publicSubcategory.includes("унисекс")) return audienceKey === "woman" || audienceKey === "man";
      if (audienceKey === "woman" && publicSubcategory === "clothing women") return true;
      if (audienceKey === "man" && publicSubcategory === "clothing men") return true;
      return false;
    };
    const matchesMaximumPrice = (card, maximum) => {
      if (!Number.isFinite(maximum)) return true;
      const low = Number(card.dataset.priceMin);
      const high = Number(card.dataset.priceMax);
      const highestKnownPrice = Number.isFinite(high) && high > 0 ? high : low;
      return Number.isFinite(highestKnownPrice) && highestKnownPrice > 0 && highestKnownPrice <= maximum;
    };
    const categoryLabel = (key) => {
      const item = CATEGORIES.find((category) => category.key === key);
      return item ? (getCurrentLang() === "en" ? item.labelEn || item.label : item.label) : "";
    };
    const subcategoryLabel = (categoryKey, subcategoryKey) => {
      const item = CATEGORIES.find((category) => category.key === categoryKey)?.subcategories.find((subcategory) => subcategory.key === subcategoryKey);
      return item ? (getCurrentLang() === "en" ? item.labelEn || item.label : item.label) : "";
    };

    function renderActiveSelections() {
      if (!activeSelections) return;
      const chips = [];
      if (activeCategoryKey) chips.push({ key: "category", label: categoryLabel(activeCategoryKey) });
      if (activeSubcategoryKey) chips.push({ key: "subcategory", label: subcategoryLabel(activeCategoryKey, activeSubcategoryKey) });
      if (activeProductType) chips.push({ key: "productType", label: activeProductType });
      currentSearchIntent?.labels.forEach((label) => chips.push({ key: `intent:${label}`, label }));
      if (q.value.trim()) chips.push({ key: "search", label: `“${q.value.trim()}”` });
      if (selectedPriceRange !== "all") chips.push({ key: "price", label: selectedPriceRange === "0-25" ? "До €25" : selectedPriceRange === "100+" ? "€100+" : `€${selectedPriceRange}` });
      if (selectedDeliveryOutside) chips.push({ key: "delivery", label: "Доставка извън България" });
      selectedAttributes.forEach((label) => chips.push({ key: `attribute:${label}`, label }));
      selectedMaterials.forEach((label) => chips.push({ key: `material:${label}`, label }));
      selectedColors.forEach((label) => chips.push({ key: `color:${label}`, label }));
      selectedGiftFilters.forEach((value) => chips.push({ key: `gift:${value}`, label: value === "giftable:true" ? "Подарък" : value.split(":").slice(1).join(":") || "Подарък" }));
      activeSelections.innerHTML = "";
      chips.forEach(({ key, label }) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "active-selection";
        button.setAttribute("aria-label", `Премахни филтър: ${label}`);
        const labelNode = document.createElement("span");
        labelNode.className = "active-selection__label";
        labelNode.textContent = label;
        const removeNode = document.createElement("span");
        removeNode.className = "active-selection__remove";
        removeNode.setAttribute("aria-hidden", "true");
        removeNode.textContent = "×";
        button.append(labelNode, removeNode);
        button.addEventListener("click", () => clearSelection(key));
        activeSelections.appendChild(button);
      });
      if (chips.length > 1) {
        const clear = document.createElement("button");
        clear.type = "button";
        clear.className = "active-selection active-selection--clear";
        clear.textContent = "Изчисти всички";
        clear.addEventListener("click", clearAllSelections);
        activeSelections.appendChild(clear);
      }
      activeSelections.hidden = chips.length === 0;
    }

    function clearSelection(key) {
      window.bulgaritamTrack?.("remove_filter", { selected_value: key, filter_name: key.split(":")[0], filter_value: key.split(":").slice(1).join(":") || key, ...(window.__bulgaritamDiscoveryContext || {}) });
      if (key === "category") { activeCategoryKey = ""; activeSubcategoryKey = ""; activeProductType = ""; renderSubChips(null); renderTypeChips(); }
      else if (key === "subcategory") { activeSubcategoryKey = ""; activeProductType = ""; renderTypeChips(); }
      else if (key === "productType") activeProductType = "";
      else if (key === "search") q.value = "";
      else if (key.startsWith("intent:")) q.value = "";
      else if (key === "price") selectedPriceRange = "all";
      else if (key === "delivery") selectedDeliveryOutside = false;
      else if (key.startsWith("attribute:")) selectedAttributes = selectedAttributes.filter((value) => value !== key.slice(10));
      else if (key.startsWith("material:")) selectedMaterials = selectedMaterials.filter((value) => value !== key.slice(9));
      else if (key.startsWith("color:")) selectedColors = selectedColors.filter((value) => value !== key.slice(6));
      else if (key.startsWith("gift:")) selectedGiftFilters = selectedGiftFilters.filter((value) => value !== key.slice(5));
      applyDiscovery(q.value || "");
    }

    function clearAllSelections() {
      window.bulgaritamTrack?.("clear_filters", window.__bulgaritamDiscoveryContext || {});
      activeCategoryKey = ""; activeSubcategoryKey = ""; activeProductType = "";
      selectedPriceRange = "all"; selectedDeliveryOutside = false; selectedAttributes = []; selectedMaterials = []; selectedColors = []; selectedGiftFilters = []; q.value = "";
      renderSubChips(null); renderTypeChips(); syncFilterInputs(); syncOccasionInputs(); applyDiscovery("");
    }

    function applyDiscovery(value = q.value) {
      const v = value || "";
      currentSearchIntent = parseBulgarianShoppingIntent(v, { materials: catalogueMaterials });
      searchFallbackRequired = false;
      const categoryFilterKey = activeCategoryKey || "";
      const subcategoryFilterKey = activeSubcategoryKey || "";
      const filteredCards = [];

      const matchesManualFilters = (card) => {
        const attributes = splitPipeValues(card.dataset.attributes);
        const materials = splitPipeValues(card.dataset.materials);
        const colors = splitPipeValues(card.dataset.colors);
        const recipients = splitPipeValues(card.dataset.recipients);
        const giftOccasions = splitPipeValues(card.dataset.giftOccasions);
        const matchesCategory = !categoryFilterKey || card.dataset.publicCategory === categoryFilterKey;
        const matchesSubcategory = !subcategoryFilterKey || card.dataset.publicSubcategory === subcategoryFilterKey;
        const matchesProductType = !activeProductType || card.dataset.productType === activeProductType;
        const matchesAttributes = !selectedAttributes.length || selectedAttributes.every((entry) => attributes.includes(entry));
        const matchesMaterials = !selectedMaterials.length || selectedMaterials.some((entry) => materials.includes(entry));
        const matchesColors = !selectedColors.length || selectedColors.some((entry) => colors.includes(entry));
        const matchesGift = !selectedGiftFilters.length || (card.dataset.giftable === "1" && selectedGiftFilters.every((filter) => {
          const [kind, ...rest] = filter.split(":");
          const filterValue = rest.join(":");
          if (kind === "giftable") return true;
          if (kind === "recipient") return recipients.includes(filterValue);
          if (kind === "occasion") return giftOccasions.includes(filterValue);
          if (kind === "attribute") return attributes.includes(filterValue);
          return false;
        }));
        const matchesDelivery = !selectedDeliveryOutside || card.dataset.deliversAbroad === "1";
        return matchesCategory && matchesSubcategory && matchesProductType && matchesAttributes && matchesMaterials && matchesColors && matchesGift && matchesPriceRange(card, selectedPriceRange) && matchesDelivery;
      };

      const matchesIntent = (card) => {
        if (!currentSearchIntent) return true;
        const attributes = splitPipeValues(card.dataset.attributes);
        const recipients = splitPipeValues(card.dataset.recipients);
        const giftOccasions = splitPipeValues(card.dataset.giftOccasions);
        const materials = splitPipeValues(card.dataset.materials);
        if (currentSearchIntent.categoryKey && card.dataset.publicCategory !== currentSearchIntent.categoryKey) return false;
        if (currentSearchIntent.subcategoryKey && card.dataset.publicSubcategory !== currentSearchIntent.subcategoryKey) return false;
        if (currentSearchIntent.productType && card.dataset.productType !== currentSearchIntent.productType) return false;
        if (currentSearchIntent.giftable && card.dataset.giftable !== "1") return false;
        if (!currentSearchIntent.recipients.length && !matchesAudience(card, currentSearchIntent.audienceKey)) return false;
        if (currentSearchIntent.recipients.some((entry) => !recipients.includes(entry))) return false;
        if (currentSearchIntent.occasions.some((entry) => !giftOccasions.includes(entry))) return false;
        if (currentSearchIntent.attributes.some((entry) => !attributes.includes(entry))) return false;
        if (currentSearchIntent.materials.length && !currentSearchIntent.materials.some((entry) => materials.includes(entry))) return false;
        if (!matchesMaximumPrice(card, currentSearchIntent.maxPriceEur)) return false;
        return true;
      };

      const textQuery = currentSearchIntent ? currentSearchIntent.residualQuery : v;
      const searchQuery = buildSearchQuery(textQuery);
      allCards.forEach((card) => {
        if (matchesSearchDocument(card, searchQuery) && matchesIntent(card) && matchesManualFilters(card)) {
          filteredCards.push(card);
        }
      });

      if (currentSearchIntent && filteredCards.length === 0) {
        const fallbackQuery = normalizeSearchText(v).replace(/(^|\s)за(?=\s|$)/g, " ").replace(/\s+/g, " ").trim();
        allCards.forEach((card) => {
          const attributes = splitPipeValues(card.dataset.attributes);
          const recipients = splitPipeValues(card.dataset.recipients);
          const giftOccasions = splitPipeValues(card.dataset.giftOccasions);
          const materials = splitPipeValues(card.dataset.materials);
          const isCompatibleLegacyFallback =
            (!currentSearchIntent.categoryKey || card.dataset.publicCategory === currentSearchIntent.categoryKey) &&
            (!currentSearchIntent.subcategoryKey || card.dataset.publicSubcategory === currentSearchIntent.subcategoryKey) &&
            (!currentSearchIntent.productType || !card.dataset.productType || card.dataset.productType === currentSearchIntent.productType) &&
            (!currentSearchIntent.giftable || card.dataset.giftable === "1") &&
            (currentSearchIntent.recipients.length > 0 || matchesAudience(card, currentSearchIntent.audienceKey)) &&
            currentSearchIntent.recipients.every((entry) => !recipients.length || recipients.includes(entry)) &&
            currentSearchIntent.occasions.every((entry) => !giftOccasions.length || giftOccasions.includes(entry)) &&
            currentSearchIntent.attributes.every((entry) => !attributes.length || attributes.includes(entry)) &&
            (!currentSearchIntent.materials.length || currentSearchIntent.materials.some((entry) => materials.includes(entry))) &&
            matchesMaximumPrice(card, currentSearchIntent.maxPriceEur);
          if (isCompatibleLegacyFallback && matchesManualFilters(card) && matchesSearchDocument(card, fallbackQuery)) filteredCards.push(card);
        });
        searchFallbackRequired = filteredCards.length > 0;
      }

      matchedCards = v.trim() && selectedSort === "featured"
        ? sortCardsForSearch(filteredCards, searchQuery)
        : sortCards(filteredCards, selectedSort);
      const derivedListContext = currentSearchIntent?.giftable || currentSearchIntent?.recipients?.length || currentSearchIntent?.occasions?.length || selectedGiftFilters.length
        ? "gift_discovery"
        : v.trim()
          ? "search_results"
          : activeProductType
            ? "product_type"
            : activeSubcategoryKey
              ? "subcategory"
              : activeCategoryKey
                ? "category"
                : "homepage_default";
      window.__bulgaritamDiscoveryContext = {
        ...(executedSearchContext && executedSearchContext.search_term === v.trim() ? executedSearchContext : {}),
        query: v.trim(),
        search_term: v.trim(),
        normalized_query: normalizeSearchText(v),
        structured_intent: currentSearchIntent?.labels?.join(" > ") || "",
        used_fallback: searchFallbackRequired ? "1" : "0",
        category: currentSearchIntent?.categoryKey || activeCategoryKey || "",
        subcategory: currentSearchIntent?.subcategoryKey || activeSubcategoryKey || "",
        product_type: currentSearchIntent?.productType || activeProductType || "",
        gift_recipient: currentSearchIntent?.recipients?.join(",") || selectedGiftFilters.filter((entry) => entry.startsWith("recipient:")).map((entry) => entry.slice(10)).join(","),
        gift_occasion: currentSearchIntent?.occasions?.join(",") || selectedGiftFilters.filter((entry) => entry.startsWith("occasion:")).map((entry) => entry.slice(9)).join(","),
        audience: currentSearchIntent?.audienceKey || "",
        materials: currentSearchIntent?.materials?.join(",") || selectedMaterials.join(","),
        max_price_eur: currentSearchIntent?.maxPriceEur ?? "",
        active_filters: [...selectedAttributes, ...selectedMaterials, ...selectedColors, selectedPriceRange !== "all" ? selectedPriceRange : "", selectedDeliveryOutside ? "delivery_abroad" : ""].filter(Boolean).join(","),
        list_context: derivedListContext,
        list_name: "Начална discovery мрежа",
      };
      matchedCards.forEach((card, position) => {
        card.dataset.listContext = derivedListContext;
        card.dataset.position = String(position + 1);
      });
      window.bulgaritamCommitDiscoveryState?.({
        surface_type: derivedListContext,
        search_id: executedSearchContext?.search_term === v.trim() ? executedSearchContext.search_id : null,
        query: v.trim(),
        category: currentSearchIntent?.categoryKey || activeCategoryKey || null,
        subcategory: currentSearchIntent?.subcategoryKey || activeSubcategoryKey || null,
        product_type: currentSearchIntent?.productType || activeProductType || null,
        sort_value: selectedSort || "featured",
        price_min_eur: selectedPriceRange.includes("-") ? Number(selectedPriceRange.split("-")[0]) : selectedPriceRange === "100+" ? 100 : null,
        price_max_eur: selectedPriceRange.includes("-") ? Number(selectedPriceRange.split("-")[1]) : null,
        gift_recipient: currentSearchIntent?.recipients?.join(",") || selectedGiftFilters.filter((entry) => entry.startsWith("recipient:")).map((entry) => entry.slice(10)).join(",") || null,
        gift_occasion: currentSearchIntent?.occasions?.join(",") || selectedGiftFilters.filter((entry) => entry.startsWith("occasion:")).map((entry) => entry.slice(9)).join(",") || null,
        active_filters: {
          attributes: selectedAttributes, materials: selectedMaterials, colors: selectedColors,
          price_range: selectedPriceRange, delivery_abroad: selectedDeliveryOutside,
          gift: selectedGiftFilters,
        },
        metadata: { list_name: "Начална discovery мрежа", used_fallback: searchFallbackRequired },
      }, matchedCards.map((card) => ({ node: card, entity_type: "product", product_id: card.dataset.productId || "", brand_id: card.dataset.brandId || "" })));
      const isUnfilteredCatalogue = !v.trim() && !activeCategoryKey && !activeSubcategoryKey && !activeProductType && selectedPriceRange === "all" && !selectedDeliveryOutside && !selectedGiftFilters.length && !selectedAttributes.length && !selectedMaterials.length && !selectedColors.length;
      count.textContent = String(isUnfilteredCatalogue && loadedThroughPage < totalStaticPages ? totalCatalogueItems : matchedCards.length);
      const contextParts = [];
      if (activeCategoryKey) contextParts.push(categoryLabel(activeCategoryKey));
      if (activeSubcategoryKey) contextParts.push(subcategoryLabel(activeCategoryKey, activeSubcategoryKey));
      if (activeProductType) contextParts.push(activeProductType);
      const context = contextParts.filter(Boolean).join(" › ");
      const searchContext = v.trim() ? `${getCurrentLang() === "en" ? "Results for:" : "Резултати за:"} “${value.trim()}”` : "";
      hint.textContent = [context, searchContext].filter(Boolean).join(" · ");
      if (intentStatus) {
        const cardsInIntentContext = currentSearchIntent ? allCards.filter((card) =>
          (!currentSearchIntent.categoryKey || card.dataset.publicCategory === currentSearchIntent.categoryKey) &&
          (!currentSearchIntent.subcategoryKey || card.dataset.publicSubcategory === currentSearchIntent.subcategoryKey)
        ) : allCards;
        const missingStructuredFacet = Boolean(currentSearchIntent && (
          (currentSearchIntent.productType && !cardsInIntentContext.some((card) => card.dataset.productType === currentSearchIntent.productType)) ||
          currentSearchIntent.recipients.some((entry) => !allCards.some((card) => splitPipeValues(card.dataset.recipients).includes(entry))) ||
          currentSearchIntent.occasions.some((entry) => !allCards.some((card) => splitPipeValues(card.dataset.giftOccasions).includes(entry))) ||
          currentSearchIntent.attributes.some((entry) => !allCards.some((card) => splitPipeValues(card.dataset.attributes).includes(entry)))
        ));
        if (searchFallbackRequired) {
          intentStatus.textContent = "Показваме текстови съвпадения, защото част от структурираната класификация в каталога липсва.";
          intentStatus.hidden = false;
        } else if (currentSearchIntent && !filteredCards.length && missingStructuredFacet) {
          intentStatus.textContent = "Разпознахме търсенето, но каталогът още няма попълнена структурирана класификация за този тип или повод.";
          intentStatus.hidden = false;
        } else if (currentSearchIntent && !filteredCards.length) {
          intentStatus.textContent = "Няма продукти, които отговарят на избраната комбинация.";
          intentStatus.hidden = false;
        } else {
          intentStatus.hidden = true;
          intentStatus.textContent = "";
        }
      }
      visibleCount = v.trim()
        ? Math.min(matchedCards.length, Math.max(getBatchSize() * 2, 24))
        : getBatchSize();
      updateFeedVisibility();
      updateUsefulResultSignals();
      updateActiveChips();
      updateFiltersBadge();
      updateOccasionBadge();
      renderActiveSelections();
      if (!v && !activeCategoryKey) {
        subChips.hidden = true;
        if (subChipsLabel) subChipsLabel.hidden = true;
        subChips.innerHTML = "";
        if (typeChips) { typeChips.hidden = true; typeChips.innerHTML = ""; }
        if (typeChipsLabel) typeChipsLabel.hidden = true;
      }

      if (!v && !activeCategoryKey) {
        activeSubcategoryKey = "";
      }
    }

    function renderMainChips() {
      mainChips.innerHTML = "";

      CATEGORIES.forEach((cat) => {
        const b = document.createElement("button");
        b.className = "chip";
        b.type = "button";
        const categoryText = getCurrentLang() === "en"
          ? (cat.chipLabelEn || cat.labelEn || cat.chipLabel || cat.label)
          : (cat.chipLabel || cat.label);
        b.textContent = `${cat.emoji || ""} ${categoryText}`.trim();
        b.dataset.categoryKey = cat.key;

        b.addEventListener("click", () => {
          window.bulgaritamTrack?.("select_category", {
            selected_value: cat.label,
            filter_name: "category",
            filter_value: cat.key,
            category: cat.key,
            source_context: "homepage_discovery",
          });
          selectCategory(cat);
        });

        mainChips.appendChild(b);
      });
    }

    function renderSubChips(cat) {
      if (!cat) {
        if (subChipsLabel) subChipsLabel.hidden = true;
        subChips.hidden = true;
        subChips.innerHTML = "";
        return;
      }
      subChips.innerHTML = "";

      const availableSubcategories = cat.subcategories.filter((subcategory) =>
        allCards.some((card) => card.dataset.publicCategory === cat.key && card.dataset.publicSubcategory === subcategory.key)
      );
      if (subChipsLabel) subChipsLabel.hidden = availableSubcategories.length === 0;
      subChips.hidden = availableSubcategories.length === 0;
      availableSubcategories.forEach((s) => {
        const b = document.createElement("button");
        b.className = "chip chip-sub";
        b.type = "button";
        b.textContent = getCurrentLang() === "en" ? (s.labelEn || s.label) : s.label;
        b.dataset.subcategoryKey = s.key;

        b.addEventListener("click", () => {
          window.bulgaritamTrack?.("select_subcategory", {
            selected_value: s.label,
            filter_name: "subcategory",
            filter_value: s.key,
            category: cat.key,
            subcategory: s.key,
            source_context: "homepage_discovery",
          });
          activeCategoryKey = cat.key;
          activeSubcategoryKey = s.key;
          activeProductType = "";
          selectedMaterials = [];
          selectedColors = [];
          removeStructuredTermsFromSearch();
          renderTypeChips();
          applyDiscovery(q.value || "");
          pulseResults();
          gentlyRevealTaxonomy(typeChipsLabel?.hidden ? taxonomyResultsCue : typeChipsLabel);
        });

        subChips.appendChild(b);
      });
    }

    const gentlyRevealTaxonomy = (node) => {
      if (!node || window.innerWidth > 768) return;
      window.requestAnimationFrame(() => node.scrollIntoView({ behavior: "smooth", block: "center" }));
    };

    function renderTypeChips() {
      if (!typeChips || !typeChipsLabel || !activeSubcategoryKey) {
        if (typeChips) { typeChips.hidden = true; typeChips.innerHTML = ""; }
        if (typeChipsLabel) typeChipsLabel.hidden = true;
        if (taxonomyResultsCue) taxonomyResultsCue.hidden = !activeCategoryKey;
        return;
      }
      const counts = new Map();
      const allowedTypes = new Set(
        CATEGORIES.find((category) => category.key === activeCategoryKey)
          ?.subcategories.find((subcategory) => subcategory.key === activeSubcategoryKey)
          ?.productTypes || []
      );
      allCards
        .filter((card) => card.dataset.publicCategory === activeCategoryKey && card.dataset.publicSubcategory === activeSubcategoryKey)
        .forEach((card) => {
          const value = card.dataset.productType || "";
          if (value && allowedTypes.has(value)) counts.set(value, (counts.get(value) || 0) + 1);
        });
      const types = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "bg"));
      typeChips.innerHTML = "";
      types.forEach(([value, productCount]) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "chip chip-type";
        button.dataset.productType = value;
        button.textContent = `${value} (${productCount})`;
        button.addEventListener("click", () => {
          const isApplyingProductType = activeProductType !== value;
          activeProductType = isApplyingProductType ? value : "";
          selectedMaterials = [];
          selectedColors = [];
          removeStructuredTermsFromSearch();
          window.bulgaritamTrack?.("select_product_type", { selected_value: value, filter_name: "product_type", filter_value: value, ...(window.__bulgaritamDiscoveryContext || {}) });
          applyDiscovery(q.value || "");
          pulseResults();
          if (isApplyingProductType) focusResults();
        });
        typeChips.appendChild(button);
      });
      typeChips.hidden = types.length === 0;
      typeChipsLabel.hidden = types.length === 0;
      if (taxonomyResultsCue) taxonomyResultsCue.hidden = !activeCategoryKey;
    }

    function syncDiscoveryModalState() {
      const isOpen = Boolean(
        (filtersModal && !filtersModal.hasAttribute("hidden")) ||
        (occasionModal && !occasionModal.hasAttribute("hidden"))
      );
      document.documentElement.classList.toggle("discovery-modal-open", isOpen);
      document.documentElement.classList.toggle("no-scroll", isOpen);
    }

    function updateDynamicFilterOptions() {
      const modalAttributes = Array.from(filtersModal?.querySelectorAll('input[name="attributeFilter"]:checked') || []).map((input) => input.value);
      const modalMaterials = Array.from(filtersModal?.querySelectorAll('input[name="materialFilter"]:checked') || []).map((input) => input.value);
      const modalColors = Array.from(filtersModal?.querySelectorAll('input[name="colorFilter"]:checked') || []).map((input) => input.value);
      const modalPrice = filtersModal?.querySelector('input[name="priceFilter"]:checked')?.value || selectedPriceRange;
      const modalDelivery = Boolean(filtersModal?.querySelector('#deliveryOutsideHome')?.checked);
      const modalGiftFilters = Array.from(occasionModal?.querySelectorAll('input[name="giftFilter"]:checked') || []).map((input) => input.value);
      const modalGiftPrice = occasionModal?.querySelector('input[name="giftPriceFilter"]:checked')?.value || selectedPriceRange;
      const groups = [
        { root: filtersModal, name: "price", selected: [modalPrice], values: (card) => ["all", "0-25", "25-50", "50-100", "100+"].filter((range) => matchesPriceRange(card, range)) },
        { root: filtersModal, name: "attribute", selected: modalAttributes, values: (card) => splitPipeValues(card.dataset.attributes) },
        { root: filtersModal, name: "material", selected: modalMaterials, values: (card) => splitPipeValues(card.dataset.materials) },
        { root: filtersModal, name: "color", selected: modalColors, values: (card) => splitPipeValues(card.dataset.colors) },
        { root: occasionModal, name: "recipient", selected: modalGiftFilters.filter((v) => v.startsWith("recipient:")), values: (card) => splitPipeValues(card.dataset.recipients).map((v) => `recipient:${v}`) },
        { root: occasionModal, name: "occasion", selected: modalGiftFilters.filter((v) => v.startsWith("occasion:")), values: (card) => splitPipeValues(card.dataset.giftOccasions).map((v) => `occasion:${v}`) },
        { root: occasionModal, name: "giftAttribute", selected: modalGiftFilters.filter((v) => v.startsWith("attribute:")), values: (card) => splitPipeValues(card.dataset.attributes).map((v) => `attribute:${v}`) },
        { root: occasionModal, name: "giftPrice", selected: [modalGiftPrice], values: (card) => ["all", "0-25", "25-50", "50-100", "100+"].filter((range) => matchesPriceRange(card, range)) },
      ];
      const matchesPending = (card, omitted) => {
        const attributes = splitPipeValues(card.dataset.attributes);
        const materials = splitPipeValues(card.dataset.materials);
        const colors = splitPipeValues(card.dataset.colors);
        const recipients = splitPipeValues(card.dataset.recipients);
        const occasions = splitPipeValues(card.dataset.giftOccasions);
        const giftMatch = modalGiftFilters.every((filter) => {
          const [kind, ...rest] = filter.split(":"); const value = rest.join(":");
          if (omitted === kind || (omitted === "giftAttribute" && kind === "attribute")) return true;
          return kind === "recipient" ? recipients.includes(value) : kind === "occasion" ? occasions.includes(value) : kind === "attribute" ? attributes.includes(value) : true;
        });
        return (!activeCategoryKey || card.dataset.publicCategory === activeCategoryKey) &&
          (!activeSubcategoryKey || card.dataset.publicSubcategory === activeSubcategoryKey) &&
          (!activeProductType || card.dataset.productType === activeProductType) &&
          (omitted === "attribute" || !modalAttributes.length || modalAttributes.every((v) => attributes.includes(v))) &&
          (omitted === "material" || !modalMaterials.length || modalMaterials.some((v) => materials.includes(v))) &&
          (omitted === "color" || !modalColors.length || modalColors.some((v) => colors.includes(v))) &&
          giftMatch && (omitted === "price" || matchesPriceRange(card, modalPrice)) &&
          (omitted === "giftPrice" || matchesPriceRange(card, modalGiftPrice)) &&
          (!modalDelivery || card.dataset.deliversAbroad === "1");
      };
      groups.forEach(({ root, name, selected, values }) => {
        const group = root?.querySelector(`[data-dynamic-filter-group="${name}"]`);
        if (!group) return;
        const candidates = allCards.filter((card) => matchesPending(card, name));
        const counts = new Map();
        candidates.forEach((card) => values(card).forEach((value) => counts.set(value, (counts.get(value) || 0) + 1)));
        let available = 0;
        group.querySelectorAll("[data-dynamic-filter-option]").forEach((option) => {
          const input = option.querySelector("input");
          const count = counts.get(input.value) || 0;
          const isSelected = input.checked || selected.includes(input.value);
          option.hidden = count === 0 && !isSelected;
          input.disabled = count === 0 && !isSelected;
          const label = option.querySelector("[data-filter-label]");
          if (label) label.textContent = `${label.dataset.filterLabel} (${count})`;
          if (count > 0) available += 1;
        });
        group.hidden = !["price", "giftPrice"].includes(name) && available === 0 && selected.length === 0;
      });
      updateCollapsibleOptions();
    }

    function updateCollapsibleOptions() {
      document.querySelectorAll("[data-collapsible-options]").forEach((container) => {
        const options = Array.from(container.querySelectorAll("[data-dynamic-filter-option]")).filter((option) => !option.hidden);
        let button = container.parentElement?.querySelector(":scope > .filter-options-more");
        if (options.length <= 8) { options.forEach((option) => option.classList.remove("is-overflow-option")); button?.remove(); return; }
        if (!button) { button = document.createElement("button"); button.type = "button"; button.className = "filter-options-more"; container.insertAdjacentElement("afterend", button); }
        const expanded = button.getAttribute("aria-expanded") === "true";
        options.forEach((option, index) => option.classList.toggle("is-overflow-option", !expanded && index >= 8 && !option.querySelector("input")?.checked));
        button.textContent = expanded ? "Покажи по-малко" : `Покажи още (${options.length - 8})`;
        button.setAttribute("aria-expanded", String(expanded));
        button.onclick = () => { button.setAttribute("aria-expanded", String(!expanded)); updateCollapsibleOptions(); };
      });
    }

    function openFilters() {
      if (!filtersModal) return;
      syncFilterInputs();
      updateDynamicFilterOptions();
      filtersModal.removeAttribute("hidden");
      filtersToggle?.setAttribute("aria-expanded", "true");
      syncDiscoveryModalState();
    }

    function closeFilters() {
      if (!filtersModal) return;
      filtersModal.setAttribute("hidden", "");
      filtersToggle?.setAttribute("aria-expanded", "false");
      syncDiscoveryModalState();
    }

    function syncOccasionInputs() {
      occasionModal?.querySelectorAll('input[name="giftFilter"]').forEach((input) => {
        input.checked = selectedGiftFilters.includes(input.value);
      });
      const giftPriceInput = occasionModal?.querySelector(`input[name="giftPriceFilter"][value="${selectedPriceRange}"]`) || occasionModal?.querySelector('input[name="giftPriceFilter"][value="all"]');
      if (giftPriceInput) giftPriceInput.checked = true;
    }

    function syncFilterInputs() {
      filtersModal?.querySelectorAll('input[name="attributeFilter"]').forEach((input) => {
        input.checked = selectedAttributes.includes(input.value);
      });
      filtersModal?.querySelectorAll('input[name="materialFilter"]').forEach((input) => { input.checked = selectedMaterials.includes(input.value); });
      filtersModal?.querySelectorAll('input[name="colorFilter"]').forEach((input) => { input.checked = selectedColors.includes(input.value); });
      const priceInput = filtersModal?.querySelector(`input[name="priceFilter"][value="${selectedPriceRange}"]`);
      if (priceInput) priceInput.checked = true;
      const deliveryInput = document.getElementById("deliveryOutsideHome");
      if (deliveryInput) deliveryInput.checked = selectedDeliveryOutside;
    }

    async function openOccasions() {
      if (!occasionModal) return;
      await ensureAllStaticPages();
      syncOccasionInputs();
      updateDynamicFilterOptions();
      occasionModal.removeAttribute("hidden");
      occasionToggle?.setAttribute("aria-expanded", "true");
      syncDiscoveryModalState();
    }

    function closeOccasions() {
      if (!occasionModal) return;
      occasionModal.setAttribute("hidden", "");
      occasionToggle?.setAttribute("aria-expanded", "false");
      syncDiscoveryModalState();
    }

    async function selectCategory(category, sourceContext = "homepage_discovery") {
      await ensureAllStaticPages();
      removeStructuredTermsFromSearch();
      activeCategoryKey = category.key;
      activeSubcategoryKey = "";
      activeProductType = "";
      selectedMaterials = [];
      selectedColors = [];
      renderSubChips(category);
      renderTypeChips();
      applyDiscovery(q.value || "");
      gentlyRevealTaxonomy(subChipsLabel?.hidden ? taxonomyResultsCue : subChipsLabel);
      if (sourceContext !== "homepage_discovery") {
        window.bulgaritamTrack?.("select_category", {
          selected_value: category.label,
          filter_name: "category",
          filter_value: category.key,
          category: category.key,
          source_context: sourceContext,
        });
      }
    }

    // Initial setup
    renderMainChips();
    updateFiltersBadge();
    updateOccasionBadge();
    taxonomyResultsCue?.addEventListener("click", () => focusResults());
    window.addEventListener("bulgaritam:lang", () => {
      renderMainChips();
      const activeCategory = CATEGORIES.find((cat) => cat.key === activeCategoryKey);
      if (activeCategoryKey && activeCategory) {
        renderSubChips(activeCategory);
      }
      renderTypeChips();
      applyDiscovery(q.value || "");
    });

    // Existing listeners
    const executeHomeSearch = async ({ scrollToResults = false } = {}) => {
      if ((q.value || "").trim()) await ensureAllStaticPages();
      const value = q.value || "";
      if (value.trim()) {
        const searchId = globalThis.crypto?.randomUUID?.() || `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
        executedSearchContext = { search_id: searchId, search_term: String(value).trim() };
        activeCategoryKey = "";
        activeSubcategoryKey = "";
        activeProductType = "";
        selfChoices?.setAttribute("hidden", "");
        selfToggle?.setAttribute("aria-expanded", "false");
        renderMainChips();
        renderSubChips(null);
        renderTypeChips();
      } else {
        executedSearchContext = null;
      }
      applyDiscovery(value);
      scheduleSearchTracking(value, executedSearchContext?.search_id || "");
      updateUsefulResultSignals();
      if (value.trim()) {
        pulseResults();
        if (scrollToResults) focusResults();
      }
    };

    q.addEventListener("input", (e) => {
      if (!(e.target.value || "").trim()) applyDiscovery("");
    });

    q.addEventListener("search", (e) => {
      if (!(e.target.value || "").trim()) applyDiscovery("");
    });
    q.addEventListener("keydown", (event) => {
      if (event.key !== "Enter") return;
      event.preventDefault();
      executeHomeSearch({ scrollToResults: true });
    });
    searchForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      executeHomeSearch({ scrollToResults: true });
    });
    document.querySelectorAll("[data-discovery-category]").forEach((shortcut) => {
      shortcut.addEventListener("click", () => {
        const categoryKey = shortcut.dataset.discoveryCategory || "";
        const category = CATEGORIES.find((entry) => entry.key === categoryKey);
        if (!category) return;
        q.value = "";
        selectCategory(category, "discovery_shortcut");
      });
    });
    const selfToggle = document.querySelector("[data-discovery-self]");
    const selfChoices = document.getElementById("selfCategoryChoices");
    selfToggle?.addEventListener("click", () => {
      const willOpen = selfChoices?.hasAttribute("hidden");
      selfChoices?.toggleAttribute("hidden", !willOpen);
      selfToggle.setAttribute("aria-expanded", willOpen ? "true" : "false");
    });
    selfChoices?.querySelectorAll("[data-self-category]").forEach((choice) => {
      choice.addEventListener("click", () => {
        const category = CATEGORIES.find((entry) => entry.key === choice.dataset.selfCategory);
        if (!category) return;
        q.value = "";
        selfChoices.setAttribute("hidden", "");
        selfToggle?.setAttribute("aria-expanded", "false");
        selectCategory(category, "self_discovery");
      });
    });
    document.querySelector("[data-discovery-gift]")?.addEventListener("click", async () => {
      await openOccasions();
      window.bulgaritamTrack?.("open_gift_discovery", { source_context: "discovery_shortcut" });
    });
    document.querySelector("[data-discovery-surprise]")?.addEventListener("click", () => {
      const candidates = matchedCards.length ? matchedCards : allCards;
      const selected = candidates[Math.floor(Math.random() * candidates.length)];
      const link = selected?.querySelector("a.card-titlelink, a.card-imglink");
      if (!link) return;
      window.bulgaritamTrack?.("surprise_me", {
        product_id: selected.dataset.productId,
        product_slug: selected.dataset.productSlug,
        brand_id: selected.dataset.brandId,
        brand_slug: selected.dataset.brandSlug,
        source_context: "discovery_shortcut",
      });
      window.location.assign(link.href);
    });
    const initialQuery = new URLSearchParams(window.location.search).get("q")?.trim() || "";
    if (requestedSort) await ensureAllStaticPages();
    if (initialQuery) {
      q.value = initialQuery;
      await executeHomeSearch({ scrollToResults: window.bulgaritamConsumeExplicitSearchScroll?.() === true });
    } else applyDiscovery("");
    sortSelect?.addEventListener("change", async (e) => {
      await ensureAllStaticPages();
      selectedSort = e.target.value || "featured";
      applyDiscovery(q.value);
      window.bulgaritamTrack?.("change_sort", {
        selected_value: selectedSort,
        ...(window.__bulgaritamDiscoveryContext || {}),
      });
      pulseResults();
    });

    occasionToggle?.addEventListener("click", () => { void openOccasions(); });
    filtersModal?.addEventListener("change", (event) => {
      if (event.target.matches("input")) updateDynamicFilterOptions();
    });
    occasionModal?.addEventListener("change", (event) => {
      if (event.target.matches("input")) updateDynamicFilterOptions();
    });
    occasionModal?.addEventListener("click", (e) => {
      if (e.target.closest("[data-occasion-close]")) closeOccasions();
    });

    occasionApply?.addEventListener("click", async () => {
      await ensureAllStaticPages();
      selectedGiftFilters = Array.from(
        occasionModal?.querySelectorAll('input[name="giftFilter"]:checked') || []
      ).map((input) => input.value);
      selectedGiftFilters.unshift("giftable:true");
      selectedPriceRange = occasionModal?.querySelector('input[name="giftPriceFilter"]:checked')?.value || "all";
      window.bulgaritamTrack?.("apply_filter", {
        selected_value: selectedPriceRange,
        filter_name: "gift_budget",
        filter_value: selectedPriceRange,
        price_range: selectedPriceRange,
        source_context: "gift_discovery",
        ...(window.__bulgaritamDiscoveryContext || {}),
      });
      selectedGiftFilters.forEach((filter) => {
        const [kind, ...parts] = filter.split(":");
        const selectedValue = parts.join(":");
        window.bulgaritamTrack?.(kind === "recipient" ? "select_gift_recipient" : kind === "occasion" ? "select_gift_occasion" : "apply_filter", {
          selected_value: selectedValue || filter,
          filter_name: kind,
          filter_value: selectedValue || filter,
          ...(window.__bulgaritamDiscoveryContext || {}),
        });
      });
      closeOccasions();
      applyDiscovery(q.value);
      pulseResults();
      focusResults({ smooth: true });
    });

    occasionReset?.addEventListener("click", () => {
      window.bulgaritamTrack?.("clear_filters", {
        filter_name: "gift_filters",
        source_context: "gift_discovery",
        ...(window.__bulgaritamDiscoveryContext || {}),
      });
      selectedGiftFilters = [];
      selectedPriceRange = "all";
      syncOccasionInputs();
      closeOccasions();
      applyDiscovery(q.value);
      pulseResults();
    });

    filtersToggle?.addEventListener("click", openFilters);
    filtersModal?.addEventListener("click", (e) => {
      if (e.target.closest("[data-filters-close]")) closeFilters();
    });

    filtersApply?.addEventListener("click", async () => {
      await ensureAllStaticPages();
      const checked = filtersModal?.querySelector('input[name="priceFilter"]:checked');
      selectedPriceRange = checked?.value || "all";
      selectedDeliveryOutside = Boolean(document.getElementById("deliveryOutsideHome")?.checked);
      selectedAttributes = Array.from(filtersModal?.querySelectorAll('input[name="attributeFilter"]:checked') || []).map((input) => input.value);
      selectedMaterials = Array.from(filtersModal?.querySelectorAll('input[name="materialFilter"]:checked') || []).map((input) => input.value);
      selectedColors = Array.from(filtersModal?.querySelectorAll('input[name="colorFilter"]:checked') || []).map((input) => input.value);
      closeFilters();
      applyDiscovery(q.value);
      window.bulgaritamTrack?.("apply_filter", {
        filter_name: "product_constraints",
        filter_value: [selectedPriceRange, selectedDeliveryOutside ? "delivery_abroad" : "", ...selectedAttributes, ...selectedMaterials, ...selectedColors].filter(Boolean).join(","),
        price_range: selectedPriceRange,
        delivers_outside_bulgaria: selectedDeliveryOutside,
        attributes: selectedAttributes,
        materials: selectedMaterials,
        colors: selectedColors,
        result_count: matchedCards.length,
        ...(window.__bulgaritamDiscoveryContext || {}),
      });
      pulseResults();
    });

    filtersReset?.addEventListener("click", () => {
      window.bulgaritamTrack?.("clear_filters", {
        filter_name: "product_constraints",
        source_context: "homepage_discovery",
        ...(window.__bulgaritamDiscoveryContext || {}),
      });
      selectedPriceRange = "all";
      selectedDeliveryOutside = false;
      selectedAttributes = [];
      selectedMaterials = [];
      selectedColors = [];
      const first = filtersModal?.querySelector('input[name="priceFilter"][value="all"]');
      if (first) first.checked = true;
      const deliveryCheckbox = document.getElementById("deliveryOutsideHome");
      if (deliveryCheckbox) deliveryCheckbox.checked = false;
      filtersModal?.querySelectorAll('input[name="attributeFilter"]').forEach((input) => { input.checked = false; });
      filtersModal?.querySelectorAll('input[name="materialFilter"], input[name="colorFilter"]').forEach((input) => { input.checked = false; });
      closeFilters();
      applyDiscovery(q.value);
      pulseResults();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      if (filtersModal && !filtersModal.hasAttribute("hidden")) closeFilters();
      if (occasionModal && !occasionModal.hasAttribute("hidden")) closeOccasions();
    });

    feedLoadMore?.addEventListener("click", loadMore);

    if ("IntersectionObserver" in window && feedSentinel) {
      feedObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) loadMore();
        });
      }, {
        // The site shell scrolls body (height: 100%; overflow-x: hidden).
        // Use that scrollport so its clipping does not cancel rootMargin.
        root: /auto|scroll/.test(getComputedStyle(document.body).overflowY) && document.body.scrollHeight > document.body.clientHeight ? document.body : null,
        rootMargin: "900px 0px",
      });

      if (matchedCards.length > visibleCount || loadedThroughPage < totalStaticPages) feedObserver.observe(feedSentinel);
    } else if (feedLoadMore && matchedCards.length > visibleCount) {
      feedLoadMore.hidden = false;
    }

    window.addEventListener("resize", () => {
      const minimumVisible = Math.max(visibleCount, getBatchSize());
      visibleCount = minimumVisible;
      updateFeedVisibility();
    });
    }
    initializeHomepage();
  </script>
</BaseLayout>
