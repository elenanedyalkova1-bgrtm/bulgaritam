---
import SeoProductLanding from "../../components/SeoProductLanding.astro";
import { getCategoryLanding, getProductsForLanding, getLandingPageHierarchy } from "../../lib/seo-landings";
import { loadProducts } from "../../lib/products";

const allProducts = await loadProducts();
const landing = getCategoryLanding("gifts");

if (!landing) {
  throw new Error("Missing gifts landing");
}

const seoLanding = {
  ...landing,
  h1: "Идеи за подарък",
  title: "Идеи за подарък от български брандове | Българитъм",
  description: "Открий идеи за подарък от български брандове за жена, мъж, дете, бебе и специални поводи.",
  intro: [
    "Открий идеи за подарък от локални марки, подредени така, че да стигаш по-лесно до точния жест за точния човек.",
    "Разгледай български подаръци по получател, повод и начин на изработка."
  ],
};

const products = getProductsForLanding(allProducts, landing);
const hierarchy = getLandingPageHierarchy(landing, allProducts);
const giftPills = [...hierarchy.primaryPills, ...hierarchy.secondaryPills];
const mobileMainPillOrder = ["За жена", "За мъж", "За дете", "За бебе", "За сватба", "Ръчно изработени"];
const primaryPills = giftPills
  .map((entry) => ({ ...entry, isMobilePrimary: mobileMainPillOrder.includes(entry.label) }))
  .sort((a, b) => {
    const aIndex = mobileMainPillOrder.indexOf(a.label);
    const bIndex = mobileMainPillOrder.indexOf(b.label);
    if (aIndex === -1 && bIndex === -1) return 0;
    if (aIndex === -1) return 1;
    if (bIndex === -1) return -1;
    return aIndex - bIndex;
  });
---

<SeoProductLanding
  landing={seoLanding}
  products={products}
  browseProducts={allProducts}
  canonicalPath="/bulgarski-podaratsi/"
  breadcrumbs={hierarchy.breadcrumbs}
  primaryPills={primaryPills}
  parentLink={hierarchy.parentLink}
/>
