---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomepageProductCard from "../../components/HomepageProductCard.astro";
import { loadConsumerDeals, type ConsumerDeal } from "../../lib/weekly-discounts";
import { CONSUMER_DEALS_ENDPOINT } from "../../lib/consumer-deals-client.mjs";
import { DEAL_CATEGORY_ORDER } from "../../lib/deal-facets.mjs";

const env = (import.meta as ImportMeta & { env?: Record<string, string | undefined> }).env || process.env;
const dynamicDealsEndpoint = String(env.PUBLIC_DYNAMIC_DEALS_ENDPOINT || CONSUMER_DEALS_ENDPOINT).trim();
if (dynamicDealsEndpoint !== CONSUMER_DEALS_ENDPOINT) throw new Error("Unexpected consumer deals endpoint");
let deals: ConsumerDeal[] = [];
try { deals = (await loadConsumerDeals(new Date())).deals; }
catch { console.warn("Consumer deals static references unavailable; live loader remains enabled"); }
// Used only inside an inert template; it never represents a real offer.
const templateDeal = { entity_type: "observed_product", entity_id: "template", title: "", brand: "",
  image_url: "/favicon.svg", destination_type: "external", destination_url: "https://bulgaritam.bg/namaleniya/",
  outbound_url: "https://bulgaritam.bg/namaleniya/", materials: [], ingredients: [] } as unknown as ConsumerDeal;
const brands = [...new Map(deals.map((deal) => [String(deal.brand_id), { id: String(deal.brand_id), name: deal.brand }])).values()].sort((a, b) => a.name.localeCompare(b.name, "bg"));
const categories = DEAL_CATEGORY_ORDER.filter((category) => deals.some((deal) => deal.deal_category === category));
const materials = [...new Set(deals.flatMap((deal) => deal.materials).filter(Boolean))].sort((a, b) => a.localeCompare(b, "bg"));
const ingredients = [...new Set(deals.flatMap((deal) => deal.ingredients).filter(Boolean))].sort((a, b) => a.localeCompare(b, "bg"));
const title = "Намаления от български брандове тази седмица | Българитъм";
const description = "Активни намаления от проверени български брандове, чиито публични продуктови цени Българитъм периодично проверява.";
---
<BaseLayout newsletterContext="discounts" title={title} description={description} canonical="https://bulgaritam.bg/namaleniya/" seo={{ type: "category", data: { category: "Намаления от български брандове", description } }}>
<main class="page-shell deals-page">
  <header class="page-head deals-head"><p class="page-kicker">Проверени продуктови намаления</p><h1 class="page-title">Намаления от български брандове</h1><p class="page-intro">Следим цените на продукти от проверени български брандове и събираме активните им намаления на едно място.</p><details class="method"><summary>Как проверяваме намаленията?</summary><p>Наблюдаваме публично достъпните продуктови цени и показваме само надеждно установени активни намаления, проверени през последните 72 часа. Покупката винаги се извършва директно в сайта на съответния бранд.</p></details></header>
  <p id="dealsStatus" role="status" aria-live="polite">За актуалните намаления е необходима проверка в реално време.</p>
  <button id="dealsRetry" type="button" hidden>Опитай отново</button>
  <noscript><p>Включете JavaScript, за да заредите актуално проверените намаления. Връзките по-долу са достъпни и без него.</p></noscript>
  <section id="dealsLive" aria-labelledby="resultsTitle" hidden>
    <div class="search search--home"><label class="search-label" for="dealSearch">Търси в намаленията</label><form class="search-row" id="dealSearchForm" role="search"><input id="dealSearch" class="search-input" type="search" placeholder="Търси продукт или бранд" autocomplete="off"/><button class="search-submit" type="submit">Търси</button></form></div>
    <div class="discovery-tools" aria-label="Сортиране и филтри"><button id="filtersToggle" class="discovery-btn" type="button" aria-haspopup="dialog" aria-controls="filtersModal" aria-expanded="false"><span>Филтри</span><span id="filterBadge" class="discovery-btn__badge" hidden>0</span></button><label class="sort-control" for="dealSort"><span class="sort-label">Подредба</span><select id="dealSort" class="sort-select"><option value="recommended">Препоръчани</option><option value="discount-desc">Най-голямо намаление</option><option value="checked-desc">Най-ново проверени</option><option value="price-asc">Цена: ниска към висока</option><option value="price-desc">Цена: висока към ниска</option></select></label></div>
    <div class="results-head"><h2 id="resultsTitle"><span id="resultCount">0</span> потвърдени намаления</h2></div>
    <ul id="dealGrid" class="grid" data-masonry-grid data-deals-loader="consumer-deals-v1" data-deals-state="idle" data-deals-endpoint={dynamicDealsEndpoint}></ul>
    <div id="noResults" class="empty" hidden><h2>Няма намаления с тези филтри</h2><p>Променете търсенето или изчистете филтрите.</p><button id="emptyReset" type="button">Изчисти филтрите</button></div>
    <div id="loadSentinel" class="sentinel" aria-hidden="true"></div>
    <div id="filtersModal" class="filters-modal" hidden><div class="filters-modal__backdrop" data-filters-close></div><div class="filters-modal__panel" role="dialog" aria-modal="true" aria-labelledby="filtersTitle"><div class="filters-modal__head"><div><p class="filters-modal__eyebrow">Още контрол</p><h2 id="filtersTitle" class="filters-modal__title">Филтри</h2></div><button class="filters-modal__close" type="button" aria-label="Затвори" data-filters-close>✕</button></div><div class="filters-modal__body">
      <section class="filters-group" data-deal-facet-group="category" hidden={!categories.length}><p class="filters-group__label">Категория</p><div class="filter-options-grid" data-deal-facet-options="category">{categories.map((category) => <label class="filter-option filter-option--checkbox"><input type="checkbox" name="category" value={category}/><span>{category}</span></label>)}</div></section>
      <section class="filters-group filters-group--spaced" data-deal-facet-group="brand" hidden={!brands.length}><p class="filters-group__label">Бранд</p><div class="filter-options-grid" data-deal-facet-options="brand">{brands.map((brand) => <label class="filter-option filter-option--checkbox"><input type="checkbox" name="brand" value={brand.id}/><span>{brand.name}</span></label>)}</div></section>
      <section class="filters-group filters-group--spaced"><p class="filters-group__label">Намаление</p>{[["all","Всички"],["under20","До 20%"],["20-30","20–30%"],["30-50","30–50%"],["over50","Над 50%"]].map(([value,label])=><label class="filter-option"><input type="radio" name="discount" value={value} checked={value==="all"}/><span>{label}</span></label>)}</section>
      <section class="filters-group filters-group--spaced"><p class="filters-group__label">Цена</p>{[["all","Всички цени"],["under25","До €25"],["25-50","€25–50"],["50-100","€50–100"],["over100","€100+"]].map(([value,label])=><label class="filter-option"><input type="radio" name="price" value={value} checked={value==="all"}/><span>{label}</span></label>)}</section>
      <section class="filters-group filters-group--spaced" data-deal-facet-group="material" hidden={!materials.length}><p class="filters-group__label">Материали</p><div class="filter-options-grid" data-deal-facet-options="material">{materials.map((value)=><label class="filter-option filter-option--checkbox"><input type="checkbox" name="material" value={value}/><span>{value}</span></label>)}</div></section>
      <section class="filters-group filters-group--spaced" data-deal-facet-group="ingredient" hidden={!ingredients.length}><p class="filters-group__label">Съставки</p><div class="filter-options-grid" data-deal-facet-options="ingredient">{ingredients.map((value)=><label class="filter-option filter-option--checkbox"><input type="checkbox" name="ingredient" value={value}/><span>{value}</span></label>)}</div></section>
    </div><div class="filters-modal__actions"><button id="resetFilters" class="filters-action filters-action--ghost" type="button">Изчисти</button><button id="applyFilters" class="filters-action" type="button">Покажи резултатите</button></div></div></div>
  </section>
  <template id="dealCardTemplate"><HomepageProductCard consumerDeal={templateDeal} index={0} dealPresentation="template" /></template>
  <section id="dealsFallback" aria-labelledby="fallbackTitle">
    <h2 id="fallbackTitle">Продукти и магазини за разглеждане</h2>
    <p>Тези връзки са от последното обновяване на страницата и не потвърждават активна отстъпка. Проверете условията в магазина.</p>
    <ul class="grid" data-masonry-grid>{deals.map((deal, index) => <HomepageProductCard consumerDeal={deal} index={index} dealPresentation="fallback" />)}</ul>
    <p><a href="/">Разгледайте продуктите и брандовете в Българитъм</a></p>
  </section>
</main>
<style>
#dealsLive[hidden],#dealsFallback[hidden],#dealsRetry[hidden]{display:none}#dealsStatus{text-align:center}#dealsRetry{display:block;margin:16px auto;padding:12px 20px}.deals-page{max-width:1240px}.deals-head{margin-bottom:30px}.method{display:inline-block;max-width:650px;text-align:center}.method summary{cursor:pointer;color:#55705e;font-size:13px;font-weight:var(--weight-ui)}.method p{margin:10px 0 0;padding:14px 16px;border-radius:14px;background:rgba(95,127,107,.07);font-size:13px;line-height:1.55;text-align:left}.search--home{max-width:760px;margin:0 auto 20px;padding:18px;border-radius:24px;background:rgba(255,255,255,.74);border:1px solid rgba(26,26,26,.08);box-shadow:0 16px 40px rgba(0,0,0,.06)}.search-label{display:block;margin-bottom:12px;text-align:center;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:rgba(26,26,26,.62)}.search-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px}.search-input{min-width:0;width:100%;height:58px;border:1px solid rgba(26,26,26,.08);border-radius:14px;padding:0 22px;font:16px var(--font-body)}.search-submit{min-width:104px;height:58px;padding:0 20px;border:1px solid rgba(26,26,26,.1);border-radius:14px;background:var(--accent);color:#fff;font:var(--weight-ui) 14px var(--font-body);cursor:pointer}.discovery-tools{display:grid;grid-template-columns:auto auto;align-items:center;justify-content:center;gap:12px;margin:18px 0 28px}.discovery-btn,.sort-select{min-height:48px;border-radius:14px;border:1px solid rgba(26,26,26,.1);background:rgba(255,255,255,.82);box-shadow:0 12px 26px rgba(0,0,0,.05);color:rgba(26,26,26,.86)}.discovery-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:0 18px;font:var(--weight-ui) 14px var(--font-body);cursor:pointer}.discovery-btn__badge{display:inline-grid;place-items:center;min-width:22px;height:22px;padding:0 6px;border-radius:999px;background:rgba(95,127,107,.14);font-size:12px}.discovery-btn__badge[hidden]{display:none}.sort-control{display:inline-flex;align-items:center;gap:10px;min-width:330px;padding-left:14px;border-radius:999px;background:rgba(255,255,255,.68);border:1px solid rgba(26,26,26,.08);box-shadow:0 12px 26px rgba(0,0,0,.05)}.sort-label{font-size:12px;font-weight:var(--weight-ui);letter-spacing:.08em;text-transform:uppercase;color:rgba(26,26,26,.54)}.sort-select{min-width:214px;padding:0 18px 0 8px;border:0;background:transparent;font:var(--weight-ui) 14px var(--font-body);appearance:none;cursor:pointer}.results-head{margin:20px 0}.results-head h2{margin:0;font-family:var(--font-display);font-size:var(--type-h2);font-weight:var(--weight-display)}.grid{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;align-items:start;--masonry-row:10px;grid-auto-rows:auto;grid-auto-flow:dense}.grid.is-masonry-ready{grid-auto-rows:var(--masonry-row)}:global(.grid.is-masonry-ready>[data-masonry-card]){grid-row:span var(--masonry-span)}
.filters-modal{position:fixed;inset:0;z-index:1000}.filters-modal__backdrop{position:absolute;inset:0;background:rgba(22,18,12,.18);backdrop-filter:blur(6px)}.filters-modal__panel{position:absolute;top:50%;left:50%;width:min(92vw,680px);height:min(88dvh,760px);display:grid;grid-template-rows:auto minmax(0,1fr) auto;overflow:hidden;overscroll-behavior:contain;border:1px solid rgba(26,26,26,.08);border-radius:28px;background:rgba(250,247,242,.96);box-shadow:0 28px 70px rgba(0,0,0,.16);transform:translate(-50%,-50%)}.filters-modal__head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding:24px 24px 18px;background:rgba(250,247,242,.98)}.filters-modal__body{min-height:0;padding:2px 24px 24px;overflow-y:auto}.filters-modal__eyebrow{margin:0 0 6px;font-size:12px;font-weight:var(--weight-ui);letter-spacing:.12em;text-transform:uppercase;color:rgba(26,26,26,.5)}.filters-modal__title{margin:0;font:var(--weight-ui) 34px/1 var(--font-body);letter-spacing:-.04em}.filters-modal__close{display:grid;place-items:center;width:42px;height:42px;border:1px solid rgba(26,26,26,.08);border-radius:999px;background:#fff;color:#7b403b;cursor:pointer}.filters-group__label{margin:0 0 12px;font-size:13px;font-weight:var(--weight-ui);letter-spacing:.08em;text-transform:uppercase;color:rgba(26,26,26,.58)}.filters-group--spaced{margin-top:22px}.filter-options-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.filter-option{display:flex;align-items:center;gap:12px;padding:13px 14px;border:1px solid rgba(26,26,26,.07);border-radius:18px;background:rgba(255,255,255,.78)}.filter-option+.filter-option{margin-top:10px}.filter-options-grid .filter-option+.filter-option{margin-top:0}.filter-option input{width:16px;height:16px;accent-color:#7b403b}.filters-modal__actions{display:flex;justify-content:flex-end;gap:10px;padding:16px 24px 20px;border-top:1px solid rgba(26,26,26,.07);background:rgba(250,247,242,.98)}.filters-action{min-height:44px;padding:0 16px;border:1px solid rgba(26,26,26,.08);border-radius:999px;background:rgba(26,26,26,.9);color:#fff;font:var(--weight-ui) 14px var(--font-body);cursor:pointer}.filters-action--ghost{background:#fff;color:rgba(26,26,26,.82)}.filters-modal[hidden],.empty[hidden]{display:none}.empty{max-width:650px;margin:45px auto;padding:32px;text-align:center;border:1px solid rgba(26,26,26,.08);border-radius:24px;background:rgba(255,255,255,.68)}.sentinel{height:1px}
@media(max-width:1024px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:768px){.page-head{width:100%;padding-inline:4px}.page-title,.page-intro,.page-kicker,.method{text-align:center;margin-inline:auto}.page-title{max-width:18ch}.discovery-tools{grid-template-columns:1fr;gap:10px}.discovery-btn{width:100%;min-height:50px;justify-content:space-between}.sort-control{width:100%;min-width:0;min-height:50px;justify-content:space-between}.sort-select{width:100%;min-width:0}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.filter-options-grid{grid-template-columns:1fr}}@media(max-width:640px){.deals-page{padding-inline:10px}.search--home{padding:14px;border-radius:22px}.search-row{grid-template-columns:1fr}.search-input,.search-submit{height:52px}.filters-modal__panel{width:calc(100vw - 16px);height:calc(100dvh - 16px);border-radius:24px}.filters-modal__head{padding:18px 18px 14px}.filters-modal__body{padding:2px 18px 18px}.filters-modal__actions{flex-direction:column-reverse;padding:14px 18px 18px}.filters-action{width:100%}}
/* Keep the homepage-style responsive grid ahead of the generic collection fallback. */
ul#dealGrid:not(#grid){grid-template-columns:repeat(4,minmax(0,1fr))}@media(max-width:1024px){ul#dealGrid:not(#grid){grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:768px){ul#dealGrid:not(#grid){grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}}
</style>
<script>
  import "../../scripts/consumer-deals-filters";
  import "../../scripts/dynamic-consumer-deals";
</script>
</BaseLayout>
