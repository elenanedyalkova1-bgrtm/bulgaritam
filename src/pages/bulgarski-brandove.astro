    const SPECIAL_EQUIVALENTS = [
      [/^памуч/, ["памук"]],
      [/^pamuch/, ["pamuk"]],
      [/^ленен/, ["лен"]],
      [/^lenen/, ["len"]],
      [/^вълнен/, ["вълна"]],
