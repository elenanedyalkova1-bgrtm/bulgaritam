---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { listBrands } from "../../lib/repositories";
const allBrands=await listBrands();const q=(Astro.url.searchParams.get("q")||"").trim().toLowerCase();const status=Astro.url.searchParams.get("status")||"all";
const valid=allBrands.filter((b)=>b.brand_name&&b.brand_slug);const brands=valid.filter((b)=>!q||`${b.brand_name} ${b.brand_slug}`.toLowerCase().includes(q)).filter((b)=>status==="all"||(status==="active"?b.is_active===true:b.is_active!==true));
---
<AdminLayout title="Brands" active="brands"><header class="head"><div><h1>Brands</h1><p class="muted">{brands.length} of {valid.length} Brands</p></div><a class="btn" href="/brands/new/">New Brand</a></header><form class="panel filters" method="get"><input type="search" name="q" value={q} placeholder="Search name or slug"/><select name="status"><option value="all" selected={status==="all"}>All statuses</option><option value="active" selected={status==="active"}>Active</option><option value="hidden" selected={status==="hidden"}>Hidden</option></select><button>Filter</button><a class="btn secondary" href="/brands/">Clear</a></form><section class="panel table-wrap"><table><thead><tr><th>Brand</th><th>Status</th><th>Products</th><th>Website</th></tr></thead><tbody>{brands.map((b)=><tr><td><a class="row-link" href={`/brands/${b.id}/`}>{b.brand_name}</a><div class="muted">/{b.brand_slug}</div></td><td><span class={`status ${b.is_active===true?"":"hidden"}`}>{b.is_active===true?"Active":"Hidden"}</span></td><td>{b.products?.length||0}</td><td>{b.brand_url?<a href={b.brand_url} target="_blank">Open ↗</a>:"—"}</td></tr>)}</tbody></table>{!brands.length&&<div class="empty">No Brands match these filters.</div>}</section></AdminLayout>
