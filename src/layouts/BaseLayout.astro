      const applyLanguage = (lang) => {
        const nextLang = lang === "en" ? "en" : "bg";
        localStorage.setItem(BULGARITAM_LANG_KEY, nextLang);
        document.documentElement.lang = nextLang;
        document.body.dataset.lang = nextLang;
        window.__bulgaritamLang = nextLang;

        document.querySelectorAll("[data-lang-switch]").forEach((button) => {
          const active = button.getAttribute("data-lang-switch") === nextLang;
          button.classList.toggle("is-active", active);
          button.setAttribute("aria-pressed", active ? "true" : "false");
        });

        document.querySelectorAll("[data-i18n]").forEach((node) => {
          const key = node.getAttribute("data-i18n");
          const translated = BULGARITAM_I18N[nextLang]?.[key];
          if (translated) node.textContent = translated;
        });

        document.querySelectorAll("[data-i18n-bg][data-i18n-en]").forEach((node) => {
          const translated = nextLang === "en"
            ? node.getAttribute("data-i18n-en")
            : node.getAttribute("data-i18n-bg");
          if (translated) node.textContent = translated;
        });

        document.querySelectorAll("[data-i18n-placeholder]").forEach((node) => {
          const key = node.getAttribute("data-i18n-placeholder");
          const translated = BULGARITAM_I18N[nextLang]?.[key];
          if (translated) node.setAttribute("placeholder", translated);
        });

        window.dispatchEvent(new CustomEvent("bulgaritam:lang", { detail: { lang: nextLang } }));
      };

      const initialLang = localStorage.getItem(BULGARITAM_LANG_KEY) || "bg";
      applyLanguage(initialLang);

      document.addEventListener("click", (event) => {
        const button = event.target.closest("[data-lang-switch]");
        if (!button) return;
        applyLanguage(button.getAttribute("data-lang-switch"));
      });
