{
  "name": "bulgaritam-clean",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "admin:dev": "npm --prefix admin-app run dev",
    "admin:check": "npm --prefix admin-app run check",
    "admin:password": "node scripts/generate-admin-password.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "audit:tags": "node scripts/audit-product-tags.mjs",
    "health:products": "node scripts/check-product-health.mjs",
    "health:products:apply": "node scripts/check-product-health.mjs --apply",
    "price-monitor": "node scripts/price-monitor.mjs",
    "test:price-monitor": "node --test test/price-monitor.test.mjs test/price-monitor-scheduler.test.mjs test/price-monitor-sheets.test.mjs test/price-monitor-discounts.test.mjs test/price-monitor-discount-report.test.mjs && node --import ./admin-app/node_modules/tsx/dist/loader.mjs --test test/verified-offer.test.ts",
    "test:weekly-discounts": "node --import ./admin-app/node_modules/tsx/dist/loader.mjs --test test/weekly-discounts.test.ts",
    "audit:verified-offers": "node scripts/audit-verified-offer-build.mjs",
    "canary:verified-offers": "admin-app/node_modules/.bin/tsx scripts/canary-verified-offers.ts",
    "setup:price-monitor-sheet": "node scripts/setup-price-monitor-sheet.mjs",
    "validate:price-monitor": "node scripts/validate-price-monitor.mjs",
    "migrate:price-monitor": "node scripts/migrate-price-monitor-storage.mjs",
    "migrate:manual-prices": "node scripts/migrate-price-monitor-storage.mjs",
    "prices:import": "admin-app/node_modules/.bin/tsx scripts/import-catalog-prices.ts",
    "monitor:scheduled": "node scripts/run-scheduled-price-monitor.mjs",
    "report:discounts": "node scripts/report-discounts.mjs",
    "verify:public-build": "node scripts/verify-public-build.mjs",
    "verify:seo-membership": "admin-app/node_modules/.bin/tsx scripts/verify-seo-product-membership.ts",
    "verify:seo-content": "node scripts/validate-primary-cluster-content.mjs",
    "verify:internal-links": "node scripts/validate-internal-linking.mjs",
    "setup:product-facets": "node scripts/setup-product-facets.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.1.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3"
  }
}
