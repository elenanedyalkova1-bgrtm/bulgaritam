      ["natural", "натурален", "натурална", "натурално"],
      ["organic", "органичен", "органична", "органично", "bio", "био"],
      ["eco", "еко", "sustainable", "устойчив", "reusable", "многократен", "biodegradable", "биоразградим"],
    ];

    const normalize = (value) =>
      String(value || "")
        .toLowerCase()
        .replace(/&/g, " ")
        .replace(/['\"`´’‘]/g, "")
        .replace(/[.,/#!$%^*;:{}=\\-_~()@\\[\\]+<>?\\\\|]/g, " ")
        .replace(/\s+/g, " ")
        .trim();

    const transliterateBulgarianToLatin = (value) =>
      Array.from(normalize(value))
        .map((char) => CYRILLIC_TO_LATIN[char] || char)
        .join("");

    const tokenize = (value) =>
      normalize(value)
        .split(/\s+/)
        .map((token) => token.trim())
        .filter(Boolean);

    const expandToken = (token) => {
      const forms = new Set();
      const normalized = normalize(token);
      if (!normalized) return Array.from(forms);
      forms.add(normalized);
      if (normalized.length >= 4) forms.add(normalized.slice(0, 4));
      if (normalized.length >= 6) forms.add(normalized.slice(0, 5));

      BG_SUFFIXES.forEach((suffix) => {
        if (normalized.length - suffix.length >= 3 && normalized.endsWith(suffix)) {
          forms.add(normalized.slice(0, -suffix.length));
        }
      });

      SPECIAL_EQUIVALENTS.forEach(([pattern, equivalents]) => {
        if (pattern.test(normalized)) equivalents.forEach((entry) => forms.add(entry));
      });

      SEMANTIC_GROUPS.forEach((group) => {
        if (group.includes(normalized)) group.forEach((entry) => forms.add(entry));
      });

      return Array.from(forms);
    };

    const buildSearchGroups = (value) => {
      const normalized = normalize(value);
      const transliterated = transliterateBulgarianToLatin(normalized);
      const rawTokens = [...new Set([...tokenize(normalized), ...tokenize(transliterated)])];
      return rawTokens.map((token) => expandToken(token));
    };

    const docTokenCache = new WeakMap();

    const getDocumentTokens = (node) => {
      if (!docTokenCache.has(node)) {
        const raw = normalize(node?.dataset?.searchRaw || "");
        const rawLatin = transliterateBulgarianToLatin(raw);
        const structured = String(node?.dataset?.search || "");
        docTokenCache.set(
          node,
          new Set([
            ...structured.split(/\s+/).filter(Boolean),
            ...tokenize(raw),
            ...tokenize(rawLatin),
          ])
        );
      }
      return docTokenCache.get(node);
    };

    const matchesDirectText = (node, value) => {
      const normalizedQuery = normalize(value);
      if (!normalizedQuery) return true;

      const raw = normalize(node?.dataset?.searchRaw || "");
      const rawLatin = transliterateBulgarianToLatin(raw);
      const queryLatin = transliterateBulgarianToLatin(normalizedQuery);

      return raw.includes(normalizedQuery) ||
        raw.includes(queryLatin) ||
        rawLatin.includes(normalizedQuery) ||
        rawLatin.includes(queryLatin);
    };

    const matchesSearchDocument = (node, value) => {
      if (matchesDirectText(node, value)) return true;
      const groups = buildSearchGroups(value);
      if (!groups.length) return true;
      const searchable = `${normalize(node?.dataset?.searchRaw || "")} ${String(node?.dataset?.search || "")}`.trim();
      const searchableLatin = transliterateBulgarianToLatin(searchable);
      return groups.every((group) =>
        group.some((token) => {
          if (!token) return false;
          if (token.length < 3) return false;
          const docTokens = getDocumentTokens(node);
          if (docTokens.has(token)) return true;
          for (const docToken of docTokens) {
            if (docToken.startsWith(token)) return true;
          }
          return false;
        })
      );
    };

    const getBrandSearchRelevanceScore = (node, value) => {
      const normalizedQuery = normalize(value);
      if (!normalizedQuery) return 0;

      const queryLatin = transliterateBulgarianToLatin(normalizedQuery);
      const brandName = normalize(node?.dataset?.brandName || "");
      const brandNameLatin = transliterateBulgarianToLatin(brandName);
      const raw = normalize(node?.dataset?.searchRaw || "");
      const rawLatin = transliterateBulgarianToLatin(raw);
      const searchDocument = String(node?.dataset?.search || "");
      const searchable = `${raw} ${searchDocument}`.trim();
      const searchableLatin = transliterateBulgarianToLatin(searchable);
      const queryGroups = buildSearchGroups(value);
      let score = 0;

      if (brandName === normalizedQuery || brandNameLatin === queryLatin) score += 260;
      if (brandName.startsWith(normalizedQuery) || brandNameLatin.startsWith(queryLatin)) score += 190;
      if (brandName.includes(normalizedQuery) || brandName.includes(queryLatin) || brandNameLatin.includes(normalizedQuery) || brandNameLatin.includes(queryLatin)) score += 150;
      if (raw.includes(normalizedQuery) || rawLatin.includes(queryLatin)) score += 70;
      if (searchable.includes(normalizedQuery) || searchable.includes(queryLatin) || searchableLatin.includes(normalizedQuery) || searchableLatin.includes(queryLatin)) score += 45;

      queryGroups.forEach((group) => {
        const bestTokenScore = group.reduce((best, token) => {
          if (!token) return best;
          if (brandName.includes(token) || brandNameLatin.includes(token)) return Math.max(best, 45);
          if (searchable.includes(token) || searchableLatin.includes(token)) return Math.max(best, 18);
          return best;
        }, 0);
        score += bestTokenScore;
      });

      return score;
    };

    const scheduleBrandSearchTracking = (value) => {
      window.clearTimeout(brandSearchTrackTimer);
      const normalized = normalize(value);
      if (normalized.length < 2) {
        lastBrandSearchSignature = "";
        return;
      }

      brandSearchTrackTimer = window.setTimeout(() => {
        const visibleCount = cards.filter((card) => card.style.display !== "none").length;
        const signature = [normalized, activeFilter, activeSort, visibleCount].join("|");
        if (signature === lastBrandSearchSignature) return;
        lastBrandSearchSignature = signature;

        window.bulgaritamTrack?.("brands_search", {
          search_query: normalized,
          active_category: activeFilter,
          sort_mode: activeSort,
          results_count: visibleCount,
        });
      }, 700);
    };

    const updateOccasionBadge = () => {
      if (!brandOccasionBadge) return;
      if (activeOccasionKeys.length) {
        brandOccasionBadge.textContent = String(activeOccasionKeys.length);
        brandOccasionBadge.removeAttribute("hidden");
      } else {
        brandOccasionBadge.setAttribute("hidden", "");
      }
    };

    const syncOccasionInputs = () => {
      brandOccasionModal?.querySelectorAll('input[name="brandOccasionFilter"]').forEach((input) => {
        input.checked = activeOccasionKeys.includes(input.value);
      });
    };

    const openOccasionModal = () => {
      if (!brandOccasionModal) return;
      syncOccasionInputs();
      brandOccasionModal.removeAttribute("hidden");
      brandOccasionToggle?.setAttribute("aria-expanded", "true");
      document.documentElement.classList.add("no-scroll");
    };

    const closeOccasionModal = () => {
      if (!brandOccasionModal) return;
      brandOccasionModal.setAttribute("hidden", "");
      brandOccasionToggle?.setAttribute("aria-expanded", "false");
      document.documentElement.classList.remove("no-scroll");
    };

    const setActive = (btn) => {
      filters.querySelectorAll(".pill").forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");
    };

    const sortCards = (list, sortValue) => {
      const sorted = [...list];

      switch (sortValue) {
        case "alpha-asc":
          sorted.sort((a, b) =>
            (a.dataset.brandName || "").localeCompare(b.dataset.brandName || "", "bg")
          );
          break;
        case "alpha-desc":
          sorted.sort((a, b) =>
            (b.dataset.brandName || "").localeCompare(a.dataset.brandName || "", "bg")
          );
          break;
        case "date-desc":
          sorted.sort((a, b) => Number(b.dataset.createdAt || 0) - Number(a.dataset.createdAt || 0));
          break;
        case "date-asc":
          sorted.sort((a, b) => Number(a.dataset.createdAt || 0) - Number(b.dataset.createdAt || 0));
          break;
        case "featured":
        default:
          sorted.sort((a, b) => Number(a.dataset.originalIndex || 0) - Number(b.dataset.originalIndex || 0));
          break;
      }

      return sorted;
    };

    const sortCardsForSearch = (list, value) =>
      [...list].sort((a, b) => {
        const scoreDiff = getBrandSearchRelevanceScore(b, value) - getBrandSearchRelevanceScore(a, value);
        if (scoreDiff !== 0) return scoreDiff;
        return Number(a.dataset.originalIndex || 0) - Number(b.dataset.originalIndex || 0);
      });

    const applyDiscovery = () => {
      let visibleCount = 0;
      const matchingCards = [];

      cards.forEach((card) => {
        const keys = getKeys(card);
        const occasionKeys = (card.dataset.occasionKeys || "").split(",").filter(Boolean);
        const matchesFilter = activeFilter === "all" ? true : keys.includes(activeFilter);
        const matchesQuery = matchesSearchDocument(card, activeQuery);
        const matchesOccasion = !activeOccasionKeys.length || activeOccasionKeys.some((key) => occasionKeys.includes(key));
        const matchesDelivery = !activeDeliveryOutside || card.dataset.deliversAbroad === "1";
        if (matchesFilter && matchesQuery && matchesOccasion && matchesDelivery) matchingCards.push(card);
      });

      const orderedCards = activeQuery.trim()
        ? sortCardsForSearch(matchingCards, activeQuery)
        : sortCards(matchingCards, activeSort);

      orderedCards.forEach((card) => {
        brandGrid?.appendChild(card);
      });

      cards.forEach((card) => {
        const show = matchingCards.includes(card);
        card.style.display = show ? "" : "none";
        if (show) visibleCount += 1;
      });

      if (empty) {
        if (visibleCount === 0) empty.removeAttribute("hidden");
        else empty.setAttribute("hidden", "");
      }
    };

    filters.addEventListener("click", (e) => {
      const btn = e.target.closest("[data-filter]");
      if (!btn) return;

      const key = btn.getAttribute("data-filter") || "all";
      activeFilter = key;
      setActive(btn);
      applyDiscovery();
      window.bulgaritamTrack?.("category_pill_click", {
        surface: "brands",
        category_key: key,
        category_label: btn.textContent || "",
      });
      pulseResults();
    });

    const handleBrandSearchInput = (value) => {
      activeQuery = value || "";
      if (activeQuery.trim()) {
        activeFilter = "all";
        const allButton = filters.querySelector('[data-filter="all"]');
        if (allButton) setActive(allButton);
      }
      applyDiscovery();
      scheduleBrandSearchTracking(activeQuery);
      if (activeQuery.trim()) {
        brandGrid?.scrollIntoView({ behavior: "smooth", block: "start" });
      }
      pulseResults();
    };

    brandSearchInput?.addEventListener("input", (e) => {
      handleBrandSearchInput(e.target.value || "");
    });

    brandSearchInput?.addEventListener("search", (e) => {
      activeQuery = e.target.value || "";
      handleBrandSearchInput(activeQuery);
    });

    brandSortSelect?.addEventListener("change", (e) => {
      activeSort = e.target.value || "featured";
      applyDiscovery();
      window.bulgaritamTrack?.("sort_change", {
        surface: "brands",
        sort_mode: activeSort,
        active_category: activeFilter,
      });
      pulseResults();
    });

    brandDeliveryOutside?.addEventListener("change", (e) => {
      activeDeliveryOutside = Boolean(e.target.checked);
      applyDiscovery();
      window.bulgaritamTrack?.("filter_apply", {
        surface: "brands",
        delivers_outside_bulgaria: activeDeliveryOutside,
      });
      pulseResults();
    });

    brandOccasionToggle?.addEventListener("click", openOccasionModal);
    brandOccasionModal?.addEventListener("click", (e) => {
      if (e.target.closest("[data-brand-occasion-close]")) closeOccasionModal();
    });

    brandOccasionApply?.addEventListener("click", () => {
      activeOccasionKeys = Array.from(
        brandOccasionModal?.querySelectorAll('input[name="brandOccasionFilter"]:checked') || []
      ).map((input) => input.value);
      closeOccasionModal();
      updateOccasionBadge();
      applyDiscovery();
      window.bulgaritamTrack?.("occasion_filter_apply", {
        surface: "brands",
        occasion_keys: activeOccasionKeys,
      });
      pulseResults();
    });

    brandOccasionReset?.addEventListener("click", () => {
      activeOccasionKeys = [];
      syncOccasionInputs();
      closeOccasionModal();
      updateOccasionBadge();
      applyDiscovery();
      pulseResults();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && brandOccasionModal && !brandOccasionModal.hasAttribute("hidden")) {
        closeOccasionModal();
      }
    });

    updateOccasionBadge();
    applyDiscovery();
  </script>
</BaseLayout>
