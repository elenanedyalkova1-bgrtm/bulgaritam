---
import "../styles/global.css";
const SITE_URL = (
  (import.meta.env.PUBLIC_SITE_URL && String(import.meta.env.PUBLIC_SITE_URL).trim()) ||
  (Astro.site ? String(Astro.site) : "") ||
  "https://bulgaritam.bg"
).replace(/\/+$/, "");
const ANALYTICS_ENDPOINT = String(import.meta.env.PUBLIC_ANALYTICS_ENDPOINT || "").trim();

const HOME_SEO = {
  title: "Българитъм | Подбрани български марки и продукти",
  description:
    "Открий подбрани български марки и продукти в Българитъм. Разглеждай, запазвай и намирай качествени находки на едно място.",
};

const {
  title,
  description,
  canonical,
  seo,
  robots,
  i18n = {},
} = Astro.props;

const normalizeText = (value = "") => String(value ?? "").replace(/\s+/g, " ").trim();

const trimAtWord = (value, max) => {
  const text = normalizeText(value);
  if (!text) return "";
  if (text.length <= max) return text;

  const slice = text.slice(0, max + 1);
  const breakpoints = [" ", "-", "–", "—", "|", ","];
  let cutIndex = -1;

  for (const breakpoint of breakpoints) {
    cutIndex = Math.max(cutIndex, slice.lastIndexOf(breakpoint));
  }

  const safeIndex = cutIndex > Math.floor(max * 0.6) ? cutIndex : max;
  return slice
    .slice(0, safeIndex)
    .trim()
    .replace(/[|,;:.!?\-–—]+$/u, "");
};

const buildTitleWithSuffix = (primary, suffix, max = 60) => {
  const main = normalizeText(primary);
  const tail = normalizeText(suffix);
  if (!main && !tail) return "";
  if (!tail) return trimAtWord(main, max);

  const full = `${main} ${tail}`.trim();
  if (full.length <= max) return full;

  const availableForMain = max - tail.length - 1;
  if (availableForMain <= 12) return trimAtWord(full, max);

  return `${trimAtWord(main, availableForMain)} ${tail}`.trim();
};

function generateTitle(seoConfig, manualTitle) {
  const directTitle = trimAtWord(manualTitle || seoConfig?.title, 60);
  if (directTitle) return directTitle;

  const type = normalizeText(seoConfig?.type).toLowerCase();
  const data = seoConfig?.data || {};

  switch (type) {
    case "product": {
      const productName = normalizeText(data.productName);
      const brandName = normalizeText(data.brandName);
      if (!productName || !brandName) return HOME_SEO.title;
      return buildTitleWithSuffix(productName, `| От ${brandName} | Българитъм`);
    }

    case "brand": {
      const brandName = normalizeText(data.brandName);
      if (!brandName) return HOME_SEO.title;
      return buildTitleWithSuffix(brandName, "| Български бранд | Българитъм");
    }

    case "category": {
      const category = normalizeText(data.category);
      if (!category) return HOME_SEO.title;
      return buildTitleWithSuffix(`Български ${category}`, "| Подбрани марки | Българитъм");
    }

    case "blog": {
      const blogTitle = normalizeText(data.blogTitle);
      if (!blogTitle) return HOME_SEO.title;
      return buildTitleWithSuffix(blogTitle, "| Българитъм");
    }

    case "home":
      return HOME_SEO.title;

    default:
      return HOME_SEO.title;
  }
}

function generateDescription(seoConfig, manualDescription) {
  const directDescription = trimAtWord(manualDescription || seoConfig?.description, 155);
  if (directDescription) return directDescription;

  const type = normalizeText(seoConfig?.type).toLowerCase();
  const data = seoConfig?.data || {};

  switch (type) {
    case "product": {
      const productName = normalizeText(data.productName);
      const brandName = normalizeText(data.brandName);
      if (!productName || !brandName) return HOME_SEO.description;
      return trimAtWord(
        `Открий ${productName} от ${brandName} в Българитъм. Подбрани български продукти с неповторим дизайн и качество.`,
        155
      );
    }

    case "brand": {
      const brandName = normalizeText(data.brandName);
      if (!brandName) return HOME_SEO.description;
      return trimAtWord(
        `Открий ${brandName} – български бранд със собствен характер и неповторим стил. Разгледай продуктите им в Българитъм.`,
        155
      );
    }

    case "category": {
      const category = normalizeText(data.category);
      if (!category) return HOME_SEO.description;
      return trimAtWord(
        `Разгледай български ${category}. Подбрани марки и продукти, създадени в България.`,
        155
      );
    }

    case "blog": {
      const excerpt =
        normalizeText(data.excerpt) ||
        normalizeText(data.summary) ||
        normalizeText(data.description);
      if (excerpt) return trimAtWord(excerpt, 155);

      const blogTitle = normalizeText(data.blogTitle);
      if (!blogTitle) return HOME_SEO.description;

      return trimAtWord(
        `Прочети ${blogTitle} в Българитъм и открий подбрани истории, идеи и препоръки за български марки и продукти.`,
        155
      );
    }

    case "home":
      return HOME_SEO.description;

    default:
      return HOME_SEO.description;
  }
}

const resolvedTitle = generateTitle(seo, title);
const resolvedDescription = generateDescription(seo, description);
const resolvedCanonical = normalizeText(canonical) || new URL(Astro.url.pathname, `${SITE_URL}/`).toString();

const pathname = Astro.url.pathname;
const isActive = (href) => (href === "/" ? pathname === "/" : pathname.startsWith(href));

const normalizeUrl = (value) => {
  const text = normalizeText(value);
  if (!text) return "";

  try {
    return new URL(text, `${SITE_URL}/`).toString();
  } catch {
    return "";
  }
};

const seoType = normalizeText(seo?.type).toLowerCase();
const seoData = seo?.data || {};
const robotsDirective = normalizeText(robots) || "index,follow,max-image-preview:large";
const socialImage = normalizeUrl(seoData.image) || `${SITE_URL}/social-preview.png`;
const openGraphType = seoType === "product" ? "product" : "website";
const gaMeasurementId = normalizeText(import.meta.env.PUBLIC_GA_MEASUREMENT_ID) || "G-7XT69Z6DKS";
const gtmContainerId = normalizeText(import.meta.env.PUBLIC_GTM_CONTAINER_ID) || "GTM-58MC374T";
const faviconSvg = "/favicon.svg";
const faviconPng48 = "/favicon-48x48.png";
const faviconPng192 = "/favicon-192x192.png";
const appleTouchIcon = "/apple-touch-icon.png";

const defaultBreadcrumbs = [{ name: "Начало", item: `${SITE_URL}/` }];
if (pathname !== "/") {
  defaultBreadcrumbs.push({ name: resolvedTitle, item: resolvedCanonical });
}

const breadcrumbItems = Array.isArray(seoData.breadcrumbs) && seoData.breadcrumbs.length
  ? seoData.breadcrumbs
      .map((entry) => ({
        name: normalizeText(entry?.name || entry?.label),
        item: normalizeUrl(entry?.item || entry?.href),
      }))
      .filter((entry) => entry.name && entry.item)
  : defaultBreadcrumbs;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Българитъм",
    url: SITE_URL,
    logo: `${SITE_URL}${faviconPng192}`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Българитъм",
    url: SITE_URL,
    inLanguage: "bg-BG",
  },
];

if (breadcrumbItems.length > 1) {
  structuredData.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbItems.map((entry, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: entry.name,
      item: entry.item,
    })),
  });
}

if (seoType === "product" && seoData.productName) {
  const productImage = normalizeUrl(seoData.image);
  const brandName = normalizeText(seoData.brandName);
  const productSchema = {
    "@context": "https://schema.org",
    "@type": "Product",
    name: normalizeText(seoData.productName),
    description: normalizeText(seoData.description) || resolvedDescription,
    url: resolvedCanonical,
    image: productImage ? [productImage] : undefined,
    brand: brandName ? { "@type": "Brand", name: brandName } : undefined,
    category: normalizeText(seoData.category) || undefined,
    offers: seoData.productUrl
      ? {
          "@type": "Offer",
          url: normalizeUrl(seoData.productUrl) || resolvedCanonical,
          priceCurrency: normalizeText(seoData.currency) || "EUR",
          price: seoData.price ?? undefined,
          availability: "https://schema.org/InStock",
        }
      : undefined,
  };

  structuredData.push(productSchema);
}

if (seoType === "brand" && seoData.brandName) {
  structuredData.push({
    "@context": "https://schema.org",
    "@type": "Brand",
    name: normalizeText(seoData.brandName),
    url: resolvedCanonical,
    description: normalizeText(seoData.description) || resolvedDescription,
  });
}

if (seoType === "category" && seoData.category) {
  structuredData.push({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: normalizeText(seoData.category),
    url: resolvedCanonical,
    description: normalizeText(seoData.description) || resolvedDescription,
    inLanguage: "bg-BG",
  });
}
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <meta name="robots" content={robotsDirective} />
    <meta name="googlebot" content={robotsDirective} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={faviconSvg} />
    <link rel="icon" type="image/png" sizes="48x48" href={faviconPng48} />
    <link rel="icon" type="image/png" sizes="192x192" href={faviconPng192} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-TileImage" content="/mstile-150x150.png" />
    <meta name="msapplication-TileColor" content="#f4eee6" />
    <meta name="theme-color" content="#f4eee6" />
    <link rel="canonical" href={resolvedCanonical} />
    <link rel="alternate" hrefLang="bg-BG" href={resolvedCanonical} />
    <link rel="alternate" hrefLang="x-default" href={resolvedCanonical} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:type" content={openGraphType} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:site_name" content="Българитъм" />
    <meta property="og:locale" content="bg_BG" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1227" />
    <meta property="og:image:height" content="812" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Forum&family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Forum&family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Forum&family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
      />
    </noscript>

    <!-- Microsoft Clarity -->
    <script is:inline>
      (() => {
        const startClarity = () => {
          if (window.__bulgaritamClarityLoaded) return;
          window.__bulgaritamClarityLoaded = true;
          (function(c,l,a,r,i,t,y){
              c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
              t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
              y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
          })(window, document, "clarity", "script", "sbw66lvia1");
        };

        const schedule =
          window.requestIdleCallback
            ? () => window.requestIdleCallback(startClarity, { timeout: 2500 })
            : () => window.setTimeout(startClarity, 1800);

        if (document.readyState === "complete") schedule();
        else window.addEventListener("load", schedule, { once: true });
      })();
    </script>

    {gtmContainerId ? (
      <script is:inline define:vars={{ gtmContainerId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmContainerId);
      </script>
    ) : null}
    {!gtmContainerId && gaMeasurementId ? (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaMeasurementId)}`}></script>
    ) : null}
    <script is:inline define:vars={{ gaMeasurementId, gtmContainerId, analyticsEndpoint: ANALYTICS_ENDPOINT }}>
      (() => {
        const measurementId = String(gaMeasurementId || "").trim();
        const containerId = String(gtmContainerId || "").trim();
        const firstPartyEndpoint = String(analyticsEndpoint || "").trim();
        const queue = [];

        // The shared event transport must exist before consent state or any
        // hydrated component can attempt to emit an analytics event.
        window.dataLayer = window.dataLayer || [];

        const hasAnalyticsConsent = () =>
          Boolean(window.__cookieConsent?.analytics || document.documentElement.dataset.cookieAnalytics === "1");
        const isAnalyticsExcluded = () =>
          document.cookie.split(";").some((part) => part.trim() === "bulgaritam_analytics_excluded=1");

        const getLanguage = () => {
          try {
            return window.localStorage?.getItem("bulgaritam_lang_v1") === "en" ? "en" : "bg";
          } catch {
            // Storage can be unavailable in privacy-restricted/preview contexts.
            // Analytics must still work without reading it.
            return "bg";
          }
        };
        const getDeviceType = () => (window.matchMedia("(max-width: 768px)").matches ? "mobile" : "desktop");

        const safeStorage = (storage, key, fallbackFactory) => {
          try {
            const existing = storage?.getItem(key);
            if (existing) return existing;
            const next = fallbackFactory();
            storage?.setItem(key, next);
            return next;
          } catch { return fallbackFactory(); }
        };
        const randomId = () => globalThis.crypto?.randomUUID?.() || `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
        const getSessionId = () => safeStorage(window.sessionStorage, "bulgaritam_analytics_session_v1", randomId);
        const getJourneyId = () => safeStorage(window.localStorage, "bulgaritam_analytics_journey_v1", randomId);
        const safeReferrerDomain = () => {
          try { return document.referrer ? new URL(document.referrer).hostname.replace(/^www\./, "") : ""; }
          catch { return ""; }
        };
        const initialAcquisition = (() => {
          const query = new URLSearchParams(window.location.search);
          return {
            landing_page: window.location.pathname,
            referrer_domain: safeReferrerDomain(),
            utm_source: query.get("utm_source") || "",
            utm_medium: query.get("utm_medium") || "",
            utm_campaign: query.get("utm_campaign") || "",
          };
        })();

        const redactPotentialPii = (value) => {
          const text = String(value || "");
          if (/\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b/i.test(text)) return "[redacted]";
          if (/(?:\+?359|0)[\s.-]?[0-9]{2}[\s.-]?[0-9]{3}[\s.-]?[0-9]{3,4}/.test(text)) return "[redacted]";
          return text;
        };

        const sanitizeValue = (value, key = "") => {
          if (Array.isArray(value)) return value.filter(Boolean).join(",");
          if (value == null) return undefined;
          if (typeof value === "boolean") return value ? "1" : "0";
          if (["board_name", "collection_name", "email", "phone", "destination_url"].includes(key)) return undefined;
          const stringValue = redactPotentialPii(value).trim();
          return stringValue ? stringValue.slice(0, 240) : undefined;
        };

        const sanitizeParams = (params = {}) =>
          Object.fromEntries(
            Object.entries(params)
              .map(([key, value]) => [key, sanitizeValue(value, key)])
              .filter(([, value]) => value !== undefined)
          );

        const ensureGa = () => {
          if (!measurementId && !containerId) return;

          window.gtag = window.gtag || function gtag(){ window.dataLayer.push(arguments); };
          if (!window.__bulgaritamGaInitialized) {
            window.gtag("js", new Date());
            window.gtag("consent", "default", {
              analytics_storage: "denied",
              ad_storage: "denied",
              ad_user_data: "denied",
              ad_personalization: "denied",
            });
            if (!containerId && measurementId) {
              window.gtag("config", measurementId, { anonymize_ip: true, send_page_view: false });
            }
            window.__bulgaritamGaInitialized = true;
          }
        };

        const flushQueue = () => {
          if (typeof window.gtag !== "function") return;
          while (queue.length) {
            const next = queue.shift();
            if (next && !containerId) window.gtag("event", next.eventName, next.params);
          }
        };

        const applyConsentToGa = () => {
          if ((!measurementId && !containerId) || typeof window.gtag !== "function") return;
          const granted = hasAnalyticsConsent() && !isAnalyticsExcluded();
          window.gtag("consent", "update", {
            analytics_storage: granted ? "granted" : "denied",
            ad_storage: "denied",
            ad_user_data: "denied",
            ad_personalization: "denied",
          });

          if (granted && !window.__bulgaritamInitialPageviewSent) {
            window.bulgaritamTrack?.("page_view", {
              page_path: window.location.pathname,
              page_title: document.title,
              language: getLanguage(),
              device_type: getDeviceType(),
            });
            window.__bulgaritamInitialPageviewSent = true;
          }

          if (granted) flushQueue();
        };

        const buildCommonParams = () => ({
          page_path: window.location.pathname,
          page_location: `${window.location.origin}${window.location.pathname}`,
          page_title: document.title,
          language: getLanguage(),
          device_type: getDeviceType(),
          page_type: document.body?.dataset?.pageType || (window.location.pathname.startsWith("/p/") ? "product" : window.location.pathname.startsWith("/brand/") ? "brand" : window.location.pathname === "/" ? "discovery" : "content"),
          ...initialAcquisition,
        });

        const readPersistedDiscoveryContext = () => {
          try { return JSON.parse(window.sessionStorage?.getItem("bulgaritam_discovery_context_v1") || "{}"); }
          catch { return {}; }
        };

        const persistDiscoveryContext = (payload) => {
          const searchTerm = payload.search_term || payload.query;
          if (!searchTerm && !payload.category && !payload.subcategory && !payload.active_filters) return;
          const context = sanitizeParams({
            search_term: searchTerm,
            normalized_query: payload.normalized_query,
            structured_intent: payload.structured_intent,
            category: payload.category,
            subcategory: payload.subcategory,
            product_type: payload.product_type,
            gift_recipient: payload.gift_recipient,
            gift_occasion: payload.gift_occasion,
            active_filters: payload.active_filters,
            source_context: payload.source_context || payload.list_context,
          });
          try { window.sessionStorage?.setItem("bulgaritam_discovery_context_v1", JSON.stringify(context)); } catch {}
        };

        const sendFirstParty = (eventName, payload) => {
          if (!firstPartyEndpoint) return;
          const body = JSON.stringify({
            event_name: eventName,
            occurred_at: new Date().toISOString(),
            anonymous_session_id: getSessionId(),
            anonymous_journey_id: getJourneyId(),
            ...payload,
          });
          try {
            if (navigator.sendBeacon) {
              navigator.sendBeacon(firstPartyEndpoint, new Blob([body], { type: "application/json" }));
            } else {
              fetch(firstPartyEndpoint, { method: "POST", headers: { "Content-Type": "application/json" }, body, keepalive: true, credentials: "omit" }).catch(() => {});
            }
          } catch {}
        };

        window.bulgaritamTrack = (eventName, params = {}) => {
          if ((!measurementId && !containerId) || !hasAnalyticsConsent() || isAnalyticsExcluded() || !eventName) return;

          const payload = {
            ...buildCommonParams(),
            ...readPersistedDiscoveryContext(),
            ...sanitizeParams(params),
          };

          if (eventName === "search" || eventName === "search_results_view" || eventName === "search_no_results") persistDiscoveryContext(payload);

          window.dataLayer = window.dataLayer || [];
          const dataLayerEvent = { event: eventName, ...payload };
          window.dataLayer.push(dataLayerEvent);
          sendFirstParty(eventName, payload);

          if (!containerId && typeof window.gtag === "function") {
            window.gtag("event", eventName, payload);
          } else if (!containerId) {
            queue.push({ eventName, params: payload });
          }
        };

        const destinationDomain = (href) => {
          try { return new URL(href, window.location.href).hostname.replace(/^www\./, ""); }
          catch { return ""; }
        };

        const getDiscoveryContext = () => window.__bulgaritamDiscoveryContext || {};

        const getProductContext = (node) => {
          const scope = node?.closest?.("[data-product-slug]");
          if (!scope) return {};
          return sanitizeParams({
            product_slug: scope.dataset.productSlug,
            product_id: scope.dataset.productId,
            product_name: scope.dataset.productName,
            brand_id: scope.dataset.brandId,
            brand_slug: scope.dataset.brandSlug,
            brand_name: scope.dataset.brandName,
            category: scope.dataset.publicCategory || scope.dataset.categoryKey,
            subcategory: scope.dataset.publicSubcategory || scope.dataset.subcategoryKeys,
            product_type: scope.dataset.productType,
            price: scope.dataset.price || scope.dataset.priceMin,
            list_context: scope.dataset.listContext,
            list_name: scope.dataset.listName,
            position: scope.dataset.position,
            ...getDiscoveryContext(),
          });
        };

        const getBrandContext = (node) => {
          const scope = node?.closest?.("[data-brand]");
          if (!scope) return {};
          const href = node?.getAttribute?.("href") || "";
          const inferredSlug = href.startsWith("/brand/") ? href.replace(/^\/brand\//, "").replace(/\/$/, "") : "";
          return sanitizeParams({
            brand_slug: scope.dataset.brandSlug || inferredSlug,
            brand_id: scope.dataset.brandId,
            brand_name: scope.dataset.brandName,
            category: scope.dataset.keys,
            delivers_abroad: scope.dataset.deliversAbroad,
            list_context: scope.dataset.listContext,
            position: scope.dataset.position,
            ...getDiscoveryContext(),
          });
        };

        document.addEventListener("click", (event) => {
          const target = event.target instanceof Element ? event.target : null;
          if (!target) return;

          const outboundLink = target.closest("a.cta-out, a[data-analytics-event='outbound_brand_click']");
          if (outboundLink) {
            const productContext = getProductContext(outboundLink);
            window.bulgaritamTrack?.(productContext.product_slug ? "outbound_product_click" : "outbound_brand_click", {
              ...productContext,
              ...getBrandContext(outboundLink),
              destination_domain: destinationDomain(outboundLink.getAttribute("href") || ""),
              source_context: productContext.list_context || window.location.pathname,
            });
            return;
          }

          const productLink = target.closest("a.card-titlelink, a.card-imglink, a.related-link, a.shared-card__media, a.shared-card__cta");
          if (productLink) {
            window.bulgaritamTrack?.("view_product", {
              ...getProductContext(productLink),
              target_path: productLink.getAttribute("href") || "",
            });
            return;
          }

          const brandLink = target.closest("a.brand-link, a.brand[href^='/brand/']");
          if (brandLink) {
            window.bulgaritamTrack?.("view_brand", {
              ...getBrandContext(brandLink),
              target_path: brandLink.getAttribute("href") || "",
            });
          }
        });

        window.addEventListener("cookie-consent", () => {
          ensureGa();
          applyConsentToGa();
        });

        ensureGa();
        applyConsentToGa();

        const impressionSeen = new WeakMap();
        const observeImpressions = () => {
          if (!("IntersectionObserver" in window)) return;
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting || entry.intersectionRatio < 0.5) return;
              const node = entry.target;
              const context = getDiscoveryContext();
              const signature = JSON.stringify([context.query || "", context.category || "", context.subcategory || "", context.product_type || "", node.dataset.listContext || ""]);
              const seen = impressionSeen.get(node) || new Set();
              if (seen.has(signature)) return;
              seen.add(signature);
              impressionSeen.set(node, seen);
              if (node.dataset.analyticsKind === "brand") {
                window.bulgaritamTrack?.("brand_impression", getBrandContext(node));
              } else {
                window.bulgaritamTrack?.("product_impression", getProductContext(node));
              }
            });
          }, { threshold: [0.5] });
          document.querySelectorAll("[data-analytics-kind]").forEach((node) => observer.observe(node));
        };

        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", observeImpressions, { once: true });
        else observeImpressions();

        window.addEventListener("load", () => {
          const productPage = document.querySelector("[data-page-product]");
          const brandPage = document.querySelector("[data-page-brand]");
          if (productPage) window.bulgaritamTrack?.("view_product", { ...getProductContext(productPage), source_context: "product_page" });
          if (brandPage) window.bulgaritamTrack?.("view_brand", { ...getBrandContext(brandPage), source_context: "brand_page" });
        }, { once: true });
      })();
    </script>
    <script is:inline>
      (() => {
        const markBrokenImage = (img) => {
          if (!(img instanceof HTMLImageElement) || img.dataset.fallbackApplied === "true") return;
          const source = img.currentSrc || img.src || img.getAttribute("data-lazy-src") || "";
          if (!source || source.startsWith("data:")) return;

          img.dataset.fallbackApplied = "true";
          img.classList.add("is-broken-product-image");
          img.removeAttribute("data-lazy-src");
          img.alt = "Снимката временно не е налична";

          const frame = img.closest("picture, .thumb, .card-media, .hero, .related-media, .related-link") || img.parentElement;
          frame?.classList.add("has-broken-product-image");
        };

        document.addEventListener("error", (event) => markBrokenImage(event.target), true);
        window.addEventListener("DOMContentLoaded", () => {
          document.querySelectorAll("img").forEach((img) => {
            if (img.complete && img.naturalWidth === 0) markBrokenImage(img);
          });
        });
      })();
    </script>
