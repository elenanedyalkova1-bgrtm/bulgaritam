---
import AdminLayout from "../layouts/AdminLayout.astro";
import { dispatchPublish, listPublishRuns, publishConfiguration } from "../lib/github-deploy";
import { validateCsrf } from "../lib/repositories";

const configuration = publishConfiguration();
let message = "";
let error = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  try {
    validateCsrf(form, Astro.locals.admin.csrf);
    const mode = form.get("mode") === "deploy" ? "deploy" : "dry-run";
    await dispatchPublish(mode);
    message = mode === "deploy" ? "Production publication requested. GitHub approval may still be required." : "Safe dry-run build requested.";
  } catch (cause) {
    error = cause instanceof Error ? cause.message : "Could not trigger the workflow.";
  }
}
let runs: Awaited<ReturnType<typeof listPublishRuns>> = [];
try { runs = await listPublishRuns(); } catch (cause) { error ||= cause instanceof Error ? cause.message : "Could not load workflow status."; }
const busy = runs.some((run) => run.status !== "completed");
---
<AdminLayout title="Publish website" active="publish">
  {busy && <meta http-equiv="refresh" content="15" />}
  <header class="head"><div><h1>Publish website</h1><p class="muted">Build the latest Baserow catalog and publish the verified static site to SuperHosting.</p></div></header>
  {message && <div class="notice">{message}</div>}{error && <div class="error">{error}</div>}
  {configuration.missing.length ? <section class="panel warning"><h2>Configuration required</h2><p class="muted">Missing server variables: {configuration.missing.join(", ")}. The trigger is disabled until they are configured in Vercel.</p></section> :
  <section class="panel"><h2>Safe build check</h2><p class="muted">Pulls current Baserow data, builds the public Astro site, verifies all Product and Brand routes, detects stale output and uploads a downloadable artifact. It never connects to SuperHosting.</p><form method="post"><input type="hidden" name="csrf" value={Astro.locals.admin.csrf}/><input type="hidden" name="mode" value="dry-run"/><button>Run safe dry-run</button></form></section>}
  <section class="panel warning"><h2>Publish to SuperHosting</h2><p class="muted">Runs the same verified build, then waits for the protected GitHub production environment. Only Product and Brand directories are synchronized with deletion, removing stale pages without deleting unrelated hosting files.</p><form method="post"><input type="hidden" name="csrf" value={Astro.locals.admin.csrf}/><input type="hidden" name="mode" value="deploy"/><button class="danger" disabled={!configuration.productionEnabled || configuration.missing.length > 0}>Publish website</button></form>{!configuration.productionEnabled && <p class="hint">Production publishing is locked until the first live publish is explicitly approved.</p>}</section>
  <section class="panel table-wrap"><div class="head"><div><h2>Recent publication runs</h2><p class="muted">{busy ? "A run is active; this page refreshes every 15 seconds." : "Latest GitHub Actions results."}</p></div><a class="btn secondary" href="/publish/">Refresh</a></div><table><thead><tr><th>Started</th><th>Status</th><th>Commit</th><th>Actor</th><th>Details</th></tr></thead><tbody>{runs.map((run) => <tr><td>{new Date(run.createdAt).toLocaleString("bg-BG")}</td><td><span class={`status ${run.conclusion === "failure" ? "hidden" : ""}`}>{run.status === "completed" ? run.conclusion : run.status}</span></td><td>{run.commit}</td><td>{run.actor}</td><td><a href={run.url} target="_blank">Open GitHub ↗</a></td></tr>)}</tbody></table>{!runs.length && <div class="empty">No workflow runs are available yet.</div>}</section>
</AdminLayout>
