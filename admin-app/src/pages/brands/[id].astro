---
import AdminLayout from "../../layouts/AdminLayout.astro";import BrandForm from "../../components/BrandForm.astro";import {findBrand,listProducts,saveBrand,setBrandVisibility,validateCsrf,isProductActive} from "../../lib/repositories";
const id=Number(Astro.params.id);if(!id)return new Response("Not found",{status:404});let brand=await findBrand(id);let error="";if(Astro.request.method==="POST"){const form=await Astro.request.formData();try{validateCsrf(form,Astro.locals.admin.csrf);if(form.get("_action")==="visibility")brand=await setBrandVisibility(id,form.get("visible")==="true");else brand=await saveBrand(form,id);return Astro.redirect(`/brands/${id}/?saved=1`)}catch(e){error=e instanceof Error?e.message:"Could not save Brand."}}
const products=(await listProducts()).filter((p)=>Number(p.brand_ref?.[0]?.id)===id||(!p.brand_ref?.length&&String(p.brand_slug||"").trim()===String(brand.brand_slug||"").trim()));const success=Astro.url.searchParams.has("saved")||Astro.url.searchParams.has("created");
---
<AdminLayout title={brand.brand_name||"Brand"} active="brands"><header class="head"><div><h1>{brand.brand_name||"Brand"}</h1><p class="muted">Baserow row #{id}</p></div><a class="btn secondary" href="/brands/">Back</a></header>{success&&<div class="notice">Brand saved and verified in Baserow. Public deployment is still required.</div>}<BrandForm brand={brand} csrf={Astro.locals.admin.csrf} error={error}/><section class="panel table-wrap"><h2>Linked Products ({products.length})</h2><table><thead><tr><th>Product</th><th>Status</th><th>Public preview</th></tr></thead><tbody>{products.map((p)=><tr><td><a class="row-link" href={`/products/${p.id}/`}>{p.name_bg||`Row #${p.id}`}</a></td><td><span class={`status ${isProductActive(p.is_active)?"":"hidden"}`}>{isProductActive(p.is_active)?"Active":"Hidden"}</span></td><td>{p.slug?<a href={`${(import.meta.env.SITE_ORIGIN||"https://bulgaritam.bg").replace(/\/$/,"")}/p/${p.slug}/`} target="_blank">Preview ↗</a>:"—"}</td></tr>)}</tbody></table>{!products.length&&<div class="empty">No Products are linked to this Brand.</div>}</section></AdminLayout>
