---
const { title = "Admin", active = "" } = Astro.props;
const nav = [["overview","/","Overview"],["products","/products/","Products"],["brands","/brands/","Brands"],["import","/import/","Import"],["analytics","/analytics/","Analytics"],["publish","/publish/","Publish"]];
---
<!doctype html>
<html lang="en">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex,nofollow" /><title>{title} · Bulgaritam Admin</title></head>
  <body>
    <aside><a class="logo" href="/">Bulgaritam <span>Admin</span></a><nav>{nav.map(([key,href,label]) => <a class={active === key ? "active" : ""} href={href}>{label}</a>)}</nav><form method="post" action="/logout/"><button class="logout">Log out</button></form></aside>
    <main><slot /></main>
  </body>
</html>
<style is:global>
  :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif;color:#272622;background:#f5f1eb;--green:#315b4c;--line:#ded8cf;--danger:#9c3838}*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;grid-template-columns:220px 1fr}aside{background:#252c29;color:#fff;padding:26px 18px;display:flex;flex-direction:column;position:sticky;top:0;height:100vh}.logo{font-family:Georgia,serif;font-size:22px;color:#fff;text-decoration:none;margin:0 10px 30px}.logo span{display:block;font:11px Inter,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#b9c7c1;margin-top:4px}nav{display:grid;gap:5px}nav a{color:#dce4e0;text-decoration:none;padding:11px 12px;border-radius:8px}nav a:hover,nav a.active{background:#3b4742;color:#fff}.logout{margin-top:auto;width:100%;background:transparent;border:1px solid #59645f;color:#fff}aside form{margin-top:auto}main{padding:34px;max-width:1500px;width:100%}h1{font:700 34px Georgia,serif;margin:0}h2{font-size:18px}.head{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:26px}.actions{display:flex;gap:10px;align-items:center}.btn,button{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:8px;padding:10px 15px;background:var(--green);color:#fff;text-decoration:none;font-weight:650;cursor:pointer;font-size:14px}.btn.secondary,button.secondary{background:#fff;color:#333;border:1px solid var(--line)}button.danger{background:var(--danger)}.panel{background:#fff;border:1px solid var(--line);border-radius:12px;padding:20px;margin-bottom:20px}.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.metric{background:#fff;border:1px solid var(--line);padding:20px;border-radius:12px}.metric b{display:block;font-size:30px;margin-top:7px}.muted{color:#777;font-size:14px}.notice{padding:12px 15px;border-radius:8px;background:#e5f3eb;color:#204c38;margin-bottom:18px}.error{padding:12px 15px;border-radius:8px;background:#fbe9e7;color:#842b27;margin-bottom:18px}.filters{display:flex;gap:10px;flex-wrap:wrap}.filters input,.filters select{min-width:180px}input,select,textarea{width:100%;font:inherit;color:inherit;padding:10px 11px;border:1px solid #cbc5bc;border-radius:7px;background:#fff}textarea{min-height:110px;resize:vertical}label{display:grid;gap:6px;font-size:13px;font-weight:650}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.span-2{grid-column:span 2}.check{display:flex;align-items:center;gap:8px}.check input{width:auto}table{width:100%;border-collapse:collapse}th,td{text-align:left;border-bottom:1px solid #ece7df;padding:11px 9px;font-size:14px;vertical-align:top}th{color:#6f6b65;font-size:12px;text-transform:uppercase;letter-spacing:.04em}.status{display:inline-block;padding:4px 8px;border-radius:999px;background:#e5f3eb;color:#275c43;font-size:12px;font-weight:700}.status.hidden{background:#eeeae5;color:#6d655c}.row-link{font-weight:700;color:#234c3d;text-decoration:none}.row-link:hover{text-decoration:underline}.empty{text-align:center;padding:45px;color:#777}.hint{font-size:12px;color:#777;font-weight:400}.warning{background:#fff7dc;border-color:#eadba8}.login-wrap{min-height:100vh;display:grid;place-items:center;padding:20px}.login-card{width:min(420px,100%);background:#fff;padding:30px;border-radius:14px;border:1px solid var(--line)}@media(max-width:850px){body{display:block}aside{height:auto;position:static;padding:14px}.logo{margin:0 0 12px}nav{display:flex;overflow:auto}aside form{position:absolute;right:14px;top:14px}.logout{font-size:0;padding:8px}.logout:after{content:'Exit';font-size:13px}main{padding:20px}.cards{grid-template-columns:repeat(2,1fr)}.form-grid{grid-template-columns:1fr}.span-2{grid-column:auto}.table-wrap{overflow:auto}}
</style>
