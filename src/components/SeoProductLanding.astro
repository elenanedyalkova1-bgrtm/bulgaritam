      gap: 12px;
    }

    .seo-editorial__content p {
      margin: 0;
      line-height: 1.76;
      color: rgba(26, 26, 26, 0.78);
    }

    .seo-editorial[open] .seo-editorial__toggle {
      background: rgba(26, 26, 26, 0.08);
    }

    .price--inline {
      font-size: 12px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: rgba(26, 26, 26, 0.62);
    }

    .card-titlelink {
      display: block;
      font-size: clamp(20px, 2vw, 24px);
      line-height: 1.14;
      letter-spacing: -0.02em;
      text-decoration: none;
      text-wrap: balance;
    }

    .card-sub {
      margin-top: 8px;
      min-height: 20px;
      font-size: 14px;
      color: rgba(26, 26, 26, 0.62);
    }

    .brand-link {
      color: inherit;
      text-decoration: none;
    }

    .brand-link:hover,
    .card-titlelink:hover {
      text-decoration: underline;
    }

    .card-foot {
      padding: 0 16px 16px;
    }

    .cta-out {
      width: auto;
      min-height: 40px;
      padding: 10px 14px;
      justify-content: center;
      background: transparent;
      border: 1px solid rgba(26, 26, 26, 0.1);
      color: rgba(26, 26, 26, 0.76);
      font-size: 13px;
      text-decoration: none;
      display: inline-flex;
      border-radius: 999px;
    }

    .cta-out:hover {
      background: rgba(95, 127, 107, 0.08);
      border-color: rgba(95, 127, 107, 0.22);
      color: rgba(26, 26, 26, 0.92);
    }

    @media (max-width: 1024px) {
      .grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .grid.grid--ordered {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 768px) {
      .landing-refinements__panel {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .grid {
        width: 100%;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        justify-content: stretch;
        gap: 12px;
      }

      .grid.grid--ordered {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .card {
        margin-bottom: 14px;
        border-radius: 24px;
      }

      .thumb {
        border-radius: 24px 24px 0 0;
      }

      .card-body {
        padding: 10px 10px 6px;
      }

      .card-meta-row {
        flex-wrap: wrap;
      }

      .card-titlelink {
        font-size: clamp(16px, 4.3vw, 19px);
      }

      .card-sub {
        font-size: 12px;
      }

      .card-foot {
        padding: 0 10px 10px;
      }

      .cta-out {
        width: 100%;
        min-height: 36px;
        font-size: 10px;
      }

      .save-btn--card {
        width: 40px;
        height: 40px;
      }
    }

    @media (max-width: 640px) {
      .landing-refinements[open] { max-height: min(76vh, 680px); overflow-y: auto; }
      .landing-refinements__sticky-close { display: block; position: sticky; bottom: 0; z-index: 2; padding-top: 10px; background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,.98) 28%); }
      .landing-refinements__summary {
        padding: 14px 16px;
      }

      .landing-refinements__panel {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        padding: 0 14px 14px;
      }

      .landing-refinements__option {
        min-height: 42px;
        padding: 0 12px;
      }

      .landing-refinements__option span {
        font-size: 12px;
      }

      .landing-subcategories {
        justify-content: center;
      }

      [data-mobile-gift-pills="true"] .is-mobile-longtail { display: none; }
      [data-mobile-gift-pills="true"].is-expanded .is-mobile-longtail { display: inline-flex; }
      .landing-gift-more {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 16px;
        border: 0;
        background: transparent;
        color: var(--accent-strong);
        font: 700 14px var(--font-body);
        text-decoration: underline;
        text-underline-offset: 4px;
        cursor: pointer;
      }

      .grid {
        width: 100%;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        justify-content: stretch;
        gap: 10px;
      }

      .grid.grid--ordered {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .card {
        margin-bottom: 12px;
      }

      .seo-editorial__grid {
        grid-template-columns: 1fr;
      }

      .seo-editorial__toggle {
        min-height: 34px;
        padding: 0 12px;
        font-size: 11px;
      }

      .seo-editorial__content p,
      .seo-editorial__intro {
        font-size: 15px;
        line-height: 1.7;
      }
    }
  </style>

  <script is:inline>
    const grid = document.getElementById("grid");
    const count = document.getElementById("count");
    const feedStatus = document.getElementById("feedStatus");
    const feedSentinel = document.getElementById("feedSentinel");
    const feedLoadMore = document.getElementById("feedLoadMore");
    let allCards = Array.from(grid.querySelectorAll("li.card"));
    const refinementInputs = Array.from(document.querySelectorAll("[data-refinement-input]"));
    const feedSection = document.getElementById("products");
    const refinements = feedSection?.querySelector(".landing-refinements");
    const landingSortSelect = document.getElementById("landing-sort-select");
    const collectionPagination = feedSection?.querySelector(".collection-pagination");
    const parseJson = (value, fallback) => { try { return JSON.parse(value || "") || fallback; } catch { return fallback; } };
    const seoStateRegistry = new Map(parseJson(feedSection?.dataset.seoStateRegistry, []).map((entry) => [entry.stateKey, entry.path]));
    const baseStructuredState = parseJson(feedSection?.dataset.baseStructuredState, {});
    const splitFacetValues = (value) => String(value || "").split("|").map((entry) => entry.trim()).filter(Boolean);
    let loadedThroughPage = Number(feedSection?.dataset.currentPage || 1);
    const loadedStaticPages = new Set([loadedThroughPage]);
    const totalPages = Number(feedSection?.dataset.totalPages || 1);
    const totalItems = Number(feedSection?.dataset.totalItems || allCards.length);
    const collectionPath = feedSection?.dataset.collectionPath || feedSection?.dataset.canonicalPath || window.location.pathname;
    let pageLoadPromise = null;
    let appendInProgress = false;
    const pageUrl = (page) => page === 1 ? collectionPath : `${collectionPath.replace(/\/$/, "")}/page/${page}/`;
    const loadStaticPage = async (page) => {
      if (loadedStaticPages.has(page) || page < 1 || page > totalPages) return false;
      if (pageLoadPromise) return pageLoadPromise;
      pageLoadPromise = fetch(pageUrl(page), { credentials: "same-origin" })
        .then((response) => { if (!response.ok) throw new Error(`Pagination ${response.status}`); return response.text(); })
        .then((html) => {
          const documentPage = new DOMParser().parseFromString(html, "text/html");
          const existing = new Set(allCards.map((card) => card.dataset.productSlug));
          const added = Array.from(documentPage.querySelectorAll("#grid li.card"))
            .filter((card) => !existing.has(card.dataset.productSlug));
          added.forEach((card) => { card.style.display = "none"; grid.appendChild(document.importNode(card, true)); });
          allCards = Array.from(grid.querySelectorAll("li.card"));
          allCards.forEach((card, index) => { if (!card.dataset.originalPosition) card.dataset.originalPosition = card.dataset.position || String(index + 1); });
          loadedStaticPages.add(page);
          loadedThroughPage = Math.max(loadedThroughPage, page);
          window.dispatchEvent(new CustomEvent("bulgaritam:products-appended", { detail: { nodes: allCards.slice(-added.length) } }));
          if (typeof window.syncSaveButtons === "function") window.syncSaveButtons();
          return added.length > 0;
        })
        .finally(() => { pageLoadPromise = null; });
      return pageLoadPromise;
    };
    const ensureAllStaticPages = async () => {
      for (let page = 1; page <= totalPages; page += 1) await loadStaticPage(page);
    };
    const cardFacetKey = (group) => group === "material" ? "materials" : group;
    const stateFacetKey = (group) => ({ type: "product_type", material: "materials", color: "colors" })[group] || group;
    const cardFacetValues = (card, group) => {
      try {
        const values = JSON.parse(card.dataset.facetValues || "{}")[cardFacetKey(group)];
        return Array.isArray(values) ? values.map((value) => String(value).trim()).filter(Boolean) : [];
      } catch {
        return [];
      }
    };

    const getBatchSize = () => {
      if (window.innerWidth <= 640) return 8;
      if (window.innerWidth <= 768) return 10;
      return 16;
    };

    let visibleCount = getBatchSize();
    let lastTrackedResultCount = 0;
    const supportedSorts = new Set(["featured", "price-asc", "price-desc", "alpha-asc", "alpha-desc"]);
    const requestedSort = new URLSearchParams(window.location.search).get("sort") || "";
    let selectedSort = supportedSorts.has(requestedSort) ? requestedSort : "featured";
    if (landingSortSelect) landingSortSelect.value = selectedSort;
    let filtersTouched = false;
    allCards.forEach((card, index) => { card.dataset.originalPosition = card.dataset.position || String(index + 1); });
    const numericPrice = (card) => { const min = Number(card.dataset.priceMin); const max = Number(card.dataset.priceMax); return Number.isFinite(min) && min > 0 ? min : Number.isFinite(max) && max > 0 ? max : Number.POSITIVE_INFINITY; };
    const originalPosition = (card) => Number(card.dataset.originalPosition || Number.MAX_SAFE_INTEGER);
    const sortCards = (cards) => [...cards].sort((a, b) => {
      if (selectedSort === "featured") return originalPosition(a) - originalPosition(b);
      if (selectedSort === "alpha-asc") return String(a.dataset.productName || "").localeCompare(String(b.dataset.productName || ""), "bg") || originalPosition(a) - originalPosition(b);
      if (selectedSort === "alpha-desc") return String(b.dataset.productName || "").localeCompare(String(a.dataset.productName || ""), "bg") || originalPosition(a) - originalPosition(b);
      const ap = numericPrice(a), bp = numericPrice(b), am = !Number.isFinite(ap), bm = !Number.isFinite(bp);
      if (am !== bm) return am ? 1 : -1;
      if (am && bm) return originalPosition(a) - originalPosition(b);
      return (selectedSort === "price-desc" ? bp - ap : ap - bp) || originalPosition(a) - originalPosition(b);
    });

    const serializeState = (state) => Object.entries(state)
      .filter(([, values]) => Array.isArray(values) && values.length)
      .sort(([a], [b]) => a.localeCompare(b))
      .map(([field, values]) => `${field}=${[...new Set(values.map((value) => String(value).trim().toLowerCase()).filter(Boolean))].sort().join("|")}`)
      .join("&");

    const currentStructuredState = () => {
      const state = Object.fromEntries(Object.entries(baseStructuredState).map(([field, values]) => [field, [...values]]));
      const mutableFields = new Set(refinementInputs.map((input) => stateFacetKey(input.dataset.filterGroup || "type")));
      mutableFields.forEach((field) => delete state[field]);
      refinementInputs.filter((input) => input.checked).forEach((input) => {
        const field = stateFacetKey(input.dataset.filterGroup || "type");
        (state[field] ||= []).push(input.value);
      });
      return state;
    };

    const startCanonicalNavigation = () => {
      const state = currentStructuredState();
      const destination = seoStateRegistry.get(serializeState(state));
      if (!destination || destination === feedSection?.dataset.canonicalPath) return;
      let prefetchLink = document.head.querySelector(`link[data-seo-filter-prefetch][href="${destination}"]`);
      if (!prefetchLink) {
        prefetchLink = document.createElement("link");
        prefetchLink.rel = "prefetch";
        prefetchLink.href = destination;
        prefetchLink.dataset.seoFilterPrefetch = "true";
        document.head.append(prefetchLink);
      }
      sessionStorage.setItem("bulgaritam:seo-filter-transition", JSON.stringify({ destination, state, filtersOpen: Boolean(refinements?.open), anchor: "products" }));
      requestAnimationFrame(() => window.location.assign(destination));
    };

    const restoreTransitionState = () => {
      const saved = parseJson(sessionStorage.getItem("bulgaritam:seo-filter-transition"), null);
      if (!saved || saved.destination !== feedSection?.dataset.canonicalPath) return;
      sessionStorage.removeItem("bulgaritam:seo-filter-transition");
      refinementInputs.forEach((input) => {
        const values = saved.state?.[stateFacetKey(input.dataset.filterGroup || "type")] || [];
        input.checked = values.some((value) => String(value).toLowerCase() === String(input.value).toLowerCase());
      });
      if (saved.filtersOpen && refinements) refinements.open = true;
      requestAnimationFrame(() => document.getElementById(saved.anchor || "products")?.scrollIntoView({ block: "start" }));
    };

    refinementInputs.forEach((input) => {
      const values = baseStructuredState[stateFacetKey(input.dataset.filterGroup || "type")] || [];
      input.checked = values.some((value) => String(value).toLowerCase() === String(input.value).toLowerCase());
    });
    restoreTransitionState();

    const getFilteredCards = () => {
      const selected = {};
      refinementInputs.filter((input) => input.checked).forEach((input) => {
        const group = input.dataset.filterGroup || "type";
        (selected[group] ||= []).push(input.value);
      });
      return allCards.filter((card) => {
        const hasSelection = Object.values(selected).some((entries) => entries.length);
        if (!hasSelection && card.dataset.initialMatch !== "1") return false;
        return Object.entries(selected).every(([group, entries]) => !entries.length || entries.some((entry) => cardFacetValues(card, group).includes(entry)));
      });
    };

    const updateFacetAvailability = () => {
      const selectionsByGroup = () => refinementInputs.filter((input) => input.checked).reduce((groups, input) => {
        const name = input.dataset.filterGroup || "type";
        (groups[name] ||= []).push(input.value);
        return groups;
      }, {});
      document.querySelectorAll("[data-facet-group]").forEach((group) => {
        const groupName = group.dataset.facetGroup;
        const selected = selectionsByGroup();
        delete selected[groupName];
        const candidates = allCards.filter((card) => Object.entries(selected).every(([name, values]) =>
          values.some((value) => cardFacetValues(card, name).includes(value))
        ));
        let available = 0;
        group.querySelectorAll("[data-facet-option]").forEach((option) => {
          const input = option.querySelector("input");
          const count = candidates.filter((card) => {
            return cardFacetValues(card, groupName).includes(input.value);
          }).length;
          option.hidden = count === 0 && !input.checked;
          input.disabled = count === 0 && !input.checked;
          const label = option.querySelector("[data-option-label]");
          if (label) label.textContent = `${label.dataset.optionLabel} (${count})`;
          if (count > 0 || input.checked) available += 1;
        });
        const hasSelectedOption = Array.from(group.querySelectorAll("input")).some((input) => input.checked);
        if (groupName !== "type") group.hidden = available < 2 && !hasSelectedOption;
      });
      document.querySelectorAll("[data-collapsible-facet]").forEach((panel) => {
        const options = Array.from(panel.querySelectorAll("[data-facet-option]")).filter((option) => !option.hidden);
        let button = panel.parentElement?.querySelector(":scope > .landing-refinements__more");
        if (options.length <= 8) { options.forEach((option) => option.classList.remove("is-overflow-option")); button?.remove(); return; }
        if (!button) { button = document.createElement("button"); button.type = "button"; button.className = "landing-refinements__more"; panel.insertAdjacentElement("afterend", button); }
        const expanded = button.getAttribute("aria-expanded") === "true";
        options.forEach((option, index) => option.classList.toggle("is-overflow-option", !expanded && index >= 8 && !option.querySelector("input")?.checked));
        button.textContent = expanded ? "Покажи по-малко" : `Покажи още (${options.length - 8})`;
        button.setAttribute("aria-expanded", String(expanded));
        button.onclick = () => { button.setAttribute("aria-expanded", String(!expanded)); updateFacetAvailability(); };
      });
    };

    const updateFeedVisibility = () => {
      const filteredCards = sortCards(getFilteredCards());
      const activeFilters = refinementInputs
        .filter((input) => input.checked)
        .map((input) => input.value);

      grid?.classList.remove("grid--ordered");

      grid?.classList.remove("is-masonry-ready");

      allCards.forEach((card) => {
        card.style.display = "none";
        card.style.removeProperty("--masonry-span");
      });

      filteredCards.forEach((card) => grid?.appendChild(card));

      filteredCards.forEach((card, index) => {
        card.dataset.position = String(index + 1);
        card.style.display = index < visibleCount ? "" : "none";
      });

      // Preselected collection facets are the base membership, not a user refinement.
      const hasActiveSelection = serializeState(currentStructuredState()) !== serializeState(baseStructuredState);
      if (collectionPagination) collectionPagination.hidden = filtersTouched;
      const resolvedResultCount = !hasActiveSelection && loadedThroughPage < totalPages ? totalItems : filteredCards.length;
      if (count) count.textContent = String(resolvedResultCount);

      if (feedStatus) {
        const shown = Math.min(visibleCount, filteredCards.length);
        feedStatus.textContent = resolvedResultCount > shown ? `Показани ${shown} от ${resolvedResultCount}` : "";
      }

      if (feedSentinel) {
        feedSentinel.hidden = filteredCards.length <= visibleCount && loadedThroughPage >= totalPages;
      }
      if (feedLoadMore) feedLoadMore.hidden = filteredCards.length <= visibleCount && loadedThroughPage >= totalPages;

      updateFacetAvailability();
      lastTrackedResultCount = filteredCards.length;
      window.bulgaritamScheduleMasonry?.(grid);
      return filteredCards;
    };

    const commitSeoDiscoveryState = (filteredCards) => {
      const structured = currentStructuredState();
      const first = (key) => Array.isArray(structured[key]) ? structured[key][0] || null : null;
      return window.bulgaritamCommitDiscoveryState?.({
        surface_type: "seo_landing_page",
        category: first("category"),
        subcategory: first("subcategory"),
        product_type: first("product_type"),
        gift_recipient: first("recipient_age") || first("recipient_gender"),
        gift_occasion: first("gift_occasion"),
        active_filters: structured,
        metadata: { canonical_path: feedSection?.dataset.canonicalPath || window.location.pathname },
      }, filteredCards.map((card) => ({ node: card, entity_type: "product", product_id: card.dataset.productId || "", brand_id: card.dataset.brandId || "" })));
    };

    const loadMore = async () => {
      if (appendInProgress) return;
      appendInProgress = true;
      try {
      if (visibleCount >= getFilteredCards().length && loadedThroughPage < totalPages) {
        await loadStaticPage(loadedThroughPage + 1);
      }
      if (visibleCount >= getFilteredCards().length) return;
      visibleCount += getBatchSize();
      updateFeedVisibility();
      } finally {
        appendInProgress = false;
        if (feedSentinel && !feedSentinel.hidden) {
          const rect = feedSentinel.getBoundingClientRect();
          if (rect.top <= window.innerHeight + 320 && rect.bottom >= -320) requestAnimationFrame(loadMore);
        }
      }
    };

    commitSeoDiscoveryState(updateFeedVisibility());

    refinementInputs.forEach((input) => {
      input.addEventListener("change", async () => {
        filtersTouched = true;
        await ensureAllStaticPages();
        const resultsBefore = lastTrackedResultCount;
        visibleCount = getBatchSize();
        const filteredCards = updateFeedVisibility();
        window.bulgaritamTrack?.("apply_filter", { filter_name: input.dataset.filterGroup || "facet", filter_value: input.value, selected_value: input.value, filter_action: input.checked ? "add" : "remove", results_before: resultsBefore, results_after: lastTrackedResultCount, result_count: lastTrackedResultCount, source_context: "seo_landing_page" });
        commitSeoDiscoveryState(filteredCards);
        startCanonicalNavigation();
      });
    });
    landingSortSelect?.addEventListener("change", async (event) => {
      await ensureAllStaticPages();
      selectedSort = event.target.value || "featured";
      visibleCount = getBatchSize();
      commitSeoDiscoveryState(updateFeedVisibility());
    });
    refinements?.querySelector("[data-refinements-close]")?.addEventListener("click", () => {
      refinements.open = false;
      refinements.querySelector("summary")?.focus();
    });
    feedLoadMore?.addEventListener("click", loadMore);

    if ("IntersectionObserver" in window && feedSentinel) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) loadMore();
        });
      }, { rootMargin: "320px 0px" });

      observer.observe(feedSentinel);
    }

    window.addEventListener("resize", () => {
      visibleCount = Math.max(visibleCount, getBatchSize());
      updateFeedVisibility();
    });

    const mobileGiftPills = document.querySelector('[data-mobile-gift-pills="true"]');
    const giftMoreButton = mobileGiftPills?.querySelector(".landing-gift-more");
    giftMoreButton?.addEventListener("click", () => {
      const expanded = !mobileGiftPills.classList.contains("is-expanded");
      mobileGiftPills.classList.toggle("is-expanded", expanded);
      giftMoreButton.setAttribute("aria-expanded", String(expanded));
      giftMoreButton.textContent = expanded ? "Скрий допълнителните идеи" : "Още идеи за подарък";
    });
  </script>
</BaseLayout>
<style>
  .landing-breadcrumbs{margin:0 0 18px;font:600 13px/1.4 var(--font-body);color:rgba(26,26,26,.62)}.landing-breadcrumbs ol{display:flex;flex-wrap:wrap;gap:6px;list-style:none;margin:0;padding:0}.landing-breadcrumbs li:not(:last-child)::after{content:"/";margin-left:6px;color:rgba(26,26,26,.32)}.landing-breadcrumbs a{text-decoration:none}.landing-breadcrumbs a:hover{text-decoration:underline}@media(max-width:640px){.landing-breadcrumbs{margin-bottom:14px;text-align:left}}
</style>
