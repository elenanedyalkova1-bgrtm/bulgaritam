---
import SeoProductLanding from "../components/SeoProductLanding.astro";
import { getIntentLandingByKey, getProductsForIntentLanding, getClothingEditorialForLanding, getLandingPageHierarchy } from "../lib/seo-landings";
import { loadProducts } from "../lib/products";

const allProducts = await loadProducts();
const landing = getIntentLandingByKey("mens_shoes");

if (!landing) throw new Error("Missing mens shoes landing");

const products = getProductsForIntentLanding(allProducts, landing);
const hierarchy = getLandingPageHierarchy(landing, allProducts);

const clothingEditorial = getClothingEditorialForLanding(landing);
---

<SeoProductLanding
  landing={hierarchy.seoLanding}
  products={products}
  browseProducts={allProducts}
  canonicalPath={landing.path}
  breadcrumbs={hierarchy.breadcrumbs}
  primaryPills={hierarchy.primaryPills}
  secondaryPills={hierarchy.secondaryPills}
  parentLink={hierarchy.parentLink}
  secondaryPillsTitle="Още от мъжката мода"
  editorialHeader={clothingEditorial?.header}
  editorialSections={clothingEditorial?.sections || []}
/>
