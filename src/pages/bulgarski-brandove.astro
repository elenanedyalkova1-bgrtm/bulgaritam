---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadBrands } from "../lib/brands";
import { OCCASION_FILTERS, OCCASION_GROUPS, getOccasionKeysForProduct } from "../lib/occasions";
import { loadProducts } from "../lib/products";
import { buildSearchDocument } from "../lib/search";
import { getTaxonomyForProduct, getTopLevelCategories } from "../lib/taxonomy";

const [products, brandsSheet] = await Promise.all([loadProducts(), loadBrands()]);
const categories = getTopLevelCategories();

const brandsMap = new Map();
const brandsBySlug = new Map(brandsSheet.map((brand) => [brand.brand_slug, brand]));

for (const p of products) {
  if (!p.brand_slug) continue;

  const taxonomy = getTaxonomyForProduct(p);
  if (!taxonomy.categoryKeys.length) continue;

  const entry = brandsMap.get(p.brand_slug) || {
    name: p.brand_name || p.brand_slug,
    slug: p.brand_slug,
    keys: new Set(),
    occasionKeys: new Set(),
    count: 0,
    previewImages: [],
    newestCreatedAt: 0,
    searchText: "",
    rawSearchText: "",
  };

  taxonomy.categoryKeys.forEach((key) => entry.keys.add(key));
  getOccasionKeysForProduct(p).forEach((key) => entry.occasionKeys.add(key));
  entry.count += 1;
  if (p.image_urls?.[0] && entry.previewImages.length < 3) {
    entry.previewImages.push(p.image_urls[0]);
  }
  const createdAt = p.created_at ? Date.parse(p.created_at) : 0;
  if (!Number.isNaN(createdAt) && createdAt > entry.newestCreatedAt) {
    entry.newestCreatedAt = createdAt;
  }
  entry.searchText = buildSearchDocument(
    entry.searchText,
    p.name_bg,
    p.brand_name,
    p.category,
    taxonomy.categoryLabel,
    taxonomy.subcategoryLabels,
    p.tags,
    p.short_desc_bg,
    p.long_desc_bg
  );
  entry.rawSearchText = [
    entry.rawSearchText,
    p.name_bg,
    p.brand_name,
    p.category,
    taxonomy.categoryLabel,
    Array.isArray(taxonomy.subcategoryLabels) ? taxonomy.subcategoryLabels.join(" ") : taxonomy.subcategoryLabels,
    Array.isArray(p.tags) ? p.tags.join(" ") : p.tags,
    p.short_desc_bg,
    p.long_desc_bg,
  ]
    .filter(Boolean)
    .join(" ");

  brandsMap.set(p.brand_slug, entry);
}

const brands = Array.from(brandsMap.values()).map((b) => ({
  ...b,
  logo: brandsBySlug.get(b.slug)?.brand_logo_url || "",
  intro: brandsBySlug.get(b.slug)?.intro_bg || "",
  deliversAbroad: Boolean(brandsBySlug.get(b.slug)?.delivers_abroad),
  keys: Array.from(b.keys),
  occasionKeys: Array.from(b.occasionKeys || []),
  searchText: buildSearchDocument(b.searchText, brandsBySlug.get(b.slug)?.intro_bg || "", b.name),
  rawSearchText: [b.rawSearchText, brandsBySlug.get(b.slug)?.intro_bg || "", b.name, b.slug].filter(Boolean).join(" "),
}));


// SEO
const title = "Български брандове – каталог на родни марки | Българитъм";
const description =
  "Открий подбрани български брандове и родни производители по категории – дом и интериор, козметика, облекло, подаръци и още.";
const canonical = "https://bulgaritam.bg/bulgarski-brandove/";

const editorialSections = [
  {
    title: "Защо все повече хора търсят български брандове",
    paragraphs: [
      "Когато търсиш български брандове, рядко търсиш само още един продукт. По-често търсиш усещане за близост, по-честен произход и онова приятно чувство, че избираш нещо направено с мисъл, а не просто произведено на конвейер. Българските марки често започват от лична нужда, от семейна история, от малко ателие, лаборатория или студио, в което всеки детайл минава през ръцете на хора, които стоят зад името си. Това се усеща в начина, по който е формулиран един козметичен продукт, в начина, по който е ушита една дреха, в избора на дърво, метал, текстил или аромат при продуктите за дома. Именно затова страницата за български брандове не е просто каталог, а място, в което можеш да се ориентираш по-лесно между различни стилове, категории и начини на създаване.",
      "За много хора покупката от местен производител означава и по-кратък път между идеята и човека, който ще използва продукта. Това не гарантира автоматично качество, но много често означава повече внимание, по-малки серии, по-ясна комуникация и по-голям шанс да попаднеш на нещо, което не изглежда като копие на всичко останало. В Българитъм събираме такива марки на едно място, за да не губиш часове в Instagram, в разпръснати профили, хаотични търсения и случайни попадения. Тук идеята е да откриваш по-спокойно, по-смислено и с повече контекст."
    ],
  },
  {
    title: "Какво всъщност отличава добрите български марки",
    paragraphs: [
      "Добрите български марки не се разпознават само по това, че са локални. Те се разпознават по последователността си. Ако става дума за козметика, това често означава внимателно подбрани съставки, по-ясна философия на грижата и желание продуктът да бъде разбран, а не просто продаден. Ако става дума за дом и интериор, разликата често е в материала, в усещането за текстура, в това как един предмет стои в ежедневието ти и дали може да остане с теб дълго. При облеклото и аксесоарите пък личи в кройката, в малките серии, в това, че не всичко е направено за масов вкус, а за конкретен човек, настроение и стил.",
      "Има и нещо по-тихо, но много важно: много български брандове създават продукти, които носят повече човешка мярка. Те не се опитват да бъдат всичко за всички. Затова често изглеждат по-искрени, по-разпознаваеми и по-лесни за обичане. Точно тази разлика искаме да стане видима и в начина, по който се разглеждат. Вместо да подреждаме марките като безличен списък, се стремим да ги поставим в контекст: в категории, в употреби, в стилове и в ситуации, в които наистина биха били полезни."
    ],
  },
  {
    title: "Български брандове за дом, грижа, подарък и ежедневие",
    paragraphs: [
      "Една от причините хората да търсят български марки е, че днес локалното производство присъства в почти всяка част от живота ни. В рамките на едно и също място можеш да откриеш свещи, домашен текстил, детски продукти, козметика, чайове, добавки, подаръчни комплекти, дрехи, бижута и малки предмети, които правят ежедневието по-красиво. Това разнообразие е прекрасно, но и объркващо, ако не е подредено добре. Затова на страницата за български брандове категориите не са просто етикети. Те са начин да започнеш от нуждата си: дали търсиш нещо за дома, за ритуал на грижа, за дете, за повод или за подарък.",
      "Когато тази структура работи добре, откриването става много по-леко. Ако например знаеш, че искаш българска козметика, можеш бързо да видиш кои марки реално работят в тази посока. Ако обзавеждаш кът у дома или търсиш малък предмет с характер, можеш да влезеш през дом и интериор. Ако искаш подарък, който да носи история и усещане за отношение, можеш да разглеждаш марки, които създават комплекти, ръчно направени предмети или продукти, свързани с грижа, аромат, текстил и дизайн. Това прави избора не просто по-бърз, а и по-личен."
    ],
  },
  {
    title: "Как да използваш страницата по-умно, когато търсиш конкретен тип марка",
    paragraphs: [
      "Ако идваш тук с конкретна идея, най-добрият подход е да комбинираш категориите с търсенето по ключова дума. Така вместо да преглеждаш всичко, можеш да стигнеш по-бързо до по-релевантни марки. Например можеш да търсиш свещи, чанти, натурална козметика, детски играчки, лен, бижута или име на вече познат бранд. Това е особено полезно, когато знаеш типа продукт, но още не знаеш коя точно марка би паснала на вкуса ти. Подредбата също помага: понякога искаш да видиш подбраните марки първо, понякога търсиш нещо ново, а понякога просто искаш да минеш азбучно, за да сравняваш по-лесно.",
      "Ако идваш без конкретна заявка, тогава страницата работи по друг начин: като място за откриване. Тук можеш да започнеш от визуалното усещане, от краткото интро, от категориите на даден бранд и да си позволиш да попаднеш на нещо, което не си търсила пряко. Именно в това е чарът на доброто търсене онлайн. То не е просто филтриране. То е усещане, че сред много избори постепенно намираш онези марки, които сякаш говорят на твоя език."
    ],
  },
  {
    title: "Защо това има значение и отвъд самата покупка",
    paragraphs: [
      "Да откриваш български брандове по-лесно има значение не само за самия потребител, но и за средата, в която живеем. Когато добрите локални марки са по-видими, повече хора достигат до тях навреме, а не след безкрайно ровене и случайни препоръки. Това означава повече шанс за малките производители, повече устойчивост за студията и ателиетата, повече пространство за смислен дизайн и по-малко нужда всичко да минава през шумни алгоритми. В такъв контекст пазаруването не е просто транзакция. То става избор за това какъв вкус, каква грижа и какъв тип отношение искаме да подкрепяме.",
      "Затова в Българитъм не гледаме на страницата за български брандове като на проста директория. Гледаме на нея като на навигационна точка към по-добро откриване: място, където можеш да намериш марки, които правят ежедневието по-красиво, грижата по-смислена, дома по-личен и подаръците по-топли. Това е причината да подреждаме информацията така, че да има и структура, и атмосфера. Защото когато зад един продукт стои истинска работа, заслужава и начинът на откриване да бъде малко по-внимателен."
    ],
  },
];
---

<BaseLayout
  seo={{
    type: "category",
    title,
    description,
    data: {
      category: "брандове",
      description,
      breadcrumbs: [
        { name: "Начало", item: "/" },
        { name: "Български брандове", item: "/bulgarski-brandove/" },
      ],
    },
  }}
  canonical={canonical}
  i18n={{
    en: {
      "brands.kicker": "Catalog",
      "brands.title": "Bulgarian brands",
      "brands.intro": "Discover Bulgarian brands by category, explore visually curated selections, and reach the brands that best fit your style, home, care rituals, or gift ideas more quickly.",
      "brands.sectionTitle": "Categories of Bulgarian brands",
      "brands.searchLabel": "Search brand",
      "brands.searchPlaceholder": "e.g. cosmetics, bags, candles, Saff",
      "brands.sortLabel": "Sort",
      "brands.sort.featured": "Featured",
      "brands.sort.alphaAsc": "Alphabetical: A–Z",
      "brands.sort.alphaDesc": "Alphabetical: Z–A",
      "brands.sort.dateDesc": "Date added: newest",
      "brands.sort.dateAsc": "Date added: oldest",
      "brands.occasion": "Occasion",
      "brands.all": "All",
      "brands.curatedTitle": "Curated Bulgarian brands",
      "brands.productsCount": "products",
      "brands.categoriesCount": "categories",
      "brands.explore": "Explore brand →",
      "brands.empty": "There are no brands in this category yet.",
      "brands.occasionEyebrow": "Browse by mood",
      "brands.occasionTitle": "Occasion",
      "brands.readMore": "Read more"
    }
  }}
>
  <main class="page-shell">
    <header class="page-head">
      <p class="page-kicker" data-i18n="brands.kicker">Каталог</p>
      <h1 class="page-title" data-i18n="brands.title">Български брандове</h1>
      <p class="page-intro" data-i18n="brands.intro">
        Открий български марки по категории, разгледай визуално подбрани селекции и стигни по-бързо до брандовете, които най-добре пасват на твоя стил, дом, ритуали за грижа или идея за подарък.
      </p>
    </header>

    <!-- CATEGORIES -->
    <section class="section">
      <h2 class="section-title" data-i18n="brands.sectionTitle">Категории български брандове</h2>

      <div class="brand-discovery">
        <label class="brand-search" for="brand-search-input">
          <span class="brand-search__label" data-i18n="brands.searchLabel">Търси бранд</span>
          <input
            id="brand-search-input"
            class="brand-search__input"
            type="search"
            placeholder="напр. козметика, чанти, свещи, Saff"
            data-i18n-placeholder="brands.searchPlaceholder"
            autocomplete="off"
          />
        </label>

        <label class="brand-sort" for="brand-sort-select">
          <span class="brand-sort__label" data-i18n="brands.sortLabel">Подредба</span>
          <select id="brand-sort-select" class="brand-sort__select">
            <option value="featured" data-i18n="brands.sort.featured">Подбрани</option>
            <option value="alpha-asc" data-i18n="brands.sort.alphaAsc">Азбучно: А–Я</option>
            <option value="alpha-desc" data-i18n="brands.sort.alphaDesc">Азбучно: Я–А</option>
            <option value="date-desc" data-i18n="brands.sort.dateDesc">Дата на добавяне: нови</option>
            <option value="date-asc" data-i18n="brands.sort.dateAsc">Дата на добавяне: стари</option>
          </select>
        </label>

        <button
          id="brand-occasion-toggle"
          class="brand-occasion-trigger"
          type="button"
          aria-haspopup="dialog"
          aria-controls="brand-occasion-modal"
          aria-expanded="false"
        >
          <span data-i18n="brands.occasion">Повод</span>
          <span id="brand-occasion-badge" class="brand-occasion-trigger__badge" hidden>1</span>
        </button>

        <label class="brand-delivery-filter">
          <input id="brand-delivery-outside" type="checkbox" />
          <span>Доставя извън България</span>
        </label>
      </div>

      <div class="pills" id="brand-filters" aria-label="Филтри по категория">
        <button class="pill is-active" type="button" data-filter="all" data-i18n="brands.all">Всички</button>

        {categories.map((c) => (
          <button class="pill" type="button" data-filter={c.key} data-i18n-bg={c.chipLabel} data-i18n-en={c.chipLabelEn}>
            {c.chipLabel}
          </button>
        ))}
      </div>
    </section>

    <!-- BRANDS -->
    <section class="section">
      <h2 class="section-title" data-i18n="brands.curatedTitle">Подбрани български брандове</h2>

      <ul class="brand-grid" id="brand-grid">
        {brands.map((b, index) => (
          <li
            class="brand-card"
            data-brand
            data-brand-slug={b.slug}
            data-keys={b.keys.join(",")}
            data-occasion-keys={b.occasionKeys.join(",")}
            data-search={b.searchText}
            data-search-raw={b.rawSearchText}
            data-brand-name={b.name.toLowerCase()}
            data-created-at={b.newestCreatedAt || 0}
            data-delivers-abroad={b.deliversAbroad ? "1" : "0"}
            data-original-index={index}
          >
            <a class="brand-link" href={`/brand/${b.slug}/`}>
              <div class="brand-card__top">
                {b.logo ? (
                  <img
                    class="brand-logo"
                    src={b.logo}
                    alt={`${b.name} лого`}
                    loading="lazy"
                  />
                ) : (
                  <div class="brand-logo brand-logo--fallback" aria-hidden="true">
                    {b.name.slice(0, 1)}
                  </div>
                )}

                <div class="brand-headline">
                  <div class="brand-name">{b.name}</div>
                  <div class="brand-meta">
                    <span>{b.count} <span data-i18n="brands.productsCount">продукта</span></span>
                    <span>{b.keys.length} <span data-i18n="brands.categoriesCount">категории</span></span>
                  </div>
                </div>
              </div>

              {b.previewImages.length ? (
                <div class="brand-preview" aria-hidden="true">
                  {b.previewImages.map((image, index) => (
                    <div class:list={["brand-preview__item", index === 0 ? "is-featured" : ""]}>
                      <img src={image} alt="" loading="lazy" />
                    </div>
                  ))}
                </div>
              ) : null}

              {b.intro ? <p class="brand-intro">{b.intro}</p> : null}

              <div class="brand-cta" data-i18n="brands.explore">Разгледай марката →</div>
            </a>
          </li>
        ))}
      </ul>

      <!-- Optional empty state -->
      <p id="brand-empty" class="empty" hidden data-i18n="brands.empty">
        Няма брандове в тази категория засега.
      </p>
    </section>

    <div id="brand-occasion-modal" class="brand-occasion-modal" hidden>
      <div class="brand-occasion-modal__backdrop" data-brand-occasion-close></div>
      <div
        class="brand-occasion-modal__panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="brandOccasionTitle"
      >
        <div class="brand-occasion-modal__head">
          <div>
            <p class="brand-occasion-modal__eyebrow" data-i18n="brands.occasionEyebrow">Подбор по настроение</p>
            <h3 id="brandOccasionTitle" class="brand-occasion-modal__title" data-i18n="brands.occasionTitle">Повод</h3>
          </div>

          <button class="brand-occasion-modal__close" type="button" aria-label="Затвори" data-brand-occasion-close>
            ✕
          </button>
        </div>

        <div class="brand-occasion-sheet">
          {OCCASION_GROUPS.map((group) => (
            <section class="brand-occasion-group">
              <h4 class="brand-occasion-group__title" data-i18n-bg={group.label} data-i18n-en={group.labelEn}>{group.label}</h4>
              <div class="brand-occasion-options">
                {OCCASION_FILTERS.filter((occasion) => occasion.group === group.key).map((occasion) => (
                  <label class="brand-occasion-option">
                    <input type="checkbox" name="brandOccasionFilter" value={occasion.key} />
                    <span data-i18n-bg={occasion.label} data-i18n-en={occasion.labelEn}>{occasion.label}</span>
                  </label>
                ))}
              </div>
            </section>
          ))}
        </div>

        <div class="brand-occasion-modal__actions">
          <button id="brand-occasion-reset" class="brand-occasion-action brand-occasion-action--ghost" type="button">
            <span data-i18n="filters.clear">Изчисти</span>
          </button>
          <button id="brand-occasion-apply" class="brand-occasion-action" type="button">
            <span data-i18n="filters.showResults">Покажи резултатите</span>
          </button>
        </div>
      </div>
    </div>

    <section class="seo-editorial" aria-label="Контекст за българските брандове">
      <div class="seo-editorial__header">
        <p class="seo-editorial__kicker">По-широк контекст</p>
        <h2 class="seo-editorial__title">Какво стои зад избора на български брандове</h2>
        <p class="seo-editorial__intro">
          Ако търсиш повече контекст, не само списък с марки, тази секция събира по-широката картина:
          защо локалните производители стават все по-важни, как да се ориентираш по-умно в категориите
          и какво всъщност прави едно откритие наистина стойностно.
        </p>
      </div>

      <div class="seo-editorial__grid">
        {editorialSections.map((section) => (
          <details class="seo-editorial__card">
            <summary class="seo-editorial__summary">
              <div class="seo-editorial__summary-copy">
                <h3>{section.title}</h3>
              </div>
              <span class="seo-editorial__toggle" aria-hidden="true" data-i18n="brands.readMore">Прочети още</span>
            </summary>

            <div class="seo-editorial__content">
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </details>
        ))}
      </div>
    </section>
  </main>

  <style>
    .section {
      margin-top: 28px;
    }

    .section-title {
      margin: 0 0 16px;
      font-size: 22px;
      letter-spacing: -0.01em;
      text-align: center;
