---
import AdminLayout from "../../layouts/AdminLayout.astro"; import ProductForm from "../../components/ProductForm.astro";
import { findProduct,getProductFieldSchema,listBrands,saveProduct,setProductVisibility,validateCsrf } from "../../lib/repositories";
import { MANUAL_CLASSIFICATION_GUIDANCE } from "../../lib/product-taxonomy";
const id=Number(Astro.params.id);if(!id)return new Response("Not found",{status:404});let product=await findProduct(id);let error="";
if(Astro.request.method==="POST"){const form=await Astro.request.formData();try{validateCsrf(form,Astro.locals.admin.csrf);if(form.get("_action")==="visibility")product=await setProductVisibility(id,form.get("visible")==="true");else product=await saveProduct(form,id);return Astro.redirect(`/products/${id}/?saved=1`)}catch(e){error=e instanceof Error?e.message:"Could not save Product."}}
const [brands,taxonomyFields]=await Promise.all([listBrands(),getProductFieldSchema()]);const success=Astro.url.searchParams.has("saved")||Astro.url.searchParams.has("created");
const guidance=MANUAL_CLASSIFICATION_GUIDANCE[product.slug];
---
<AdminLayout title={product.name_bg || "Product"} active="products"><header class="head"><div><h1>{product.name_bg || "Product"}</h1><p class="muted">Baserow row #{id}</p></div><a class="btn secondary" href="/products/?classification=needs">Back to review</a></header>{success&&<div class="notice">Product saved and verified in Baserow. Public deployment is still required.</div>}{guidance&&<section class="panel warning"><h2>Classification guidance</h2><p><strong>{guidance.recommended}</strong></p><p>{guidance.reason}</p><p class="muted">Alternatives: {guidance.alternatives.join("; ")}</p></section>}<ProductForm product={product} brands={brands} taxonomyFields={taxonomyFields} csrf={Astro.locals.admin.csrf} error={error}/></AdminLayout>
