---
import FaviconHead from "../components/FaviconHead.astro";
const title = Astro.props.title || "Българитъм";
const description =
  Astro.props.description ||
  "Открий подбрани български марки и продукти в Българитъм.";
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:image" content="https://bulgaritam.bg/social-preview.png" />
    <meta name="twitter:image" content="https://bulgaritam.bg/social-preview.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <FaviconHead />
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
