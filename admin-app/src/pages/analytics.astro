---
import AdminLayout from "../layouts/AdminLayout.astro";
import AnalyticsTable from "../components/AnalyticsTable.astro";
import {buildAcquisitionRows,buildBrandRows,buildBrandSearchRows,buildDimensionRows,buildFilterRows,buildFunnel,buildPageRows,buildProductRows,buildSearchRows,buildUnmetRows,count,loadAnalyticsEvents,metricSummary,resolvePeriod,returnedBrands,returnedProducts} from "../lib/analytics";
const period=resolvePeriod(Astro.url);let error="";let allEvents:Awaited<ReturnType<typeof loadAnalyticsEvents>>=[];try{allEvents=await loadAnalyticsEvents()}catch(cause){error=cause instanceof Error?cause.message:"Данните не могат да бъдат заредени."}
const inRange=(e:any,a:Date,b:Date)=>e.at>=a&&e.at<b,dated=allEvents.filter(e=>inRange(e,period.start,period.end)),previousAll=allEvents.filter(e=>inRange(e,period.previousStart,period.previousEnd));
const brandFilter=Astro.url.searchParams.get("brand")||"",productFilter=Astro.url.searchParams.get("product")||"",categoryFilter=Astro.url.searchParams.get("category")||"";
const matches=(e:any)=>{const rp=returnedProducts(e),rb=returnedBrands(e);return(!brandFilter||e.brandId===brandFilter||rp.some((x:any)=>x[1]===brandFilter)||rb.some((x:any)=>x[0]===brandFilter))&&(!productFilter||e.productId===productFilter||rp.some((x:any)=>x[0]===productFilter))&&(!categoryFilter||e.category===categoryFilter)};
const events=dated.filter(matches),previous=previousAll.filter(matches),fmt=(n:number,d=0)=>new Intl.NumberFormat("bg-BG",{maximumFractionDigits:d}).format(n),rate=(a:number,b:number)=>b?a/b*100:0,na=(v:number|null)=>v===null?"Няма данни":fmt(v),pct=(v:number|null)=>v===null?"Няма данни":`${fmt(v,1)}%`;
const human=(value:string)=>({clothing:"Облекло",accessories:"Аксесоари",cosmetics:"Козметика",home:"Дом",kids:"Деца",gifts:"Подаръци",discovery:"Откриване",product:"Продукт",brand:"Бранд",content:"Съдържание",homepage_default:"Начална страница",search_results:"Резултати от търсене",brand_directory:"Каталог с брандове",gift_discovery:"Откриване на подаръци",product_page:"Продуктова страница",brand_page:"Страница на бранд",shared_collection:"Споделена колекция"} as Record<string,string>)[value]||value.replaceAll("_"," ");
const brandOptions=buildBrandRows(dated),productOptions=buildProductRows(dated),categoryOptions=[...new Set(dated.map(e=>e.category).filter(Boolean))].sort(),rawMetrics=metricSummary(events,previous);const metric=(key:string,label:string)=>{const m=rawMetrics.find(x=>x.key===key);return{label,value:m?.value||0,change:m?.change??null}};const sessions=new Set(events.map(e=>e.sessionId).filter(Boolean)),discovered=new Set(events.filter(e=>["save_product","outbound_product_click"].includes(e.event)).map(e=>e.sessionId).filter(Boolean));
const overview=[metric("sessions","Сесии"),metric("search","Търсения"),metric("search_no_results","Без резултат"),{label:"Дял без резултат",value:rate(count(events,"search_no_results"),count(events,"search")),change:null,suffix:"%"},metric("view_product","Прегледи на продукти"),metric("view_brand","Прегледи на брандове"),metric("outbound_product_click","Изходящи към продукти"),metric("outbound_brand_click","Изходящи към брандове"),metric("save_product","Запазвания"),{label:"Процент на откриване",value:rate(discovered.size,sessions.size),change:null,suffix:"%"}];
const searches=buildSearchRows(events),unmet=buildUnmetRows(events),filters=buildFilterRows(events),products=buildProductRows(events),brands=buildBrandRows(events),pages=buildPageRows(events),acquisition=buildAcquisitionRows(events),funnel=buildFunnel(events);
const zeroDemand=unmet.filter(r=>r.resultCount===0),lowDemand=unmet.filter(r=>r.resultCount>0);
const dimensions=[{title:"Категории",rows:buildDimensionRows(events,e=>e.category)},{title:"Подкатегории",rows:buildDimensionRows(events,e=>e.subcategory)},{title:"Типове продукти",rows:buildDimensionRows(events,e=>e.productType)},{title:"Източник",rows:buildDimensionRows(events,e=>e.sourceContext)},{title:"Списък / контекст",rows:buildDimensionRows(events,e=>e.listContext)},{title:"Получатели",rows:buildDimensionRows(events,e=>e.giftRecipient)},{title:"Поводи",rows:buildDimensionRows(events,e=>e.giftOccasion)}],filterGroups=[{title:"Таксономия",keys:["category","subcategory","product_type"]},{title:"Подаръци",keys:["gift_budget","gift_recipient","gift_occasion","giftable"]},{title:"Продуктови характеристики",keys:["materials","colors","attributes","price_range","delivery_abroad"]}];
---
<AdminLayout title="Аналитика" active="analytics"><header class="head"><div><h1>Аналитика</h1><p class="muted">Поведение при търсене и откриване · данни от Baserow</p></div></header>
<form class="panel controls" method="get"><div class="presets">{[["today","Днес"],["yesterday","Вчера"],["7d","7 дни"],["30d","30 дни"],["90d","90 дни"]].map(([k,l])=><a class:list={["btn","secondary",{active:period.key===k}]} href={`/analytics/?period=${k}`}>{l}</a>)}</div><label>От<input type="date" name="from" value={period.from}/></label><label>До<input type="date" name="to" value={period.to}/></label><input type="hidden" name="period" value="custom"/><label>Бранд<select name="brand"><option value="">Всички</option>{brandOptions.map(x=><option value={x.id} selected={x.id===brandFilter}>{x.name}</option>)}</select></label><label>Продукт<select name="product"><option value="">Всички</option>{productOptions.map(x=><option value={x.id} selected={x.id===productFilter}>{x.name}</option>)}</select></label><label>Категория<select name="category"><option value="">Всички</option>{categoryOptions.map(x=><option value={x} selected={x===categoryFilter}>{human(x)}</option>)}</select></label><button>Приложи</button><span class="muted">{period.from} → {period.to} · {events.length} събития</span></form>{error&&<div class="error">{error}</div>}
<section class="metric-grid">{overview.map(m=><article class="metric"><span>{m.label}</span><b>{fmt(m.value,1)}{m.suffix||""}</b>{m.change!==null&&<small>{m.change>=0?"+":""}{fmt(m.change,1)}% спрямо предходния период</small>}</article>)}</section>
<section class="panel analytics-section"><h2>Какво търсят хората</h2><input class="table-search" type="search" placeholder="Търси фраза" data-filter-table="search-demand"/><AnalyticsTable heads={["Търсене","Брой","Средно резултати","Без резултат","Дял без резултат","Прегледи продукти","Прегледи брандове","Запазвания","Изходящи продукти","Изходящи брандове"]} rows={searches.map(r=>[r.query,r.searches,fmt(r.avgResults,1),r.zero,`${fmt(r.zeroRate,1)}%`,r.productViews,r.brandViews,r.saves,r.productOutbound,r.brandOutbound])} id="search-demand"/></section>
<section class="panel analytics-section"><h2>Търсения без резултат</h2><AnalyticsTable heads={["Търсене","Брой","Резултати","Категория","Подкатегория","Тип продукт","Получател","Повод","Бюджет"]} rows={zeroDemand.map(r=>[r.query,r.searches,r.resultCount,human(r.category),human(r.subcategory),human(r.productType),human(r.recipient),human(r.occasion),human(r.budget)])} emphasizeColumn={2} emphasizeValue={0}/><h3>Слабо покритие (1–3 резултата)</h3><AnalyticsTable heads={["Търсене","Брой","Резултати","Категория","Подкатегория","Тип продукт","Получател","Повод","Бюджет"]} rows={lowDemand.map(r=>[r.query,r.searches,r.resultCount,human(r.category),human(r.subcategory),human(r.productType),human(r.recipient),human(r.occasion),human(r.budget)])}/></section>
<section class="panel analytics-section"><h2>Какви филтри използват</h2><div class="columns">{filterGroups.map(g=><article><h3>{g.title}</h3><AnalyticsTable heads={["Филтър","Стойност","Избори","Прегледи след избор","Изходящи след избор"]} rows={filters.filter(r=>g.keys.includes(r.key)).map(r=>[r.label,human(r.value),r.selections,r.views,r.outbound])}/></article>)}</div></section>
<section class="panel analytics-section"><h2>Продукти</h2><input class="table-search" type="search" placeholder="Продукт или бранд" data-filter-table="products-table"/><AnalyticsTable heads={["Продукт","Бранд","Върнат в търсене","Импресии","Прегледи","Запазвания","Изходящи","Върнат→импресия","Импресия→преглед","Преглед→изходящ"]} rows={products.map(r=>[r.name,r.brand,na(r.returned),r.impressions,r.views,r.saves,r.outbound,pct(r.returnedImpressionRate),pct(r.impressionViewRate),pct(r.viewOutboundRate)])} id="products-table"/></section>
<section class="panel analytics-section"><h2>Брандове</h2><input class="table-search" type="search" placeholder="Търси бранд" data-filter-table="brands-table"/><div id="brands-table">{brands.map(r=><details class="brand-row"><summary><strong>{r.name}</strong><span>Върнат: {na(r.returned)} · Импресии: {r.impressions} · Бранд прегледи: {r.brandViews} · Продуктови прегледи: {r.productViews} · Запазвания: {r.saves} · Изходящи: {r.productOutbound+r.brandOutbound}</span></summary><h3>Кои търсения водят до този бранд</h3><AnalyticsTable heads={["Търсене","Появи в резултати","Импресии","Прегледи","Изходящи"]} rows={buildBrandSearchRows(events,r.id).map(x=>[x.query,x.returned,x.impressions,x.views,x.outbound])}/></details>)}</div></section>
<section class="panel analytics-section"><h2>Страници и входни страници</h2><AnalyticsTable heads={["Страница / път","Тип","Сесии","Прегледи на страници","Прегледи продукти","Прегледи брандове","Запазвания","Изходящи"]} rows={pages.map(r=>[r.path,human(r.pageType),r.sessions,r.pageViews,r.productViews,r.brandViews,r.saves,r.outbound])}/></section>
<section class="panel analytics-section"><h2>Фуния на търсенето и откриването</h2>{!funnel.available&&<p class="notice">Данните за върнати резултати не са налични за избрания исторически период.</p>}<div class="funnel">{[["Търсене → резултат",rate(funnel.searchesWithResults,funnel.searches)],["Върнат → импресия",funnel.available?funnel.returnImpression:null],["Импресия → преглед",funnel.impressionView],["Преглед → запазване",funnel.viewSave],["Преглед → изходящ",funnel.viewOutbound],["Търсене → изходящ",funnel.searchOutbound]].map(([l,v])=><div><span>{l}</span><b>{v===null?"Няма данни":`${fmt(Number(v),1)}%`}</b></div>)}</div></section>
<section class="panel analytics-section"><h2>Контекст на откриване</h2><div class="columns">{dimensions.map(d=><article><h3>{d.title}</h3><AnalyticsTable heads={["Стойност","Събития","Сесии","Прегледи","Запазвания","Изходящи"]} rows={d.rows.map(r=>[human(r.name),r.events,r.sessions,r.views,r.saves,r.outbound])}/></article>)}</div></section>
<section class="panel analytics-section"><h2>Придобиване</h2><AnalyticsTable heads={["Източник","Канал","Кампания","Препращащ сайт","Сесии","Търсения","Прегледи","Запазвания","Изходящи"]} rows={acquisition.map(r=>[r.source,r.medium,r.campaign,r.referrer,r.sessions,r.searches,r.views,r.saves,r.outbound])}/></section></AdminLayout>
<script>document.querySelectorAll("table[data-sortable] th").forEach((h,i)=>h.addEventListener("click",()=>{const b=h.closest("table")?.tBodies[0];if(!b)return;const d=h.dataset.d==="a"?-1:1;h.dataset.d=d===1?"a":"d";[...b.rows].sort((x,y)=>{const a=x.cells[i]?.innerText||"",c=y.cells[i]?.innerText||"",an=Number(a.replace(",",".")),cn=Number(c.replace(",","."));return(Number.isFinite(an)&&Number.isFinite(cn)?an-cn:a.localeCompare(c,"bg"))*d}).forEach(x=>b.appendChild(x))}));document.querySelectorAll("[data-filter-table]").forEach(i=>i.addEventListener("input",()=>{const q=i.value.toLocaleLowerCase("bg"),target=document.getElementById(i.dataset.filterTable);target?.querySelectorAll("tbody tr, details.brand-row").forEach(r=>r.hidden=Boolean(q&&!r.textContent.toLocaleLowerCase("bg").includes(q)))}));</script>
<style>.controls{display:flex;gap:9px;align-items:end;flex-wrap:wrap}.controls label{width:145px}.presets{display:flex;gap:5px}.active{background:var(--green)!important;color:#fff!important}.metric-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin:18px 0}.metric{background:#fff;border:1px solid var(--line);border-radius:10px;padding:14px}.metric span,.metric small{display:block;color:#777}.metric b{font-size:25px}.analytics-section{margin:18px 0}.columns{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.table-wrap{max-height:560px;overflow:auto}th{cursor:pointer;position:sticky;top:0;background:#fff}tr.signal{background:#fff4dd}.table-search{max-width:280px;margin-bottom:10px}.brand-row{border:1px solid var(--line);border-radius:8px;padding:12px;margin:8px 0}.brand-row summary{display:flex;justify-content:space-between;gap:15px;cursor:pointer}.funnel{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}.funnel div{background:#edf5f0;padding:14px;border-radius:8px}.funnel span,.funnel b{display:block}.funnel b{font-size:22px}.notice{color:#80520b}@media(max-width:1100px){.metric-grid,.columns{grid-template-columns:repeat(2,1fr)}.funnel{grid-template-columns:repeat(3,1fr)}}@media(max-width:700px){.metric-grid,.columns,.funnel{grid-template-columns:1fr}.brand-row summary{display:block}}</style>
