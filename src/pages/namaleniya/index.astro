---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomepageProductCard from "../../components/HomepageProductCard.astro";
import { loadWeeklyDiscountProducts } from "../../lib/weekly-discounts";
import { combineStructuredFacets, priceBucketFor, PRICE_BUCKET_LABELS } from "../../lib/weekly-discount-ui";

const { products: discounts } = await loadWeeklyDiscountProducts();
const title = "Намаления от български брандове тази седмица | Българитъм";
const description = "Разгледайте актуално потвърдени намаления на продукти от български брандове, чиито цени Българитъм провери през тази седмица.";
const productTypes = [...new Set(discounts.map(({ product }) => product.product_type).filter(Boolean))].sort((a, b) => a.localeCompare(b, "bg"));
const facetLabels = new Map<string, string>();
discounts.forEach(({ product }) => combineStructuredFacets(product.materials, product.ingredient).forEach((label) => {
  const key = label.toLocaleLowerCase("bg-BG");
  if (!facetLabels.has(key)) facetLabels.set(key, label);
}));
const combinedFacets = [...facetLabels.entries()].sort((a, b) => a[1].localeCompare(b[1], "bg"));
const priceBuckets = Object.entries(PRICE_BUCKET_LABELS).filter(([bucket]) => discounts.some((entry) => priceBucketFor(Number(entry.current_price)) === bucket));
---

<BaseLayout title={title} description={description} canonical="https://bulgaritam.bg/namaleniya/" seo={{ type: "category", data: { category: "Намаления от български брандове", description } }}>
  <main class="discounts-page">
    <header class="discounts-head">
      <p class="discounts-eyebrow">Актуални тази седмица</p>
      <h1 class="page-title">Намаления от български брандове</h1>
      <p>Разгледай кои български продукти имат активни намаления.<br />Селекцията на Българитъм се обновява всеки понеделник.<br />Използвай филтрите, за да намериш точния продукт за теб.</p>
    </header>

    {discounts.length ? (
      <section class="discounts-results" aria-labelledby="discounts-results-title">
        <div class="discount-tools" aria-label="Сортиране и филтри">
          <button id="discountFiltersToggle" class="discovery-btn" type="button" aria-haspopup="dialog" aria-controls="discountFiltersModal" aria-expanded="false"><span>Избери филтри</span><span id="discountFiltersBadge" class="discovery-btn__badge" hidden>0</span></button>
          <label class="sort-control" for="discountSort"><span class="sort-label">Подредба</span><select id="discountSort" class="sort-select"><option value="discount-desc">Най-голямо намаление</option><option value="price-asc">Цена: ниска към висока</option><option value="price-desc">Цена: висока към ниска</option></select></label>
        </div>
        <div id="discountActiveSelections" class="active-selections" aria-live="polite" hidden></div>
        <div class="discounts-results__head"><h2 id="discounts-results-title">Продукти с намаление</h2><p><span id="discountResultCount">{discounts.length}</span> <span id="discountResultNoun">продукта</span></p></div>
        <ul class="discounts-grid" id="discountGrid" data-masonry-grid>{discounts.map((entry, index) => <HomepageProductCard product={entry.product} discount={entry} index={index} />)}</ul>
        <div id="discountFilteredEmpty" class="discounts-empty discounts-empty--filtered" role="status" hidden><h2>Няма продукти с тези филтри</h2><p>Премахни някой от избраните филтри, за да видиш повече резултати.</p><button id="discountEmptyReset" type="button">Изчисти филтрите</button></div>
      </section>
    ) : (
      <section class="discounts-empty" role="status"><h2>В момента няма потвърдени намаления за тази седмица</h2><p>Проверяваме цените редовно. Междувременно разгледайте всички български продукти.</p><a href="/">Разгледайте продуктите</a></section>
    )}
  </main>

  {discounts.length ? <div id="discountFiltersModal" class="filters-modal" hidden>
    <div class="filters-modal__backdrop" data-discount-filters-close></div>
    <div class="filters-modal__panel" role="dialog" aria-modal="true" aria-labelledby="discountFiltersTitle">
      <div class="filters-modal__head"><div><p class="filters-modal__eyebrow">Избери филтри</p><h2 id="discountFiltersTitle" class="filters-modal__title">Филтри</h2></div><button class="filters-modal__close" type="button" aria-label="Затвори" data-discount-filters-close>✕</button></div>
      <div class="filters-modal__body">
        {productTypes.length ? <section class="filters-group" data-discount-group="productType"><h3 class="filters-group__label">Вид продукт</h3><div class="filter-options-grid">{productTypes.map((value) => <label class="filter-option filter-option--checkbox" data-discount-option><input type="checkbox" name="discountProductType" value={value} /><span data-option-label={value}>{value}</span></label>)}</div></section> : null}
        {priceBuckets.length ? <section class="filters-group filters-group--spaced" data-discount-group="price"><h3 class="filters-group__label">Цена</h3>{priceBuckets.map(([value, label]) => <label class="filter-option" data-discount-option><input type="radio" name="discountPrice" value={value} /><span data-option-label={label}>{label}</span></label>)}</section> : null}
        {combinedFacets.length ? <section class="filters-group filters-group--spaced" data-discount-group="facet"><h3 class="filters-group__label">Материали / съставки</h3><div class="filter-options-grid">{combinedFacets.map(([value, label]) => <label class="filter-option filter-option--checkbox" data-discount-option><input type="checkbox" name="discountFacet" value={value} /><span data-option-label={label}>{label}</span></label>)}</div></section> : null}
      </div>
      <div class="filters-modal__actions"><button id="discountFiltersReset" class="filters-action filters-action--ghost" type="button">Изчисти</button><button class="filters-action" type="button" data-discount-filters-close>Готово</button></div>
    </div>
  </div> : null}

  <style>
    .discounts-page{max-width:1240px;margin:0 auto;padding:42px 18px 72px}.discounts-head{max-width:800px;margin:0 auto 32px;text-align:center}.discounts-eyebrow{margin:0 0 10px;color:var(--accent-strong);font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.discounts-head h1{margin:0;max-width:none;font-size:clamp(34px,5vw,62px);line-height:1.02;letter-spacing:-.035em;text-wrap:balance}.discounts-head>p:last-child{max-width:680px;margin:18px auto 0;color:rgba(26,26,26,.68);font-size:clamp(15px,1.6vw,18px);line-height:1.6}.discount-tools{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:12px;margin:0 0 24px}.discovery-btn,.sort-select{min-height:48px;border-radius:14px;border:1px solid rgba(26,26,26,.1);background:rgba(255,255,255,.82);box-shadow:0 12px 26px rgba(0,0,0,.05);color:rgba(26,26,26,.86)}.discovery-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:0 18px;font:700 14px var(--font-body);cursor:pointer}.discovery-btn__badge{display:inline-grid;place-items:center;min-width:22px;height:22px;padding:0 6px;border-radius:999px;background:rgba(95,127,107,.14);font-size:12px}.discovery-btn__badge[hidden],.active-selections[hidden]{display:none}.sort-control{display:inline-flex;align-items:center;gap:10px;min-width:330px;padding-left:14px;border-radius:999px;background:rgba(255,255,255,.68);border:1px solid rgba(26,26,26,.08);box-shadow:0 12px 26px rgba(0,0,0,.05)}.sort-label{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(26,26,26,.54)}.sort-select{min-width:214px;padding:0 18px 0 8px;border:0;background:transparent;font:600 14px var(--font-body);appearance:none;cursor:pointer}.discounts-results__head{display:flex;align-items:end;justify-content:space-between;gap:18px;margin-bottom:20px}.discounts-results__head h2{margin:0;font-family:var(--font-display);font-size:clamp(25px,3vw,36px);font-weight:600}.discounts-results__head p{margin:0;color:rgba(26,26,26,.58);font-size:13px}.discounts-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));align-items:start;grid-auto-flow:dense;grid-auto-rows:auto;gap:18px;list-style:none;margin:0;padding:0;--masonry-row:10px}.discounts-grid.is-masonry-ready{grid-auto-rows:var(--masonry-row)}:global(.discounts-grid.is-masonry-ready>[data-masonry-card]){grid-row:span var(--masonry-span)}.active-selections{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:8px;margin:0 auto 20px}:global(.active-selection){display:inline-flex;align-items:center;gap:7px;min-height:38px;padding:7px 11px 7px 13px;border-radius:999px;border:1px solid rgba(95,127,107,.24);background:rgba(255,255,255,.7);color:rgba(26,26,26,.84);font:700 13px var(--font-body);cursor:pointer}:global(.active-selection__remove){font-size:18px;line-height:1}.filters-modal{position:fixed;inset:0;z-index:1000}.filters-modal__backdrop{position:absolute;inset:0;background:rgba(22,18,12,.18);backdrop-filter:blur(6px)}.filters-modal__panel{position:absolute;top:50%;left:50%;width:min(92vw,680px);height:min(88dvh,760px);display:grid;grid-template-rows:auto minmax(0,1fr) auto;overflow:hidden;border:1px solid rgba(26,26,26,.08);border-radius:28px;background:rgba(250,247,242,.98);box-shadow:0 28px 70px rgba(0,0,0,.16);transform:translate(-50%,-50%)}.filters-modal__head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding:24px 24px 18px}.filters-modal__eyebrow{margin:0 0 6px;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(26,26,26,.5)}.filters-modal__title{margin:0;font-family:var(--font-title);font-size:34px;line-height:1}.filters-modal__close{display:grid;place-items:center;width:42px;height:42px;border-radius:999px;border:1px solid rgba(26,26,26,.08);background:#fff;color:#7b403b;cursor:pointer}.filters-modal__body{min-height:0;padding:2px 24px 24px;overflow-y:auto}.filters-group__label{margin:0 0 12px;font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(26,26,26,.58)}.filters-group--spaced{margin-top:22px}.filter-options-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.filter-option{display:flex;align-items:center;gap:12px;padding:13px 14px;border-radius:18px;background:rgba(255,255,255,.78);border:1px solid rgba(26,26,26,.07)}.filter-option+.filter-option{margin-top:10px}.filter-options-grid .filter-option+.filter-option{margin-top:0}.filter-option input{width:16px;height:16px;accent-color:#7b403b}.filters-modal__actions{display:flex;justify-content:flex-end;gap:10px;padding:16px 24px 20px;border-top:1px solid rgba(26,26,26,.07)}.filters-action{min-height:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(26,26,26,.08);background:rgba(26,26,26,.9);color:#fff;font:700 14px var(--font-body);cursor:pointer}.filters-action--ghost{background:rgba(255,255,255,.82);color:rgba(26,26,26,.82)}[data-discount-option][hidden],[data-discount-group][hidden]{display:none}.discounts-empty{max-width:680px;margin:72px auto;padding:38px 30px;text-align:center;border:1px solid rgba(26,26,26,.09);border-radius:26px;background:rgba(255,255,255,.66)}.discounts-empty h2{margin:0;font-family:var(--font-display);font-size:clamp(25px,3vw,34px);font-weight:600}.discounts-empty p{margin:14px auto 22px;color:rgba(26,26,26,.65);line-height:1.6}.discounts-empty a,.discounts-empty button{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:10px 18px;border:0;border-radius:999px;background:var(--accent-strong);color:#fff;font:800 13px var(--font-body);text-decoration:none;cursor:pointer}.discounts-empty--filtered{margin:32px auto}.discounts-empty[hidden]{display:none}@media(max-width:1024px){.discounts-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:768px){.filters-modal__panel{top:auto;bottom:0;left:0;width:100%;height:min(88dvh,760px);border-radius:26px 26px 0 0;transform:none}.discounts-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.discounts-page{padding:28px 12px 54px}.discounts-head{margin-bottom:26px}.discount-tools{align-items:stretch}.discovery-btn,.sort-control{flex:1 1 100%;min-width:0}.sort-control{justify-content:space-between}.sort-select{min-width:0;flex:1}.filter-options-grid{grid-template-columns:1fr}.discounts-results__head{align-items:center}}
  </style>

  <script>
    // @ts-nocheck -- DOM nodes are runtime-guarded and Astro's inline-script checker cannot narrow generic selectors.
    import { discountFacetCounts, filterDiscountItems, normalizeFacet, sortDiscountItems } from "../../lib/weekly-discount-ui";
    const grid = document.querySelector("#discountGrid");
    if (grid instanceof HTMLElement) {
      const cards = Array.from(grid.querySelectorAll("[data-masonry-card]"));
      const items = cards.map((card, original_index) => ({ row_id: card.dataset.discountRowId || "", product_type: card.dataset.productType || "", facets: JSON.parse(card.dataset.discountFacets || "[]"), current_price: Number(card.dataset.discountCurrent), discount_percent: Number(card.dataset.discountPercent), original_index }));
      const byRowId = new Map(cards.map((card) => [card.dataset.discountRowId || "", card]));
      const state = { productTypes: [], priceBucket: "all", facets: [] };
      const modal = document.querySelector("#discountFiltersModal"); const count = document.querySelector("#discountResultCount"); const noun = document.querySelector("#discountResultNoun"); const active = document.querySelector("#discountActiveSelections"); const badge = document.querySelector("#discountFiltersBadge"); const filteredEmpty = document.querySelector("#discountFilteredEmpty"); const sort = document.querySelector("#discountSort"); const toggle = document.querySelector("#discountFiltersToggle");
      const labelFor = (selector, value) => modal?.querySelector(`${selector}[value="${CSS.escape(value)}"]`)?.closest("label")?.querySelector("[data-option-label]")?.dataset.optionLabel || value;
      const selections = () => [...state.productTypes.map((value) => ({ kind: "productType", value, label: value })), ...(state.priceBucket === "all" ? [] : [{ kind: "price", value: state.priceBucket, label: labelFor('input[name="discountPrice"]', state.priceBucket) }]), ...state.facets.map((value) => ({ kind: "facet", value, label: labelFor('input[name="discountFacet"]', value) }))];
      const syncInputs = () => { modal?.querySelectorAll('input[name="discountProductType"]').forEach((input) => { input.checked = state.productTypes.includes(input.value); }); modal?.querySelectorAll('input[name="discountFacet"]').forEach((input) => { input.checked = state.facets.includes(input.value); }); modal?.querySelectorAll('input[name="discountPrice"]').forEach((input) => { input.checked = input.value === state.priceBucket; }); };
      const renderActive = () => { if (!(active instanceof HTMLElement)) return; active.replaceChildren(); selections().forEach((selection) => { const button = document.createElement("button"); button.type = "button"; button.className = "active-selection"; button.setAttribute("aria-label", `Премахни филтър: ${selection.label}`); button.innerHTML = `<span>${selection.label}</span><span class="active-selection__remove" aria-hidden="true">×</span>`; button.addEventListener("click", () => { if (selection.kind === "productType") state.productTypes = state.productTypes.filter((value) => value !== selection.value); if (selection.kind === "facet") state.facets = state.facets.filter((value) => value !== selection.value); if (selection.kind === "price") state.priceBucket = "all"; syncInputs(); apply(); }); active.append(button); }); active.hidden = !selections().length; if (badge instanceof HTMLElement) { badge.textContent = String(selections().length); badge.hidden = !selections().length; } };
      const updateFacets = () => { const counts = discountFacetCounts(items, state); const groups = [{ selector: 'input[name="discountProductType"]', values: counts.productTypes, selected: state.productTypes }, { selector: 'input[name="discountPrice"]', values: counts.priceBuckets, selected: state.priceBucket === "all" ? [] : [state.priceBucket] }, { selector: 'input[name="discountFacet"]', values: counts.facets, selected: state.facets }]; groups.forEach(({ selector, values, selected }) => { const inputs = Array.from(modal?.querySelectorAll(selector) || []); let visible = 0; inputs.forEach((input) => { const key = selector.includes("discountFacet") ? normalizeFacet(input.value) : input.value; const option = input.closest("[data-discount-option]"); const amount = values[key] || 0; const keep = selected.includes(input.value); if (option instanceof HTMLElement) option.hidden = amount === 0 && !keep; input.disabled = amount === 0 && !keep; const label = option?.querySelector("[data-option-label]"); if (label) label.textContent = `${label.dataset.optionLabel} (${amount})`; if (amount || keep) visible += 1; }); const group = inputs[0]?.closest("[data-discount-group]"); if (group instanceof HTMLElement) group.hidden = visible === 0; }); };
      const apply = () => { const visible = sortDiscountItems(filterDiscountItems(items, state), sort?.value || "discount-desc"); grid.classList.remove("is-masonry-ready"); grid.replaceChildren(...visible.map((item) => byRowId.get(item.row_id)).filter(Boolean)); window.bulgaritamScheduleMasonry?.(grid); if (count) count.textContent = String(visible.length); if (noun) noun.textContent = visible.length === 1 ? "продукт" : "продукта"; if (filteredEmpty instanceof HTMLElement) filteredEmpty.hidden = visible.length !== 0; renderActive(); updateFacets(); window.syncSaveButtons?.(); };
      modal?.querySelectorAll("input").forEach((input) => input.addEventListener("change", () => { state.productTypes = Array.from(modal.querySelectorAll('input[name="discountProductType"]:checked')).map((entry) => entry.value); state.facets = Array.from(modal.querySelectorAll('input[name="discountFacet"]:checked')).map((entry) => entry.value); state.priceBucket = modal.querySelector('input[name="discountPrice"]:checked')?.value || "all"; apply(); })); sort?.addEventListener("change", apply);
      const close = () => { modal?.setAttribute("hidden", ""); toggle?.setAttribute("aria-expanded", "false"); document.documentElement.classList.remove("no-scroll"); }; toggle?.addEventListener("click", () => { modal?.removeAttribute("hidden"); toggle.setAttribute("aria-expanded", "true"); document.documentElement.classList.add("no-scroll"); updateFacets(); }); modal?.querySelectorAll("[data-discount-filters-close]").forEach((button) => button.addEventListener("click", close));
      const reset = () => { state.productTypes = []; state.facets = []; state.priceBucket = "all"; syncInputs(); apply(); }; document.querySelector("#discountFiltersReset")?.addEventListener("click", reset); document.querySelector("#discountEmptyReset")?.addEventListener("click", reset); document.addEventListener("keydown", (event) => { if (event.key === "Escape" && !modal?.hasAttribute("hidden")) close(); }); apply();
    }
  </script>
</BaseLayout>
