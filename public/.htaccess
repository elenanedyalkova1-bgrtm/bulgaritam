RewriteEngine On

# Compress text responses when Apache mod_deflate is available.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml text/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Canonical SEO landing redirects. Keep every migration to one hop.
RewriteRule ^podarak-za-zhena-za-rozhden-den/?$ /podarak-za-rozhden-den-na-zhena/ [R=301,L,NE]
RewriteRule ^podarak-za-zhena-za-rozhden-den/page/([1-9][0-9]*)/?$ /podarak-za-rozhden-den-na-zhena/page/$1/ [R=301,L,NE]
RewriteRule ^k/detsko-obleklo/?$ /bulgarski-detski-drehi/ [R=301,L,NE]
RewriteRule ^k/detsko-obleklo/page/([1-9][0-9]*)/?$ /bulgarski-detski-drehi/page/$1/ [R=301,L,NE]
# This former second page disappears after applying the women's audience filter.
# If catalogue growth generates it again, serve that page normally.
RewriteCond %{DOCUMENT_ROOT}/bulgarski-drehi/damski-chanti/page/2/index.html !-f
RewriteRule ^bulgarski-drehi/damski-chanti/page/2/?$ /bulgarski-drehi/damski-chanti/ [R=301,L,NE]
RewriteRule ^category/podaratsi/?$ /bulgarski-podaratsi/ [R=301,L,NE]
RewriteRule ^category/idei-za-podarak/?$ /bulgarski-podaratsi/ [R=301,L,NE]
RewriteRule ^k/(podaraci|idei-za-podarak|bulgarski-podaratsi)/?$ /bulgarski-podaratsi/ [R=301,L,NE]
RewriteRule ^k/(za-zhena|podaraci-za-jena)/?$ /bulgarski-podaratsi/za-zhena/ [R=301,L,NE]
RewriteRule ^k/(za-mazh|podaraci-za-nego)/?$ /bulgarski-podaratsi/za-mazh/ [R=301,L,NE]
RewriteRule ^k/(za-bebe|podaraci-za-bebe)/?$ /bulgarski-podaratsi/za-bebe/ [R=301,L,NE]
RewriteRule ^k/(za-dete|podaraci-za-dete)/?$ /bulgarski-podaratsi/za-dete/ [R=301,L,NE]
RewriteRule ^k/(za-svatba|podaraci-za-svatba)/?$ /bulgarski-podaratsi/za-svatba/ [R=301,L,NE]
RewriteRule ^k/(bulgarski-drehi|obleklo)/?$ /bulgarski-drehi/ [R=301,L,NE]
RewriteRule ^k/dom-i-interior/?$ /k/za-doma/ [R=301,L,NE]
RewriteRule ^k/dekor/?$ /k/dekoraciq-za-doma/ [R=301,L,NE]
RewriteRule ^k/detski-aksesoari/?$ /k/detski-mebeli-i-tekstil/ [R=301,L,NE]
RewriteRule ^k/detski-knigi/?$ /bulgarski-detski-knigi/ [R=301,L,NE]
RewriteRule ^k/grizha-za-deca/?$ /k/kozmetika-za-deca/ [R=301,L,NE]
RewriteRule ^k/(imunitet|vitamini)/?$ /k/dobavki-i-ekstrakti/ [R=301,L,NE]
RewriteRule ^k/srebarni-bijuta/?$ /k/bijuta/ [R=301,L,NE]

# Send directory URLs without a trailing slash directly to the one canonical URL.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^ https://bulgaritam.bg%{REQUEST_URI}/ [R=301,L,NE]

# HTTPS and the non-www hostname are the only canonical origin.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^bulgaritam\.bg$ [NC]
RewriteRule ^ https://bulgaritam.bg%{REQUEST_URI} [R=301,L,NE]
