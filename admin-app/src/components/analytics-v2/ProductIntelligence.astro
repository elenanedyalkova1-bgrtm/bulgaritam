---
import type {AnalyticsV2ViewModel} from "../../lib/analytics-v2";
import ProductIntelligenceDetail from "./ProductIntelligenceDetail.astro";
const {product}=Astro.props as{product:AnalyticsV2ViewModel["product"]};
const n=(value:number)=>new Intl.NumberFormat("bg-BG").format(value);
const times=(value:number)=>`${n(value)} ${value===1?"път":"пъти"}`;
const visitorText=(value:number)=>`${n(value)} ${value===1?"посетител":"посетители"}`;
const deepSignals=(row:typeof product.rows[number])=>[{label:"Посещения на продуктовата страница",value:row.pageViews},{label:"Запазен",value:row.saves},{label:"Добавен в колекция",value:row.collectionAdds},{label:"Премахнат от колекция",value:row.collectionRemoves},{label:"Споделен",value:row.shares},{label:"Преминавания към сайта",value:row.outbound}].filter(item=>item.value>0);
---
<div class="product-intelligence">
 {product.rows.length===0?<div class="empty">Няма наблюдавана продуктова активност за избрания период.</div>:<>
  <section class="product-section orientation" aria-labelledby="product-overview"><h4 id="product-overview">Какво се случи</h4><div class="summary-grid"><article><span>Продукти с възможност за показване</span><b>{n(product.summary.eligibleProducts)}</b><small>различни продукта</small></article><article><span>Действително видени продукти</span><b>{n(product.summary.visibleProducts)}</b><small>различни продукта</small></article><article><span>Отворени от резултатите</span><b>{n(product.summary.openedProducts)}</b><small>различни продукта</small></article><article><span>С преминаване към сайта</span><b>{n(product.summary.outboundProducts)}</b><small>различни продукта</small></article></div><p>Виждане се отчита само когато поне половината продуктова карта е била видима. Възможността за показване не означава, че продуктът е бил видян.</p></section>

  <section class="product-section attention" aria-labelledby="product-attention"><h4 id="product-attention">Какво заслужава внимание</h4><p>{n(product.summary.visibleProducts)} продукта са били действително видени през периода. {product.peerNote||`${n(product.summary.peerEligibleProducts)} продукта имат достатъчно сравними показвания за внимателна оценка.`}</p></section>

  {product.visible.length>0&&<section class="product-section" aria-labelledby="product-visible"><div class="section-head"><div><h4 id="product-visible">Кои продукти действително са били видени?</h4><p>Подредени по броя посетители, които са ги видели.</p></div></div><div class="product-list">{product.visible.slice(0,12).map(row=><details class="product-row"><summary><span class="identity"><b>{row.name}</b><small>{row.brand}</small></span><span><b>{visitorText(row.visitors)}</b><small>{times(row.qualifiedViews)} действителна видимост</small></span><i aria-hidden="true">⌄</i></summary><div class="product-detail"><ProductIntelligenceDetail row={row}/></div></details>)}</div></section>}

  {product.opened.length>0&&<section class="product-section" aria-labelledby="product-opened"><h4 id="product-opened">Кои от видените продукти са били отворени?</h4><p>Директното отваряне от резултатите е отделно от посещението на продуктовата страница.</p><div class="compact-cards">{product.opened.slice(0,8).map(row=><article><b>{row.name}</b><small>{row.brand}</small><p>Отворен от резултатите {times(row.opened)} от {visitorText(row.openingVisitors)}.</p>{row.pageViews>0&&<p>Продуктовата страница е посетена {times(row.pageViews)}.</p>}</article>)}</div></section>}

  {product.deeper.length>0&&<section class="product-section" aria-labelledby="product-deeper"><h4 id="product-deeper">Кои продукти са получили по-дълбоко действие?</h4><div class="compact-cards">{product.deeper.slice(0,10).map(row=><article><b>{row.name}</b><small>{row.brand}</small><ul>{deepSignals(row).map(signal=><li>{signal.label}: {times(signal.value)}</li>)}{row.repeatObservedVisitors>0&&<li>Повторно наблюдаван в отделни посещения: {visitorText(row.repeatObservedVisitors)}</li>}{row.repeatExplicitVisitors>0&&<li>Повторно изрично действие в отделни посещения: {visitorText(row.repeatExplicitVisitors)}</li>}</ul></article>)}</div></section>}

  {product.lowVisibility.length>0&&<section class="product-section low" aria-labelledby="product-low"><h4 id="product-low">Кои продукти все още нямат достатъчно видимост за оценка?</h4><p>Тези продукти имат измерена възможност за показване, но под 20 проверени действителни показвания. Това не означава, че са слаби.</p><div class="low-list">{product.lowVisibility.slice(0,8).map(row=><div><span><b>{row.name}</b><small>{row.brand}</small></span><span>{n(row.eligible)} възможности · {n(row.verifiedQualifiedViews)} проверени показвания</span></div>)}</div>{product.lowVisibility.length>8&&<p class="more">Още {n(product.lowVisibility.length-8)} продукта са достъпни в списъка по-долу.</p>}</section>}

  <section class="product-section all-products" aria-labelledby="all-products"><details><summary id="all-products">Виж всички продукти и подробните данни</summary><div class="table-wrap"><table><thead><tr><th>Продукт</th><th>Виден</th><th>Посетители</th><th>Отворен</th><th>Страница</th><th>Запазен</th><th>Към сайта</th></tr></thead><tbody>{product.rows.map(row=><tr><td><details><summary>{row.name}<small>{row.brand}</small></summary><div class="inline-detail"><ProductIntelligenceDetail row={row}/></div></details></td><td>{n(row.qualifiedViews)}</td><td>{n(row.visitors)}</td><td>{n(row.opened)}</td><td>{n(row.pageViews)}</td><td>{n(row.saves)}</td><td>{n(row.outbound)}</td></tr>)}</tbody></table></div></details></section>
 </>}
</div>
<style>
 .product-intelligence{min-width:0;max-width:100%;color:#29322c}.product-section{margin-top:24px}.product-section:first-child{margin-top:0}.product-section h4{margin:0 0 5px;font-size:1.15rem}.product-section>p,.section-head p{margin:.25rem 0 14px;color:#657069;line-height:1.55}.summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.summary-grid article,.compact-cards article{min-width:0;padding:14px;border:1px solid #dbe5de;border-radius:10px;background:#fff}.summary-grid span,.summary-grid b,.summary-grid small,.compact-cards b,.compact-cards small{display:block}.summary-grid span{font-size:.88rem;color:#526059}.summary-grid b{margin:.3rem 0;font-size:1.5rem}.summary-grid small,.compact-cards small,.identity small{color:#6a746e}.attention{padding:16px;border-left:3px solid #789a83;background:#f6faf7;border-radius:0 9px 9px 0}.attention p{margin:0}.product-list{display:grid;gap:8px}.product-row{border:1px solid #dbe5de;border-radius:10px;background:#fff;overflow:hidden}.product-row>summary{display:grid;grid-template-columns:minmax(0,1fr) minmax(180px,.65fr) auto;gap:16px;align-items:center;padding:13px 15px;cursor:pointer;list-style:none}.product-row>summary::-webkit-details-marker,.all-products>details>summary::-webkit-details-marker,td details>summary::-webkit-details-marker{display:none}.product-row>summary span b,.product-row>summary span small{display:block}.product-row>summary>span:nth-child(2){text-align:right}.product-detail{padding:16px;border-top:1px solid #e7ede9;background:#fbfcfb}.facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:12px 0}.facts div{padding:9px;background:#fff;border:1px solid #e3e9e5;border-radius:7px}.facts dt{font-size:.78rem;color:#68736c}.facts dd{margin:3px 0 0;font-weight:650}.contexts{margin-top:13px}.contexts h6{margin:0 0 5px;font-size:.88rem}.contexts ul,.compact-cards ul{margin:5px 0;padding-left:18px}.contexts p,.position,.comparison{font-size:.86rem;color:#606b64}.compact-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.compact-cards p{margin:.6rem 0 0}.low{padding:16px;border:1px solid #e0e5dd;border-radius:10px;background:#fafbf8}.low-list{display:grid;gap:6px}.low-list>div{display:flex;justify-content:space-between;gap:20px;padding:9px 0;border-top:1px solid #e3e7e1}.low-list small{display:block;color:#717a74}.more{margin-bottom:0!important}.all-products>details>summary{cursor:pointer;font-weight:700;padding:13px 15px;border:1px solid #cedbd2;border-radius:9px;background:#fff}.all-products details[open]>summary{border-radius:9px 9px 0 0}.table-wrap{max-width:100%;overflow-x:auto;border:1px solid #dbe5de;border-top:0}.table-wrap table{width:100%;min-width:700px;border-collapse:collapse}.table-wrap th,.table-wrap td{padding:10px;text-align:left;border-bottom:1px solid #e5ebe7;vertical-align:top}.table-wrap td:not(:first-child),.table-wrap th:not(:first-child){text-align:right}.table-wrap td summary{cursor:pointer;min-width:190px}.table-wrap td summary small{display:block;color:#727b75}.inline-detail{min-width:310px;max-width:620px;padding:12px 0}.empty{padding:18px;border:1px dashed #bccbc0;border-radius:8px;background:#fff;color:#5d675f}
 @media(max-width:850px){.summary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.facts{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:600px){.summary-grid,.compact-cards,.facts{grid-template-columns:1fr}.product-row>summary{grid-template-columns:minmax(0,1fr) auto;gap:8px}.product-row>summary>span:nth-child(2){grid-column:1;text-align:left}.product-row>summary>i{grid-column:2;grid-row:1/3}.low-list>div{display:grid;gap:5px}.product-detail{padding:13px}.product-section{margin-top:20px}.table-wrap{max-width:100%}}
</style>
