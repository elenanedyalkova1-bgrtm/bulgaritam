---
import { resolvePublishableOffer, formatVerifiedOfferAmount } from "../lib/verified-offer";
import type { Product } from "../lib/products";
import { buildSearchDocument } from "../lib/search";
import { getCategoryLabelForLang, getTaxonomyForProduct } from "../lib/taxonomy";
import { getProductBadges } from "../lib/product-badges";
import { getPublicBrowseForProduct } from "../lib/public-browse-taxonomy";
import { formatDiscountMoney, formatDiscountPercent, type ConsumerDeal, type WeeklyDiscountProduct } from "../lib/weekly-discounts";
import { combineStructuredFacets } from "../lib/weekly-discount-ui";

interface Props { product?: Product; index: number; discount?: WeeklyDiscountProduct; consumerDeal?: ConsumerDeal; }
const { product, index, consumerDeal } = Astro.props;
const discount = Astro.props.discount || consumerDeal;
const p = product || ({
  id: `observed-${consumerDeal?.entity_id}`, row_id: Number(consumerDeal?.entity_id), brand_id: consumerDeal?.brand_id,
  name_bg: consumerDeal?.title || "", brand_name: consumerDeal?.brand || "", slug: consumerDeal?.internal_slug || `observed-${consumerDeal?.entity_id}`,
  category: consumerDeal?.category || "", tags: [], subcategory: "", product_type: consumerDeal?.product_type || "",
  recipient: [], gift_occasion: [], attributes: [], recipient_age: [], recipient_gender: [], role_interest: [], wedding_anniversary_type: [], audience: [], colors: [],
  materials: consumerDeal?.materials || [], gemstone: [], jewelry_detail: [], clothing_style: [], sleeve: [], season: [], ingredient: consumerDeal?.ingredients || [], skin_type: [], skin_need: [], hair_need: [],
  image_urls: consumerDeal?.image_url ? [consumerDeal.image_url] : [], product_url: consumerDeal?.outbound_url || "", brand_slug: "", currency: consumerDeal?.currency || "EUR",
  giftable: false, gift_targets: [], gift_match_score: 0, delivers_abroad: false,
} as unknown as Product);
const taxonomy = getTaxonomyForProduct(p);
const publicBrowse = getPublicBrowseForProduct(p);
const { isBio, isEco, isHandmade, isGift } = getProductBadges(p);
const shouldEagerLoad = index < 4;
const categoryLabelBg = taxonomy.categoryLabel;
const categoryLabelEn = getCategoryLabelForLang(taxonomy.categoryKey, "en");
const offer = discount ? null : resolvePublishableOffer(p, new Date(), { visible: true });
const price = discount ? formatDiscountMoney(Number(discount.current_price), String(discount.currency)) : offer ? formatVerifiedOfferAmount(offer) : p.price_min_eur != null && p.price_max_eur != null
  ? `${p.price_min_eur}–${p.price_max_eur} ${p.currency}`
  : p.price_min_eur != null ? `${p.price_min_eur}+ ${p.currency}` : "";
const discountRegularPrice = discount ? formatDiscountMoney(Number(discount.regular_price), String(discount.currency)) : "";
const discountBadge = discount ? formatDiscountPercent(Number(discount.discount_percent)) : "";
const discountFacets = discount ? combineStructuredFacets(p.materials, p.ingredient) : [];
const cardUrl = consumerDeal?.destination_url || `/p/${p.slug}/`;
const cardExternal = consumerDeal?.destination_type === "external";
const outboundUrl = consumerDeal?.outbound_url || p.product_url;
const checkedTime = consumerDeal?.latest_checked_at ? Date.parse(consumerDeal.latest_checked_at) : NaN;
const ageHours = Number.isFinite(checkedTime) ? Math.max(0, (Date.now() - checkedTime) / 3_600_000) : null;
const freshness = ageHours == null ? "" : ageHours < 24 ? "Проверено днес" : Math.floor(ageHours / 24) === 1 ? "Проверено преди 1 ден" : "Проверено преди " + Math.floor(ageHours / 24) + " дни";
---

<li class="card" data-masonry-card data-analytics-kind={consumerDeal ? "deal" : "product"} data-list-context={consumerDeal ? "consumer_deals" : discount ? "weekly_discounts" : "homepage_default"} data-list-name={discount ? "Намаления" : "Начална discovery мрежа"} data-position={index + 1} data-entity-type={consumerDeal?.entity_type} data-entity-id={consumerDeal?.entity_id} data-destination-type={consumerDeal?.destination_type} data-source-page={consumerDeal ? "namaleniya" : undefined} data-product-id={consumerDeal?.entity_id || p.id} data-product-slug={p.slug} data-product-name={p.name_bg} data-brand-slug={p.brand_slug} data-brand-id={p.brand_id ?? ""} data-brand-name={p.brand_name} data-product-url={outboundUrl} data-category-key={taxonomy.categoryKey} data-category-keys={taxonomy.categoryKeys.join(",")} data-subcategory-keys={taxonomy.subcategoryKeys.join(",")} data-public-category={publicBrowse.categoryKey} data-public-subcategory={publicBrowse.subcategoryKey} data-product-type={p.product_type} data-giftable={p.giftable ? "1" : "0"} data-recipients={p.recipient.join("|")} data-gift-occasions={p.gift_occasion.join("|")} data-attributes={p.attributes.join("|")} data-audience={p.audience.join("|")} data-materials={p.materials.join("|")} data-ingredients={p.ingredient.join("|")} data-colors={p.colors.join("|")} data-search={consumerDeal?.search_text || buildSearchDocument([p.name_bg,p.brand_name,p.category,p.subcategory,p.product_type,...p.audience,...p.materials,...p.colors,...p.attributes,...(p.tags || []),p.short_desc_bg,p.long_desc_bg])} data-search-raw={[p.name_bg,p.brand_name,p.category,p.subcategory,p.product_type,...p.audience,...p.materials,...p.colors,...p.attributes,...(p.tags || []),p.short_desc_bg,p.long_desc_bg].filter(Boolean).join(" ")} data-tags={(p.tags || []).join(",")} data-brand={p.brand_slug} data-delivers-abroad={p.delivers_abroad ? "1" : "0"} data-price-min={p.price_min_eur ?? ""} data-price-max={p.price_max_eur ?? ""} data-created-at={p.created_at ?? ""} data-discount-current={discount?.current_price ?? undefined} data-current-price={discount?.current_price ?? undefined} data-checked-at={consumerDeal?.latest_checked_at} data-discount-percent={discount?.discount_percent ?? undefined} data-discount-facets={discount ? JSON.stringify(discountFacets) : undefined} data-discount-row-id={discount ? String(p.row_id) : undefined}>
  <div class="card-top">
    <a class="card-imglink" href={cardUrl} target={cardExternal ? "_blank" : undefined} rel={cardExternal ? "noopener noreferrer" : undefined} data-deal-link={consumerDeal ? "card" : undefined}><div class="thumb">{p.image_urls?.[0] ? <img class="thumb-img" src={p.image_urls[0]} alt={p.name_bg} loading={shouldEagerLoad ? "eager" : "lazy"} fetchpriority={index < 4 ? "high" : undefined} decoding="async" width="800" height="1000" sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 25vw" /> : <div class="thumb-ph" aria-hidden="true"></div>}</div></a>
    {!consumerDeal ? <button class="save-btn save-btn--card" type="button" aria-label="Запази продукта" aria-pressed="false" data-save-id={p.slug} data-save-url={`/p/${p.slug}/`} data-save-title={p.name_bg} data-save-brand={p.brand_name} data-save-price={price} data-save-image={p.image_urls?.[0] || ""}><svg class="save-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10a2 2 0 0 1 2 2v16l-7-4-7 4V5a2 2 0 0 1 2-2z" /></svg></button> : null}
  </div>
  <div class="card-body">
    <div class="card-meta-row"><div class="card-badges"><span class="cat" data-i18n-bg={categoryLabelBg} data-i18n-en={categoryLabelEn}>{categoryLabelBg}</span>{isBio ? <span class="cat cat--bio">Био</span> : null}{isEco ? <span class="cat cat--eco">Еко</span> : null}{isHandmade ? <span class="cat cat--handmade">Ръчна изработка</span> : null}{isGift ? <span class="cat cat--gift">Подарък</span> : null}</div>{discount ? <div class="discount-price" aria-label={`Редовна цена ${discountRegularPrice}; текуща цена ${price}; намаление ${discountBadge}`}><span class="discount-price__regular"><span class="sr-only">Редовна цена: </span>{discountRegularPrice}</span><span class="discount-price__current"><span class="sr-only">Текуща цена: </span>{price}</span><span class="discount-price__badge" aria-hidden="true">{discountBadge}</span></div> : price ? <span class="price price--inline">{price}</span> : null}</div>
    <a class="card-titlelink" href={cardUrl} target={cardExternal ? "_blank" : undefined} rel={cardExternal ? "noopener noreferrer" : undefined} data-deal-link={consumerDeal ? "card" : undefined}>{p.name_bg}</a>
    <div class="card-sub">{p.brand_name ? (p.brand_slug ? <a class="brand-link" href={`/brand/${p.brand_slug}/`}>{p.brand_name}</a> : <span>{p.brand_name}</span>) : null}</div>
    {freshness ? <p class="deal-freshness">{freshness}</p> : null}
  </div>
  <div class="card-foot">
    <button class="useful-result-signal" type="button" data-user-signal="useful_result" data-signal-context="search_results" aria-pressed="false" hidden>Полезен резултат</button>
    <a class="cta-out" href={outboundUrl} target="_blank" rel="noopener noreferrer" data-deal-link={consumerDeal ? "outbound" : undefined} data-deal-destination-type={consumerDeal ? "external" : undefined} data-i18n="home.cardCta">Виж в сайта на бранда ↗</a>
  </div>
</li>

<style>
  .card{display:block;width:100%;margin:0;grid-row:auto;background:rgba(255,255,255,.72);border:1px solid rgba(26,26,26,.08);border-radius:24px;box-shadow:0 10px 30px rgba(0,0,0,.05);overflow:hidden;transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease,background .22s ease}
  .card:hover{transform:translateY(-5px);box-shadow:0 20px 44px rgba(0,0,0,.1);border-color:rgba(26,26,26,.14);background:rgba(255,255,255,.9)}
  .card-top{position:relative}.thumb{position:relative;aspect-ratio:4/5;overflow:hidden;isolation:isolate;border-radius:24px 24px 0 0;background:linear-gradient(180deg,rgba(95,127,107,.1),rgba(26,26,26,.04))}
  .card:nth-child(8n + 2) .thumb{aspect-ratio:4/6}.card:nth-child(8n + 3) .thumb{aspect-ratio:1/1}.card:nth-child(8n + 5) .thumb{aspect-ratio:4/4.6}.card:nth-child(8n + 7) .thumb{aspect-ratio:4/5.8}.card:nth-child(9n + 1) .thumb{aspect-ratio:16/11}
  .thumb-img{display:block;width:100%;height:100%;object-fit:cover;transform:translateZ(0);backface-visibility:hidden;transition:transform .38s ease,filter .38s ease}.thumb-ph{display:block;width:100%;height:100%}.card:hover .thumb-img{transform:translateZ(0) scale(1.045);filter:saturate(1.02) contrast(1.01)}
  .save-btn--card{position:absolute;top:12px;right:12px;width:38px;height:38px;border:1px solid rgba(0,0,0,.08);border-radius:999px;background:rgba(255,255,255,.92);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;backdrop-filter:blur(6px);box-shadow:0 8px 18px rgba(0,0,0,.08)}.save-btn--card .save-ic{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6}.save-btn--card.is-saved .save-ic{fill:currentColor;stroke:none}.save-btn--card:focus-visible{outline:2px solid rgba(0,0,0,.35);outline-offset:2px}
  .card-body{padding:14px 16px 10px;background:rgba(255,255,255,.88)}.card-meta-row{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:10px}.card-badges{display:inline-flex;align-items:center;flex-wrap:wrap;gap:6px}
  .cat{display:inline-flex;align-items:center;min-height:28px;padding:0 10px;border-radius:999px;background:rgba(95,127,107,.1);color:rgba(26,26,26,.72);font-size:11px;font-weight:var(--weight-ui);letter-spacing:.06em;text-transform:uppercase}.cat--bio{background:rgba(87,112,88,.12);color:rgba(68,93,70,.92);border:1px solid rgba(87,112,88,.1)}.cat--eco{background:rgba(111,129,112,.11);color:rgba(84,103,85,.9);border:1px solid rgba(111,129,112,.12)}.cat--handmade{background:rgba(137,96,74,.12);color:#6c4f3f;border:1px solid rgba(137,96,74,.14);font-size:10px}.cat--gift{background:rgba(123,64,59,.1);color:#7b403b;border:1px solid rgba(123,64,59,.12)}
  .price--inline{font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:rgba(26,26,26,.62)}.card-titlelink{display:-webkit-box;font-size:clamp(17px,1.4vw,21px);line-height:1.12;letter-spacing:-.02em;text-decoration:none;text-wrap:balance;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}.card-titlelink:hover{text-decoration:none;opacity:.88}.card-sub{margin-top:6px;min-height:20px;font-size:13px;color:rgba(26,26,26,.62)}.brand-link{color:inherit;text-decoration:none}.brand-link:hover{text-decoration:underline}
  .discount-price{display:grid;grid-template-columns:auto auto;align-items:center;justify-content:end;gap:2px 7px;text-align:right}.discount-price__regular{grid-column:1/-1;color:rgba(26,26,26,.55);font-size:11px;text-decoration:line-through}.discount-price__current{font-size:14px;font-weight:var(--weight-medium);color:rgba(26,26,26,.92)}.discount-price__badge{display:inline-flex;align-items:center;min-height:23px;padding:0 7px;border-radius:999px;background:#7b403b;color:#fff;font-size:11px;font-weight:var(--weight-medium);letter-spacing:.02em}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .deal-freshness{margin:7px 0 0;color:#55705e;font-size:11px}
  .card-foot{padding:0 16px 16px;background:rgba(255,255,255,.88)}.useful-result-signal{width:100%;min-height:36px;margin:0 0 8px;border:1px solid rgba(95,127,107,.24);border-radius:999px;background:rgba(95,127,107,.08);color:rgba(26,26,26,.78);font:var(--weight-ui) 12px var(--font-body);cursor:pointer}.useful-result-signal[hidden]{display:none}.cta-out{width:100%;min-height:38px;padding:9px 12px;justify-content:center;background:transparent;border:1px solid rgba(26,26,26,.1);color:rgba(26,26,26,.76);font-size:12px;line-height:19.2px}.cta-out:hover{background:rgba(95,127,107,.08);border-color:rgba(95,127,107,.22);color:rgba(26,26,26,.92)}
  @media(max-width:768px){.card{border-radius:22px;box-shadow:0 14px 30px rgba(0,0,0,.05)}.thumb{border-radius:22px 22px 0 0;aspect-ratio:4/5.7}.card:nth-child(6n + 1) .thumb{aspect-ratio:4/5.45}.card:nth-child(6n + 2) .thumb{aspect-ratio:4/6}.card:nth-child(6n + 3) .thumb{aspect-ratio:4/5.55}.card:nth-child(6n + 4) .thumb{aspect-ratio:4/6.1}.card:nth-child(6n + 5) .thumb{aspect-ratio:4/5.5}.card:nth-child(6n + 6) .thumb{aspect-ratio:4/5.85}.save-btn--card{top:14px;right:14px;width:40px;height:40px}.card-body{padding:8px 10px 4px}.card-titlelink{font-size:clamp(15px,4.1vw,18px);line-height:1.08}.card-sub{margin-top:4px;min-height:0;font-size:11px;line-height:1.25}.card-foot{padding:0 10px 8px}.cat{min-height:22px;padding:0 7px;font-size:9px}.price--inline{font-size:10px}.discount-price__regular{font-size:9px}.discount-price__current{font-size:12px}.discount-price__badge{min-height:20px;padding:0 6px;font-size:9px}.card-meta-row{margin-bottom:8px;gap:6px}.card-badges{gap:5px}.card-badges .cat:nth-child(n + 4){display:none}.cta-out{min-height:38px;padding:2px 10px;font-size:10px;line-height:16px}}
</style>
