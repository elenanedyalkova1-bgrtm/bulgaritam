  </style>

  <script>
    const brandGrid = document.getElementById("brandGrid");
    const brandCount = document.getElementById("brandCount");
    const brandFeedStatus = document.getElementById("brandFeedStatus");
    const brandFeedSentinel = document.getElementById("brandFeedSentinel");
    const brandCards = brandGrid ? Array.from(brandGrid.querySelectorAll("[data-brand-card]")) : [];

    const getBrandBatchSize = () => {
      if (window.innerWidth <= 640) return 8;
      if (window.innerWidth <= 768) return 10;
      return 16;
    };

    let brandVisibleCount = getBrandBatchSize();

    function updateBrandFeed() {
      brandCards.forEach((card, index) => {
        card.style.display = index < brandVisibleCount ? "" : "none";
      });

      if (brandCount) brandCount.textContent = String(brandCards.length);
      if (brandFeedStatus) {
        const shown = Math.min(brandVisibleCount, brandCards.length);
        brandFeedStatus.textContent =
          brandCards.length > shown ? `Показани ${shown} от ${brandCards.length}` : "";
      }

      if (brandFeedSentinel) {
        brandFeedSentinel.hidden = brandVisibleCount >= brandCards.length;
      }

      window.dispatchEvent(new Event("resize"));
    }

    function loadMoreBrandCards() {
      if (brandVisibleCount >= brandCards.length) return;
      brandVisibleCount += getBrandBatchSize();
      updateBrandFeed();
    }

    updateBrandFeed();

    if ("IntersectionObserver" in window && brandFeedSentinel) {
      const brandObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) loadMoreBrandCards();
        });
      }, { rootMargin: "320px 0px" });

      brandObserver.observe(brandFeedSentinel);
    }

    window.addEventListener("resize", () => {
      brandVisibleCount = Math.max(brandVisibleCount, getBrandBatchSize());
      updateBrandFeed();
    });
  </script>
</BaseLayout>
