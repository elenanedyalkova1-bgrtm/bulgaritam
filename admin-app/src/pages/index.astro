---
import AdminLayout from "../layouts/AdminLayout.astro";
import { loadLatestProductHealthReport } from "../lib/github-deploy";
import { isProductActive, listBrands, listProducts } from "../lib/repositories";
const [products, brands] = await Promise.all([listProducts(), listBrands()]);
let health: Awaited<ReturnType<typeof loadLatestProductHealthReport>> = null;
try { health = await loadLatestProductHealthReport(); } catch { /* Catalog overview remains available if GitHub is temporarily unavailable. */ }
const validProducts = products.filter((p) => p.name_bg && p.slug);
const validBrands = brands.filter((b) => b.brand_name && b.brand_slug);
const knownBrandSlugs = new Set(validBrands.map((brand) => String(brand.brand_slug).trim()).filter(Boolean));
const metrics = [
  ["Products", validProducts.length], ["Active Products", validProducts.filter((p) => isProductActive(p.is_active)).length],
  ["Brands", validBrands.length], ["Active Brands", validBrands.filter((b) => b.is_active === true).length],
  ["Hidden Products", validProducts.filter((p) => !isProductActive(p.is_active)).length], ["Hidden Brands", validBrands.filter((b) => b.is_active !== true).length],
  ["Empty image field", validProducts.filter((p) => !String(p.image_urls || "").trim()).length], ["Missing Brand relationship", validProducts.filter((p) => !p.brand_ref?.length && !knownBrandSlugs.has(String(p.brand_slug || "").trim())).length],
];
const broken = health?.report.confirmed_broken_images ?? null;
const review = health?.report.needs_review ?? null;
---
<AdminLayout title="Overview" active="overview">
  <header class="head"><div><h1>Overview</h1><p class="muted">Catalog status from Baserow</p></div><a class="btn" href="/publish/">Publish website</a></header>
  <section class="cards">{metrics.map(([label,value]) => <div class="metric"><span class="muted">{label}</span><b>{value}</b></div>)}</section>
  <a class="panel problem-summary" href="/problems/">
    <div><strong>Проблемни продукти</strong><p class="muted">Последен автоматичен image-health отчет{health ? ` · ${new Date(health.report.generated_at).toLocaleString("bg-BG")}` : ""}</p></div>
    <div class="problem-count"><span>Счупени изображения<b>{broken ?? "—"}</b></span><span>За проверка<b>{review ?? "—"}</b></span><span aria-hidden="true">→</span></div>
  </a>
  <section class="panel warning"><strong>Changes require publication.</strong><p class="muted">Admin saves update Baserow immediately. Use Publish website to run a verified static build before sending changes to SuperHosting.</p></section>
</AdminLayout>
<style>.problem-summary{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:20px;color:inherit;text-decoration:none}.problem-summary:hover{border-color:var(--green)}.problem-summary p{margin:4px 0 0}.problem-count{display:flex;align-items:center;gap:24px}.problem-count span{font-size:12px;color:#777}.problem-count b{display:block;font-size:24px;color:#272622}@media(max-width:700px){.problem-summary,.problem-count{align-items:flex-start}.problem-summary{display:grid}.problem-count{flex-wrap:wrap}}</style>
