---
import SeoProductLanding from "../../../../components/SeoProductLanding.astro";
import { SEO_LANDINGS, getCanonicalPathForLanding, getLandingPageHierarchy, getProductsForLanding } from "../../../../lib/seo-landings";
import { loadProducts } from "../../../../lib/products";

export async function getStaticPaths() {
  const products = await loadProducts();
  return SEO_LANDINGS.filter((landing) => !landing.canonicalSlug && getCanonicalPathForLanding(landing).startsWith("/k/")).flatMap((landing) => {
    const matches = getProductsForLanding(products, landing);
    const pages = Math.ceil(matches.length / 48);
    return Array.from({ length: Math.max(0, pages - 1) }, (_, index) => ({
      params: { slug: landing.slug, page: String(index + 2) },
      props: { landing, products: matches, pageNumber: index + 2 },
    }));
  });
}

const { landing, products, pageNumber } = Astro.props;
const allProducts = await loadProducts();
const hierarchy = getLandingPageHierarchy(landing, allProducts);
const collectionPath = getCanonicalPathForLanding(landing);
---
<SeoProductLanding
  landing={hierarchy.seoLanding}
  products={products}
  browseProducts={allProducts}
  canonicalPath={`${collectionPath.replace(/\/$/, "")}/page/${pageNumber}/`}
  collectionPath={collectionPath}
  pageNumber={pageNumber}
  breadcrumbs={hierarchy.breadcrumbs}
  primaryPills={hierarchy.primaryPills}
  secondaryPills={hierarchy.secondaryPills}
  parentLink={hierarchy.parentLink}
/>
