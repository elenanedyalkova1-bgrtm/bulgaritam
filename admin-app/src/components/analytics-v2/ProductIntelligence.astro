---
import type {AnalyticsV2ViewModel} from "../../lib/analytics-v2";
import {productHasExplicitFollowUp} from "../../lib/analytics-v2-products";
import ProductIntelligenceDetail from "./ProductIntelligenceDetail.astro";
const {product}=Astro.props as{product:AnalyticsV2ViewModel["product"]};
const n=(value:number)=>new Intl.NumberFormat("bg-BG").format(value);
const times=(value:number)=>`${n(value)} ${value===1?"път":"пъти"}`;
const visitorText=(value:number)=>`${n(value)} ${value===1?"посетител":"посетители"}`;
const deepSignals=(row:typeof product.rows[number])=>[{label:"Посещения на продуктовата страница",value:row.pageViews},{label:"Запазен",value:row.saves},{label:"Добавен в колекция",value:row.collectionAdds},{label:"Премахнат от колекция",value:row.collectionRemoves},{label:"Споделен",value:row.shares},{label:"Преминавания към сайта",value:row.outbound}].filter(item=>item.value>0);
const deeperRows=product.rows.filter(productHasExplicitFollowUp).sort((a,b)=>Number(productHasExplicitFollowUp(b))-Number(productHasExplicitFollowUp(a))||b.outbound-a.outbound||b.pageViews-a.pageViews||a.name.localeCompare(b.name,"bg")||a.key.localeCompare(b.key));
---
<div class="product-intelligence">
 {product.rows.length===0?<div class="empty">Няма наблюдавана продуктова активност за избрания период.</div>:<>
  <section class="product-section orientation" aria-labelledby="product-overview"><h4 id="product-overview">Какво се случи</h4><div class="summary-grid"><article><span>Продукти с възможност за показване</span><b>{n(product.summary.eligibleProducts)}</b><small>различни продукта</small></article><article><span>Действително видени продукти</span><b>{n(product.summary.visibleProducts)}</b><small>различни продукта</small></article><article><span>Отворени от резултатите</span><b>{n(product.summary.openedProducts)}</b><small>различни продукта</small></article><article><span>С преминаване към сайта</span><b>{n(product.summary.outboundProducts)}</b><small>различни продукта</small></article></div><p>Виждане се отчита само когато поне половината продуктова карта е била видима. Възможността за показване не означава, че продуктът е бил видян.</p></section>

  <section class="product-section attention" aria-labelledby="product-attention"><h4 id="product-attention">Какво заслужава внимание</h4><p>{n(product.summary.visibleProducts)} продукта са били видени през периода. {product.summary.openedProducts===0?"Няма отчетени директни отваряния от резултатите.":`Директно от резултатите са били отворени ${n(product.summary.openedProducts)} продукта.`} {product.summary.outboundProducts===0?"Няма отчетени преминавания към сайтовете на брандовете.":`За ${n(product.summary.outboundProducts)} продукта е отчетено преминаване към сайта.`} Това са отделни наблюдения и не означават, че едното действие е последвало другото. {product.peerNote||`${n(product.summary.peerEligibleProducts)} продукта имат достатъчно сравними показвания за внимателна оценка.`}</p></section>

  {product.visible.length>0&&<section class="product-section" aria-labelledby="product-visible"><div class="section-head"><div><h4 id="product-visible">Кои продукти са били виждани най-често?</h4><p>Подредени по броя посетители, които са ги видели. Пълният списък е в продуктовия explorer.</p></div></div><div class="product-list">{product.visible.slice(0,8).map(row=><details class="product-row"><summary><span class="identity"><b>{row.name}</b><small>{row.brand}</small></span><span><b>{visitorText(row.visitors)}</b><small>Виден {times(row.qualifiedViews)}</small></span><i aria-hidden="true">⌄</i></summary><div class="product-detail"><ProductIntelligenceDetail row={row}/></div></details>)}</div></section>}

  {product.opened.length>0&&<section class="product-section" aria-labelledby="product-opened"><h4 id="product-opened">Кои от видените продукти са били отворени?</h4><p>Директното отваряне от резултатите е отделно от посещението на продуктовата страница.</p><div class="compact-cards">{product.opened.slice(0,8).map(row=><article><b>{row.name}</b><small>{row.brand}</small><p>Отворен от резултатите {times(row.opened)} от {visitorText(row.openingVisitors)}.</p>{row.pageViews>0&&<p>Продуктовата страница е посетена {times(row.pageViews)}.</p>}</article>)}</div></section>}

  {deeperRows.length>0?<section class="product-section" aria-labelledby="product-deeper"><h4 id="product-deeper">При кои продукти има следващо действие?</h4><p>Показани са само изрични действия; повторното виждане само по себе си не е включено. Пълният списък е в продуктовия explorer.</p><div class="compact-cards">{deeperRows.slice(0,6).map(row=><article><b>{row.name}</b><small>{row.brand}</small><ul>{deepSignals(row).map(signal=><li>{signal.label}: {times(signal.value)}</li>)}{row.repeatExplicitVisitors>0&&<li>Повторно изрично действие в отделни посещения: {visitorText(row.repeatExplicitVisitors)}</li>}</ul></article>)}</div></section>:<section class="product-section quiet" aria-labelledby="product-deeper"><h4 id="product-deeper">При кои продукти има следващо действие?</h4><p>През периода няма отчетени изрични последващи действия за продукт.</p></section>}

  {product.lowVisibility.length>0&&<p class="quiet-note">За повечето продукти все още няма достатъчно наблюдения за надеждна сравнителна оценка. Подробностите остават достъпни в продуктовия explorer.</p>}

  <section class="product-section all-products" aria-labelledby="all-products"><details><summary id="all-products">Виж всички продукти и подробните данни</summary><div class="explorer" data-product-explorer><label>Намери продукт или бранд<input type="search" placeholder="Име на продукт или бранд" data-product-search/></label><p class="search-empty" data-product-empty hidden>Няма продукт или бранд, който съответства на търсенето.</p><div class="table-wrap"><table><thead><tr><th>Продукт</th>{[["qualifiedViews","Видян"],["visitors","Посетители"],["opened","Отворен"],["pageViews","Продуктова страница"],["saves","Запазен"],["outbound","Към сайта"]].map(([key,label],index)=><th aria-sort={index===1?"descending":"none"}><button type="button" data-sort-key={key}>{label}<span aria-hidden="true">{index===1?" ↓":""}</span></button></th>)}</tr></thead><tbody>{product.rows.map((row,index)=><tr data-index={index} data-name={row.name.toLocaleLowerCase("bg")} data-brand={row.brand.toLocaleLowerCase("bg")} data-qualified-views={row.qualifiedViews} data-visitors={row.visitors} data-opened={row.opened} data-page-views={row.pageViews} data-saves={row.saves} data-outbound={row.outbound}><td><details><summary>{row.name}<small>{row.brand}</small></summary><div class="inline-detail"><ProductIntelligenceDetail row={row}/></div></details></td><td>{n(row.qualifiedViews)}</td><td>{n(row.visitors)}</td><td>{n(row.opened)}</td><td>{n(row.pageViews)}</td><td>{n(row.saves)}</td><td>{n(row.outbound)}</td></tr>)}</tbody></table></div></div></details></section>
 </>}
</div>
<script>
 document.querySelectorAll<HTMLElement>("[data-product-explorer]").forEach(explorer=>{const body=explorer.querySelector("tbody"),search=explorer.querySelector<HTMLInputElement>("[data-product-search]"),empty=explorer.querySelector<HTMLElement>("[data-product-empty]"),headers=[...explorer.querySelectorAll<HTMLButtonElement>("[data-sort-key]")];if(!body||!search)return;let active="visitors",direction:"asc"|"desc"="desc";const rows=()=>[...body.querySelectorAll<HTMLTableRowElement>("tr")];const value=(row:HTMLTableRowElement,key:string)=>Number(row.dataset[key.replace(/[A-Z]/g,letter=>`-${letter.toLowerCase()}`)]||0);const apply=()=>{const query=search.value.trim().toLocaleLowerCase("bg");const ordered=rows().sort((a,b)=>{const difference=value(a,active)-value(b,active);return(direction==="asc"?difference:-difference)||Number(a.dataset.index)-Number(b.dataset.index)});let visible=0;ordered.forEach(row=>{row.hidden=Boolean(query&&!`${row.dataset.name} ${row.dataset.brand}`.includes(query));if(!row.hidden)visible++;body.appendChild(row)});if(empty)empty.hidden=visible>0;headers.forEach(button=>{const selected=button.dataset.sortKey===active,th=button.closest("th")!;th.setAttribute("aria-sort",selected?(direction==="asc"?"ascending":"descending"):"none");const indicator=button.querySelector("span");if(indicator)indicator.textContent=selected?(direction==="asc"?" ↑":" ↓"):""})};search.addEventListener("input",apply);headers.forEach(button=>button.addEventListener("click",()=>{const key=button.dataset.sortKey||"visitors";direction=active===key&&direction==="desc"?"asc":"desc";active=key;apply()}));apply()});
</script>
<style>
 .product-intelligence{min-width:0;max-width:100%;color:#29322c}.product-section{margin-top:24px}.product-section:first-child{margin-top:0}.product-section h4{margin:0 0 5px;font-size:1.15rem}.product-section>p,.section-head p{margin:.25rem 0 14px;color:#657069;line-height:1.55}.summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.summary-grid article,.compact-cards article{min-width:0;padding:14px;border:1px solid #dbe5de;border-radius:10px;background:#fff}.summary-grid span,.summary-grid b,.summary-grid small,.compact-cards b,.compact-cards small{display:block}.summary-grid span{font-size:.88rem;color:#526059}.summary-grid b{margin:.3rem 0;font-size:1.5rem}.summary-grid small,.compact-cards small,.identity small{color:#6a746e}.attention{padding:16px;border-left:3px solid #789a83;background:#f6faf7;border-radius:0 9px 9px 0}.attention p{margin:0}.quiet-note,.quiet{padding:12px 14px;border:1px solid #e0e7e2;border-radius:9px;background:#fafcfb;color:#626c66}.product-list{display:grid;gap:8px}.product-row{border:1px solid #dbe5de;border-radius:10px;background:#fff;overflow:hidden}.product-row>summary{display:grid;grid-template-columns:minmax(0,1fr) minmax(180px,.65fr) auto;gap:16px;align-items:center;padding:13px 15px;cursor:pointer;list-style:none}.product-row>summary::-webkit-details-marker,.all-products>details>summary::-webkit-details-marker,td details>summary::-webkit-details-marker{display:none}.product-row>summary span b,.product-row>summary span small{display:block}.product-row>summary>span:nth-child(2){text-align:right}.product-detail{padding:16px;border-top:1px solid #e7ede9;background:#fbfcfb}.compact-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.compact-cards p{margin:.6rem 0 0}.all-products>details>summary{cursor:pointer;font-weight:700;padding:13px 15px;border:1px solid #cedbd2;border-radius:9px;background:#fff}.all-products details[open]>summary{border-radius:9px 9px 0 0}.explorer{padding:14px;border:1px solid #dbe5de;border-top:0;background:#fff}.explorer>label{display:grid;gap:6px;max-width:420px;margin-bottom:12px;font-weight:650}.explorer input{padding:10px 11px;border:1px solid #cbd7cf;border-radius:7px;font:inherit}.search-empty{color:#657069}.table-wrap{max-width:100%;overflow-x:auto;border:1px solid #dbe5de}.table-wrap table{width:100%;min-width:760px;border-collapse:collapse}.table-wrap th,.table-wrap td{padding:10px;text-align:left;border-bottom:1px solid #e5ebe7;vertical-align:top}.table-wrap td:not(:first-child),.table-wrap th:not(:first-child){text-align:right}.table-wrap th button{padding:0;border:0;background:transparent;color:inherit;font:inherit;font-weight:700;cursor:pointer;white-space:nowrap}.table-wrap th[aria-sort]:not([aria-sort="none"]) button{color:#235e43;text-decoration:underline;text-underline-offset:3px}.table-wrap td summary{cursor:pointer;min-width:190px}.table-wrap td summary small{display:block;color:#727b75}.inline-detail{min-width:310px;max-width:620px;padding:12px 0}.empty{padding:18px;border:1px dashed #bccbc0;border-radius:8px;background:#fff;color:#5d675f}
 @media(max-width:850px){.summary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.facts{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:600px){.summary-grid,.compact-cards{grid-template-columns:1fr}.product-row>summary{grid-template-columns:minmax(0,1fr) auto;gap:8px}.product-row>summary>span:nth-child(2){grid-column:1;text-align:left}.product-row>summary>i{grid-column:2;grid-row:1/3}.product-detail{padding:13px}.product-section{margin-top:20px}.table-wrap{max-width:100%}.explorer{padding:10px}}
</style>
