    <!-- COOKIE BANNER -->
    <div id="cookie-banner" class="cookie" hidden>
      <div class="cookie-card" role="dialog" aria-modal="true" aria-labelledby="cookie-title" aria-live="polite">
        <div class="cookie-text">
          <div class="cookie-title" id="cookie-title" data-i18n="cookie.title">Бисквитки</div>
          <p class="cookie-p">
            <span data-i18n="cookie.body">Използваме необходими бисквитки за да работи сайтът. С Ваше съгласие можем да използваме и аналитични бисквитки.</span>
            <a class="cookie-link" href="/politika-na-poveritelnost/" data-i18n="footer.privacy">Политика за поверителност</a>.
          </p>
        </div>

        <div class="cookie-actions">
          <button class="cookie-btn cookie-btn--ghost" type="button" data-cookie="settings" data-i18n="cookie.settings">Настройки</button>
          <button class="cookie-btn" data-cookie="necessary" data-i18n="cookie.necessary">Само необходими</button>
          <button class="cookie-btn cookie-btn--primary" data-cookie="accept" data-i18n="cookie.accept">Приемам</button>
        </div>

        <div id="cookie-settings" class="cookie-settings" hidden>
          <label class="cookie-row" for="cookie-analytics">
            <input id="cookie-analytics" type="checkbox" />
            <span>
              <strong data-i18n="cookie.analytics">Аналитични бисквитки</strong><br />
              <span class="cookie-muted" data-i18n="cookie.analyticsHint">Помагат ни да разбираме кои продукти, търсения и филтри използват хората най-често.</span>
            </span>
          </label>

          <div class="cookie-actions cookie-actions--right">
            <button class="cookie-btn cookie-btn--primary" type="button" data-cookie="save" data-i18n="cookie.save">Запази избора</button>
          </div>
        </div>
      </div>
    </div>

    <script is:inline>
      const COOKIE_KEY = "bulgaritam_cookie_consent_v1";
      const banner = document.getElementById("cookie-banner");
      const settingsWrap = document.getElementById("cookie-settings");
      const analyticsCheckbox = document.getElementById("cookie-analytics");

      const applyCookieConsent = (consent) => {
        document.documentElement.dataset.cookieAnalytics = consent?.analytics ? "1" : "0";
        window.__cookieConsent = {
          necessary: true,
          analytics: Boolean(consent?.analytics),
        };
        window.dispatchEvent(new CustomEvent("cookie-consent", { detail: window.__cookieConsent }));
      };

      const readConsent = () => {
        try {
          const raw = localStorage.getItem(COOKIE_KEY);
          return raw ? JSON.parse(raw) : null;
        } catch {
          return null;
        }
      };

      const writeConsent = (consent) => {
        localStorage.setItem(COOKIE_KEY, JSON.stringify(consent));
        applyCookieConsent(consent);
        banner?.setAttribute("hidden", "");
      };

      const existingConsent = readConsent();
      if (existingConsent) {
        applyCookieConsent(existingConsent);
        if (analyticsCheckbox) analyticsCheckbox.checked = Boolean(existingConsent.analytics);
      } else if (banner) {
        banner.removeAttribute("hidden");
      }

      banner?.addEventListener("click", (e) => {
        const b = e.target.closest("[data-cookie]");
        if (!b) return;
        const action = b.dataset.cookie;

        if (action === "settings") {
          settingsWrap?.toggleAttribute("hidden");
          return;
        }

        if (action === "save") {
          writeConsent({
            necessary: true,
            analytics: Boolean(analyticsCheckbox?.checked),
          });
          return;
        }

        writeConsent({
          necessary: true,
          analytics: action === "accept",
        });
      });
    </script>

    <script is:inline>
      const lazyImages = Array.from(document.querySelectorAll("img[data-lazy-src]"));

      const hydrateLazyImage = (img) => {
        const nextSrc = img.getAttribute("data-lazy-src");
        if (!nextSrc) return;

        img.src = nextSrc;
        img.removeAttribute("data-lazy-src");
      };

      let lazyImageObserver = null;
      if ("IntersectionObserver" in window) {
        lazyImageObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            hydrateLazyImage(entry.target);
            observer.unobserve(entry.target);
          });
        }, { rootMargin: "640px 0px" });
      }

      window.bulgaritamHydrateLazyImages = (root = document) => {
        const scopedImages = Array.from(root.querySelectorAll?.("img[data-lazy-src]") || []);
        if (!scopedImages.length) return;
        if (lazyImageObserver) {
          scopedImages.forEach((img) => lazyImageObserver.observe(img));
        } else {
          scopedImages.forEach(hydrateLazyImage);
        }
      };

      window.bulgaritamHydrateLazyImages(document);
    </script>

    <script is:inline>
      const masonryGrids = Array.from(document.querySelectorAll("[data-masonry-grid]"));

      const measureMasonryGrid = (grid) => {
        const disableOnMobile = grid.dataset.masonryMobile === "off" && window.innerWidth <= 768;
        const cards = Array.from(grid.querySelectorAll("[data-masonry-card]"));

        if (disableOnMobile) {
          cards.forEach((card) => card.style.removeProperty("--masonry-span"));
          return;
        }

        const computed = window.getComputedStyle(grid);
        const rowGap = Number.parseFloat(computed.rowGap || computed.gap || "0") || 0;
        const autoRow = Number.parseFloat(computed.gridAutoRows || "1") || 1;

        cards.forEach((card) => {
          if (card.style.display === "none") {
            card.style.removeProperty("--masonry-span");
            return;
          }

          const span = Math.max(1, Math.ceil((card.getBoundingClientRect().height + rowGap) / (autoRow + rowGap)));
          card.style.setProperty("--masonry-span", String(span));
        });
      };

      const scheduleMasonry = (grid) => {
        cancelAnimationFrame(grid.__masonryFrame || 0);
        grid.__masonryFrame = requestAnimationFrame(() => measureMasonryGrid(grid));
      };

      masonryGrids.forEach((grid) => {
        scheduleMasonry(grid);

        Array.from(grid.querySelectorAll("img")).forEach((img) => {
          if (img.complete) return;
          img.addEventListener("load", () => scheduleMasonry(grid), { once: true });
          img.addEventListener("error", () => scheduleMasonry(grid), { once: true });
        });

        if ("ResizeObserver" in window) {
          const resizeObserver = new ResizeObserver(() => scheduleMasonry(grid));
          resizeObserver.observe(grid);
          Array.from(grid.querySelectorAll("[data-masonry-card]")).forEach((card) => resizeObserver.observe(card));
        }
      });

      window.addEventListener("resize", () => {
        masonryGrids.forEach((grid) => scheduleMasonry(grid));
      });
    </script>

    
