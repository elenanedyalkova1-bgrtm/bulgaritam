---
import type {ProductPresentationRow} from "../../lib/analytics-v2-products";
import {acquisitionLabel,contextLabel} from "../../lib/analytics-v2-language";
const {row}=Astro.props as{row:ProductPresentationRow};
const n=(value:number)=>new Intl.NumberFormat("bg-BG").format(value);
const times=(value:number)=>`${n(value)} ${value===1?"път":"пъти"}`;
const visitors=(value:number)=>`${n(value)} ${value===1?"посетител":"посетители"}`;
const signals=[{label:"Посещения на продуктовата страница",value:row.pageViews},{label:"Запазен",value:row.saves},{label:"Добавен в колекция",value:row.collectionAdds},{label:"Премахнат от колекция",value:row.collectionRemoves},{label:"Споделен",value:row.shares},{label:"Преминавания към сайта",value:row.outbound}].filter(item=>item.value>0);
const seen=row.visitors?`е бил видян от ${visitors(row.visitors)} общо ${times(row.qualifiedViews)}`:`не е бил видян през периода`;
const opened=row.opened?`Отворен е директно от резултатите ${times(row.opened)}.`:"Няма отчетено директно отваряне от резултатите.";
const page=row.pageViews?`Продуктовата страница е посетена ${times(row.pageViews)}.`:"Няма отчетено посещение на продуктовата страница.";
const outbound=row.outbound?`Има ${times(row.outbound)} преминаване към сайта.`:"Няма отчетено преминаване към сайта.";
---
<div class="product-detail-content"><h5>{row.name} · {row.brand}</h5><p class="narrative">Този продукт е имал {n(row.eligible)} възможности за показване и {seen}. {opened} {page} {outbound} {row.positionSummary!=="—"&&`Най-често е присъствал в позиции ${row.positionSummary}.`} {row.peerComparisons.some(item=>item.eligible)?"Има достатъчно сравними показвания за внимателна оценка спрямо подобни продукти.":"Данните все още не са достатъчни за надеждна сравнителна оценка."}</p><details class="evidence"><summary>Виж подробните данни</summary><dl class="facts"><div><dt>Възможности за показване</dt><dd>{n(row.eligible)}</dd></div><div><dt>Видян</dt><dd>{times(row.qualifiedViews)} · {visitors(row.visitors)}</dd></div><div><dt>Отваряния от резултатите</dt><dd>{times(row.opened)}</dd></div><div><dt>Посещения на продуктовата страница</dt><dd>{times(row.pageViews)}</dd></div><div><dt>Преминавания към сайта</dt><dd>{times(row.outbound)}</dd></div><div><dt>Повторна видимост/действие</dt><dd>{visitors(row.repeatObservedVisitors)}</dd></div>{row.repeatExplicitVisitors>0&&<div><dt>Повторно изрично действие</dt><dd>{visitors(row.repeatExplicitVisitors)}</dd></div>}</dl>{row.surfaces.length>0&&<div class="contexts"><h6>Къде е срещан</h6><ul>{row.surfaces.map(item=><li><b>{contextLabel(item.surface)}</b> · възможности {n(item.eligible)} · видян {n(item.seen)} · отваряния {n(item.opened)}</li>)}</ul></div>}{row.positionSummary!=="—"&&<p class="position">Най-често е присъствал в позиции {row.positionSummary}.</p>}{row.searchContexts.length>0&&<div class="contexts"><h6>Търсения с директен контекст</h6><p>{row.searchContexts.map(value=>`„${value}“`).join(" · ")}</p></div>}{row.choiceContexts.length>0&&<div class="contexts"><h6>Критерии с директен контекст</h6><p>{row.choiceContexts.join(" · ")}</p></div>}{row.acquisition.length>0&&<div class="contexts"><h6>Входни посещения на продуктовата страница</h6><ul>{row.acquisition.map(item=><li>{acquisitionLabel({source:item.channel})}: {times(item.visits)}</li>)}</ul></div>}{signals.length>0&&<div class="contexts"><h6>Следващи действия</h6><ul>{signals.map(item=><li>{item.label}: {times(item.value)}</li>)}</ul></div>}<p class="comparison">{row.peerComparisons.some(item=>item.eligible)?"Има достатъчно сравними показвания; сравнението използва същото място и позиционен контекст.":"Все още няма достатъчно сравними показвания за надеждна оценка."}</p></details></div>
<style>
 h5{margin:0 0 10px;font-size:1rem}.narrative{margin:0;line-height:1.6;color:#3f4943}.evidence{margin-top:13px}.evidence>summary{cursor:pointer;font-weight:700;color:#315e48}.facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:12px 0}.facts div{padding:9px;background:#fff;border:1px solid #e3e9e5;border-radius:7px}.facts dt{font-size:.78rem;color:#68736c}.facts dd{margin:3px 0 0;font-weight:650}.contexts{margin-top:13px}.contexts h6{margin:0 0 5px;font-size:.88rem}.contexts ul{margin:5px 0;padding-left:18px}.contexts p,.position,.comparison{font-size:.86rem;color:#606b64}.comparison{margin-bottom:0}@media(max-width:850px){.facts{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.facts{grid-template-columns:1fr}}
</style>
