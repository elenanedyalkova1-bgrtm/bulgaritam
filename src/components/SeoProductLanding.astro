---
import { resolvePublishableOffer, formatVerifiedOfferAmount } from "../lib/verified-offer";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCategoryLabel, getCategoryLabelForLang, getSubcategoryLabelForLang, getTaxonomyForProduct } from "../lib/taxonomy";
import { getProductBadges } from "../lib/product-badges";
import { PUBLIC_BROWSE_CATEGORIES } from "../lib/public-browse-taxonomy";
import { GIFT_FACETS_BY_CONTEXT, STRUCTURED_FACET_OPTIONS } from "../../admin-app/src/lib/product-taxonomy";
import { SEO_INTENT_LANDINGS, getFallbackSiblingLinks, getLandingGraphNode, getSeoLandingStateRegistry } from "../lib/seo-landings";
import { orderPublicFilters } from "../lib/public-filter-order";
import { priceRangesForProduct } from "../lib/price-ranges";
import { getHumanReviewedLandingContent } from "../lib/landing-content";

const {
  landing,
  products,
  canonicalPath,
  breadcrumbs = [],
  primaryPills = [],
  secondaryPills = [],
  primaryPillsAriaLabel = "Подкатегории",
  secondaryPillsAriaLabel = "Още филтри",
  editorialSections = [],
  editorialHeader = null,
  refinementTitle = "",
  secondaryPillsTitle = "",
  parentLink = null,
  browseProducts = [],
  pageNumber = 1,
  pageSize = 48,
  collectionPath = canonicalPath,
} = Astro.props;

const reviewedContent = getHumanReviewedLandingContent(collectionPath);
const contentH1 = reviewedContent?.h1 || landing.h1;
const contentIntro = reviewedContent ? reviewedContent.intro : landing.intro;
const contentEditorialHeader = reviewedContent
  ? (reviewedContent.collapsibleSummary ? { title: reviewedContent.collapsibleSummary } : null)
  : editorialHeader;
const contentEditorialSections = reviewedContent
  ? (reviewedContent.collapsibleSummary && reviewedContent.collapsibleParagraphs.length
      ? [{ title: "", paragraphs: reviewedContent.collapsibleParagraphs }]
      : [])
  : editorialSections;

const clean = (value) => String(value ?? "").trim();
const resolvedRefinementTitle = refinementTitle ||
  (landing.group === "clothing" || landing.categoryKey === "clothing" ? "Вид облекло" : "Вид продукт");
const resolvedSecondaryPillsTitle = secondaryPillsTitle || (
  landing.categoryKey === "gifts" ? "Разгледай още идеи" :
  landing.categoryKey === "clothing" || landing.group === "clothing" ? "Още български дрехи" :
  landing.categoryKey === "cosmetics" ? "Още българска козметика" :
  "Свързани категории"
);
const fallbackSiblingPills = browseProducts.length ? getFallbackSiblingLinks(landing, browseProducts, 6) : [];
const getPrimaryImage = (product) =>
  Array.isArray(product?.image_urls)
    ? product.image_urls.find((url) => /^https?:\/\//i.test(clean(url))) || product.image_urls.find((url) => clean(url))
    : "";

const registeredStructuredState = landing.structuredState || {};
const registeredCategory = clean(registeredStructuredState.category?.[0] || landing.structuredCategory);
const registeredSubcategory = clean(registeredStructuredState.subcategory?.[0] || landing.structuredSubcategory);
const browseCategoryKey = landing.categoryKey || "";
const browseSubcategoryKey = landing.audienceSubcategoryKey || landing.subcategoryKey ||
  PUBLIC_BROWSE_CATEGORIES.find((category) => category.key === browseCategoryKey || category.value === registeredCategory)
    ?.subcategories.find((subcategory) => subcategory.value === registeredSubcategory)?.key || "";
const browseCategory = PUBLIC_BROWSE_CATEGORIES.find((category) => category.key === browseCategoryKey || category.value === registeredCategory);
const browseSubcategory = browseCategory?.subcategories.find((subcategory) => subcategory.key === browseSubcategoryKey || subcategory.value === registeredSubcategory);
const displayProducts = [...new Map(products.filter((product) => getPrimaryImage(product)).map((product) => [product.slug, product])).values()];
const initialDisplayCount = displayProducts.length;
const totalPages = Math.max(1, Math.ceil(initialDisplayCount / pageSize));
const pageStart = (pageNumber - 1) * pageSize;
const pageProducts = displayProducts.slice(pageStart, pageStart + pageSize);
const pageHref = (page) => page === 1 ? collectionPath : `${collectionPath.replace(/\/$/, "")}/page/${page}/`;
const structuredTypeCounts = new Map();
displayProducts.forEach((product) => {
  const value = clean(product.product_type);
  if (value && getPrimaryImage(product)) structuredTypeCounts.set(value, (structuredTypeCounts.get(value) || 0) + 1);
});
const structuredRefinementOptions = Array.from(structuredTypeCounts.entries())
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "bg"))
  .map(([value, productCount]) => ({ key: value, label: `${value} (${productCount})`, baseLabel: value }));
const allowedProductTypes = new Set(
  browseSubcategory
    ? browseSubcategory.productTypes
    : browseCategory?.subcategories.flatMap((subcategory) => subcategory.productTypes) || []
);
const refinementOptions = structuredRefinementOptions.filter((option) => allowedProductTypes.has(option.key));
const buildFacetOptions = (field) => {
  const counts = new Map();
  displayProducts.forEach((product) => {
    [...new Set(Array.isArray(product[field]) ? product[field].map(clean).filter(Boolean) : [])]
      .forEach((value) => counts.set(value, (counts.get(value) || 0) + 1));
  });
  return Array.from(counts.entries())
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "bg"))
    .map(([value, productCount]) => ({ value, productCount }));
};
const materialOptions = buildFacetOptions("materials");
const colorOptions = buildFacetOptions("colors");
const isGiftContext = landing.categoryKey === "gifts";
const registeredRecipient = clean(registeredStructuredState.recipient?.[0]);
const registeredOccasion = clean(registeredStructuredState.gift_occasion?.[0]);
const giftContextKey = landing.subcategoryKey || ({
  "За жена": "gifts_for_her", "За мъж": "gifts_for_him", "За дете": "gifts_for_child", "За бебе": "gifts_for_baby",
}[registeredRecipient]) || (registeredOccasion === "Сватба" ? "gifts_for_wedding" : "");
const giftFacetConfig = GIFT_FACETS_BY_CONTEXT[giftContextKey] || null;
const isJewelryContext = landing.subcategoryKey === "accessories_jewelry" || registeredSubcategory === "Бижута";
const isShoeContext = landing.subcategoryKey === "accessories_shoes" || registeredSubcategory === "Обувки";
const isClothingContext = landing.categoryKey === "clothing" || landing.group === "clothing" || registeredCategory === "Облекло";
const isCosmeticsContext = landing.categoryKey === "cosmetics" || registeredCategory === "Козметика";
const isFaceCosmetics = isCosmeticsContext && (landing.subcategoryKey === "cosmetics_face" || registeredSubcategory === "Грижа за лицето");
const isHairCosmetics = isCosmeticsContext && (landing.subcategoryKey === "cosmetics_hair" || registeredSubcategory === "Грижа за косата");
const approvedFacetOptions = (field, approved) => {
  const allowed = new Set(approved || []);
  return buildFacetOptions(field).filter((option) => allowed.has(option.value));
};
const additionalFacetSpecs = [
  ...(giftFacetConfig?.recipient_age ? [{ group: "recipient_age", field: "recipient_age", label: "Възраст", options: approvedFacetOptions("recipient_age", giftFacetConfig.recipient_age) }] : []),
  ...(giftFacetConfig?.recipient_gender ? [{ group: "recipient_gender", field: "recipient_gender", label: "Пол", options: approvedFacetOptions("recipient_gender", giftFacetConfig.recipient_gender) }] : []),
  ...(giftFacetConfig?.gift_occasion ? [{ group: "gift_occasion", field: "gift_occasion", label: "Повод", options: approvedFacetOptions("gift_occasion", giftFacetConfig.gift_occasion) }] : []),
  ...(giftFacetConfig?.role_interest ? [{ group: "role_interest", field: "role_interest", label: "Роля / интерес", options: approvedFacetOptions("role_interest", giftFacetConfig.role_interest) }] : []),
  ...(giftFacetConfig?.wedding_anniversary_type ? [{ group: "wedding_anniversary_type", field: "wedding_anniversary_type", label: "Вид годишнина", options: approvedFacetOptions("wedding_anniversary_type", giftFacetConfig.wedding_anniversary_type) }] : []),
  ...(isGiftContext ? [{ group: "attributes", field: "attributes", label: "Характеристики", options: approvedFacetOptions("attributes", ["Персонализируем", "Романтичен", "Практичен", "Забавен"]), display: { "Персонализируем": "Персонализиран" } }] : []),
  ...(isJewelryContext ? [{ group: "gemstone", field: "gemstone", label: "Камък", options: approvedFacetOptions("gemstone", STRUCTURED_FACET_OPTIONS.gemstone) }] : []),
  ...(isJewelryContext ? [{ group: "jewelry_detail", field: "jewelry_detail", label: "Детайл", options: approvedFacetOptions("jewelry_detail", STRUCTURED_FACET_OPTIONS.jewelry_detail) }] : []),
  ...(isClothingContext && !isShoeContext ? [
    { group: "clothing_style", field: "clothing_style", label: "Стил", options: approvedFacetOptions("clothing_style", STRUCTURED_FACET_OPTIONS.clothing_style) },
    { group: "sleeve", field: "sleeve", label: "Ръкав", options: approvedFacetOptions("sleeve", STRUCTURED_FACET_OPTIONS.sleeve) },
    { group: "season", field: "season", label: "Сезон", options: approvedFacetOptions("season", STRUCTURED_FACET_OPTIONS.season) },
  ] : []),
  ...(isCosmeticsContext ? [{ group: "ingredient", field: "ingredient", label: "Съставка", options: approvedFacetOptions("ingredient", STRUCTURED_FACET_OPTIONS.ingredient) }] : []),
  ...(isFaceCosmetics ? [
    { group: "skin_type", field: "skin_type", label: "Тип кожа", options: approvedFacetOptions("skin_type", STRUCTURED_FACET_OPTIONS.skin_type) },
    { group: "skin_need", field: "skin_need", label: "Нужда / ефект", options: approvedFacetOptions("skin_need", STRUCTURED_FACET_OPTIONS.skin_need) },
  ] : []),
  ...(isHairCosmetics ? [{ group: "hair_need", field: "hair_need", label: "Нужда", options: approvedFacetOptions("hair_need", STRUCTURED_FACET_OPTIONS.hair_need) }] : []),
].filter((spec) => spec.options.length > 0);
const baseGiftRecipient = landing.giftFilters?.recipients?.[0] || landing.recipients?.[0] || registeredRecipient;
const giftSeoHrefByFacet = Object.fromEntries(SEO_INTENT_LANDINGS.filter((entry) => {
  if (entry.group !== "gifts" || !baseGiftRecipient || entry.recipients?.length !== 1 || entry.recipients[0] !== baseGiftRecipient) return false;
  const dimensions = [entry.ages?.length, entry.occasions?.length, entry.genders?.length].filter(Boolean).length;
  return dimensions === 1;
}).flatMap((entry) => [
  ...(entry.ages?.length === 1 ? [[`recipient_age:${entry.ages[0]}`, entry.path]] : []),
  ...(entry.occasions?.length === 1 ? [[`gift_occasion:${entry.occasions[0]}`, entry.path]] : []),
  ...(entry.genders?.length === 1 ? [[`recipient_gender:${entry.genders[0]}`, entry.path]] : []),
]));
const landingGraphNode = getLandingGraphNode(landing);
const parentGraphNode = landingGraphNode?.parentKey ? getLandingGraphNode(landingGraphNode.parentKey) : null;
const inferredStructuredSubcategory = landing.categoryKey !== "gifts" && parentGraphNode?.pageType === "subcategory"
  ? parentGraphNode.navigationLabel
  : "";
const baseStructuredState = landing.structuredState || {
  ...((registeredCategory || (landing.categoryKey && landing.categoryKey !== "gifts")) ? { category: [registeredCategory || browseCategory?.value || getCategoryLabel(landing.categoryKey)] } : {}),
  ...((registeredSubcategory || landing.kind === "subcategory" || inferredStructuredSubcategory) ? { subcategory: [registeredSubcategory || browseSubcategory?.value || inferredStructuredSubcategory] } : {}),
  ...(landing.productTypes?.length ? { product_type: landing.productTypes } : {}),
  ...(landing.categoryKey === "gifts" ? { giftable: ["true"] } : {}),
  ...((landing.giftFilters?.recipients || landing.recipients)?.length ? { recipient: landing.giftFilters?.recipients || landing.recipients } : {}),
  ...((landing.giftFilters?.occasions || landing.occasions)?.length ? { gift_occasion: landing.giftFilters?.occasions || landing.occasions } : {}),
  ...((landing.giftFilters?.ages || landing.ages)?.length ? { recipient_age: landing.giftFilters?.ages || landing.ages } : {}),
  ...((landing.giftFilters?.genders || landing.genders)?.length ? { recipient_gender: landing.giftFilters?.genders || landing.genders } : {}),
};
const seoStateRegistry = getSeoLandingStateRegistry();
const priceOptions = [
  { value: "0-25", label: "До €25" }, { value: "25-50", label: "€25–50" },
  { value: "50-100", label: "€50–100" }, { value: "100+", label: "€100+" },
].map((option) => ({ ...option, productCount: displayProducts.filter((product) => priceRangesForProduct(product).includes(option.value)).length })).filter((option) => option.productCount > 0);
const showMaterials = landing.categoryKey !== "cosmetics" && (materialOptions.length >= 2 || Boolean(baseStructuredState.materials?.length));
const showColors = colorOptions.length >= 2 || Boolean(baseStructuredState.colors?.length);
const showPrice = priceOptions.length > 0;
const hasRefinements = refinementOptions.length || showMaterials || showColors || showPrice || additionalFacetSpecs.length;
const filterContext = isGiftContext
  ? "gift"
  : isJewelryContext
    ? "jewelry"
    : isShoeContext
      ? "shoes"
      : isFaceCosmetics
        ? "cosmetics_face"
        : isHairCosmetics
          ? "cosmetics_hair"
          : isCosmeticsContext
            ? "cosmetics"
            : isClothingContext
              ? "clothing"
              : "default";
const orderedFacetSpecs = orderPublicFilters([
  ...(refinementOptions.length ? [{ group: "type", label: resolvedRefinementTitle, options: refinementOptions, optionKind: "type" }] : []),
  ...(showMaterials ? [{ group: "material", label: "Материал", options: materialOptions, optionKind: "facet" }] : []),
  ...(showColors ? [{ group: "color", label: "Цвят", options: colorOptions, optionKind: "facet" }] : []),
  ...(showPrice ? [{ group: "price", label: "Цена", options: priceOptions, optionKind: "price" }] : []),
  ...additionalFacetSpecs.map((spec) => ({ ...spec, optionKind: "additional" })),
], filterContext);

const trimDescription = (value, max = 160) => {
  const text = clean(value).replace(/\s+/g, " ");
  if (text.length <= max) return text;
  const slice = text.slice(0, max - 1);
  const cut = slice.lastIndexOf(" ");
  return `${slice.slice(0, cut > 125 ? cut : max - 1).replace(/[,:;\s]+$/u, "")}…`;
};

const buildSeoDescription = () => {
  const current = clean(landing.description);
  if (current.length >= 100) return current;

  const variant = Array.from(clean(canonicalPath)).reduce((sum, char) => sum + char.codePointAt(0), 0) % 4;
  const additionOptions = isGiftContext
    ? [
        ["Сравни идеите по повод, получател и вид продукт.", "Детайлите са при бранда."],
        ["Ориентирай се по интереси, възраст и конкретен повод.", "Условията са при бранда."],
        ["Подреди избора според човека, повода и вида подарък.", "Виж данните от бранда."],
        ["Прецени вариантите според повода и предпочитанията.", "Провери ги при бранда."],
      ]
    : isJewelryContext
      ? [
          ["Сравни моделите по материал, размер, детайли и закопчаване.", "Детайлите са при бранда."],
          ["Провери материала, размерите и начина на закопчаване.", "Данните са от бранда."],
          ["Ориентирай се по вид бижу, материал, камък и размер.", "Виж данните от бранда."],
          ["Съпостави изработката, размерите и важните детайли.", "Провери ги при бранда."],
        ]
      : isCosmeticsContext
        ? [
            ["Сравни продуктите по предназначение, състав и употреба.", "Детайлите са при бранда."],
            ["Ориентирай се по нужда, формула и начин на използване.", "Данните са от бранда."],
            ["Провери съставките, типа грижа и указанията за употреба.", "Виж данните от бранда."],
            ["Съпостави формулите според нуждата и своята рутина.", "Провери ги при бранда."],
          ]
        : isClothingContext || isShoeContext
          ? [
              ["Сравни моделите по материя, кройка, размер и предназначение.", "Детайлите са при бранда."],
              ["Ориентирай се по състав, силует и таблица с размери.", "Данните са от бранда."],
              ["Провери материята, размерите и указанията за поддръжка.", "Виж данните от бранда."],
              ["Съпостави кройките, материите и начина на носене.", "Провери ги при бранда."],
            ]
          : [
              ["Сравни предложенията по вид, материали и предназначение.", "Детайлите са при бранда."],
              ["Ориентирай се по функция, изработка и приложението им.", "Данните са от бранда."],
              ["Провери материалите, особеностите и начина на използване.", "Виж данните от бранда."],
              ["Съпостави вариантите според нуждата и употребата.", "Провери ги при бранда."],
            ];
  const additions = additionOptions[variant];

  let expanded = current;
  for (const addition of additions) {
    const candidate = `${expanded} ${addition}`;
    if (candidate.length <= 160) expanded = candidate;
    if (expanded.length >= 135) break;
  }
  return trimDescription(expanded);
};

const seoDescription = buildSeoDescription();
const parentLinkText = parentLink?.href === "/bulgarski-podaratsi/"
  ? "Върни се към всички идеи за подарък"
  : parentLink
    ? `Към ${parentLink.label}`
    : "Към началото";

function priceLabel(p) {
  const offer = resolvePublishableOffer(p, new Date(), { visible: true });
  if (offer) return formatVerifiedOfferAmount(offer);
  if (p.price_min_eur != null && p.price_max_eur != null) return `${p.price_min_eur}–${p.price_max_eur} ${p.currency}`;
  if (p.price_min_eur != null) return `${p.price_min_eur}+ ${p.currency}`;
  return "";
}
---

<BaseLayout
  seo={{
    type: "category",
    title: landing.title,
    description: seoDescription,
    data: {
      category: contentH1,
      description: seoDescription,
      breadcrumbs,
    }
  }}
  canonical={`https://bulgaritam.bg${canonicalPath}`}
  robots={initialDisplayCount === 0 || landing.canonicalSlug ? "noindex,follow,max-image-preview:large" : undefined}
  i18n={{
    en: {
      "landing.category": "Category",
      "landing.subcategory": "Subcategory",
      "landing.products": "Products",
      "landing.backHome": "Back to home",
      "landing.cta": "See on brand site ↗"
    }
  }}
>
  <main class="page-shell landing-shell">
    {breadcrumbs.length > 1 ? <nav class="landing-breadcrumbs" aria-label="Breadcrumb"><ol>{breadcrumbs.map((entry, index) => <li>{index < breadcrumbs.length - 1 ? <a href={entry.item}>{entry.name}</a> : <span aria-current="page">{entry.name}</span>}</li>)}</ol></nav> : null}
    <header class="page-head landing-head">
      <h1 class="page-title">{contentH1}</h1>
      <div class="landing-intro">
        {contentIntro.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      {primaryPills.length ? (
        <div class="landing-subcategories" aria-label={primaryPillsAriaLabel} data-seo-link-group="parent-primary" data-mobile-gift-pills={landing.categoryKey === "gifts" ? "true" : undefined}>
          {primaryPills.map((entry) => (
            <a
              class:list={[
                "landing-subcategories__pill",
                landing.categoryKey === "gifts" && !entry.isMobilePrimary ? "is-mobile-longtail" : "",
                entry.isActive ? "is-active" : ""
              ]}
              href={entry.href}
              data-i18n-bg={entry.label}
              data-i18n-en={entry.labelEn || entry.label}
            >
              {entry.label}
            </a>
          ))}
          {landing.categoryKey === "gifts" && primaryPills.some((entry) => !entry.isMobilePrimary) ? (
            <button class="landing-gift-more" type="button" aria-expanded="false">Още идеи за подарък</button>
          ) : null}
        </div>
      ) : null}

      {secondaryPills.length ? (
        <div class="landing-secondary-group">
          <p class="landing-secondary-title">{resolvedSecondaryPillsTitle}</p>
          <div class="landing-subcategories landing-subcategories--secondary" aria-label={secondaryPillsAriaLabel} data-seo-link-group="parent-secondary">
            {secondaryPills.map((entry) => (
              <a
                class:list={[
                  "landing-subcategories__pill",
                  "landing-subcategories__pill--secondary",
                  entry.isActive ? "is-active" : ""
                ]}
                href={entry.href}
                data-i18n-bg={entry.label}
                data-i18n-en={entry.labelEn || entry.label}
              >
                {entry.label}
              </a>
            ))}
          </div>
        </div>
      ) : null}

      {fallbackSiblingPills.length ? (
        <div class="landing-secondary-group" data-seo-fallback-links>
          <p class="landing-secondary-title">Свързани селекции</p>
          <div class="landing-subcategories landing-subcategories--secondary" aria-label="Свързани селекции" data-seo-link-group="sibling-fallback">
            {fallbackSiblingPills.map((entry) => (
              <a
                class="landing-subcategories__pill landing-subcategories__pill--secondary"
                href={entry.href}
                data-i18n-bg={entry.label}
                data-i18n-en={entry.labelEn || entry.label}
              >
                {entry.label}
              </a>
            ))}
          </div>
        </div>
      ) : null}
    </header>

    <section
      id="products"
      class="section section--feed"
      data-seo-state-registry={JSON.stringify(seoStateRegistry)}
      data-base-structured-state={JSON.stringify(baseStructuredState)}
      data-canonical-path={canonicalPath}
      data-collection-path={collectionPath}
      data-current-page={pageNumber}
      data-total-pages={totalPages}
      data-total-items={initialDisplayCount}
    >
      {hasRefinements ? (
        <details class="landing-refinements">
          <summary class="landing-refinements__summary">
            <span class="landing-refinements__summary-copy">
              <span class="landing-refinements__label">Филтри</span>
              <span class="landing-refinements__support">Избери филтри и резултатите ще се обновят автоматично.</span>
            </span>
            <span class="landing-refinements__toggle"><span class="when-closed">Отвори филтрите</span><span class="when-open">Затвори филтрите</span></span>
          </summary>

          <div class="landing-refinements__groups">
            {orderedFacetSpecs.map((spec) => <fieldset class="landing-refinements__group" data-facet-group={spec.group}>
              <legend>{spec.label}</legend>
              <div class="landing-refinements__panel" data-collapsible-facet>
                {spec.options.map((option) => {
                  const value = spec.optionKind === "type" ? option.key : option.value;
                  const baseLabel = spec.optionKind === "type" ? option.baseLabel : spec.optionKind === "price" ? option.label : option.value;
                  const displayLabel = spec.display?.[value] || baseLabel;
                  const renderedLabel = spec.optionKind === "type" ? option.label : `${displayLabel} (${option.productCount})`;
                  return <label class="landing-refinements__option" data-facet-option>
                    <input
                      type="checkbox"
                      value={value}
                      data-refinement-input
                      data-filter-group={spec.group}
                      data-seo-href={giftSeoHrefByFacet[`${spec.group}:${value}`] || undefined}
                    />
                    <span data-option-label={displayLabel}>{renderedLabel}</span>
                  </label>;
                })}
              </div>
            </fieldset>)}
          </div>
          <div class="landing-refinements__sticky-close"><button type="button" data-refinements-close>Затвори филтрите</button></div>
        </details>
      ) : null}

      <div class="section-head section-head--centered">
