---
import AdminLayout from "../layouts/AdminLayout.astro";
import { buildBrandRows, buildCollectionSummary, buildDimensionRows, buildJourneyRows, buildProductRows, buildSearchRows, loadAnalyticsEvents, metricSummary, resolvePeriod } from "../lib/analytics";
const period=resolvePeriod(Astro.url);let error="";let allEvents:Awaited<ReturnType<typeof loadAnalyticsEvents>>=[];
try{allEvents=await loadAnalyticsEvents()}catch(cause){error=cause instanceof Error?cause.message:"Analytics data could not be loaded."}
const inRange=(event:typeof allEvents[number],start:Date,end:Date)=>event.at>=start&&event.at<end;
const events=allEvents.filter(e=>inRange(e,period.start,period.end)),previous=allEvents.filter(e=>inRange(e,period.previousStart,period.previousEnd));
const metrics=metricSummary(events,previous),searches=buildSearchRows(events),products=buildProductRows(events),brands=buildBrandRows(events),categories=buildDimensionRows(events,e=>e.category),contexts=buildDimensionRows(events,e=>e.sourceContext||e.listContext),acquisition=buildDimensionRows(events,e=>[e.utmSource,e.utmMedium,e.utmCampaign].filter(Boolean).join(" / ")||e.referrerDomain||"Direct / unknown"),collections=buildCollectionSummary(events),journeys=buildJourneyRows(events);
const sessions=new Set(events.map(e=>e.sessionId).filter(Boolean)),discovered=new Set(events.filter(e=>["save_product","outbound_product_click"].includes(e.event)).map(e=>e.sessionId).filter(Boolean));
const discoveryRate=sessions.size?discovered.size/sessions.size*100:0,fmt=(n:number,d=0)=>new Intl.NumberFormat("bg-BG",{maximumFractionDigits:d}).format(n);
const eventLabel:Record<string,string>={create_collection:"Created",add_to_collection:"Products added",remove_from_collection:"Products removed",view_collection:"Views",share_collection:"Shares"};
const days=new Map<string,number>();events.forEach(e=>{const day=e.at.toISOString().slice(0,10);days.set(day,(days.get(day)||0)+1)});const daily=[...days].sort(([a],[b])=>a.localeCompare(b)),maxDaily=Math.max(1,...daily.map(([,n])=>n));
---
<AdminLayout title="Analytics" active="analytics">
<header class="head analytics-head"><div><h1>Analytics</h1><p class="muted">First-party, consented discovery behaviour. Updated directly from Baserow.</p></div><button id="analytics-device-toggle" class="secondary" type="button">Изключи това устройство от аналитиките</button></header>
<form class="panel period-controls" method="get"><div class="period-presets">{[['today','Today'],['yesterday','Yesterday'],['7d','Last 7 days'],['30d','Last 30 days']].map(([key,label])=><a class:list={["btn","secondary",{active:period.key===key}]} href={`/analytics/?period=${key}`}>{label}</a>)}</div><label>From<input type="date" name="from" value={period.from}/></label><label>To<input type="date" name="to" value={period.to}/></label><input type="hidden" name="period" value="custom"/><button>Custom range</button><span class="muted period-summary">{period.from} → {period.to} · {events.length} events</span></form>
{error&&<div class="error">{error}</div>}
<section class="metric-grid">{metrics.map(m=><article class="metric"><span class="muted">{m.label}</span><b>{fmt(m.value)}</b><small class:list={{positive:(m.change||0)>0,negative:(m.change||0)<0}}>{m.change===null?"No previous data":`${m.change>=0?"+":""}${fmt(m.change,1)}% vs previous`}</small></article>)}<article class="metric metric-feature"><span class="muted">Discovery Rate</span><b>{fmt(discoveryRate,1)}%</b><small>Sessions with save or product outbound</small></article></section>
{daily.length>1&&<section class="panel"><h2>Event activity</h2><p class="muted">All stored events by day.</p><div class="trend">{daily.map(([day,value])=><div class="trend-col" title={`${day}: ${value}`}><div class="trend-bar" style={`height:${Math.max(5,value/maxDaily*100)}%`}></div><span>{day.slice(5)}</span></div>)}</div></section>}

<section class="panel analytics-section"><div class="section-head"><div><h2>Search Intelligence</h2><p class="muted">Actions later in the same anonymous session or carrying the search context.</p></div><input class="table-search" type="search" placeholder="Search queries" data-table-filter="search-table"/></div><div class="table-wrap"><table id="search-table" data-sortable><thead><tr><th>Query</th><th>Searches</th><th>Avg results</th><th>Zero</th><th>Views</th><th>Saves</th><th>Outbound</th><th>Demand</th></tr></thead><tbody>{searches.map(r=><tr><td><strong>{r.query}</strong></td><td data-value={r.searches}>{r.searches}</td><td data-value={r.avgResults}>{fmt(r.avgResults,1)}</td><td>{r.zero}</td><td>{r.productViews}</td><td>{r.saves}</td><td>{r.outbound}</td><td><span class:list={["signal",{high:r.zero>0&&r.unmetScore>=3}]}>{r.zero>0?"Unmet demand":r.searches&&!r.productViews?"No engagement":"—"}</span></td></tr>)}</tbody></table></div>{!searches.length&&<p class="empty">No searches in this period.</p>}</section>

<section class="panel analytics-section"><div class="section-head"><div><h2>Products</h2><p class="muted">Performance by stable Product ID.</p></div><input class="table-search" type="search" placeholder="Search product or brand" data-table-filter="products-table"/></div><div class="table-wrap"><table id="products-table" data-sortable><thead><tr><th>Product</th><th>Brand</th><th>Impressions</th><th>Views</th><th>Saves</th><th>Adds</th><th>Shares</th><th>Outbound</th><th>Imp→view</th><th>View→out</th></tr></thead><tbody>{products.map(r=><tr><td><strong>{r.name}</strong><div class="muted">ID {r.id}</div></td><td>{r.brand}</td><td>{r.impressions}</td><td>{r.views}</td><td>{r.saves}</td><td>{r.adds}</td><td>{r.shares}</td><td>{r.outbound}</td><td>{fmt(r.impressionViewRate,1)}%</td><td>{fmt(r.viewOutboundRate,1)}%</td></tr>)}</tbody></table></div></section>

<section class="panel analytics-section"><div class="section-head"><div><h2>Brands</h2><p class="muted">Activity by stable Brand ID. Expand a Brand for its Products.</p></div><input class="table-search" type="search" placeholder="Search brand" data-table-filter="brands-table"/></div><div class="table-wrap"><table id="brands-table" data-sortable><thead><tr><th>Brand</th><th>Impressions</th><th>Product views</th><th>Brand views</th><th>Saves</th><th>Adds</th><th>Shares</th><th>Product outbound</th><th>Brand outbound</th></tr></thead><tbody>{brands.map(r=><tr><td><details><summary><strong>{r.name}</strong></summary><div class="brand-products">{r.products.slice(0,20).map(p=><div>{p.name}: {p.views} views · {p.outbound} outbound</div>)}</div></details><div class="muted">ID {r.id}</div></td><td>{r.impressions}</td><td>{r.productViews}</td><td>{r.brandViews}</td><td>{r.saves}</td><td>{r.adds}</td><td>{r.shares}</td><td>{r.productOutbound}</td><td>{r.brandOutbound}</td></tr>)}</tbody></table></div></section>

<div class="analytics-columns"><section class="panel analytics-section"><h2>Categories</h2><div class="table-wrap"><table><thead><tr><th>Category</th><th>Events</th><th>Sessions</th><th>Views</th><th>Saves</th><th>Outbound</th></tr></thead><tbody>{categories.map(r=><tr><td>{r.name}</td><td>{r.events}</td><td>{r.sessions}</td><td>{r.views}</td><td>{r.saves}</td><td>{r.outbound}</td></tr>)}</tbody></table></div></section><section class="panel analytics-section"><h2>Discovery context</h2><div class="table-wrap"><table><thead><tr><th>Context</th><th>Events</th><th>Sessions</th><th>Views</th><th>Outbound</th></tr></thead><tbody>{contexts.map(r=><tr><td>{r.name}</td><td>{r.events}</td><td>{r.sessions}</td><td>{r.views}</td><td>{r.outbound}</td></tr>)}</tbody></table></div></section></div>
<div class="analytics-columns"><section class="panel analytics-section"><h2>Acquisition</h2><p class="muted">UTM values, then referring domain where present.</p><div class="table-wrap"><table><thead><tr><th>Source</th><th>Sessions</th><th>Events</th><th>Views</th><th>Saves</th><th>Outbound</th></tr></thead><tbody>{acquisition.map(r=><tr><td>{r.name}</td><td>{r.sessions}</td><td>{r.events}</td><td>{r.views}</td><td>{r.saves}</td><td>{r.outbound}</td></tr>)}</tbody></table></div></section><section class="panel analytics-section"><h2>Collections</h2><div class="collection-metrics">{collections.map(r=><div><span>{eventLabel[r.event]}</span><b>{r.count}</b><small>{r.collections} collection IDs</small></div>)}</div></section></div>
<section class="panel analytics-section"><h2>Anonymous journeys</h2><p class="muted">Chronological sequences in one anonymous session; sequence is not causation or identity.</p><div class="journeys">{journeys.map(r=><details><summary><span>{r.sessionId} · {r.started?.toISOString().replace('T',' ').slice(0,16)}</span>{r.meaningful&&<span class="status">Discovery</span>}</summary><ol>{r.steps.map(s=><li><strong>{s.event}</strong>{s.label&&<span> — {s.label}</span>}</li>)}</ol></details>)}</div>{!journeys.length&&<p class="empty">No multi-event sessions in this period.</p>}</section>
<section class="panel limitations"><h2>Data limitations</h2><ul><li>Sessions are consented anonymous browser sessions, not people or GA4 users.</li><li>No geography, demographics, ad-platform attribution or cross-device identity is stored.</li><li>Search-to-action is same-session/context association, not proven causation.</li></ul></section>
</AdminLayout>
<script>
const cookieName="bulgaritam_analytics_excluded",toggle=document.getElementById("analytics-device-toggle"),isExcluded=()=>document.cookie.split(";").some(p=>p.trim()===`${cookieName}=1`),render=()=>{if(toggle)toggle.textContent=isExcluded()?"Включи това устройство в аналитиките":"Изключи това устройство от аналитиките"};toggle?.addEventListener("click",()=>{document.cookie=isExcluded()?`${cookieName}=; Max-Age=0; Path=/; Domain=.bulgaritam.bg; Secure; SameSite=Lax`:`${cookieName}=1; Max-Age=31536000; Path=/; Domain=.bulgaritam.bg; Secure; SameSite=Lax`;render()});render();
document.querySelectorAll<HTMLInputElement>("[data-table-filter]").forEach(input=>input.addEventListener("input",()=>{const q=input.value.trim().toLocaleLowerCase("bg");document.querySelectorAll<HTMLTableRowElement>(`#${input.dataset.tableFilter} tbody tr`).forEach(row=>row.hidden=Boolean(q&&!row.textContent.toLocaleLowerCase("bg").includes(q)))}));
document.querySelectorAll<HTMLTableCellElement>("table[data-sortable] th").forEach((header,index)=>header.addEventListener("click",()=>{const table=header.closest("table"),body=table?.querySelector("tbody");if(!table||!body)return;const direction=header.dataset.direction==="asc"?-1:1;table.querySelectorAll<HTMLTableCellElement>("th").forEach(th=>delete th.dataset.direction);header.dataset.direction=direction===1?"asc":"desc";[...body.rows].sort((a,b)=>{const av=a.cells[index]?.dataset.value||a.cells[index]?.innerText||"",bv=b.cells[index]?.dataset.value||b.cells[index]?.innerText||"",an=Number(av),bn=Number(bv);return Number.isFinite(an)&&Number.isFinite(bn)?(an-bn)*direction:av.localeCompare(bv,"bg")*direction}).forEach(row=>body.appendChild(row))}));
</script>
<style>
.analytics-head{align-items:flex-start}.period-controls{display:flex;align-items:end;gap:10px;flex-wrap:wrap}.period-controls label{width:150px}.period-presets{display:flex;gap:6px;flex-wrap:wrap}.period-controls .active{background:var(--green);color:#fff}.period-summary{margin-left:auto;padding-bottom:9px}.metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:20px}.metric small{display:block;color:#777;margin-top:5px}.metric small.positive{color:#287048}.metric small.negative{color:#a13d3d}.metric-feature{background:#edf5f0}.analytics-section h2{margin-top:0}.section-head{display:flex;justify-content:space-between;align-items:start;gap:18px;margin-bottom:14px}.section-head h2{margin:0}.table-search{width:min(280px,100%)}th[data-direction]{color:var(--green)}th[data-direction]::after{content:" ↕"}.signal{font-size:12px;color:#777}.signal.high{background:#fff0d2;color:#80520b;padding:3px 7px;border-radius:999px}.brand-products{font-size:12px;font-weight:400;line-height:1.7;margin-top:8px}.analytics-columns{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.collection-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.collection-metrics div{border:1px solid var(--line);border-radius:9px;padding:12px}.collection-metrics span,.collection-metrics small{display:block;color:#777}.collection-metrics b{font-size:24px}.journeys{display:grid;gap:8px}.journeys details{border:1px solid var(--line);border-radius:8px;padding:10px 12px}.journeys summary{display:flex;justify-content:space-between;cursor:pointer}.trend{height:150px;display:flex;align-items:end;gap:6px;overflow-x:auto}.trend-col{height:100%;min-width:28px;display:flex;flex-direction:column;justify-content:end;align-items:center;gap:4px}.trend-bar{width:18px;background:var(--green);border-radius:5px 5px 0 0}.trend-col span{font-size:10px;color:#777;writing-mode:vertical-rl}.limitations ul{margin-bottom:0;color:#605d58}.table-wrap{max-height:620px;overflow:auto}thead{position:sticky;top:0;background:#fff;z-index:1}@media(max-width:1100px){.metric-grid{grid-template-columns:repeat(3,1fr)}.analytics-columns{grid-template-columns:1fr}}@media(max-width:700px){.metric-grid{grid-template-columns:repeat(2,1fr)}.analytics-head,.section-head{display:grid}.period-summary{margin:0}.table-search{width:100%}.collection-metrics{grid-template-columns:1fr}}
</style>
