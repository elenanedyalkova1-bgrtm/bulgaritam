---
import type {AnalyticsV2ViewModel} from "../../lib/analytics-v2";
const {model}=Astro.props as{model:AnalyticsV2ViewModel};
const n=(value:number)=>new Intl.NumberFormat("bg-BG",{maximumFractionDigits:0}).format(value),visible=model.insights.slice(0,3),more=model.insights.slice(3);
const exploreHref=(area:string)=>{const p=new URLSearchParams(Astro.url.searchParams);p.set("view","explore");p.set("area",area);return`/analytics/?${p}`};
const links=[{area:"search",label:"Какво търсят хората?"},{area:"products",label:"Кои продукти разглеждат?"},{area:"acquisition",label:"Откъде идват посетителите?"},{area:"discovery",label:"Къде откриват продуктите?"}];
---
<section class="overview" aria-label="Преглед за периода">
 <p class="orientation">{model.overview.summary}</p>
 <section class="overview-section activity"><h3>Какво се случи</h3><div class="facts">{model.overview.facts.map(fact=><article><b>{n(fact.value)}</b><span>{fact.label}</span></article>)}</div></section>
 <section class="overview-section attention"><h3>Какво заслужава внимание</h3>{visible.length?<div class="insights">{visible.map(insight=><article class="insight"><strong>{insight.statement}</strong><b class="magnitude">{insight.change}</b><p class="comparison">{insight.comparison}</p><p>{insight.interpretation}</p><details><summary>Как стигнахме до този извод?</summary><div class="evidence"><p><b>Основание:</b> {insight.evidenceText}</p><p>{insight.sampleText}</p><p><b>{insight.confidenceLabel}</b></p>{insight.caveat&&<p>{insight.caveat}</p>}<p>{insight.question}</p></div></details></article>)}</div>:<p class="quiet-state">Все още няма достатъчно данни за надеждни автоматични сравнения. Фактическата активност за периода е показана по-горе.</p>}{more.length>0&&<details class="more-insights"><summary>Виж всички изводи</summary><div class="compact-insights">{more.map(insight=><article><strong>{insight.statement}</strong><span>{insight.change}</span><details><summary>Виж основанието</summary><p>{insight.evidenceText}</p><p>{insight.sampleText} · {insight.confidenceLabel}</p></details></article>)}</div></details>}</section>
 <section class="overview-section explore-next"><h3>Разгледай повече</h3><nav aria-label="Следващи въпроси">{links.map(link=><a href={exploreHref(link.area)}>{link.label}<span aria-hidden="true">→</span></a>)}</nav></section>
</section>
<style>.overview{width:100%;max-width:100%;min-width:0}.orientation{max-width:760px;margin:24px 0;font-size:1.18rem;line-height:1.55}.overview-section{min-width:0;padding:22px 0;border-top:1px solid #d9e7dd}.overview-section h3{margin:0 0 14px}.facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.facts article{display:grid;gap:4px;padding:14px 0;border-bottom:2px solid #dce8df}.facts b{font-size:1.65rem}.facts span{color:#5d675f}.insights{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.insight{min-width:0;padding:17px;background:#fff;border:1px solid var(--line);border-radius:9px}.insight>strong{display:block;font-size:1.05rem;line-height:1.4}.magnitude{display:block;margin-top:14px;font-size:1.65rem;color:#245d37}.comparison{color:#4f5952}.insight details,.more-insights{margin-top:14px}.insight summary,.more-insights summary{cursor:pointer;font-weight:600}.evidence{margin-top:10px;padding-top:8px;border-top:1px solid #e2e8e3;color:#626b65;font-size:.9rem}.quiet-state{max-width:760px;padding:12px 14px;border-left:3px solid #b9c9bd;background:#fff}.compact-insights{display:grid;gap:8px;margin-top:10px}.compact-insights article{display:grid;gap:5px;padding:12px;background:#fff;border:1px solid var(--line);border-radius:8px}.explore-next nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.explore-next a{display:flex;justify-content:space-between;gap:12px;padding:12px 14px;border:1px solid var(--line);border-radius:8px;background:#fff;color:inherit;text-decoration:none}.explore-next a:hover{border-color:var(--green)}@media(max-width:900px){.insights{grid-template-columns:1fr}.facts{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.facts,.explore-next nav{grid-template-columns:1fr}.orientation{font-size:1.05rem}.magnitude{font-size:1.45rem}}</style>
