---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { OCCASION_FILTERS, OCCASION_GROUPS, getOccasionKeysForProduct } from "../lib/occasions";
import { CATEGORY_LANDINGS, SUBCATEGORY_LANDINGS } from "../lib/seo-landings";
import { buildSearchDocument } from "../lib/search";
import { getCategoryLabel, getCategoryLabelForLang, getSubcategoryViewAllLabelForLang, getTaxonomyForProduct, getTopLevelCategories } from "../lib/taxonomy";
import { loadProducts } from "../lib/products";
import { getProductBadges } from "../lib/product-badges";
import homeHero from "../assets/home-hero-banner-2.png";

const products = await loadProducts();
const displayProducts = products.filter((product) => product.image_urls?.[0]);
const LAZY_IMAGE_PLACEHOLDER = "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==";
const homeCategories = getTopLevelCategories();

function priceLabel(p) {
  if (p.price_min_eur != null && p.price_max_eur != null) return `${p.price_min_eur}–${p.price_max_eur} ${p.currency}`;
  if (p.price_min_eur != null) return `${p.price_min_eur}+ ${p.currency}`;
  return "";
}
---

<BaseLayout seo={{ type: "home" }} i18n={{
  en: {
    "home.freshNote": "New brands every week",
    "home.searchLabel": "Find a Bulgarian product",
    "home.searchPlaceholder": 'e.g. "silver earrings", "women\'s pajamas", "night cream"',
    "home.searchHint": "Search starts automatically as you type",
    "home.viewAll": "View all",
    "home.occasion": "Occasion",
    "home.filters": "Filters",
    "home.sortLabel": "Sort",
    "home.sort.featured": "Featured",
    "home.sort.newest": "Newest",
    "home.sort.priceAsc": "Price: low to high",
    "home.sort.priceDesc": "Price: high to low",
    "home.sort.alpha": "A–Z",
    "home.cardCta": "See on brand site ↗",
    "home.subcategories": "Subcategories",
    "home.resultsFor": "Results for:"
  }
}}>
  <main class="wrap">
    <section class="home-hero home-hero--banner">
      <div class="hero-media">
        <Image
          src={homeHero}
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 768px) 100vw, (max-width: 1240px) 100vw, 1240px"
          format="webp"
          quality={82}
          alt="Жена разглежда списание в спокоен интериор"
          class="hero-media-img"
          width={homeHero.width}
          height={homeHero.height}
          loading="eager"
          fetchpriority="high"
          priority
          decoding="async"
        />
      </div>
      <p class="home-fresh-note" data-i18n="home.freshNote">Нови брандове всяка седмица</p>
    </section>

    <section class="home-search" aria-label="Търсене и категории">
      <div class="search search--home">
        <label class="search-label" for="q" data-i18n="home.searchLabel">Търси български продукт</label>

        <div class="search-row">
          <input
            id="q"
            class="search-input"
            type="search"
            placeholder='напр. „сребърни обеци“, „дамска пижама“, „нощен крем“'
            data-i18n-placeholder="home.searchPlaceholder"
            autocomplete="off"
          />
        </div>

        <div class="search-hint" data-i18n="home.searchHint">
          Търсенето започва автоматично докато пишеш
        </div>
      </div>

      <div class="chips chips--home" role="group" aria-label="Категории" id="mainChips"></div>
      <p class="chips-section-label" id="subChipsLabel" hidden data-i18n="home.subcategories">Подкатегории</p>
      <div class="chips chips-sub chips--home" role="group" aria-labelledby="subChipsLabel" id="subChips" hidden></div>
      <div
        id="homeLandingData"
        data-landings={JSON.stringify(
          [...CATEGORY_LANDINGS, ...SUBCATEGORY_LANDINGS].map((landing) => ({
            slug: landing.slug,
            categoryKey: landing.categoryKey,
            subcategoryKey: landing.subcategoryKey,
            kind: landing.kind,
            label: landing.label,
            viewAllLabel: landing.viewAllLabel,
            viewAllLabelEn: landing.kind === "subcategory" && landing.subcategoryKey
              ? getSubcategoryViewAllLabelForLang(landing.subcategoryKey, "en")
              : `All ${getCategoryLabelForLang(landing.categoryKey, "en")}`,
            queryAliases: landing.queryAliases || [],
          }))
        )}
        hidden
      ></div>
      <div id="homeCategoriesData" data-categories={JSON.stringify(homeCategories)} hidden></div>
      <div class="home-view-all" id="homeViewAll" hidden>
        <a id="homeViewAllLink" class="home-view-all__link" href="#" data-i18n="home.viewAll">Виж всички</a>
      </div>
      <div class="discovery-tools" aria-label="Сортиране и филтри">
        <button
          id="occasionToggle"
          class="discovery-btn discovery-btn--occasion"
          type="button"
          aria-haspopup="dialog"
          aria-controls="occasionModal"
          aria-expanded="false"
        >
          <span data-i18n="home.occasion">Повод</span>
          <span id="occasionBadge" class="discovery-btn__badge" hidden>1</span>
        </button>

        <button
          id="filtersToggle"
          class="discovery-btn discovery-btn--filters"
          type="button"
          aria-haspopup="dialog"
          aria-controls="filtersModal"
          aria-expanded="false"
        >
          <span data-i18n="home.filters">Филтри</span>
          <span id="filtersBadge" class="discovery-btn__badge" hidden>1</span>
        </button>

        <label class="sort-control" for="sortSelect">
          <span class="sort-label" data-i18n="home.sortLabel">Подредба</span>
          <select id="sortSelect" class="sort-select">
            <option value="featured" data-i18n="home.sort.featured">Подбрани</option>
            <option value="newest" data-i18n="home.sort.newest">Най-нови</option>
            <option value="price-asc" data-i18n="home.sort.priceAsc">Цена: ниска към висока</option>
            <option value="price-desc" data-i18n="home.sort.priceDesc">Цена: висока към ниска</option>
            <option value="alpha" data-i18n="home.sort.alpha">A–Я</option>
          </select>
        </label>
      </div>
    </section>

    <div id="filtersModal" class="filters-modal" hidden>
      <div class="filters-modal__backdrop" data-filters-close></div>

      <div
        class="filters-modal__panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="filtersTitle"
      >
        <div class="filters-modal__head">
          <div>
            <p class="filters-modal__eyebrow">Още контрол</p>
            <h3 id="filtersTitle" class="filters-modal__title">Филтри</h3>
          </div>

          <button class="filters-modal__close" type="button" aria-label="Затвори" data-filters-close>
            ✕
          </button>
        </div>

        <div class="filters-group">
          <p class="filters-group__label">Цена</p>

          <label class="filter-option">
            <input type="radio" name="priceFilter" value="all" checked />
            <span>Всички цени</span>
          </label>
          <label class="filter-option">
            <input type="radio" name="priceFilter" value="0-50" />
            <span>До 50 евро</span>
          </label>
          <label class="filter-option">
            <input type="radio" name="priceFilter" value="50-100" />
            <span>50–100 евро</span>
          </label>
          <label class="filter-option">
            <input type="radio" name="priceFilter" value="100-200" />
            <span>100–200 евро</span>
          </label>
          <label class="filter-option">
            <input type="radio" name="priceFilter" value="200+" />
            <span>200+ евро</span>
          </label>
        </div>

        <div class="filters-group">
          <p class="filters-group__label">Доставка</p>

          <label class="filter-option filter-option--checkbox">
            <input type="checkbox" id="deliveryOutsideHome" name="deliveryOutsideHome" />
            <span>Доставя извън България</span>
          </label>
        </div>

        <div class="filters-modal__actions">
          <button id="filtersReset" class="filters-action filters-action--ghost" type="button">
            Изчисти
          </button>
          <button id="filtersApply" class="filters-action" type="button">
            Покажи резултатите
          </button>
        </div>
      </div>
    </div>

    <div id="occasionModal" class="filters-modal" hidden>
      <div class="filters-modal__backdrop" data-occasion-close></div>

      <div
        class="filters-modal__panel filters-modal__panel--occasion"
        role="dialog"
        aria-modal="true"
        aria-labelledby="occasionTitle"
      >
        <div class="filters-modal__head">
          <div>
            <p class="filters-modal__eyebrow">Подбор по настроение</p>
            <h3 id="occasionTitle" class="filters-modal__title">Повод</h3>
          </div>

          <button class="filters-modal__close" type="button" aria-label="Затвори" data-occasion-close>
            ✕
          </button>
        </div>

        <div class="occasion-sheet">
          {OCCASION_GROUPS.map((group) => (
            <section class="occasion-group">
              <h4 class="occasion-group__title" data-i18n-bg={group.label} data-i18n-en={group.labelEn}>{group.label}</h4>
              <div class="occasion-options">
                {OCCASION_FILTERS.filter((occasion) => occasion.group === group.key).map((occasion) => (
                  <label class="occasion-option">
                    <input type="checkbox" name="occasionFilter" value={occasion.key} />
                    <span data-i18n-bg={occasion.label} data-i18n-en={occasion.labelEn}>{occasion.label}</span>
                  </label>
                ))}
              </div>
            </section>
          ))}
        </div>

        <div class="filters-modal__actions">
          <button id="occasionReset" class="filters-action filters-action--ghost" type="button">
            Изчисти
          </button>
          <button id="occasionApply" class="filters-action" type="button">
            Покажи резултатите
          </button>
        </div>
      </div>
    </div>

    <section class="section section--feed">
      <div class="section-head section-head--centered">
        <h2 class="h2">Продукти (<span id="count">{displayProducts.length}</span>)</h2>
        <div class="hint" id="hint"></div>
      </div>

      <ul class="grid" id="grid">
        {displayProducts.map((p, index) => {
          const taxonomy = getTaxonomyForProduct(p);
          const occasionKeys = getOccasionKeysForProduct(p);
          const { isBio, isEco, isHandmade, isGift } = getProductBadges(p);
          const shouldEagerLoad = index < 4;
          const categoryLabelBg = taxonomy.categoryLabel;
          const categoryLabelEn = getCategoryLabelForLang(taxonomy.categoryKey, "en");
          return (
            <li
              class="card"
              data-product-slug={p.slug}
              data-product-name={p.name_bg}
              data-brand-slug={p.brand_slug}
              data-brand-name={p.brand_name}
              data-product-url={p.product_url}
              data-category-key={taxonomy.categoryKey}
              data-category-keys={taxonomy.categoryKeys.join(",")}
              data-subcategory-keys={taxonomy.subcategoryKeys.join(",")}
              data-occasion-keys={occasionKeys.join(",")}
              data-search={buildSearchDocument([
                p.name_bg,
                p.brand_name,
                p.category,
                ...(p.tags || []),
                p.short_desc_bg,
                p.long_desc_bg,
              ])}
              data-search-raw={[
                p.name_bg,
                p.brand_name,
                p.category,
                ...(p.tags || []),
                p.short_desc_bg,
                p.long_desc_bg,
              ].filter(Boolean).join(" ")}
              data-tags={(p.tags || []).join(",")}
              data-brand={p.brand_slug}
              data-delivers-abroad={p.delivers_abroad ? "1" : "0"}
              data-price-min={p.price_min_eur ?? ""}
              data-price-max={p.price_max_eur ?? ""}
              data-created-at={p.created_at ?? ""}
            >
              <div class="card-top">
                <a class="card-imglink" href={`/p/${p.slug}/`}>
                  <div class="thumb">
                    {p.image_urls?.[0] ? (
                      <img
                        class="thumb-img"
                        src={shouldEagerLoad ? p.image_urls[0] : LAZY_IMAGE_PLACEHOLDER}
                        data-lazy-src={shouldEagerLoad ? undefined : p.image_urls[0]}
                        alt={p.name_bg}
                        loading={shouldEagerLoad ? "eager" : undefined}
                        fetchpriority={index < 4 ? "high" : undefined}
                        decoding="async"
                        width="800"
                        height="1000"
                        sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 25vw"
                      />
                    ) : (
                      <div class="thumb-ph" aria-hidden="true"></div>
                    )}
                  </div>
                </a>

                <button
                  class="save-btn save-btn--card"
                  type="button"
                  aria-label="Запази продукта"
                  aria-pressed="false"
                  data-save-id={p.slug}
                  data-save-url={`/p/${p.slug}/`}
                  data-save-title={p.name_bg}
                  data-save-brand={p.brand_name}
                  data-save-price={priceLabel(p)}
                  data-save-image={p.image_urls?.[0] || ""}
                >
                  <svg class="save-ic" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M7 3h10a2 2 0 0 1 2 2v16l-7-4-7 4V5a2 2 0 0 1 2-2z" />
                  </svg>
                </button>
              </div>

              <div class="card-body">
                <div class="card-meta-row">
                  <div class="card-badges">
                    <span class="cat" data-i18n-bg={categoryLabelBg} data-i18n-en={categoryLabelEn}>{categoryLabelBg}</span>
                    {isBio ? <span class="cat cat--bio">Био</span> : null}
                    {isEco ? <span class="cat cat--eco">Еко</span> : null}
                    {isHandmade ? <span class="cat cat--handmade">Ръчна изработка</span> : null}
                    {isGift ? <span class="cat cat--gift">Подарък</span> : null}
                  </div>
                  {priceLabel(p) ? <span class="price price--inline">{priceLabel(p)}</span> : null}
                </div>

                <a class="card-titlelink" href={`/p/${p.slug}/`}>{p.name_bg}</a>

                <div class="card-sub">
                  {p.brand_name && p.brand_slug ? (
                    <a class="brand-link" href={`/brand/${p.brand_slug}/`}>
                      {p.brand_name}
                    </a>
                  ) : null}
                </div>
              </div>

              <div class="card-foot">
                <a
                  class="cta-out"
                  href={p.product_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-i18n="home.cardCta"
                >
                  Виж в сайта на бранда ↗
                </a>
              </div>
            </li>
          );
        })}
      </ul>

      <div class="feed-meta">
        <p class="feed-status" id="feedStatus" aria-live="polite"></p>
        <div class="feed-sentinel" id="feedSentinel" aria-hidden="true"></div>
      </div>
    </section>
  </main>

  <style>
    .home-hero--banner {
      max-width: 1240px;
      margin: 0 auto;
      padding: 28px 0 22px;
    }

    .hero-media {
      width: 100%;
      max-width: 100%;
      border-radius: 28px;
      overflow: hidden;
      background: transparent;
      box-shadow: 0 18px 48px rgba(0, 0, 0, 0.08);
    }

    .hero-media-img {
      display: block;
      width: 100%;
      max-width: 100%;
      height: auto;
    }

    .home-search {
      max-width: 1240px;
      margin: 0 auto;
      padding: 4px 0 22px;
    }

    .home-fresh-note {
      margin: 14px auto 0;
      text-align: center;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(26, 26, 26, 0.54);
    }

    .search--home {
      max-width: 760px;
      margin: 0 auto 20px;
      padding: 18px;
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.74);
      border: 1px solid rgba(26, 26, 26, 0.08);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.06);
    }

    .search--home .search-label {
      margin-bottom: 12px;
      text-align: center;
      font-size: 13px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(26, 26, 26, 0.62);
    }

    .search--home .search-row {
      justify-content: flex-start;
    }

    .search--home .search-input {
      max-width: 640px;
      width: 100%;
      height: 58px;
      border-radius: 999px;
      padding: 0 22px;
      font-size: 16px;
      border: 1px solid rgba(26, 26, 26, 0.08);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }

    .search--home .search-hint {
      margin-top: 10px;
      text-align: center;
    }

    .chips--home {
      max-width: 940px;
      margin: 0 auto;
      justify-content: center;
      min-height: 60px;
    }

    .chips--home .chip,
    .chips--home .chip-sub {
      min-height: 48px;
      padding: 12px 18px;
      font-weight: 800;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.05);
    }

    .chips-section-label {
      margin: 14px 0 0;
      text-align: center;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(26, 26, 26, 0.48);
    }

    .chips-sub {
      margin-top: 8px;
      opacity: 0.95;
      padding: 10px 12px;
      border-radius: 22px;
      background: rgba(255, 255, 255, 0.5);
      border: 1px dashed rgba(26, 26, 26, 0.08);
      min-height: 64px;
    }

    .chip-sub {
      border-style: dashed;
    }

    .home-view-all {
      display: flex;
      justify-content: center;
      margin-top: 14px;
      min-height: 42px;
    }

    .home-view-all__link {
      display: inline-flex;
      align-items: center;
      min-height: 42px;
      padding: 0 16px;
      border-radius: 999px;
      border: 1px solid rgba(26, 26, 26, 0.1);
      background: rgba(255, 255, 255, 0.72);
      color: rgba(26, 26, 26, 0.8);
      text-decoration: none;
      font-weight: 700;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.05);
    }

    .home-view-all__link:hover {
      background: rgba(255, 255, 255, 0.9);
    }

    .chip.is-active {
      border-color: rgba(95, 127, 107, 0.42);
      background: rgba(95, 127, 107, 0.12);
      color: rgba(26, 26, 26, 0.92);
    }

    .discovery-tools {
      display: grid;
      grid-template-columns: auto auto auto;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-top: 18px;
      min-height: 52px;
    }

    .discovery-btn,
    .sort-select {
      min-height: 48px;
      border-radius: 999px;
      border: 1px solid rgba(26, 26, 26, 0.1);
      background: rgba(255, 255, 255, 0.82);
      box-shadow: 0 12px 26px rgba(0, 0, 0, 0.05);
      color: rgba(26, 26, 26, 0.86);
    }

    .discovery-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 0 18px;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }

    .discovery-btn__badge {
      display: inline-grid;
      place-items: center;
      min-width: 22px;
      height: 22px;
      padding: 0 6px;
      border-radius: 999px;
      background: rgba(95, 127, 107, 0.14);
      font-size: 12px;
      line-height: 1;
    }

    .sort-control {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-width: 330px;
      padding-left: 14px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.68);
      border: 1px solid rgba(26, 26, 26, 0.08);
      box-shadow: 0 12px 26px rgba(0, 0, 0, 0.05);
    }

    .sort-label {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(26, 26, 26, 0.54);
    }

    .sort-select {
      min-width: 214px;
      padding: 0 18px 0 8px;
      border: 0;
      background: transparent;
      font: inherit;
      font-weight: 600;
      appearance: none;
      cursor: pointer;
    }

    .sort-select:focus,
    .discovery-btn:focus-visible,
    .filters-modal__close:focus-visible,
    .filters-action:focus-visible {
      outline: 2px solid rgba(26, 26, 26, 0.3);
      outline-offset: 2px;
    }

    .filters-modal {
      position: fixed;
      inset: 0;
      z-index: 60;
    }

    .filters-modal__backdrop {
      position: absolute;
      inset: 0;
      background: rgba(22, 18, 12, 0.18);
      backdrop-filter: blur(6px);
    }

    .filters-modal__panel {
      position: absolute;
      top: 50%;
      left: 50%;
      width: min(92vw, 460px);
      padding: 24px;
      border-radius: 28px;
      border: 1px solid rgba(26, 26, 26, 0.08);
      background: rgba(250, 247, 242, 0.96);
      box-shadow: 0 28px 70px rgba(0, 0, 0, 0.16);
      transform: translate(-50%, -50%);
    }

    .filters-modal__panel--occasion {
      width: min(94vw, 760px);
      max-height: min(82vh, 760px);
      overflow: auto;
    }

    .filters-modal__head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 20px;
    }

    .filters-modal__eyebrow {
      margin: 0 0 6px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(26, 26, 26, 0.5);
    }

    .filters-modal__title {
      margin: 0;
      font-family: var(--font-title);
      font-size: 34px;
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .filters-modal__close {
      display: inline-grid;
      place-items: center;
      width: 42px;
      height: 42px;
      border-radius: 999px;
      border: 1px solid rgba(26, 26, 26, 0.08);
      background: rgba(255, 255, 255, 0.88);
      cursor: pointer;
      color: #7b403b;
    }

    .filters-group__label {
      margin: 0 0 12px;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(26, 26, 26, 0.58);
    }

    .filter-option {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 13px 14px;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.78);
      border: 1px solid rgba(26, 26, 26, 0.07);
    }

    .filter-option + .filter-option {
      margin-top: 10px;
    }

    .filter-option input {
      width: 16px;
      height: 16px;
