---
import SeoProductLanding from "../../components/SeoProductLanding.astro";
import {
  getCanonicalPathForLanding,
  getClothingEditorialForLanding,
  getLandingPageHierarchy,
  getProductsForLanding,
  SEO_LANDINGS,
} from "../../lib/seo-landings";
import { MEN_CLOTHING_TYPE_OPTIONS, WOMEN_CLOTHING_TYPE_OPTIONS } from "../../lib/clothing-types";
import { loadProducts } from "../../lib/products";

const allProducts = await loadProducts();

export async function getStaticPaths() {
  const products = await loadProducts();
  const preservedEmptySlugs = new Set([
    "zabavlenie", "hrana-i-napitki", "belio", "banya", "detski-knigi",
    "kozmetika-za-deca", "detski-mebeli-i-tekstil", "chai-i-bilki", "sport",
    "kozmetika-tyalo", "kozmetika-za-mazhe", "igri", "aksesoari-za-domashni-lyubimci",
    "napitki", "detski-aksesoari",
  ]);

  return SEO_LANDINGS.map((landing) => ({
    params: { slug: landing.slug },
    props: {
      landing,
      products: getProductsForLanding(products, landing),
    },
  })).filter((entry) => entry.props.products.length > 0 || preservedEmptySlugs.has(entry.params.slug));
}

const { landing, products } = Astro.props;

if (!landing) {
  throw new Error(`Unknown SEO landing page: ${Astro.params.slug}`);
}

const hierarchy = getLandingPageHierarchy(landing, allProducts);

const refinementOptions =
  landing.subcategoryKey === "clothing_women"
    ? WOMEN_CLOTHING_TYPE_OPTIONS
    : landing.subcategoryKey === "clothing_men"
      ? MEN_CLOTHING_TYPE_OPTIONS
      : [];

const clothingEditorial = getClothingEditorialForLanding(landing);
const registeredEditorial = hierarchy.seoLanding.editorialSections || [];
---

<SeoProductLanding
  landing={hierarchy.seoLanding}
  products={products}
  browseProducts={allProducts}
  canonicalPath={getCanonicalPathForLanding(landing)}
  breadcrumbs={hierarchy.breadcrumbs}
  primaryPills={hierarchy.primaryPills}
  secondaryPills={hierarchy.secondaryPills}
  parentLink={hierarchy.parentLink}
  secondaryPillsTitle={landing.subcategoryKey === "clothing_women" || landing.subcategoryKey === "clothing_men" ? "Най-търсени" : ""}
  refinementOptions={refinementOptions}
  refinementTitle={landing.categoryKey === "clothing" ? "Вид облекло" : "Вид продукт"}
  editorialHeader={clothingEditorial?.header}
  editorialSections={registeredEditorial.length ? registeredEditorial : clothingEditorial?.sections || []}
/>
