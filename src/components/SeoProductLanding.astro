  </style>

  <script is:inline>
    const grid = document.getElementById("grid");
    const count = document.getElementById("count");
    const feedStatus = document.getElementById("feedStatus");
    const feedSentinel = document.getElementById("feedSentinel");
    const allCards = Array.from(grid.querySelectorAll("li.card"));
    const refinementInputs = Array.from(document.querySelectorAll("[data-refinement-input]"));

    const getBatchSize = () => {
      if (window.innerWidth <= 640) return 8;
      if (window.innerWidth <= 768) return 10;
      return 16;
    };

    let visibleCount = getBatchSize();

    const getFilteredCards = () => {
      const activeFilters = refinementInputs
        .filter((input) => input.checked)
        .map((input) => input.value);

      if (!activeFilters.length) return allCards.filter((card) => card.dataset.initialMatch === "1");

      return allCards.filter((card) => {
        const keys = String(card.dataset.refinementKeys || "")
          .split(",")
          .map((value) => value.trim())
          .filter(Boolean);

        return activeFilters.some((key) => keys.includes(key));
      });
    };

    const updateFeedVisibility = () => {
      const filteredCards = getFilteredCards();
      const activeFilters = refinementInputs
        .filter((input) => input.checked)
        .map((input) => input.value);

      if (window.innerWidth > 768) {
        grid?.classList.toggle("grid--ordered", activeFilters.length > 0 || filteredCards.length <= 6);
      } else {
        grid?.classList.remove("grid--ordered");
      }

      allCards.forEach((card) => {
        card.style.display = "none";
      });

      filteredCards.forEach((card, index) => {
        card.style.display = index < visibleCount ? "" : "none";
      });

      if (count) {
        count.textContent = String(filteredCards.length);
      }

      if (feedStatus) {
        const shown = Math.min(visibleCount, filteredCards.length);
        feedStatus.textContent = filteredCards.length > shown ? `Показани ${shown} от ${filteredCards.length}` : "";
      }

      if (feedSentinel) {
        feedSentinel.hidden = filteredCards.length <= visibleCount;
      }

      window.dispatchEvent(new Event("resize"));
    };

    const loadMore = () => {
      if (visibleCount >= getFilteredCards().length) return;
      visibleCount += getBatchSize();
      updateFeedVisibility();
    };

    updateFeedVisibility();

    refinementInputs.forEach((input) => {
      input.addEventListener("change", () => {
        visibleCount = getBatchSize();
        updateFeedVisibility();
      });
    });

    if ("IntersectionObserver" in window && feedSentinel) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) loadMore();
        });
      }, { rootMargin: "320px 0px" });

      observer.observe(feedSentinel);
    }

    window.addEventListener("resize", () => {
      visibleCount = Math.max(visibleCount, getBatchSize());
      updateFeedVisibility();
    });
  </script>
</BaseLayout>
